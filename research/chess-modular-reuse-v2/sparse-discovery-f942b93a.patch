@@ -0,0 +1,420 @@
+"""Dynamic sparse readers on the native executor, with selected-only evidence.
+
+This opt-in organism starts without a reader bank or scoring conditions. Small
+random coordinate/value masks become real terminal/SCRIPT probes. A discovery
+window freezes a residual offset; only later observations review its predictive
+gain. Admitted contributions start at zero and receive ordinary residual credit.
+Prediction-based nomination/removal is not causal usefulness or consolidation.
+"""
+from __future__ import annotations
+
+from collections import deque
+from dataclasses import asdict, dataclass
+import math
+import random
+
+from recon_lite.graph import Node, NodeState, NodeType
+from .terminal_development import (
+    ACTION_CHOICE, Condition, PlasticWeight, TerminalDevelopment, _reader,
+)
+
+
+@dataclass(frozen=True)
+class DiscoveryConfig:
+    trial_capacity: int = 16
+    develop_every: int = 32
+    discovery_steps: int = 32
+    validation_steps: int = 32
+    min_active: int = 4
+    trial_age: int = 256
+    max_atoms: int = 3
+    max_nodes: int = 8192
+    retirement_window: int = 128
+    retirement_age: int = 256
+    random_fraction: float = 0.25
+    resource_cost: float = 0.0001
+
+    def __post_init__(self):
+        integers = (self.trial_capacity, self.develop_every, self.discovery_steps,
+                    self.validation_steps, self.min_active, self.trial_age,
+                    self.max_atoms, self.max_nodes, self.retirement_window,
+                    self.retirement_age)
+        if any(type(x) is not int or x < 1 for x in integers):
+            raise ValueError('discovery budgets must be positive integers')
+        if self.trial_age < self.discovery_steps + self.validation_steps:
+            raise ValueError('trial lifetime must permit a prospective review')
+        if not math.isfinite(self.random_fraction) or not 0 < self.random_fraction <= 1:
+            raise ValueError('a bounded nonzero exploratory admission route is required')
+        if not math.isfinite(self.resource_cost) or self.resource_cost < 0:
+            raise ValueError('resource charge must be finite and nonnegative')
+
+
+@dataclass
+class SparseTrial:
+    identity: int
+    atoms: tuple
+    operator: str
+    born: int
+    discovery_count: int = 0
+    discovery_active: int = 0
+    discovery_sum: float = 0.0
+    frozen_offset: float | None = None
+    validation_count: int = 0
+    validation_active: int = 0
+    validation_gain: float = 0.0
+
+    @property
+    def key(self):
+        return self.operator, self.atoms
+
+    def record(self, active, residual, config):
+        if not math.isfinite(residual):
+            raise ValueError('trial residual must be finite')
+        if self.frozen_offset is None:
+            self.discovery_count += 1
+            if active:
+                self.discovery_active += 1
+                self.discovery_sum += residual
+            if self.discovery_count >= config.discovery_steps:
+                self.frozen_offset = (self.discovery_sum / self.discovery_active
+                                      if self.discovery_active else 0.0)
+            # The receipt which freezes the coefficient is never validation.
+            return
+        self.validation_count += 1
+        if active:
+            self.validation_active += 1
+            offset = self.frozen_offset
+            self.validation_gain += residual * residual - (residual - offset) ** 2
+
+    def score(self, config):
+        if (self.frozen_offset is None
+                or self.discovery_active < config.min_active
+                or self.validation_count < config.validation_steps
+                or self.validation_active < config.min_active):
+            return None
+        return (self.validation_gain / self.validation_count
+                - config.resource_cost * len(self.atoms))
+
+
+class SparseDiscoveryDevelopment(TerminalDevelopment):
+    """A minimally seeded, immediate-feedback discovery organism.
+
+    Equality regions and AND/OR/exactly-one are supplied generic grammar, not
+    newly invented operators. Coordinate/value readers are instantiated only
+    for sampled hypotheses. No declared state/action partition is supplied.
+    """
+
+    def __init__(self, *, seed=1, config=None, discovery=None):
+        super().__init__(seed=seed, config=config)
+        self.discovery = discovery or DiscoveryConfig()
+        self.proposal_rng = random.Random(f'sparse-discovery:{seed}')
+        self.trials = {}
+        self.next_trial = 0
+        self.seen = set()
+        self.trial_archive = []
+        self.retired_history = []
+        self.live_evidence = {}
+        self.probe_slots = set()
+        self.observation_pending = None
+        self.last_credit = None
+        self.events = []
+        self.structure_version = 0
+        self._check_budget()
+
+    def _birth(self):
+        # The ancestor calls this after ordinary feedback. Never install its
+        # eager condition population or bypass this organism's evidence law.
+        return
+
+    def _prune(self):
+        # Coefficient magnitude alone does not establish dispensability.
+        return
+
+    def __getstate__(self):
+        if self.observation_pending is not None:
+            raise RuntimeError('checkpoint requires completed discovery feedback')
+        return super().__getstate__()
+
+    def act(self, port, *, event_id, learn):
+        if self.pending or self.observation_pending is not None:
+            raise RuntimeError('sparse discovery requires immediate matching feedback')
+        return super().act(port, event_id=event_id, learn=learn)
+
+    def _check_budget(self):
+        if len(self.graph.nodes) > self.discovery.max_nodes:
+            raise ValueError('sparse discovery physical node budget exceeded')
+
+    def _ensure_slots(self, count):
+        super()._ensure_slots(count)
+        self._check_budget()
+
+    def _reset(self):
+        super()._reset()
+        for node in self.graph.nodes.values():
+            if node.meta.get('discovery_trial'):
+                node.activation.value = 1.0
+
+    def _proposal(self):
+        maximum = min(self.discovery.max_atoms, len(self.schema))
+        parents = [c.atoms for c in self.conditions.values() if len(c.atoms) < maximum]
+        # Immature parents are equally eligible: no marginal maturity gate.
+        parents += [t.atoms for t in self.trials.values() if len(t.atoms) < maximum]
+        if parents and self.proposal_rng.random() < 0.5:
+            atoms = self.proposal_rng.choice(parents)
+            available = [i for i in range(len(self.schema))
+                         if i not in {index for index, _ in atoms}]
+            index = self.proposal_rng.choice(available)
+            atom = index, self.proposal_rng.choice(self.schema[index].values)
+            return 'and', tuple(sorted((*atoms, atom)))
+        sizes = tuple(range(1, maximum + 1))
+        size = self.proposal_rng.choices(sizes, weights=[1 / x for x in sizes])[0]
+        indices = self.proposal_rng.sample(range(len(self.schema)), size)
+        atoms = tuple(sorted((i, self.proposal_rng.choice(self.schema[i].values))
+                             for i in indices))
+        operator = (self.proposal_rng.choices(('and', 'or', 'xor'), (8, 1, 1))[0]
+                    if size > 1 else 'and')
+        return operator, atoms
+
+    def _refill_trials(self):
+        if self.schema is None:
+            return
+        attempts = 0
+        while len(self.trials) < self.discovery.trial_capacity and attempts < 128:
+            attempts += 1
+            key = self._proposal()
+            if key in self.seen:
+                continue
+            self.seen.add(key)
+            identity = self.next_trial
+            self.next_trial += 1
+            trial = SparseTrial(identity, key[1], key[0], self.completed)
+            self.trials[identity] = trial
+            for slot in sorted(self.probe_slots):
+                self._add_trial_slot(slot, trial)
+            self.events.append({'kind': 'trial_birth', 'at': self.completed,
+                                'trial': identity, 'operator': key[0], 'atoms': key[1]})
+        self._check_budget()
+
+    def _add_trial_slot(self, slot, trial):
+        root = f'discovery-probe:{slot}'
+        if root not in self.graph.nodes:
+            self.graph.add_node(Node(root, NodeType.SCRIPT,
+                                     meta={'confirm_policy': 'weighted_evidence'}))
+        gate = f'discovery-trial:{slot}:{trial.identity}'
+        if gate in self.graph.nodes:
+            return
+        self.graph.add_node(Node(gate, NodeType.SCRIPT,
+            meta={'confirm_policy': trial.operator, 'discovery_trial': True}))
+        self.graph.nodes[gate].activation.value = 1.0
+        self.graph.add_hierarchy_pair(root, gate)
+        for index, expected in trial.atoms:
+            terminal = f'read:{slot}:{index}:{int(expected)}'
+            if terminal not in self.graph.nodes:
+                self.graph.add_node(Node(terminal, NodeType.TERMINAL, predicate=_reader,
+                                         meta={'slot': slot, 'atom': (index, expected)}))
+            self.graph.add_hierarchy_pair(gate, terminal)
+
+    def _before_execute(self, engine, env, *, event_id, slot, prediction, learn):
+        if not learn:
+            return
+        self._refill_trials()
+        self.probe_slots.add(slot)
+        for trial in self.trials.values():
+            self._add_trial_slot(slot, trial)
+        values = {}
+        if self.trials:
+            self.graph.validate_formal_pairs()
+            root = f'discovery-probe:{slot}'
+            engine.request(root)
+            engine.run(max_ticks=40, env=env, until=lambda e:
+                       self.graph.nodes[root].state in (NodeState.CONFIRMED, NodeState.FAILED))
+            for identity in self.trials:
+                state = self.graph.nodes[f'discovery-trial:{slot}:{identity}'].state
+                if state not in (NodeState.CONFIRMED, NodeState.FAILED):
+                    raise RuntimeError('discovery probe did not settle')
+                values[identity] = state == NodeState.CONFIRMED
+        active = tuple(cid for cid in self.conditions
+                       if self.graph.nodes[f'gate:{slot}:{cid}'].state == NodeState.CONFIRMED)
+        self.observation_pending = {
+            'event_id': event_id, 'action': env['bindings'][slot],
+            'prediction': prediction, 'active': active, 'trial_values': values,
+            'condition_weights': {cid: float(c.weight) for cid, c in self.conditions.items()},
+        }
+        self._check_budget()
+
+    def _weights(self):
+        return {'bias': [self.bias.fast, self.bias.slow],
+                'conditions': {str(cid): [c.weight.fast, c.weight.slow]
+                               for cid, c in self.conditions.items()}}
+
+    def observe(self, feedback):
+        observation = self.observation_pending
+        if (len(self.pending) != 1 or observation is None
+                or (feedback.event_id, feedback.action) != self.pending[0][:2]
+                or (feedback.event_id, feedback.action)
+                != (observation['event_id'], observation['action'])):
+            raise ValueError('outcome must bind to the actual pending discovery action')
+        reward = float(feedback.reward)
+        if not math.isfinite(reward):
+            raise ValueError('reward must be finite')
+        _, action, prediction, active = self.pending[0]
+        if prediction != observation['prediction'] or active != observation['active']:
+            raise RuntimeError('discovery and scoring participation disagree')
+        before = self._weights()
+        residual = reward - prediction
+        delta = self.config.learning_rate * residual / (1 + len(active))
+        self.bias.fast += delta
+        for cid in active:
+            condition = self.conditions[cid]
+            condition.weight.fast += delta
+            condition.stats.record_activation(ACTION_CHOICE)
+            condition.stats.record_confirm(self.completed, ACTION_CHOICE)
+            condition.stats.record_correlation(
+                'positive' if reward > 0 else 'negative' if reward < 0 else 'neutral')
+        for condition in self.conditions.values():
+            condition.stats.record_request(ACTION_CHOICE)
+        self.last_credit = {'event_id': feedback.event_id, 'action': action,
+            'reward': reward, 'prediction': prediction, 'active': active,
+            'delta': delta, 'weights_before': before,
+            'weights_after_credit': self._weights()}
+        for identity, enabled in observation['trial_values'].items():
+            self.trials[identity].record(enabled, residual, self.discovery)
+        for cid, weight in observation['condition_weights'].items():
+            enabled = cid in active
+            without = prediction - weight if enabled else prediction
+            gain = (reward - without) ** 2 - residual ** 2
+            self.live_evidence.setdefault(cid, deque(
+                maxlen=self.discovery.retirement_window)).append((enabled, gain))
+        self.pending.clear()
+        self.observation_pending = None
+        self.completed += 1
+        if self.completed % self.config.consolidate_every == 0:
+            self.bias.consolidate(self.config.consolidation_rate)
+        if self.completed % self.discovery.develop_every == 0:
+            self._develop()
+
+    def _retire_one(self):
+        choices = []
+        for cid, condition in self.conditions.items():
+            evidence = self.live_evidence.get(cid, ())
+            if (self.completed - condition.born < self.discovery.retirement_age
+                    or len(evidence) < self.discovery.retirement_window
+                    or sum(enabled for enabled, _ in evidence) < self.discovery.min_active):
+                continue
+            score = sum(gain for _, gain in evidence) / len(evidence)
+            if score < -self.discovery.resource_cost * len(condition.atoms):
+                choices.append((score, cid))
+        if not choices:
+            return False
+        score, cid = min(choices)
+        condition = self.conditions.pop(cid)
+        self.live_evidence.pop(cid, None)
+        self.retired_conditions[(condition.operator, condition.atoms)] = condition
+        self.retired_history.append({'at': self.completed, 'condition': cid,
+            'operator': condition.operator, 'atoms': condition.atoms,
+            'weight': float(condition.weight), 'predictive_gain': score})
+        self.events.append({'kind': 'retirement', **self.retired_history[-1]})
+        self.pruned += 1
+        return True
+
+    def _admit_one(self):
+        if len(self.conditions) >= self.config.max_conditions:
+            self.events.append({'kind': 'scoring_budget', 'at': self.completed})
+            return False
+        eligible = []
+        ranked = []
+        for trial in self.trials.values():
+            if (trial.frozen_offset is None
+                    or trial.discovery_active < self.discovery.min_active):
+                continue
+            score = trial.score(self.discovery)
+            # Fully reviewed negative proposals never use the exploratory route.
+            if score is not None and score <= 0:
+                continue
+            eligible.append(trial)
+            if score is not None:
+                ranked.append((score, trial.identity))
+        exploratory = self.proposal_rng.random() < self.discovery.random_fraction
+        if exploratory and eligible:
+            trial = self.proposal_rng.choice(eligible)
+            reason = 'exploratory'
+        elif ranked:
+            _, identity = max(ranked, key=lambda x: (x[0], -x[1]))
+            trial, reason = self.trials[identity], 'prospective_prediction'
+        else:
+            return False
+        cid = self.next_condition
+        self.next_condition += 1
+        self.conditions[cid] = Condition(cid, trial.atoms, trial.operator,
+                                         self.completed, weight=PlasticWeight())
+        self.trial_archive.append({'status': 'admitted', 'at': self.completed,
+                                   'condition': cid, 'trial': asdict(trial)})
+        self.trials.pop(trial.identity)
+        self.events.append({'kind': 'admission', 'at': self.completed,
+            'condition': cid, 'trial': trial.identity, 'operator': trial.operator,
+            'atoms': trial.atoms, 'reason': reason, 'initial_weight': 0.0,
+            'predictive_score': trial.score(self.discovery)})
+        return True
+
+    def _develop(self):
+        removed = self._retire_one()
+        admitted = self._admit_one()
+        for identity, trial in tuple(self.trials.items()):
+            if self.completed - trial.born >= self.discovery.trial_age:
+                self.trial_archive.append({'status': 'expired', 'at': self.completed,
+                                           'trial': asdict(trial)})
+                self.events.append({'kind': 'trial_expiration', 'at': self.completed,
+                    'trial': identity, 'discovery_active': trial.discovery_active,
+                    'validation_active': trial.validation_active,
+                    'predictive_score': trial.score(self.discovery)})
+                self.trials.pop(identity)
+        # Rebuild reclaims orphan probe/readers without losing any hypothesis
+        # evidence or replacing surviving learned weight objects.
+        scaffold = TerminalDevelopment(seed=0, config=self.config)
+        scaffold.conditions, scaffold.bias = self.conditions, self.bias
+        scaffold._ensure_slots(self.slots)
+        self.graph = scaffold.graph
+        self._refill_trials()
+        for slot in sorted(self.probe_slots):
+            for trial in self.trials.values():
+                self._add_trial_slot(slot, trial)
+        if removed or admitted:
+            self.structure_version += 1
+            # Removal scores from the old joint scorer cannot delete another
+            # correlated term without new evidence in the changed scorer.
+            self.live_evidence.clear()
+        self.graph.validate_formal_pairs()
+        self._check_budget()
+
+    def inventory(self):
+        readers = {atom for condition in self.conditions.values() for atom in condition.atoms}
+        readers.update(atom for trial in self.trials.values() for atom in trial.atoms)
+        return {'nodes': len(self.graph.nodes), 'edges': len(self.graph.edges),
+                'slots': self.slots, 'live_conditions': len(self.conditions),
+                'scoring_parameters': 1 + len(self.conditions),
+                'trial_count': len(self.trials), 'unique_reader_definitions': len(readers),
+                'seen_hypotheses': len(self.seen), 'completed': self.completed,
+                'structure_version': self.structure_version}
+
+    def state_snapshot(self):
+        structural = ('slot', 'atom', 'condition_id', 'confirm_policy', 'discovery_trial')
+        return {'config': asdict(self.config), 'discovery': asdict(self.discovery),
+            'schema': None if self.schema is None else
+                      [(c.name, list(c.values)) for c in self.schema],
+            'completed': self.completed, 'last_event': self.last_event,
+            'next_trial': self.next_trial, 'next_condition': self.next_condition,
+            'weights': self._weights(),
+            'conditions': [(cid, c.atoms, c.operator, c.born, c.stats.to_dict())
+                           for cid, c in self.conditions.items()],
+            'trials': [asdict(t) for t in self.trials.values()],
+            'seen': sorted(self.seen, key=repr), 'trial_archive': self.trial_archive,
+            'retired_history': self.retired_history,
+            'live_evidence': {str(k): list(v) for k, v in self.live_evidence.items()},
+            'probe_slots': sorted(self.probe_slots), 'events': self.events,
+            'rng': self.rng.getstate(), 'proposal_rng': self.proposal_rng.getstate(),
+            'inventory': self.inventory(),
+            'graph_nodes': [(nid, node.ntype.name,
+                {k: node.meta[k] for k in structural if k in node.meta})
+                for nid, node in sorted(self.graph.nodes.items())],
+            'graph_edges': sorted((e.src, e.dst, e.ltype.name, float(e.w))
+                                   for e in self.graph.edges)}
diff --git a/tests/autogrowth/test_sparse_discovery.py b/tests/autogrowth/test_sparse_discovery.py
new file mode 100644
index 00000000..74c07d5c
--- /dev/null
+++ b/tests/autogrowth/test_sparse_discovery.py
@@ -0,0 +1,394 @@
+"""Focused discovery mechanics, not an efficacy or chess-performance study.
+
+Planted conditions below isolate execution and credit. They do not count as
+evidence that the learner discovers useful structure by itself.
+"""
+from dataclasses import replace
+import inspect
+import pickle
+
+import pytest
+
+from recon_lite.graph import LinkType, NodeType
+from recon_lite_chess.coach.interface import Feedback
+from recon_lite_hector.learning.sparse_discovery import (
+    DiscoveryConfig, SparseDiscoveryDevelopment, SparseTrial,
+)
+from recon_lite_hector.learning.terminal_development import (
+    Condition, Coordinate, DevelopmentConfig, PlasticWeight, _reader,
+)
+
+
+BOOL = (False, True)
+
+
+class VectorPort:
+    """Opaque bindings and a typed vector reachable only through terminals."""
+
+    schema = tuple(Coordinate(name, BOOL) for name in ("q0", "q1", "q2"))
+
+    def __init__(self, x=False, y=False, *, names=("a", "b"), schema=None):
+        self.row = (x, y)
+        self.names = names
+        self.executed = None
+        self.reads = []
+        if schema is not None:
+            self.schema = schema
+
+    def bindings(self):
+        assert inspect.currentframe().f_back.f_code.co_name == "_catalog"
+        return self.names
+
+    def measure(self, coordinate, binding):
+        assert inspect.currentframe().f_back.f_code.co_name == "_reader"
+        self.reads.append((coordinate, binding))
+        return (*self.row, binding == self.names[1])[coordinate]
+
+    def execute(self, binding):
+        assert inspect.currentframe().f_back.f_code.co_name == "_actuator"
+        assert self.executed is None
+        assert binding in self.names
+        self.executed = binding
+
+
+def actor(seed=7, **discovery):
+    return SparseDiscoveryDevelopment(
+        seed=seed,
+        config=DevelopmentConfig(exploration=0, consolidate_every=10000),
+        discovery=replace(DiscoveryConfig(), **discovery),
+    )
+
+
+def planted(learner, atoms, weight=0.0, operator="and"):
+    """An explicitly planted mechanical fixture, never an efficacy result."""
+    learner.schema = VectorPort.schema
+    cid = learner.next_condition
+    learner.next_condition += 1
+    condition = Condition(cid, tuple(atoms), operator, learner.completed,
+                          weight=PlasticWeight(fast=weight))
+    learner.conditions[cid] = condition
+    for slot in range(learner.slots):
+        learner._add_condition_slot(condition, slot)
+    return condition
+
+
+def step(learner, event, x=False, y=False, reward=1.0, **port_options):
+    port = VectorPort(x, y, **port_options)
+    action = learner.act(port, event_id=event, learn=True)
+    learner.observe(Feedback(event, action, reward))
+    return port, action
+
+
+def test_minimal_initializer_has_no_sensor_bank_or_planted_solution():
+    learner = actor()
+    assert learner.schema is None
+    assert not learner.conditions and not learner.retired_conditions
+    assert learner.completed == 0 and float(learner.bias) == 0
+    assert not any(node.predicate is _reader for node in learner.graph.nodes.values())
+    assert len(learner.graph.nodes) < 20
+    assert all(not learner.graph.children(nid)
+               for nid, node in learner.graph.nodes.items()
+               if node.ntype == NodeType.TERMINAL)
+
+
+def test_new_trial_observations_are_selected_only_and_terminal_mediated():
+    learner = actor()
+    port = VectorPort(True, False)
+    action = learner.act(port, event_id=0, learn=True)
+    assert action == port.executed
+    assert port.reads  # Discovery genuinely observes candidate readers.
+    assert all(binding == action for _, binding in port.reads)
+    assert all(0 <= index < len(port.schema) for index, _ in port.reads)
+    learner.graph.validate_formal_pairs()
+    learner.observe(Feedback(0, action, -1))
+
+
+def test_probe_activity_does_not_dilute_ordinary_selected_action_credit():
+    learner = actor()
+    condition = planted(learner, ((2, True),), weight=0.4)
+    port = VectorPort()
+    action = learner.act(port, event_id=0, learn=True)
+    event, token, prediction, active = learner.pending[-1]
+    assert (event, token) == (0, action)
+    assert active == (condition.identity,)
+    assert prediction == pytest.approx(0.4)
+    delta = learner.config.learning_rate * (1 - prediction) / 2
+    learner.observe(Feedback(0, action, 1))
+    assert learner.bias.fast == pytest.approx(delta)
+    assert condition.weight.fast == pytest.approx(0.4 + delta)
+    assert condition.stats.credit_stats.total_correlations == 1
+
+
+def test_graph_evidence_edge_controls_real_actuator_selection():
+    learner = actor()
+    condition = planted(learner, ((2, True),), weight=2)
+    assert learner.act(VectorPort(), event_id=0, learn=False) == "b"
+    for slot in range(learner.slots):
+        learner.graph.edge_by_key[(f"gate:{slot}:{condition.identity}",
+                                   f"option:{slot}", LinkType.SUR)].w = -2.0
+    assert learner.act(VectorPort(), event_id=1, learn=False) == "a"
+
+
+def test_outcome_identity_finiteness_and_single_credit_are_enforced():
+    learner = actor()
+    port = VectorPort()
+    action = learner.act(port, event_id=3, learn=True)
+    with pytest.raises(ValueError, match="bind|latest|identity"):
+        learner.observe(Feedback(3, "not-the-selected-token", 1))
+    with pytest.raises(ValueError, match="finite"):
+        learner.observe(Feedback(3, action, float("nan")))
+    with pytest.raises(RuntimeError, match="outcome|pending|feedback"):
+        pickle.dumps(learner)
+    learner.observe(Feedback(3, action, -1))
+    with pytest.raises((RuntimeError, ValueError), match="awaiting|pending|outcome"):
+        learner.observe(Feedback(3, action, -1))
+    with pytest.raises(ValueError, match="increase"):
+        learner.act(VectorPort(), event_id=3, learn=True)
+
+
+def test_coordinate_names_and_opaque_binding_names_do_not_guide_birth():
+    ordinary = actor(17)
+    renamed = actor(17)
+    other_schema = tuple(Coordinate(name, BOOL) for name in
+                         ("mate_detector", "red_herring", "hidden_answer"))
+    for event in range(64):
+        x, y = bool(event % 2), bool(event % 3)
+        p0, a0 = step(ordinary, event, x, y, reward=(-1 if event % 3 else 1))
+        p1, a1 = step(renamed, event, x, y, reward=(-1 if event % 3 else 1),
+                      names=("different-a", "different-b"), schema=other_schema)
+        assert p0.names.index(a0) == p1.names.index(a1)
+        assert ordinary.rng.getstate() == renamed.rng.getstate()
+        assert [(c.operator, c.atoms, float(c.weight))
+                for c in ordinary.conditions.values()] == [
+                    (c.operator, c.atoms, float(c.weight))
+                    for c in renamed.conditions.values()]
+
+
+def test_unread_coordinate_does_not_influence_planted_policy():
+    learner = actor()
+    planted(learner, ((2, True),), weight=1)
+    rng = learner.rng.getstate()
+    for x in BOOL:
+        for y in BOOL:
+            port = VectorPort(x, y)
+            assert learner.act(port, event_id=0, learn=False) == "b"
+            assert all(index == 2 for index, _ in port.reads)
+    assert learner.rng.getstate() == rng
+
+
+def test_native_reader_rejects_wrong_scalar_type():
+    learner = actor()
+    planted(learner, ((0, True),), weight=1)
+    with pytest.raises(ValueError, match="typed domain"):
+        learner.act(VectorPort(1, False), event_id=0, learn=False)
+
+
+def test_checkpoint_resume_preserves_discovery_rng_and_weight_aliases():
+    learner = actor(31)
+    for event in range(40):
+        step(learner, event, bool(event % 2), bool(event % 3),
+             reward=(1 if event % 4 == 0 else -1))
+    restored = pickle.loads(pickle.dumps(learner))
+    for event in range(40, 72):
+        row = bool(event % 2), bool(event % 3)
+        ports = [VectorPort(*row), VectorPort(*row)]
+        actions = [o.act(p, event_id=event, learn=True)
+                   for o, p in zip((learner, restored), ports)]
+        assert actions[0] == actions[1]
+        for organism, action in zip((learner, restored), actions):
+            organism.observe(Feedback(event, action, 1 if event % 4 == 0 else -1))
+        assert learner.state_snapshot() == restored.state_snapshot()
+        assert learner.events == restored.events
+        assert learner.rng.getstate() == restored.rng.getstate()
+    for condition in restored.conditions.values():
+        for slot in range(restored.slots):
+            edge = restored.graph.edge_by_key[(f"gate:{slot}:{condition.identity}",
+                                               f"option:{slot}", LinkType.SUR)]
+            assert edge.w is condition.weight
+
+
+def test_evaluation_on_a_private_copy_cannot_mutate_training_state():
+    learner = actor(41)
+    for event in range(10):
+        step(learner, event, bool(event % 2), bool(event % 3), reward=-1)
+    frozen = pickle.dumps(learner)
+    evaluation = pickle.loads(frozen)
+    count = evaluation.completed
+    state = evaluation.rng.getstate()
+    for x in BOOL:
+        for y in BOOL:
+            evaluation.act(VectorPort(x, y), event_id=0, learn=False)
+    assert pickle.dumps(learner) == frozen
+    assert evaluation.completed == count
+    assert evaluation.rng.getstate() == state
+
+
+def test_discovery_fit_is_frozen_before_strictly_later_validation():
+    config = replace(DiscoveryConfig(), discovery_steps=4, validation_steps=4,
+                     min_active=4, resource_cost=0)
+    trial = SparseTrial(0, ((0, True),), "and", 0)
+    for _ in range(4):
+        trial.record(True, 2.0, config)
+    assert trial.frozen_offset == pytest.approx(2)
+    assert trial.discovery_count == 4
+    assert trial.validation_count == 0
+    assert trial.score(config) is None
+    # Opposite future receipts expose the discovery overfit. They must never
+    # refit the originally favourable offset or enter its discovery sample.
+    for _ in range(4):
+        trial.record(True, -2.0, config)
+    assert trial.frozen_offset == pytest.approx(2)
+    assert trial.discovery_count == 4
+    assert trial.validation_count == 4
+    assert trial.score(config) == pytest.approx(-12)
+
+
+def test_negative_predictive_offset_can_be_useful_and_eligible():
+    config = replace(DiscoveryConfig(), discovery_steps=4, validation_steps=4,
+                     min_active=4, resource_cost=0)
+    trial = SparseTrial(3, ((0, True),), "and", 0)
+    for _ in range(8):
+        trial.record(True, -2.0, config)
+    assert trial.frozen_offset == pytest.approx(-2)
+    assert trial.score(config) == pytest.approx(4)
+
+
+def test_joint_trial_can_qualify_without_any_marginal_reader_maturation():
+    # Deliberately planted evidence isolates eligibility; this is not a claim
+    # that sampling has autonomously found this joint-only feature.
+    config = replace(DiscoveryConfig(), discovery_steps=4, validation_steps=4,
+                     min_active=2, resource_cost=0)
+    trial = SparseTrial(5, ((0, True), (1, True)), "and", 0)
+    for _ in range(2):
+        for active, residual in ((False, -1.0), (True, 1.0)):
+            trial.record(active, residual, config)
+    assert trial.frozen_offset == pytest.approx(1)
+    assert trial.score(config) is None
+    for _ in range(2):
+        for active, residual in ((False, -1.0), (True, 1.0)):
+            trial.record(active, residual, config)
+    assert trial.score(config) == pytest.approx(0.5)
+
+
+def test_fully_reviewed_harmful_candidate_cannot_use_random_admission():
+    learner = actor(random_fraction=1, discovery_steps=4, validation_steps=4,
+                    min_active=4, resource_cost=0)
+    learner.schema = VectorPort.schema
+    harmful = SparseTrial(1, ((0, True),), "and", 0)
+    helpful = SparseTrial(2, ((0, True), (1, True)), "and", 0)
+    for _ in range(4):
+        harmful.record(True, 2, learner.discovery)
+        helpful.record(True, -2, learner.discovery)
+    for _ in range(4):
+        harmful.record(True, -2, learner.discovery)
+        helpful.record(True, -2, learner.discovery)
+    learner.trials = {1: harmful, 2: helpful}
+    assert learner._admit_one()
+    assert learner.events[-1]["trial"] == 2
+    assert learner.events[-1]["initial_weight"] == 0
+    assert len(learner.conditions) == 1
+    assert float(next(iter(learner.conditions.values())).weight) == 0
+    assert not learner._admit_one()
+    assert learner.trials == {1: harmful}
+
+
+def test_retirement_keeps_shared_and_trial_reader_dependencies_and_history(monkeypatch):
+    learner = actor(retirement_window=4, retirement_age=4, min_active=1)
+    doomed = planted(learner, ((0, True), (1, True)), weight=1)
+    retained = planted(learner, ((0, True), (2, True)), weight=1)
+    learner._ensure_slots(2)
+    trial = SparseTrial(3, ((1, False),), "and", 300)
+    learner.trials = {3: trial}
+    learner.seen = {(c.operator, c.atoms) for c in learner.conditions.values()} | {trial.key}
+    learner.probe_slots = {0}
+    learner._add_trial_slot(0, trial)
+    learner.completed = 300
+    learner.live_evidence = {doomed.identity: [(True, -1)] * 4,
+                             retained.identity: [(True, 1)] * 4}
+    monkeypatch.setattr(learner, "_refill_trials", lambda: None)
+    learner._develop()
+    assert doomed.identity not in learner.conditions
+    assert learner.conditions == {retained.identity: retained}
+    assert (doomed.operator, doomed.atoms) in learner.retired_conditions
+    assert (doomed.operator, doomed.atoms) in learner.seen
+    assert learner.retired_history[-1]["condition"] == doomed.identity
+    assert "read:0:0:1" in learner.graph.nodes  # Shared live dependency.
+    assert "read:0:1:0" in learner.graph.nodes  # Non-scoring trial dependency.
+    assert "read:0:1:1" not in learner.graph.nodes  # Orphan is reclaimed.
+    assert not learner.live_evidence  # Old scorer's deletion evidence expires.
+    for slot in range(2):
+        assert learner.graph.edge_by_key[(f"gate:{slot}:{retained.identity}",
+                                          f"option:{slot}", LinkType.SUR)].w is retained.weight
+    learner.graph.validate_formal_pairs()
+
+
+def test_only_one_negative_gain_retirement_then_fresh_evidence_is_required(monkeypatch):
+    learner = actor(retirement_window=4, retirement_age=4, min_active=1)
+    first = planted(learner, ((0, True),), weight=1)
+    second = planted(learner, ((1, True),), weight=1)
+    learner._ensure_slots(2)
+    learner.completed = 300
+    learner.live_evidence = {first.identity: [(True, -2)] * 4,
+                             second.identity: [(True, -1)] * 4}
+    monkeypatch.setattr(learner, "_refill_trials", lambda: None)
+    learner._develop()
