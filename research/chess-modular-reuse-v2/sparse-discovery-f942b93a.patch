+#!/usr/bin/env python3
+"""One fresh exploratory M1 actor, with bounded production and native replay.
+
+This runner does not select mechanisms, tune parameters, or claim a replication
+gate. The saved M1 regression receipts supply FENs only; their moves and rewards
+are never sent to the learner. Scientific and engineering namespaces are separate.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+from dataclasses import asdict
+import gzip
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import pickle
+import platform
+import random
+import signal
+import subprocess
+import sys
+import time
+import traceback
+
+ROOT = Path(__file__).resolve().parents[1]
+PYTHON = Path("/Users/banquo/Documents/ChatGPT/Hector-Recon/project-runtimes/modular-pilot-runtime-20261009/venv/bin/python")
+SEED = 202610210901
+SCIENTIFIC_EVENTS = 3072
+CHECKPOINTS = (0, 512, 1024, 1536, 2048, 2560, 3072)
+CENSUSES = (0, 1536, 2048, 3072)
+POOL_FILES = tuple(ROOT / "tests/autogrowth/data/selective_m1" / name for name in
+                   ("m1_validated_receipts.json.gz", "m1_scope_completion_receipts.json.gz"))
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def digest_bytes(value):
+    return hashlib.sha256(value).hexdigest()
+
+
+def read_json(path):
+    return json.loads(Path(path).read_text())
+
+
+def write_json(path, value):
+    Path(path).write_text(canonical(value) + "\n")
+
+
+def append_json(path, value):
+    with Path(path).open("a") as handle:
+        handle.write(canonical(value) + "\n")
+        handle.flush()
+
+
+def check(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def runtime_sources():
+    """Only imported repository runtime modules, plus this runner."""
+    selected = {str(Path(__file__).resolve())}
+    roots = (ROOT / "src", ROOT / "libs/recon-lite/src")
+    for module_name, module in tuple(sys.modules.items()):
+        name = getattr(module, "__file__", None)
+        if name:
+            path = Path(name).resolve()
+            if path.suffix == ".py" and (any(path.is_relative_to(root) for root in roots)
+                                        or module_name == "chess" or module_name.startswith("chess.")):
+                selected.add(str(path))
+    return {path: digest_bytes(Path(path).read_bytes()) for path in sorted(selected)}
+
+
+def check_sources(expected):
+    for path, sha in expected.items():
+        check(digest_bytes(Path(path).read_bytes()) == sha, f"source changed: {path}")
+
+
+def load_fens():
+    """Export only position strings from the known regression population."""
+    fens = []
+    inputs = {}
+    for path in POOL_FILES:
+        raw = path.read_bytes()
+        inputs[str(path)] = digest_bytes(raw)
+        rows = json.loads(gzip.decompress(raw))
+        fens.extend(row["fen"] for row in rows)
+    check(len(fens) == 1512 and len(set(fens)) == 1512, "M1 population must be exactly1512 unique FENs")
+    return tuple(fens), inputs
+
+
+def create_actor(seed):
+    # Resolve the actual embodiment dependencies before the source census.
+    from recon_lite_chess.coach.interface import Feedback  # noqa: F401
+    from recon_lite_chess.coach.terminal import ChessFeaturePort  # noqa: F401
+    from recon_lite_hector.learning.sparse_discovery import SparseDiscoveryDevelopment
+
+    actor = SparseDiscoveryDevelopment(seed=seed)
+    # Marker selects the existing typed terminal adapter; it supplies no detector.
+    actor.embodiment = "typed_feature_terminals_v1"
+    check(actor.completed == 0 and not actor.conditions, "fresh actor must have zero conditions")
+    return actor
+
+
+def weight_pair(value):
+    if isinstance(value, dict):
+        return [float(value["fast"]), float(value["slow"])]
+    return [float(value[0]), float(value[1])]
+
+
+def normalized_weights(value):
+    return {"bias": weight_pair(value["bias"]), "conditions": {
+        str(key): weight_pair(pair) for key, pair in value["conditions"].items()}}
+
+
+def weights(actor):
+    return {"bias": [actor.bias.fast, actor.bias.slow], "conditions": {
+        str(cid): [condition.weight.fast, condition.weight.slow]
+        for cid, condition in actor.conditions.items()}}
+
+
+def admission_summary(events):
+    reasons = {}
+    incomplete_reviews = 0
+    for event in events:
+        if event["kind"] == "admission":
+            reason = event["reason"]
+            reasons[reason] = reasons.get(reason, 0) + 1
+            incomplete_reviews += event["predictive_score"] is None
+    return {"by_reason": reasons,
+            "before_complete_prospective_review": incomplete_reviews}
+
+
+def verify_credit(credit, *, alpha):
+    """Independent scalar arithmetic, before consolidation or development."""
+    before = normalized_weights(credit["weights_before"])
+    after = normalized_weights(credit["weights_after_credit"])
+    active = tuple(map(str, credit["active"]))
+    check(len(active) == len(set(active)), "duplicate eligible contributor")
+    check(set(before["conditions"]) == set(after["conditions"]), "credit changed contributor identities")
+    check(set(active) <= set(before["conditions"]), "credit references absent contributor")
+    prediction, reward = float(credit["prediction"]), float(credit["reward"])
+    check(math.isfinite(prediction) and reward in (-1.0, 1.0), "invalid one-step credit values")
+    # The graph's native sum is checked with rounding tolerance; scalar update
+    # additions below are computed in the same declared one-step convention.
+    reconstructed = sum(before["bias"])
+    for cid in active:
+        reconstructed += sum(before["conditions"][cid])
+    check(math.isclose(reconstructed, prediction, rel_tol=0.0, abs_tol=2e-10), "prediction does not equal active shared weights")
+    delta = alpha * (reward - prediction) / (1 + len(active))
+    expected = copy.deepcopy(before)
+    expected["bias"][0] += delta
+    for cid in active:
+        expected["conditions"][cid][0] += delta
+    check(expected == after, "independent selected-action learning arithmetic differs")
+    return delta
+
+
+def step(actor, fen, event):
+    """Grade only the real submitted move; no alternative outcome queries."""
+    import chess
+    from recon_lite_chess.coach.interface import Feedback
+    from recon_lite_chess.coach.terminal import ChessFeaturePort
+
+    board = chess.Board(fen)
+    check(board.is_valid() and board.turn == chess.WHITE and not board.is_game_over(), "invalid live M1 exercise")
+    port = ChessFeaturePort(board)
+    lifecycle_start = len(actor.events)
+    action = actor.act(port, event_id=event, learn=True)
+    check(action == port.executed and action is not None, "graph-selected actuator did not execute")
+    before = weights(actor)
+    reward = 1.0 if board.is_checkmate() else -1.0
+    actor.observe(Feedback(event, action, reward))
+    credit = copy.deepcopy(actor.last_credit)
+    check(credit["event_id"] == event and credit["action"] == action and credit["reward"] == reward,
+          "credit does not bind to actual action/outcome")
+    check(normalized_weights(credit["weights_before"]) == before, "credit input weights differ from actual actor")
+    verify_credit(credit, alpha=actor.config.learning_rate)
+    return {"event": event, "action": action, "reward": reward,
+            "after_fen": board.fen(), "credit": credit,
+            "lifecycle": copy.deepcopy(actor.events[lifecycle_start:]),
+            "inventory": actor.inventory()}
+
+
+def census(actor, fens, event):
+    """One disposable copy; zero feedback or returned outcomes enter learning."""
+    import chess
+    from recon_lite_chess.coach.terminal import ChessFeaturePort
+
+    before = canonical(actor.state_snapshot())
+    probe = copy.deepcopy(actor)
+    rows = []
+    for index, fen in enumerate(fens):
+        board = chess.Board(fen)
+        port = ChessFeaturePort(board)
+        action = probe.act(port, event_id=event, learn=False)
+        check(action == port.executed and action is not None, "evaluation actuator did not execute")
+        rows.append({"index": index, "action": action, "mate": board.is_checkmate()})
+    check(canonical(actor.state_snapshot()) == before, "evaluation mutated original actor")
+    check(probe.completed == actor.completed and probe.rng.getstate() == actor.rng.getstate(),
+          "greedy evaluation changed learning/RNG state")
+    return {"completed": event, "solved": sum(row["mate"] for row in rows),
+            "total": len(rows), "rows": rows}
+
+
+def save_checkpoint(actor, schedule, directory, completed):
+    stem = directory / f"checkpoint_{completed:04d}"
+    payload = gzip.compress(pickle.dumps({"actor": actor, "schedule": schedule.getstate()},
+                                         protocol=pickle.HIGHEST_PROTOCOL), mtime=0)
+    stem.with_suffix(".pkl.gz").write_bytes(payload)
+    write_json(stem.with_suffix(".json"), {"completed": completed,
+               "payload_sha256": digest_bytes(payload), "snapshot": actor.state_snapshot(),
+               "schedule": schedule.getstate()})
+
+
+def restore_checkpoint(directory, completed):
+    stem = directory / f"checkpoint_{completed:04d}"
+    sidecar = read_json(stem.with_suffix(".json"))
+    payload = stem.with_suffix(".pkl.gz").read_bytes()
+    check(digest_bytes(payload) == sidecar["payload_sha256"], "checkpoint payload hash mismatch")
+    # Only this task's own source-pinned, hash-verified checkpoints are loaded.
+    restored = pickle.loads(gzip.decompress(payload))
+    check(canonical(restored["actor"].state_snapshot()) == canonical(sidecar["snapshot"]),
+          "checkpoint restoration differs from declared behavioral/development snapshot")
+    check(canonical(restored["schedule"]) == canonical(sidecar["schedule"]), "checkpoint schedule mismatch")
+    return restored["actor"], restored["schedule"], sidecar
+
+
+def worker_produce(args):
+    directory = Path(args.output)
+    fens, inputs = load_fens()
+    if args.engineering:
+        fens = fens[:args.panel]
+    actor = create_actor(args.seed)
+    schedule = random.Random(args.seed ^ 0x7363686564756C65)
+    sources = runtime_sources()
+    checkpoints = CHECKPOINTS if not args.engineering else tuple(sorted({0, args.events // 2, args.events}))
+    censuses = CENSUSES if not args.engineering else (0, args.events)
+    manifest = {"kind": "engineering-only" if args.engineering else "exploratory-fresh-native-M1",
+                "seed": args.seed, "events": args.events, "checkpoints": checkpoints,
+                "censuses": censuses, "population": len(fens), "pool_inputs": inputs,
+                "fen_sha256": digest_bytes(canonical(fens).encode()), "sources": sources,
+                "python": sys.version, "executable": sys.executable,
+                "python_binary_sha256": digest_bytes(Path(sys.executable).resolve().read_bytes()),
+                "platform": platform.platform(), "config": asdict(actor.config),
+                "discovery": asdict(actor.discovery),
+                "schedule": "independent Random(seed xor0x7363686564756C65); uniform known-population FEN index",
+                "scope": "one exploratory actor; census retention only, no population reliability or discovery-selector advantage claim"}
+    write_json(directory / "manifest.json", manifest)
+    write_json(directory / "initial_inventory.json", actor.inventory())
+    for completed in range(args.events + 1):
+        if completed in checkpoints:
+            save_checkpoint(actor, schedule, directory, completed)
+        if completed in censuses:
+            result = census(actor, fens, completed)
+            write_json(directory / f"census_{completed:04d}.json", result)
+            print(f"census{completed}: {result['solved']}/{result['total']}", flush=True)
+        if completed == args.events:
+            break
+        index = schedule.randrange(len(fens))
+        record = step(actor, fens[index], completed)
+        record["fen_index"] = index
+        append_json(directory / "actions.jsonl", record)
+        if (completed + 1) % 64 == 0:
+            print(f"training{completed + 1}/{args.events}; {actor.inventory()}", flush=True)
+    check_sources(sources)
+    check(runtime_sources() == sources, "runtime dependency set changed after pinning")
+    write_json(directory / "producer_complete.json", {"events": args.events,
+               "inventory": actor.inventory(), "admissions": admission_summary(actor.events),
+               "final_snapshot_sha256": digest_bytes(canonical(actor.state_snapshot()).encode())})
+
+
+def worker_verify(args):
+    directory = Path(args.output)
+    manifest = read_json(directory / "manifest.json")
+    check(digest_bytes(Path(sys.executable).resolve().read_bytes()) == manifest["python_binary_sha256"],
+          "Python runtime binary differs")
+    check_sources(manifest["sources"])
+    fens, inputs = load_fens()
+    check(inputs == manifest["pool_inputs"], "pool input changed")
+    fens = fens[:manifest["population"]]
+    check(digest_bytes(canonical(fens).encode()) == manifest["fen_sha256"], "exported FEN population differs")
+    actor = create_actor(manifest["seed"])
+    check(runtime_sources() == manifest["sources"], "replay source set differs")
+    schedule = random.Random(manifest["seed"] ^ 0x7363686564756C65)
+    actions = (directory / "actions.jsonl").open()
+    verified_events = 0
+    cold = []
+    for completed in range(manifest["events"] + 1):
+        if completed in manifest["checkpoints"]:
+            restored, saved_schedule, sidecar = restore_checkpoint(directory, completed)
+            check(canonical(actor.state_snapshot()) == canonical(sidecar["snapshot"]),
+                  f"generative checkpoint mismatch at{completed}")
+            check(canonical(schedule.getstate()) == canonical(saved_schedule), "generative schedule mismatch")
+            if completed < manifest["events"]:
+                continuation_schedule = random.Random()
+                continuation_schedule.setstate(saved_schedule)
+                index = continuation_schedule.randrange(len(fens))
+                continued = step(restored, fens[index], completed)
+                native_copy = copy.deepcopy(actor)
+                check(step(native_copy, fens[index], completed) == continued, "cold continuation receipt differs")
+                check(canonical(native_copy.state_snapshot()) == canonical(restored.state_snapshot()),
+                      "cold continuation state differs")
+                cold.append(completed)
+        if completed in manifest["censuses"]:
+            check(census(actor, fens, completed) == read_json(directory / f"census_{completed:04d}.json"),
+                  f"independent greedy census differs at{completed}")
+        if completed == manifest["events"]:
+            break
+        line = actions.readline()
+        check(bool(line), "missing saved scientific event")
+        saved = json.loads(line)
+        index = schedule.randrange(len(fens))
+        check(saved["fen_index"] == index, "native independent schedule differs")
+        verify_credit(saved["credit"], alpha=actor.config.learning_rate)
+        actual = step(actor, fens[index], completed)
+        actual["fen_index"] = index
+        check(canonical(actual) == canonical(saved), f"native generative event differs at{completed}")
+        verified_events += 1
+        if verified_events % 128 == 0:
+            print(f"verified{verified_events}/{manifest['events']}", flush=True)
+    check(not actions.readline(), "unexpected extra scientific event")
+    actions.close()
+    check_sources(manifest["sources"])
+    check(verified_events == manifest["events"], "incomplete independent reconstruction")
+    endpoint = read_json(directory / "producer_complete.json")
+    check(endpoint["admissions"] == admission_summary(actor.events), "admission-reason census differs")
+    check(endpoint["final_snapshot_sha256"] == digest_bytes(canonical(actor.state_snapshot()).encode()),
+          "final actor differs from producer")
+    write_json(directory / "verification.json", {"passed": True, "events": verified_events,
+               "checkpoints": manifest["checkpoints"], "cold_continuations": cold,
+               "censuses": manifest["censuses"], "arithmetic": "every selected-action receipt; inactive and slow coefficients unchanged at credit stage"})
+
+
+def sample_rss(pid):
+    sample = subprocess.run(["/bin/ps", "-o", "rss=", "-p", str(pid)],
+                            capture_output=True, text=True, timeout=5, check=False)
+    value = sample.stdout.strip()
+    return int(value) * 1024 if value else None
+
+
+def guarded_worker(command, output, *, deadline, memory_bytes, interval=0.5,
+                   rss_sampler=sample_rss):
+    """Guard one owned process group; workers deliberately spawn no children."""
+    started = time.time()
+    log = Path(output)
+    maximum = 0
+    samples = 0
+    process = None
+    reason = None
+    with log.open("wb") as handle:
+        try:
+            process = subprocess.Popen(command, stdout=handle, stderr=subprocess.STDOUT,
+                                       start_new_session=True, cwd=ROOT)
+            while process.poll() is None:
+                if time.time() >= deadline:
+                    reason = "suspension-inclusive wall deadline"
+                    raise RuntimeError(reason)
+                rss = rss_sampler(process.pid)
+                if rss is None and process.poll() is None:
+                    reason = "missing owned-child RSS sample"
+                    raise RuntimeError(reason)
+                if rss is not None:
+                    maximum = max(maximum, rss)
+                    samples += 1
+                    if rss > memory_bytes:
+                        reason = "sampled RSS cap"
+                        raise RuntimeError(reason)
+                time.sleep(interval)
+            check(process.returncode == 0, f"worker failed with exit{process.returncode}; see{log}")
+        finally:
+            if process is not None and process.poll() is None:
+                try:
+                    os.killpg(process.pid, signal.SIGTERM)
+                except ProcessLookupError:
+                    pass
+                try:
+                    process.wait(timeout=3)
+                except subprocess.TimeoutExpired:
+                    try:
+                        os.killpg(process.pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+                    process.wait(timeout=3)
+            receipt = {"pid": process.pid if process else None, "started_unix": started,
+                       "elapsed_wall_seconds": time.time() - started,
+                       "sampled_peak_rss_bytes": maximum, "rss_samples": samples,
+                       "memory_cap_bytes": memory_bytes, "deadline_unix": deadline,
+                       "exit_code": process.returncode if process else None,
+                       "abort_reason": reason, "command": command}
+            write_json(log.with_suffix(".resource.json"), receipt)
+    return receipt
+
+
+def seal(directory):
+    rows = []
+    for path in sorted(directory.rglob("*")):
+        if path.is_file() and path.name != "SHA256SUMS.txt":
+            rows.append(f"{digest_bytes(path.read_bytes())}  {path.relative_to(directory)}")
+    (directory / "SHA256SUMS.txt").write_text("\n".join(rows) + "\n")
+    for line in rows:
+        sha, relative = line.split("  ", 1)
+        check(digest_bytes((directory / relative).read_bytes()) == sha, "sealed artifact reread differs")
+
+
+def run(args):
+    directory = Path(args.output).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    started = time.time()
+    deadline = started + args.hours * 3600
+    reserve = 300.0 if not args.engineering else 15.0
+    write_json(directory / "RUNNING.json", {"seed": args.seed, "events": args.events,
+               "started_unix": started, "deadline_unix": deadline,
+               "engineering": args.engineering, "immutable_scientific_identity": not args.engineering})
+    environment = os.environ.copy()
+    environment.update({"PYTHONPATH": f"{ROOT / 'src'}:{ROOT / 'libs/recon-lite/src'}",
+                        "PYTHONHASHSEED": "0", "OMP_NUM_THREADS": "1",
+                        "OPENBLAS_NUM_THREADS": "1", "MKL_NUM_THREADS": "1"})
+    # Environment is set before child creation; no uncontrolled interpreter search.
+    os.environ.update(environment)
+    base = [str(PYTHON), str(Path(__file__).resolve()), "--output", str(directory),
+            "--seed", str(args.seed), "--events", str(args.events), "--panel", str(args.panel)]
+    if args.engineering:
+        base.append("--engineering")
+    assertion = None
+    try:
+        check(Path(sys.executable).resolve() == PYTHON.resolve(), "run under the explicit qualified Python")
+        qualification = guarded_worker(
+            [str(PYTHON), "-c", "import time; time.sleep(0.3)"],
+            directory / "guard_qualification.log", deadline=min(deadline - reserve, time.time() + 10),
+            memory_bytes=2 * 1024**3)
+        check(qualification["rss_samples"] > 0, "no real owned-child RSS sample obtained")
+        if not args.engineering:
+            identities = ROOT / "pilot-identities"
+            identities.mkdir(exist_ok=True)
+            # Exclusive, persistent claim: a failed partial attempt still owns
+            # its scientific identity. A second directory is not a fresh seed.
+            with (identities / f"scientific_{args.seed}.json").open("x") as handle:
+                handle.write(canonical({"seed": args.seed, "output": str(directory),
+                                        "started_unix": started}) + "\n")
+        # Task-owned assertion is optional and always cleaned; no global setting.
+        if Path("/usr/bin/caffeinate").exists():
+            assertion = subprocess.Popen(["/usr/bin/caffeinate", "-i", "-w", str(os.getpid())],
+                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        # Reserve half the substantive clock for an actual second native pass.
+        # A resource abort is permitted; this is not a proof of completion.
+        producer_deadline = started + (args.hours * 3600 - reserve) / 2
+        production = guarded_worker(base + ["--mode", "produce"], directory / "producer.log",
+                                    deadline=producer_deadline, memory_bytes=2 * 1024**3)
+        check(time.time() < deadline - reserve, "no remaining verification budget")
+        verification = guarded_worker(base + ["--mode", "verify"], directory / "verifier.log",
+                                      deadline=deadline - reserve, memory_bytes=2 * 1024**3)
+        verified = read_json(directory / "verification.json")
+        check(verified["passed"], "scientific closure did not pass")
+        manifest = read_json(directory / "manifest.json")
+        scores = {str(event): read_json(directory / f"census_{event:04d}.json")["solved"]
+                  for event in manifest["censuses"]}
+        write_json(directory / "RESULT.json", {"status": "VERIFIED", "kind": manifest["kind"],
+                   "events": args.events, "population": manifest["population"], "scores": scores,
+                   "initial_inventory": read_json(directory / "initial_inventory.json"),
+                   "final_inventory": read_json(directory / "producer_complete.json")["inventory"],
+                   "admissions": read_json(directory / "producer_complete.json")["admissions"],
+                   "checkpoint_scope": "declared behavioral/development snapshot plus saved complete checkpoint and cold continuation; transient graph states/activations are not independently compared",
+                   "producer_resources": production, "replay_resources": verification,
+                   "elapsed_wall_seconds": time.time() - started,
+                   "limitations": "one exploratory actor; known M1 positions; sampled retention; no matched-control benefit claim"})
+    except BaseException as error:
+        write_json(directory / "FAILURE.json", {"type": type(error).__name__, "message": str(error),
+                   "traceback": traceback.format_exc(), "elapsed_wall_seconds": time.time() - started})
+        raise
+    finally:
+        if assertion is not None:
+            assertion.terminate()
+            assertion.wait(timeout=5)
+        (directory / "RUNNING.json").rename(directory / "ATTEMPT.json")
+        seal(directory)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--mode", choices=("run", "produce", "verify"), default="run")
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--seed", type=int, default=SEED)
+    parser.add_argument("--events", type=int, default=SCIENTIFIC_EVENTS)
+    parser.add_argument("--hours", type=float, default=4.0)
+    parser.add_argument("--engineering", action="store_true")
+    parser.add_argument("--panel", type=int, default=8)
+    args = parser.parse_args()
+    check(args.events > 0 and args.hours > 0 and args.panel > 0, "positive budgets required")
+    if args.engineering:
+        check(args.seed != SEED, "engineering must not consume scientific seed")
+    else:
+        check(args.seed == SEED and args.events == SCIENTIFIC_EVENTS,
+              "scientific identity and complete event budget are prospectively fixed")
+    {"run": run, "produce": worker_produce, "verify": worker_verify}[args.mode](args)
+
+
+if __name__ == "__main__":
+    main()
