+"""Focused evidence/guard checks; these are not scientific learning actors."""
+from __future__ import annotations
+
+import copy
+import gzip
+import importlib.util
+import json
+from pathlib import Path
+import random
+import sys
+import time
+
+import pytest
+
+
+RUNNER = Path(__file__).resolve().parents[1] / "tools/sparse_discovery_m1_pilot.py"
+spec = importlib.util.spec_from_file_location("sparse_pilot_runner", RUNNER)
+runner = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = runner
+spec.loader.exec_module(runner)
+
+
+def sample_credit():
+    before = {"bias": [0.2, 0.1], "conditions": {"1": [0.3, 0.1], "2": [-0.4, 0.2]}}
+    # Selected1 is active;2 is a present but inactive parameter.
+    prediction = sum(before["bias"]) + sum(before["conditions"]["1"])
+    delta = 0.3 * (1.0 - prediction) / 2
+    after = copy.deepcopy(before)
+    after["bias"][0] += delta
+    after["conditions"]["1"][0] += delta
+    return {"event_id": 0, "action": "opaque", "reward": 1.0,
+            "prediction": prediction, "active": [1],
+            "weights_before": before, "weights_after_credit": after}
+
+
+def test_scalar_credit_exactly_checks_active_bias_and_inactive_coefficients():
+    receipt = sample_credit()
+    assert runner.verify_credit(receipt, alpha=0.3) == 0.3 * (1 - receipt["prediction"]) / 2
+
+
+@pytest.mark.parametrize("mutation", ["inactive", "slow", "bias", "missing", "duplicate", "prediction"])
+def test_scalar_credit_rejects_corruption(mutation):
+    receipt = sample_credit()
+    if mutation == "inactive":
+        receipt["weights_after_credit"]["conditions"]["2"][0] += 0.01
+    elif mutation == "slow":
+        receipt["weights_after_credit"]["conditions"]["1"][1] += 0.01
+    elif mutation == "bias":
+        receipt["weights_after_credit"]["bias"][0] += 0.01
+    elif mutation == "missing":
+        receipt["active"] = [98]
+    elif mutation == "duplicate":
+        receipt["active"] = [1, 1]
+    else:
+        receipt["prediction"] += 0.01
+    with pytest.raises(RuntimeError):
+        runner.verify_credit(receipt, alpha=0.3)
+
+
+def test_empty_active_receipt_still_credits_bias():
+    receipt = {"reward": -1.0, "prediction": 0.0, "active": [],
+               "weights_before": {"bias": [0.0, 0.0], "conditions": {}},
+               "weights_after_credit": {"bias": [-0.3, 0.0], "conditions": {}}}
+    assert runner.verify_credit(receipt, alpha=0.3) == -0.3
+
+
+def test_zero_residual_is_no_change():
+    receipt = {"reward": 1.0, "prediction": 1.0, "active": [],
+               "weights_before": {"bias": [0.75, 0.25], "conditions": {}},
+               "weights_after_credit": {"bias": [0.75, 0.25], "conditions": {}}}
+    assert runner.verify_credit(receipt, alpha=0.3) == 0.0
+
+
+def test_native_tuple_records_compare_in_declared_json_representation():
+    native = {"active": (2, 3), "lifecycle": [{"atoms": ((1, True), (3, 2))}]}
+    saved = json.loads(runner.canonical(native))
+    assert native != saved
+    assert runner.canonical(native) == runner.canonical(saved)
+
+
+def test_population_export_discards_move_labels(monkeypatch, tmp_path):
+    inputs = []
+    for start in (0, 756):
+        path = tmp_path / f"pool{start}.json.gz"
+        path.write_bytes(gzip.compress(json.dumps([
+            {"fen": f"position{i}", "action": "TEACHER_MOVE", "reward": 1000}
+            for i in range(start, start + 756)]).encode()))
+        inputs.append(path)
+    monkeypatch.setattr(runner, "POOL_FILES", tuple(inputs))
+    fens, hashes = runner.load_fens()
+    assert len(fens) == 1512 and fens[0] == "position0"
+    assert "TEACHER_MOVE" not in runner.canonical(fens)
+    assert len(hashes) == 2
+
+
+def test_population_duplicate_is_rejected(monkeypatch, tmp_path):
+    path = tmp_path / "bad.gz"
+    path.write_bytes(gzip.compress(json.dumps([{"fen": "same"}] * 1512).encode()))
+    monkeypatch.setattr(runner, "POOL_FILES", (path,))
+    with pytest.raises(RuntimeError, match="unique"):
+        runner.load_fens()
+
+
+class CheckpointActor:
+    def __init__(self):
+        self.value = 3
+
+    def state_snapshot(self):
+        return {"value": self.value}
+
+
+def test_checkpoint_restores_declared_snapshot_and_random_schedule(tmp_path):
+    actor = CheckpointActor()
+    schedule = random.Random(17)
+    runner.save_checkpoint(actor, schedule, tmp_path, 0)
+    restored, state, sidecar = runner.restore_checkpoint(tmp_path, 0)
+    assert restored.state_snapshot() == actor.state_snapshot()
+    assert state == schedule.getstate()
+    payload = tmp_path / "checkpoint_0000.pkl.gz"
+    payload.write_bytes(payload.read_bytes() + b"corruption")
+    with pytest.raises(RuntimeError, match="hash"):
+        runner.restore_checkpoint(tmp_path, 0)
+
+
+def test_exploratory_admission_is_distinct_from_complete_prospective_review():
+    events = [{"kind": "trial_birth"},
+              {"kind": "admission", "reason": "exploratory", "predictive_score": None},
+              {"kind": "admission", "reason": "exploratory", "predictive_score": 0.1},
+              {"kind": "admission", "reason": "prospective_prediction", "predictive_score": 0.2}]
+    assert runner.admission_summary(events) == {
+        "by_reason": {"exploratory": 2, "prospective_prediction": 1},
+        "before_complete_prospective_review": 1}
+
+
+def test_source_binding_rejects_changed_runtime(tmp_path):
+    source = tmp_path / "runtime.py"
+    source.write_text("original")
+    pins = {str(source): runner.digest_bytes(source.read_bytes())}
+    runner.check_sources(pins)
+    source.write_text("changed")
+    with pytest.raises(RuntimeError, match="source changed"):
+        runner.check_sources(pins)
+
+
+def test_resource_guard_terminates_and_records_failed_child(tmp_path):
+    output = tmp_path / "deadline.log"
+    with pytest.raises(RuntimeError, match="wall deadline"):
+        runner.guarded_worker([sys.executable, "-c", "import time; time.sleep(20)"],
+                              output, deadline=time.time() + 0.2,
+                              memory_bytes=2 * 1024**3, interval=0.02,
+                              rss_sampler=lambda pid: 1)
+    receipt = runner.read_json(output.with_suffix(".resource.json"))
+    assert receipt["abort_reason"] == "suspension-inclusive wall deadline"
+    assert receipt["exit_code"] is not None
+    assert receipt["elapsed_wall_seconds"] < 5
+
+
+def test_resource_guard_memory_abort_and_cleanup(tmp_path):
+    output = tmp_path / "memory.log"
+    with pytest.raises(RuntimeError, match="RSS cap"):
+        runner.guarded_worker([sys.executable, "-c", "import time; time.sleep(20)"],
+                              output, deadline=time.time() + 5,
+                              memory_bytes=1000, interval=0.02,
+                              rss_sampler=lambda pid: 1001)
+    receipt = runner.read_json(output.with_suffix(".resource.json"))
+    assert receipt["abort_reason"] == "sampled RSS cap"
+    assert receipt["exit_code"] is not None
+    assert receipt["rss_samples"] == 1
+
+
+def test_resource_guard_fails_closed_when_live_child_has_no_memory_sample(tmp_path):
+    output = tmp_path / "missing-sample.log"
+    with pytest.raises(RuntimeError, match="missing owned-child RSS sample"):
+        runner.guarded_worker([sys.executable, "-c", "import time; time.sleep(20)"],
+                              output, deadline=time.time() + 5,
+                              memory_bytes=2 * 1024**3,
+                              rss_sampler=lambda pid: None)
+    receipt = runner.read_json(output.with_suffix(".resource.json"))
+    assert receipt["abort_reason"] == "missing owned-child RSS sample"
+    assert receipt["rss_samples"] == 0
+    assert receipt["exit_code"] is not None
+
+
+def test_missing_sample_after_normal_child_exit_is_an_allowed_race(tmp_path):
+    def sample_after_exit(pid):
+        time.sleep(0.2)
+        return None
+
+    receipt = runner.guarded_worker([sys.executable, "-c", "pass"], tmp_path / "exit-race.log",
+                                    deadline=time.time() + 5, memory_bytes=2 * 1024**3,
+                                    interval=0.01, rss_sampler=sample_after_exit)
+    assert receipt["exit_code"] == 0
+    assert receipt["abort_reason"] is None
+
+
+def test_seal_verifies_every_local_file_without_historical_walk(tmp_path):
+    (tmp_path / "only.txt").write_text("evidence")
+    runner.seal(tmp_path)
+    assert (tmp_path / "SHA256SUMS.txt").read_text() == (
+        runner.digest_bytes(b"evidence") + "  only.txt\n")
