+    assert len(learner.retired_history) == 1
+    learner._develop()
+    assert set(learner.conditions) == {second.identity}
+    assert len(learner.retired_history) == 1
+
+
+def test_tiny_but_predictively_useful_contributor_is_not_magnitude_pruned(monkeypatch):
