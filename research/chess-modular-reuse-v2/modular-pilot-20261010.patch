+++ b/src/recon_lite_chess/coach/m2_evidence.py
@@ -0,0 +1,174 @@
+"""Portable evidence primitives; no choice, outcome or learning authority.
+
+Canonical projection is the accepted M1 evidence format. Pickles are executable
+trusted inputs: callers must authenticate against a separately trusted manifest.
+"""
+from dataclasses import is_dataclass
+from enum import Enum
+import gzip
+import hashlib
+import json
+import os
+from pathlib import Path
+import pickle
+import platform
+import random
+import sys
+import types
+
+
+def json_bytes(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=True, allow_nan=False).encode()
+
+
+def sha(path):
+    digest = hashlib.sha256()
+    with Path(path).open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def symbol(value):
+    return value.__module__ + '.' + value.__qualname__
+
+
+def canonical(value):
+    """Typed, ordered projection with mutable alias identity, matching M1 v1."""
+    seen = {}
+
+    def visit(item):
+        if item is None or type(item) in (bool, int, str):
+            return item
+        if type(item) is float:
+            return {'float': item.hex()}
+        if type(item) is bytes:
+            return {'bytes': item.hex()}
+        if isinstance(item, Enum):
+            return {'enum': symbol(type(item)), 'name': item.name}
+        if isinstance(item, type):
+            return {'class': symbol(item)}
+        if isinstance(item, (types.FunctionType, types.BuiltinFunctionType)):
+            if getattr(item, '__closure__', None):
+                raise TypeError('persistent closures unsupported')
+            return {'callable': symbol(item)}
+        if type(item) is tuple:
+            return {'tuple': [visit(x) for x in item]}
+        if type(item) is frozenset:
+            return {'frozenset': [visit(x) for x in sorted(item, key=sort_key)]}
+        if is_dataclass(item) and item.__dataclass_params__.frozen:
+            return {'frozen': symbol(type(item)), 'attrs': [
+                [key, visit(val)] for key, val in sorted(vars(item).items())]}
+        identity = id(item)
+        if identity in seen:
+            return {'ref': seen[identity]}
+        ordinal = len(seen)
+        seen[identity] = ordinal
+        result = {'id': ordinal}
+        if type(item) is list:
+            result['list'] = [visit(x) for x in item]
+        elif type(item) is dict:
+            result['dict'] = [[visit(k), visit(v)] for k, v in item.items()]
+        elif type(item) is set:
+            result['set'] = [visit(x) for x in sorted(item, key=sort_key)]
+        elif isinstance(item, random.Random):
+            result['random'] = visit(item.getstate())
+        elif hasattr(item, '__dict__'):
+            result.update(type=symbol(type(item)), attrs=[
+                [key, visit(val)] for key, val in sorted(vars(item).items())])
+        else:
+            raise TypeError('unsupported canonical type: ' + symbol(type(item)))
+        return result
+
+    def sort_key(item):
+        return json_bytes(canonical(item))
+    return visit(value)
+
+
+def digest(value):
+    return hashlib.sha256(json_bytes(canonical(value))).hexdigest()
+
+
+def write_json(path, value):
+    with Path(path).open('xb') as stream:
+        stream.write(json_bytes(value) + b'\n')
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def runtime():
+    import chess
+    import numpy
+    return dict(python=platform.python_version(), interpreter=os.path.abspath(sys.executable),
+                prefix=sys.prefix, os=platform.system(), architecture=platform.machine(),
+                host=platform.node(), chess=chess.__version__, numpy=numpy.__version__,
+                pythonhashseed=os.environ.get('PYTHONHASHSEED'))
+
+
+def source_pins():
+    root = Path(__file__).resolve().parents[3]
+    paths = [p for base in ('src/recon_lite_chess/coach', 'src/recon_lite_hector/learning',
+                            'src/recon_lite_hector/nodes', 'libs/recon-lite/src')
+             for p in (root / base).rglob('*.py')]
+    paths.append(root / 'src/recon_lite_chess/autogrowth/mate_horizon_opponent.py')
+    return {p.relative_to(root).as_posix(): sha(p) for p in sorted(paths)}
+
+
+def verify_source(pins):
+    if pins != source_pins():
+        raise ValueError('source differs from pinned run')
+
+
+def load_m1(path, *, expected_sha256, expected_state_sha256, seed):
+    """Read only a hash-pinned accepted native3072 checkpoint, never an old finisher."""
+    path = Path(path)
+    if sha(path) != expected_sha256:
+        raise ValueError('accepted M1 transport hash differs')
+    sidecar = json.loads(path.with_suffix('.json').read_text())
+    if sidecar['sha256'] != expected_sha256 or sidecar['state_sha256'] != expected_state_sha256:
+        raise ValueError('M1 sidecar binding differs')
+    with gzip.open(path, 'rb') as stream:
+        state = pickle.load(stream)
+    from .runner import RunState
+    from .selective import SelectiveMateOneOrganism
+    if (type(state) is not RunState or type(state.organism) is not SelectiveMateOneOrganism
+            or state.seed != seed or state.next_event != 3072
+            or state.organism.completed != 3072 or state.source != sidecar['source']
+            or digest(state) != expected_state_sha256):
+        raise ValueError('accepted M1 native state differs')
+    state.organism.validate_ownership()
+    state.organism.graph.validate_formal_pairs()
+    return state
+
+
+def save(path, value, *, metadata):
+    """Exclusive checkpoint transport; pending episodes are rejected by actor."""
+    path = Path(path)
+    payload = pickle.dumps(value, protocol=5)
+    with path.open('xb') as raw:
+        with gzip.GzipFile(filename='', fileobj=raw, mode='wb', mtime=0, compresslevel=1) as stream:
+            stream.write(payload)
+        raw.flush()
+        os.fsync(raw.fileno())
+    record = {'file': path.name, 'sha256': sha(path), 'state_sha256': digest(value),
+              'metadata': metadata, 'runtime': runtime(), 'source': source_pins()}
+    write_json(path.with_suffix('.json'), record)
+    return record
+
+
+def load(path, *, expected_sha256, check_runtime=True):
+    path = Path(path)
+    record = json.loads(path.with_suffix('.json').read_text())
+    if sha(path) != expected_sha256 or record['sha256'] != expected_sha256:
+        raise ValueError('checkpoint transport mismatch')
+    verify_source(record['source'])
+    here = runtime()
+    if check_runtime and any(here[key] != record['runtime'][key]
+                             for key in ('python', 'chess', 'numpy', 'pythonhashseed')):
+        raise ValueError('checkpoint runtime mismatch; qualify explicit host replay')
+    with gzip.open(path, 'rb') as stream:
+        value = pickle.load(stream)
+    if digest(value) != record['state_sha256']:
+        raise ValueError('checkpoint physical state mismatch')
+    return value
