diff --git a/src/recon_lite_hector/learning/modular_credit.py b/src/recon_lite_hector/learning/modular_credit.py
new file mode 100644
index 0000000..63b94ba
--- /dev/null
+++ b/src/recon_lite_hector/learning/modular_credit.py
@@ -0,0 +1,486 @@
+"""Owned, complete-feedback participation for native selected-module calls.
+
+This is an outer receipt/permission boundary, not another learning law.  Local
+frames are captured and validated by ``EpisodicSelectiveDevelopment`` and actual
+credit is applied by its inherited prospective observer.  The outer ledger adds
+module identity, actual-action time and distinct declared targets.  No board,
+correct-action label, alternative reward or child value enters this module.
+"""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+import math
+from typing import Any, Callable, Mapping
+
+from recon_lite.graph import LinkType
+
+from .refining_route_action import ProspectiveRefiningRouteActionDevelopment
+from .selective_episode import EpisodicActionFrame, EpisodicSelectiveDevelopment
+
+
+EPISODE_TARGET = "remaining_episode_mate.v1"
+IMMEDIATE_TARGET = "own_immediate_mate.v1"
+CONTRACT_VERSION = "native_modular_feedback.v1"
+
+
+@dataclass(frozen=True)
+class ModulePermissions:
+    """Independent execution, recording, plasticity and development permissions."""
+
+    explore: bool = False
+    record: bool = True
+    update: bool = False
+    develop: bool = False
+
+    def __post_init__(self):
+        if any(type(value) is not bool for value in vars(self).values()):
+            raise ValueError("module permissions must be Boolean")
+        if self.develop and not self.update:
+            raise ValueError("development requires eligible updates")
+        if self.update and not self.record:
+            raise ValueError("updates require recorded participation")
+
+
+@dataclass(frozen=True)
+class ModularActionFrame:
+    module_id: str
+    request_id: Any
+    white_ordinal: int
+    board_version: Any
+    structure_version: int
+    target_name: str
+    permissions: ModulePermissions
+    local: EpisodicActionFrame
+
+    @property
+    def owner_key(self):
+        return self.module_id, self.local.owner
+
+    @property
+    def contributor_keys(self):
+        return tuple((self.module_id, cid) for cid in self.local.active)
+
+
+@dataclass(frozen=True)
+class CommitAcknowledgement:
+    request_id: Any
+    white_ordinal: int
+    selected_module: str
+    primitive: Any
+    board_version: Any
+    immediate_mate: bool
+
+
+@dataclass(frozen=True)
+class ModularFeedback:
+    """One explicit scalar receipt for one saved module prediction."""
+
+    module_id: str
+    request_id: Any
+    event_id: Any
+    action: Any
+    white_ordinal: int
+    target_name: str
+    terminal_white_ordinal: int
+    reward: float
+
+
+@dataclass(frozen=True)
+class _LocalFeedback:
+    event_id: Any
+    action: Any
+    reward: float
+
+
+@dataclass(frozen=True)
+class AppliedCredit:
+    module_id: str
+    request_id: Any
+    white_ordinal: int
+    owner_key: tuple[str, int]
+    contributor_keys: tuple[tuple[str, int], ...]
+    prediction: float
+    reward: float
+    multiplier: float
+    denominator: int
+    ordinary_increment: float
+    increment: float
+    updated: bool
+
+
+class ModularCreditLedger:
+    """Complete-bundle validation and module-local ordinary credit servicing.
+
+    Capture precedes the real actuator.  Only a matching acknowledgement makes
+    its two saved predictions eligible.  Failed precommit requests stay pending
+    for diagnosis; they cannot be turned into scalar learning feedback.
+
+    ``remount`` must atomically accept or reject the changed local actor graph.
+    Its signature is ``remount(module_id, candidate_actor)``.  The ledger stages
+    development on a private module copy, restores surviving parameter objects,
+    and invokes that callback before committing the changed module.  Sibling
+    actors, weights and RNGs are never copied or reassigned by this operation.
+    """
+
+    def __init__(self, modules: Mapping[str, EpisodicSelectiveDevelopment], *,
+                 permissions: Mapping[str, ModulePermissions],
+                 target_names: Mapping[str, str] | None = None,
+                 parent_id: str = "parent",
+                 structure_version: Callable[[str], int] | None = None,
+                 remount: Callable[[str, EpisodicSelectiveDevelopment], None] | None = None):
+        self.modules = dict(modules)
+        self.permissions = dict(permissions)
+        self.target_names = dict(target_names or {
+            "parent": EPISODE_TARGET, "setup": EPISODE_TARGET,
+            "m1": IMMEDIATE_TARGET,
+        })
+        self.parent_id = parent_id
+        if (not self.modules or parent_id not in self.modules
+                or set(self.modules) != set(self.permissions)
+                or set(self.modules) != set(self.target_names)):
+            raise ValueError("complete unique module/permission/target registry required")
+        if any(not isinstance(actor, EpisodicSelectiveDevelopment)
+               for actor in self.modules.values()):
+            raise TypeError("modular credit requires the qualified episodic adapters")
+        if any(target not in (EPISODE_TARGET, IMMEDIATE_TARGET)
+               for target in self.target_names.values()):
+            raise ValueError("unknown declared feedback target")
+        if self.target_names[parent_id] != EPISODE_TARGET:
+            raise ValueError("parent predicts the remaining episode target")
+        if any(getattr(actor, "action_invariant_credit", False)
+               for actor in self.modules.values()):
+            raise ValueError("this packet requires ordinary unfiltered credit")
+        self._structure_version = structure_version
+        self._remount = remount
+        self.episode_id = None
+        self.max_white_actions = 0
+        self._frames: list[ModularActionFrame] = []
+        self._commits: list[CommitAcknowledgement] = []
+        self._development_queue: list[dict] = []
+        self.last_frames: tuple[ModularActionFrame, ...] = ()
+        self.last_commits: tuple[CommitAcknowledgement, ...] = ()
+        self.last_credit: tuple[AppliedCredit, ...] = ()
+        self.development_history: list[dict] = []
+        self.episodes_completed = 0
+        self.validate_module_isolation()
+
+    @property
+    def pending_episode(self):
+        return self.episode_id is not None
+
+    @property
+    def frames(self):
+        return tuple(self._frames)
+
+    @property
+    def commits(self):
+        return tuple(self._commits)
+
+    @property
+    def development_queue(self):
+        return tuple(dict(record) for record in self._development_queue)
+
+    def version(self, module_id):
+        value = (self._structure_version(module_id)
+                 if self._structure_version is not None else 0)
+        if type(value) is not int or value < 0:
+            raise ValueError("structure version must be a nonnegative integer")
+        return value
+
+    def validate_module_isolation(self):
+        if len({id(actor) for actor in self.modules.values()}) != len(self.modules):
+            raise ValueError("modules cannot share a mutable actor")
+        seen_weights, seen_rngs, seen_mutable_roots = set(), set(), set()
+        for actor in self.modules.values():
+            weights = {id(actor.bias), *(id(c.weight) for c in actor.conditions.values())}
+            rngs = {id(value) for name, value in vars(actor).items()
+                    if name.endswith("rng") and value is not None}
+            if weights & seen_weights or rngs & seen_rngs:
+                raise ValueError("module weights or RNG streams alias")
+            mutable_roots = {id(value) for name, value in vars(actor).items()
+                             if isinstance(value, (dict, list, set))}
+            if mutable_roots & seen_mutable_roots:
+                raise ValueError("module mutable evidence or lifecycle containers alias")
+            seen_weights.update(weights)
+            seen_rngs.update(rngs)
+            seen_mutable_roots.update(mutable_roots)
+            actor.validate_ownership()
+
+    @staticmethod
+    def _has_local_pending(actor):
+        try:
+            EpisodicSelectiveDevelopment._require_completed_source(actor)
+        except RuntimeError:
+            return True
+        return bool(actor._episode_acting or actor._episode_crediting or actor._episode_multi_crediting)
+
+    def begin_episode(self, episode_id, *, max_white_actions=2):
+        self.require_completed_barrier()
+        if episode_id is None or type(max_white_actions) is not int or max_white_actions < 1:
+            raise ValueError("episode identity and positive physical-action budget required")
+        self.episode_id = episode_id
+        self.max_white_actions = max_white_actions
+
+    def capture(self, module_id, *, request_id, white_ordinal, board_version,
+                structure_version=None):
+        """Save native observations before commit, then free only live pending data."""
+        if not self.pending_episode or module_id not in self.modules:
+            raise ValueError("capture requires a registered pending episode module")
+        if (type(white_ordinal) is not int or not 1 <= white_ordinal <= self.max_white_actions
+                or white_ordinal != len(self._commits) + 1 or request_id is None):
+            raise ValueError("capture requires the next actual White-action ordinal")
+        permission = self.permissions[module_id]
+        if not permission.record:
+            raise ValueError("module does not permit participation recording")
+        if any(f.request_id == request_id and f.module_id == module_id for f in self._frames):
+            raise ValueError("duplicate module request participation")
+        actor = self.modules[module_id]
+        local = actor._current_frame()
+        actor._validate_frames((local,))
+        version = self.version(module_id)
+        if structure_version is not None and structure_version != version:
+            raise ValueError("capture structure version is stale")
+        frame = ModularActionFrame(module_id, request_id, white_ordinal, board_version,
+                                   version, self.target_names[module_id], permission, local)
+        self._frames.append(frame)
+        actor._clear_live_pending()
+        return frame
+
+    def acknowledge_commit(self, *, request_id, white_ordinal, selected_module,
+                           primitive, board_version, immediate_mate):
+        """Bind parent plus selected skill to one successful authoritative commit."""
+        if (not self.pending_episode or selected_module not in self.modules
+                or selected_module == self.parent_id or type(immediate_mate) is not bool
+                or type(white_ordinal) is not int
+                or white_ordinal != len(self._commits) + 1
+                or any(c.request_id == request_id for c in self._commits)
+                or any(c.immediate_mate for c in self._commits)):
+            raise ValueError("invalid or duplicate actual commit acknowledgement")
+        frames = tuple(f for f in self._frames if f.request_id == request_id)
+        if (tuple(f.module_id for f in frames) != (self.parent_id, selected_module)
+                or any(f.white_ordinal != white_ordinal or f.board_version != board_version
+                       for f in frames)
+                or frames[-1].local.action != primitive):
+            raise ValueError("commit provenance differs from parent/selected-skill frames")
+        commit = CommitAcknowledgement(request_id, white_ordinal, selected_module,
+                                       primitive, board_version, immediate_mate)
+        self._commits.append(commit)
+        return commit
+
+    def feedback_bundle(self, *, eventual_mate):
+        """Make explicit receipts from environment-supplied actual scalar outcomes."""
+        if type(eventual_mate) is not bool or not self._commits:
+            raise ValueError("actual terminal outcome and committed participation required")
+        self._validate_participation()
+        if eventual_mate != self._commits[-1].immediate_mate:
+            raise ValueError("terminal outcome differs from the actual final White commit")
+        last = self._commits[-1].white_ordinal
+        commits = {c.request_id: c for c in self._commits}
+        return tuple(ModularFeedback(
+            f.module_id, f.request_id, f.local.event_id, f.local.action,
+            f.white_ordinal, f.target_name,
+            f.white_ordinal if f.target_name == IMMEDIATE_TARGET else last,
+            1.0 if (commits[f.request_id].immediate_mate
+                    if f.target_name == IMMEDIATE_TARGET else eventual_mate) else -1.0,
+        ) for f in self._frames)
+
+    def _validate_participation(self):
+        if len(self._frames) != 2 * len(self._commits):
+            raise ValueError("missing or uncommitted selected participation")
+        seen = set()
+        for index, commit in enumerate(self._commits, start=1):
+            try:
+                duplicate = commit.request_id in seen
+                seen.add(commit.request_id)
+            except TypeError as error:
+                raise ValueError("commit identity must be hashable") from error
+            if (duplicate or type(commit.white_ordinal) is not int
+                    or commit.white_ordinal != index
+                    or commit.selected_module not in self.modules
+                    or commit.selected_module == self.parent_id
+                    or type(commit.immediate_mate) is not bool
+                    or (commit.immediate_mate and index != len(self._commits))):
+                raise ValueError("invalid actual commit history")
+            pair = self._frames[2 * (index - 1):2 * index]
+            if (tuple(f.module_id for f in pair) != (self.parent_id, commit.selected_module)
+                    or any(f.request_id != commit.request_id
+                           or f.white_ordinal != commit.white_ordinal
+                           or f.board_version != commit.board_version for f in pair)
+                    or pair[-1].local.action != commit.primitive):
+                raise ValueError("commit provenance differs from saved ordered participation")
+
+    def _validate_bundle(self, feedback, *, eventual_mate):
+        if not self.pending_episode or not self._commits:
+            raise ValueError("outcome requires a pending committed episode")
+        if type(eventual_mate) is not bool:
+            raise ValueError("terminal outcome must be a real Boolean mate observation")
+        self._validate_participation()
+        expected = self.feedback_bundle(eventual_mate=eventual_mate)
+        records = tuple(feedback)
+        if len(records) != len(expected):
+            raise ValueError("complete feedback bundle has missing or duplicate records")
+        seen = set()
+        per_module: dict[str, list[EpisodicActionFrame]] = {}
+        for frame, actual, wanted in zip(self._frames, records, expected):
+            if not isinstance(actual, ModularFeedback):
+                raise ValueError("feedback requires explicit module-scoped records")
+            try:
+                key = (actual.module_id, actual.request_id)
+                if key in seen:
+                    raise ValueError("duplicate feedback participation")
+                seen.add(key)
+                reward = float(actual.reward)
+            except (TypeError, OverflowError) as error:
+                raise ValueError("feedback requires hashable identity and finite scalar") from error
+            if not math.isfinite(reward) or actual != wanted:
+                raise ValueError("feedback target, horizon, scalar or provenance mismatch")
+            if (frame.module_id not in self.modules
+                    or frame.permissions != self.permissions[frame.module_id]
+                    or frame.target_name != self.target_names[frame.module_id]
+                    or frame.structure_version != self.version(frame.module_id)):
+                raise ValueError("saved module frame configuration is stale")
+            per_module.setdefault(frame.module_id, []).append(frame.local)
+        for module_id, frames in per_module.items():
+            actor = self.modules[module_id]
+            if self._has_local_pending(actor):
+                raise ValueError("module has foreign pending eligibility")
+            try:
+                fresh = frames[0].event_id > actor.last_event
+            except Exception as error:
+                raise ValueError("module event identity must be ordered") from error
+            if not fresh:
+                raise ValueError("module saved event is stale")
+            if any(type(f.owner) is not int or any(type(cid) is not int for cid in f.active)
+                   for f in frames):
+                raise ValueError("owner and contributor identities must be typed integers")
+            actor._validate_frames(tuple(frames))
+        self.validate_module_isolation()
+        return records
+
+    def close_episode(self, *, eventual_mate, feedback=None):
+        """Validate everything first, credit oldest parent-before-skill, then develop."""
+        if feedback is None:
+            feedback = self.feedback_bundle(eventual_mate=eventual_mate)
+        records = self._validate_bundle(feedback, eventual_mate=eventual_mate)
+        frames, commits = tuple(self._frames), tuple(self._commits)
+        last = commits[-1].white_ordinal
+        credits = []
+        queued = []
+        participating = tuple(dict.fromkeys(f.module_id for f in frames if f.permissions.update))
+        for module_id in participating:
+            actor = self.modules[module_id]
+            actor._episode_crediting = True
+            actor._episode_multi_crediting = True
+            actor._episode_development_queue = []
+        try:
+            for frame, receipt in zip(frames, records):
+                actor = self.modules[frame.module_id]
+                multiplier = (1.0 if frame.target_name == IMMEDIATE_TARGET
+                              else actor.config.eligibility_decay ** (last - frame.white_ordinal))
+                n = len(frame.local.active)
+                # This independent audit value matches the predecessor operation order.
+                delta = (actor.config.learning_rate * (receipt.reward - frame.local.prediction) / n
+                         if multiplier == 1.0 else actor.config.learning_rate * multiplier
+                         * (receipt.reward - frame.local.prediction) / n)
+                if frame.permissions.update:
+                    before_queue = len(actor._episode_development_queue)
+                    actor._install_frame(frame.local)
+                    actor._episodic_credit_multiplier = multiplier
+                    ProspectiveRefiningRouteActionDevelopment.observe(actor, _LocalFeedback(
+                        frame.local.event_id, frame.local.action, receipt.reward))
+                    actor.last_event = frame.local.event_id
+                    actor._clear_live_pending()
+                    if frame.permissions.develop:
+                        queued.extend({"module_id": frame.module_id, **record}
+                                      for record in actor._episode_development_queue[before_queue:])
+                credits.append(AppliedCredit(
+                    frame.module_id, frame.request_id, frame.white_ordinal,
+                    frame.owner_key, frame.contributor_keys, frame.local.prediction,
+                    receipt.reward, multiplier, n, delta,
+                    delta if frame.permissions.update else 0.0, frame.permissions.update))
+        finally:
+            for module_id in participating:
+                actor = self.modules[module_id]
+                actor._episodic_credit_multiplier = 1.0
+                actor._episode_multi_crediting = False
+                actor._episode_crediting = False
+
+        for module_id in participating:
+            actor = self.modules[module_id]
+            local_frames = tuple(f.local for f in frames if f.module_id == module_id)
+            actor.last_episode_frames = local_frames
+            actor.episodes_completed += 1
+            actor._episode_development_queue = []
+        self._development_queue.extend(queued)
+        self.last_frames, self.last_commits, self.last_credit = frames, commits, tuple(credits)
+        self._frames.clear()
+        self._commits.clear()
+        self.episode_id = None
+        self.episodes_completed += 1
+        # All pending eligible frames are now closed in every module.  Servicing
+        # in saved oldest-credit order is deterministic even when scopes alternate.
+        while self._development_queue:
+            record = self._development_queue[0]
+            self._service_development(record)
+            self._development_queue.pop(0)
+        return self.last_credit
+
+    def _service_development(self, record):
+        module_id, owner = record["module_id"], record["owner"]
+        actor = self.modules[module_id]
+        if self._frames or any(a.pending for a in self.modules.values()):
+            raise RuntimeError("development cannot invalidate pending module frames")
+        candidate = copy.deepcopy(actor)
+        candidate._run_development(owner)
+        candidate.validate_ownership()
+        # Rebuilds in the inherited controller clone weights.  Reconnect surviving
+        # identities without changing their values until the remount has passed.
+        staged_values = {}
+        for cid in candidate.conditions.keys() & actor.conditions.keys():
+            old = actor.conditions[cid].weight
+            new = candidate.conditions[cid].weight
+            staged_values[cid] = new.fast, new.slow
+            candidate.conditions[cid].weight = old
+        candidate.bias = actor.bias
+        for slot in range(candidate.slots):
+            candidate.graph.edge_by_key[(f"bias:{slot}", f"option:{slot}", LinkType.SUR)].w = candidate.bias
+            for cid, condition in candidate.conditions.items():
+                candidate.graph.edge_by_key[(f"gate:{slot}:{cid}", f"option:{slot}", LinkType.SUR)].w = condition.weight
+        candidate.validate_ownership()
+        if self._remount is not None:
+            self._remount(module_id, candidate)
+        for cid, (fast, slow) in staged_values.items():
+            candidate.conditions[cid].weight.fast = fast
+            candidate.conditions[cid].weight.slow = slow
+        actor.__dict__ = candidate.__dict__
+        self.development_history.append({**record, "serviced_completed": actor.completed,
+                                         "serviced_owner_visits": actor.owner_visits[owner]})
+
+    def require_completed_barrier(self):
+        if (self.pending_episode or self._frames or self._commits or self._development_queue
+                or any(self._has_local_pending(a) for a in self.modules.values())):
+            raise RuntimeError("checkpoint requires a completed modular episode barrier")
+
+    def checkpoint_contract(self):
+        self.require_completed_barrier()
+        return {
+            "version": CONTRACT_VERSION,
+            "module_ids": tuple(self.modules),
+            "parent_id": self.parent_id,
+            "targets": dict(self.target_names),
+            "permissions": dict(self.permissions),
+            "structure_versions": {m: self.version(m) for m in self.modules},
+            "empty_eligibility": True,
+            "episodes_completed": self.episodes_completed,
+        }
+
+    def __getstate__(self):
+        self.require_completed_barrier()
+        return dict(self.__dict__)
+
+
+__all__ = ["EPISODE_TARGET", "IMMEDIATE_TARGET", "CONTRACT_VERSION",
+           "ModulePermissions", "ModularActionFrame", "CommitAcknowledgement",
+           "ModularFeedback", "AppliedCredit", "ModularCreditLedger"]
