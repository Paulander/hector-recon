+def replay(directory, output):
+    """Generative native replay; recorded feedback is released after action match."""
+    from .m2_verify import verify_credit, verify_episode_observations, verify_setup_evaluation
+    directory, output = Path(directory), Path(output)
+    output.mkdir(parents=True, exist_ok=False)
+    result = json.loads((directory / 'RESULT.json').read_text())
+    verify_source(result['source'])
+    if sha(directory / 'episodes.jsonl.gz') != result['receipt_sha256']:
+        raise ValueError('receipt transport mismatch')
+    started, cpu = time.perf_counter(), time.process_time()
+    initial = result['checkpoints'][0]
+    state = load(directory / initial['file'], expected_sha256=initial['sha256'])
+    validate_replay_manifest(result, state)
+    if result['mode'] == 'neutral':
+        if (result['episodes'] != 64 or result['selected_actions'] != 128
+                or result['identity'] != f"m2-readiness-nonstudy-neutral-v1:{state.lineage['seed']}"
+                or len(result['neutral_boards']) != 16
+                or result['neutral_reward_cycle'] != [1., -1., -1., 1.]):
+            raise ValueError('neutral declaration differs')
+    selected = 0
+    checkpoints = {int(c['file'].split('-')[1].split('.')[0]): c for c in result['checkpoints']}
+    with gzip.open(directory / 'episodes.jsonl.gz', 'rt') as stream:
+        for line in stream:
+            expected = json.loads(line)
+            if result['mode'] == 'neutral':
+                index = state.episodes
+                fens = [result['neutral_boards'][(2 * index + offset) % 16] for offset in (0, 1)]
+                if (expected['kind'] != 'neutral' or expected['fens'] != fens
+                        or expected['reward'] != result['neutral_reward_cycle'][index % 4]):
+                    raise ValueError('neutral recipe differs before replay')
+            else:
+                kind = 'm1' if (state.episodes + 1) % result['protocol']['m1_every_episodes'] == 0 else 'm2'
+                fen = state.position(kind, result['boards'][kind])
+                if expected['kind'] != kind or expected['fens'] != [fen]:
+                    raise ValueError('independent pilot exercise schedule differs')
+            verify_episode_observations(state.actor, expected)
+            verify_credit(expected['credit'], expected['reward'])
+            perform(state, kind=expected['kind'], fens=expected['fens'], reward=expected['reward'], expected=expected)
+            selected += len(expected['actions'])
+            if state.episodes in checkpoints:
+                checkpoint = checkpoints[state.episodes]
+                physical = load(directory / checkpoint['file'], expected_sha256=checkpoint['sha256'])
+                if digest(state) != digest(physical):
+                    raise ValueError('physical checkpoint differs from uninterrupted replay')
+    if (selected != result['selected_actions'] or state.episodes != result['episodes']
+            or state.credited_white_actions != selected
+            or digest(state) != result['final_state_sha256']):
+        raise ValueError('replay census/final mismatch')
+    evaluation_count = 0
+    for saved in result.get('evaluations', ()):
+        checkpoint = checkpoints[saved['episode']]
+        physical = load(directory / checkpoint['file'], expected_sha256=checkpoint['sha256'])
+        actual = evaluate(physical.actor, result['boards']['m1_evaluation'],
+                          result['boards']['m2_evaluation'],
+                          strict_setup=result['mode'] == 'comparison')
+        target = directory / saved['file']
+        if sha(target) != saved['sha256'] or json_bytes(actual) != json_bytes(json.loads(target.read_text())):
+            raise ValueError('independent read-only evaluation differs')
+        if result['mode'] == 'comparison':
+            verify_setup_evaluation(physical.actor, actual)
+        evaluation_count += 1
+    record = dict(status='PASS', source=result['source'], replayed_selected_actions=selected,
+                  checkpoints=len(result['checkpoints']), newly_trained_scientific_actions=0,
+                  replay_input_mode=result['mode'],
+                  evaluation_checkpoints=evaluation_count,
+                  wall_seconds=time.perf_counter() - started, cpu_seconds=time.process_time() - cpu,
+                  input_result_sha256=sha(directory / 'RESULT.json'), runtime=runtime())
+    write_json(output / 'COMPLETE.json', record)
+    return record
+
+
+def evaluate(actor, m1_fens, m2_fens, *, strict_setup=False):
+    """Read-only task outcomes, kept entirely outside the training interface."""
+    from .mate_two import evaluate_all_replies
+    from .strict_m2_pool import _mate_available
+    original = digest(actor)
+    clone = pickle.loads(pickle.dumps(actor, protocol=5))
+    m1 = [asdict(play_mate_one_rehearsal(clone, fen, event_id=i, learn=False))
+          for i, fen in enumerate(m1_fens)]
+    m2 = evaluate_all_replies(actor, m2_fens, record_first_scores=strict_setup)
+    # Separately label the chosen first move's board-only validity. This never
+    # selects a different move or reaches an actor/update. Actual learned finish
+    # and all-reply competence remain distinct from environmental existence.
+    for row in m2['rows']:
+        after = chess.Board(row['first']['after_fen'])
+        if row['first']['action'] is None:
+            forcing = False
+        elif after.is_checkmate():
+            forcing = True
+        elif after.is_game_over(claim_draw=True):
+            forcing = False
+        else:
+            forcing = True
+            for reply in after.legal_moves:
+                successor = after.copy(stack=False)
+                successor.push(reply)
+                if successor.is_game_over(claim_draw=True) or not _mate_available(successor):
+                    forcing = False
+                    break
+        row['offline_first_move_forces_mate'] = forcing
+        if strict_setup:
+            row['setup_preferences'] = setup_preferences(row)
+    if digest(actor) != original:
+        raise ValueError('evaluation modified original actor')
+    return {'m1_rows': m1, 'm1_mates': sum(row['reward'] == 1 for row in m1),
+            'm2': m2, 'learning': False, 'truth_reaches_learner': False}
+
+
+def setup_preferences(row):
+    """Evaluator-only complete correct/incorrect margin; never a credit input."""
+    from .strict_m2_pool import _mate_available
+    board = chess.Board(row['fen'])
+    scores = row['setup_native_scores']
+    if [name for name, _ in scores] != sorted(m.uci() for m in board.legal_moves):
+        raise ValueError('native legal score bindings differ')
+    correct = []
+    for name, _ in scores:
+        after = board.copy(stack=True); after.push_uci(name)
+        good = after.is_checkmate()
+        if not good and not after.is_game_over(claim_draw=True):
+            replies = list(after.legal_moves)
+            good = bool(replies)
+            for reply in replies:
+                leaf = after.copy(stack=True); leaf.push(reply)
+                if leaf.is_game_over(claim_draw=True) or not _mate_available(leaf):
+                    good = False; break
+        if good: correct.append(name)
+    return margin_summary(scores, correct, row['first']['action'], row['all_reply_mate'])
+
+
+def margin_summary(scores, correct, selected, actual_success):
+    """Finite/tie contracts, factored for data-free tests only."""
+    import math
+    values = {name: float.fromhex(value) for name, value in scores}
+    if len(values) != len(scores) or not all(math.isfinite(v) for v in values.values()):
+        raise ValueError('invalid native score vector')
+    if len(set(correct)) != len(correct) or not set(correct) <= set(values):
+        raise ValueError('invalid correct-action set')
+    wrong = [name for name in values if name not in correct]
+    margin = max(values[n] for n in correct) - max(values[n] for n in wrong) if correct and wrong else None
+    strict = bool(correct) and (not wrong or margin > 1e-9)
+    return {'correct_moves': correct, 'incorrect_moves': wrong,
+            'best_correct_minus_best_incorrect_hex': None if margin is None else margin.hex(),
+            'no_incorrect_alternative': bool(correct) and not wrong,
+            'no_correct_alternative': not correct, 'strict_tolerance': 1e-9,
+            'strict_preference': strict, 'selected_correct': selected in correct,
+            'strict_actual_success': strict and bool(actual_success),
+            'favorable_tie_success': bool(actual_success) and margin == 0.0,
+            'positive_but_not_strict_success': bool(actual_success) and margin is not None and 0.0 < margin <= 1e-9}
+
+
+def validate_protocol(protocol):
+    if protocol.get('schema') == 'm2-action-invariant-credit-v1':
+        expected = {'schema':'m2-action-invariant-credit-v1','status':'APPROVED_FOR_EXECUTION',
+            'namespace':'m2-action-invariant-credit-20261001-v1',
+            'exercise_namespace':'m2-native-pilot-20260930-v1',
+            'arms':['ordinary','filtered'], 'lineages':[202609250801,202609250802],
+            'episodes':256,'m1_every_episodes':4,'checkpoint_every':64,
+            'evaluation_every':64,'cold_at_episode':128,
+            'pool_manifest_sha256':'06af1ca7fd430b293744b022d72b3c5664f5881ffaec5535a4e6161cb447953f'}
+        if protocol != expected:
+            raise ValueError('action-invariant comparison protocol differs')
+        return protocol
+    required = {'schema', 'status', 'namespace', 'lineages', 'episodes', 'm1_every_episodes',
+                'checkpoint_every', 'evaluation_every', 'cold_at_episode', 'pool_manifest_sha256'}
+    if set(protocol) != required or protocol['schema'] != 'm2-native-pilot-v1':
+        raise ValueError('unsupported pilot protocol fields')
+    if protocol['status'] != 'APPROVED_FOR_EXECUTION':
+        raise ValueError('proposed pilot has not been separately authorized')
+    if (protocol['lineages'] != [202609250801, 202609250802]
+            or protocol['episodes'] != 256 or protocol['m1_every_episodes'] != 4
+            or protocol['checkpoint_every'] != 64 or protocol['evaluation_every'] != 64
+            or protocol['cold_at_episode'] != 128
+            or protocol['namespace'] != 'm2-native-pilot-20260930-v1'):
+        raise ValueError('prepared pilot schedule changed; adjudicate a new protocol')
+    return protocol
+
+
+def validate_replay_manifest(result, initial):
+    """Bind summary/count/identity claims before releasing any replay feedback."""
+    if (result['identity'] != initial.identity or result['lineage'] != initial.lineage
+            or result['source'] != initial.source or initial.episodes != 0
+            or initial.credited_white_actions != 0 or initial.next_event != 3072
+            or initial.actor.completed != 3072):
+        raise ValueError('initial identity/provenance/counters differ')
+    if result['mode'] == 'neutral':
+        episodes, counts, checkpoint_episodes = 64, 128, [0, 32, 64]
+    elif result['mode'] in ('pilot', 'comparison'):
+        protocol = validate_protocol(result['protocol'])
+        identity = f"{protocol['namespace']}:{initial.lineage['seed']}"
+        if result['mode'] == 'comparison':
+            arm = result['credit_arm']
+            if arm not in protocol['arms']:
+                raise ValueError('invalid comparison arm')
+            identity += ':' + arm
+            exercise = f"{protocol['exercise_namespace']}:{initial.lineage['seed']}"
+            if (initial.exercise_identity != exercise or result['exercise_identity'] != exercise
+                    or initial.credit_arm != arm
+                    or initial.actor.action_invariant_credit is not (arm == 'filtered')
+                    or initial.schedule_rng.getstate() != random.Random('m2-position-order:'+exercise).getstate()):
+                raise ValueError('comparison exercise/filter identity differs')
+        if (result['identity'] != identity
+                or initial.lineage['seed'] not in protocol['lineages']):
+            raise ValueError('pilot identity differs')
+        episodes, counts = protocol['episodes'], result['selected_actions']
+        if type(counts) is not int or not episodes <= counts <= 448:
+            raise ValueError('pilot actual-action count outside exercise bounds')
+        checkpoint_episodes = list(range(0, episodes + 1, 64))
+        if [x['episode'] for x in result['evaluations']] != checkpoint_episodes:
+            raise ValueError('pilot evaluation census differs')
+    else:
+        raise ValueError('unrecognized replay mode')
+    if result['episodes'] != episodes or result['selected_actions'] != counts:
+        raise ValueError('declared episode/action count differs')
+    expected_names = [f'checkpoint-{i:04d}.pkl.gz' for i in checkpoint_episodes]
+    if [row['file'] for row in result['checkpoints']] != expected_names:
+        raise ValueError('duplicate/missing/reordered checkpoint census')
+
+
+def run_pilot(protocol_path, inputs, pool, seed, output, *, arm=None):
+    """Prepared execution path. This readiness task never calls it."""
+    from .strict_m2_pool import load_split
+    protocol = validate_protocol(json.loads(Path(protocol_path).read_text()))
+    if seed not in protocol['lineages']:
+        raise ValueError('seed outside proposed identity-selected pilot')
+    if sha(Path(pool) / 'manifest.json') != protocol['pool_manifest_sha256']:
+        raise ValueError('strictM2 pool differs from protocol')
+    train, train_sha = load_split(pool, 'train')
+    development, development_sha = load_split(pool, 'development')
+    m1 = _training_boards(inputs)
+    population_path = Path(inputs) / 'M1_POPULATION.json'
+    population = json.loads(population_path.read_text())
+    input_manifest = json.loads((Path(inputs) / 'INPUTS.json').read_text())
+    if sha(population_path) != input_manifest['population_sha256']:
+        raise ValueError('M1 evaluation population changed')
+    boards = {'m1': list(m1), 'm2': list(train), 'm2_evaluation': list(development),
+              'm1_evaluation': [row['fen'] for row in population['membership']]}
+    output = Path(output)
+    output.mkdir(parents=True, exist_ok=False)
+    identity = f"{protocol['namespace']}:{seed}"
+    comparison = protocol['schema'] == 'm2-action-invariant-credit-v1'
+    if comparison:
+        if arm not in protocol['arms']: raise ValueError('explicit comparison arm required')
+        identity += ':' + arm
+        exercise_identity = f"{protocol['exercise_namespace']}:{seed}"
+    elif arm is not None:
+        raise ValueError('legacy pilot has no credit arm')
+    else:
+        exercise_identity = None
+    started, cpu = time.perf_counter(), time.process_time()
+    state = (initialize(inputs, seed, identity, exercise_identity=exercise_identity,
+             action_invariant_credit=arm == 'filtered', credit_arm=arm) if comparison
+             else initialize(inputs, seed, identity))
+    write_json(output / 'START.json', {'identity': identity, 'protocol': protocol,
+               'protocol_sha256': sha(protocol_path), 'source': state.source, 'runtime': runtime(),
+               'exercise_identity': exercise_identity, 'credit_arm': arm})
+    checkpoints, evaluations = [], []
+    def snapshot():
+        path = output / f'checkpoint-{state.episodes:04d}.pkl.gz'
+        record = save(path, state, metadata={'mode': 'comparison' if comparison else 'pilot', 'identity': identity})
+        checkpoints.append(record)
+        return path, record
+    def census():
+        record = (evaluate(state.actor, boards['m1_evaluation'], boards['m2_evaluation'],
+                           strict_setup=True) if comparison else
+                  evaluate(state.actor, boards['m1_evaluation'], boards['m2_evaluation']))
+        path = output / f'evaluation-{state.episodes:04d}.json'
+        write_json(path, record)
+        evaluations.append({'episode': state.episodes, 'file': path.name, 'sha256': sha(path)})
+    snapshot()
+    census()
+    with gzip.open(output / 'episodes.jsonl.gz', 'xt') as stream:
+        for _ in range(protocol['episodes']):
+            kind = 'm1' if (state.episodes + 1) % protocol['m1_every_episodes'] == 0 else 'm2'
+            fen = state.position(kind, boards[kind])
+            row, _seconds = perform(state, kind=kind, fens=[fen])
+            stream.write(json_bytes(row).decode() + '\n')
+            stream.flush()
+            if state.episodes % protocol['checkpoint_every'] == 0:
+                path, record = snapshot()
+                if state.episodes == protocol['cold_at_episode']:
+                    state = load(path, expected_sha256=record['sha256'])
+            if state.episodes % protocol['evaluation_every'] == 0:
+                census()
+    verify_source(state.source)
+    result = dict(status='PASS', mode='comparison' if comparison else 'pilot', identity=identity, lineage=state.lineage,
+                  protocol=protocol, source=state.source, runtime=runtime(), boards=boards,
+                  train_sha256=train_sha, development_sha256=development_sha,
+                  episodes=state.episodes, selected_actions=state.credited_white_actions,
+                  scientific_m2_actions=state.credited_white_actions - protocol['episodes'] // 4,
+                  checkpoints=checkpoints, evaluations=evaluations,
+                  receipt_sha256=sha(output / 'episodes.jsonl.gz'), final_state_sha256=digest(state),
+                  wall_seconds=time.perf_counter() - started, cpu_seconds=time.process_time() - cpu,
+                  final_test_opened=False)
+    if comparison:
+        result.update(credit_arm=arm, exercise_identity=exercise_identity)
+    write_json(output / 'RESULT.json', result)
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest='command', required=True)
+    p = sub.add_parser('neutral')
+    p.add_argument('--inputs', type=Path, required=True)
+    p.add_argument('--seed', type=int, choices=(202609250801, 202609250808), required=True)
+    p.add_argument('--output', type=Path, required=True)
+    p = sub.add_parser('replay')
+    p.add_argument('--input', type=Path, required=True)
+    p.add_argument('--output', type=Path, required=True)
+    p = sub.add_parser('run')
+    p.add_argument('--protocol', type=Path, required=True)
+    p.add_argument('--inputs', type=Path, required=True)
+    p.add_argument('--output', type=Path, required=True)
+    p.add_argument('--pool', type=Path, required=True)
+    p.add_argument('--seed', type=int, required=True)
+    p.add_argument('--arm', choices=('ordinary','filtered'))
+    args = parser.parse_args()
+    if args.command == 'neutral':
+        result = neutral(args.inputs, args.seed, args.output)
+    elif args.command == 'replay':
+        result = replay(args.input, args.output)
+    else:
+        result = run_pilot(args.protocol, args.inputs, args.pool, args.seed, args.output, arm=args.arm)
+    print(json.dumps({k: v for k, v in result.items() if k in
+        ('status', 'mode', 'identity', 'selected_actions', 'replayed_selected_actions', 'wall_seconds')}))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/src/recon_lite_chess/coach/m2_schema.py b/src/recon_lite_chess/coach/m2_schema.py
new file mode 100644
index 0000000..307f5ae
--- /dev/null
+++ b/src/recon_lite_chess/coach/m2_schema.py
@@ -0,0 +1,90 @@
+"""Explicit, opt-in current-board geometry for the two-action exercise.
+
+The legacy sixteen-coordinate port and factory remain unchanged. The four new
+measurements use only the candidate target, the current rook and board edges;
+they do not push a candidate, query an outcome, or identify a remaining horizon.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+
+import chess
+
+from recon_lite_hector.learning.terminal_development import Coordinate
+
+from .terminal import ChessFeaturePort, DISTANCE, SCHEMA
+
+
+M1_SCHEMA_VERSION = "chess_relational16.v1"
+M2_SCHEMA_VERSION = "chess_relational20.v2"
+M2_SCHEMA = SCHEMA + tuple(Coordinate(name, domain) for name, domain in (
+    ("target_current_rook_file_distance", DISTANCE),
+    ("target_current_rook_rank_distance", DISTANCE),
+    ("target_nearest_file_edge_distance", tuple(range(4))),
+    ("target_nearest_rank_edge_distance", tuple(range(4))),
+))
+
+
+def _schema_signature(schema):
+    # Coordinate equality alone treats (False, True) as equal to (0, 1).
+    return tuple((coordinate.name, type(coordinate.values[0]).__name__,
+                  tuple(coordinate.values)) for coordinate in schema)
+
+
+def schema_version(schema) -> str:
+    """Recognize an exact typed schema; never infer a migration from length."""
+    signature = _schema_signature(schema)
+    for version, known in ((M1_SCHEMA_VERSION, SCHEMA),
+                           (M2_SCHEMA_VERSION, M2_SCHEMA)):
+        if signature == _schema_signature(known):
+            return version
+    raise ValueError("unrecognized chess terminal schema")
+
+
+def schema_manifest(version: str) -> dict:
+    """Return a portable manifest whose digest includes types and ordering."""
+    schemas = {M1_SCHEMA_VERSION: SCHEMA, M2_SCHEMA_VERSION: M2_SCHEMA}
+    if version not in schemas:
+        raise ValueError("unrecognized chess terminal schema version")
+    body = {
+        "version": version,
+        "coordinates": [
+            {"index": index, "name": name, "type": scalar_type,
+             "values": list(values)}
+            for index, (name, scalar_type, values)
+            in enumerate(_schema_signature(schemas[version]))
+        ],
+    }
+    data = json.dumps(body, sort_keys=True, separators=(",", ":")).encode()
+    return body | {"sha256": hashlib.sha256(data).hexdigest()}
+
+
+class M2ChessFeaturePort(ChessFeaturePort):
+    """Twenty-coordinate port; every measurement remains a terminal request."""
+
+    schema = M2_SCHEMA
+    sensor_schema_version = M2_SCHEMA_VERSION
+
+    def measure(self, coordinate, binding):
+        if type(coordinate) is not int or not 0 <= coordinate < len(self.schema):
+            raise ValueError("coordinate outside the declared twenty-coordinate schema")
+        if coordinate < len(SCHEMA):
+            return super().measure(coordinate, binding)
+        if self.executed is not None:
+            raise RuntimeError("an action invalidates this observation frame")
+        move = self._moves[binding]
+        rook = next(iter(self._board.pieces(chess.ROOK, chess.WHITE)))
+        tx, ty = chess.square_file(move.to_square), chess.square_rank(move.to_square)
+        rx, ry = chess.square_file(rook), chess.square_rank(rook)
+        measurements = (abs(tx - rx), abs(ty - ry), min(tx, 7 - tx), min(ty, 7 - ty))
+        return self.schema[coordinate].validate(measurements[coordinate - len(SCHEMA)])
+
+
+def chess_feature_port(actor, board: chess.Board) -> ChessFeaturePort:
+    """Bind only the schema already declared by the actor, without conversion."""
+    version = schema_version(actor.schema)
+    declared = getattr(actor, "sensor_schema_version", None)
+    if declared is not None and declared != version:
+        raise ValueError("actor schema version disagrees with its typed coordinates")
+    return (ChessFeaturePort if version == M1_SCHEMA_VERSION else M2ChessFeaturePort)(board)
diff --git a/src/recon_lite_chess/coach/m2_verify.py b/src/recon_lite_chess/coach/m2_verify.py
new file mode 100644
index 0000000..141329e
--- /dev/null
+++ b/src/recon_lite_chess/coach/m2_verify.py
@@ -0,0 +1,340 @@
+"""Independent receipt arithmetic and observation-time mask verification.
+
+The checker neither imports the learner's transition nor calls its mask helper.
+Board geometry and typed Boolean evaluation below are an independent projection
+of the current, fixed twenty-coordinate native observation contract. They never
+push a candidate, query its outcome, or alter an actor. Native generative replay
+separately verifies the recorded board chain, graph execution and physical state.
+"""
+import math
+
+
+def _require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def evaluate_expression(expression, coordinates):
+    """Typed equality and exact-one semantics, independent of graph execution."""
+    operator, children, atom = expression.operator, expression.children, expression.atom
+    if operator == 'true':
+        _require(not children and atom is None, 'malformed constant')
+        return True
+    if operator == 'read':
+        _require(not children and type(atom) is tuple and len(atom) == 2,
+                 'malformed reader')
+        index, wanted = atom
+        _require(type(index) is int and 0 <= index < len(coordinates)
+                 and type(wanted) in (int, bool), 'invalid typed reader')
+        got = coordinates[index]
+        _require(type(got) is type(wanted), 'typed reader mismatch')
+        return got == wanted
+    _require(operator in ('and', 'or', 'xor') and atom is None
+             and len(children) >= 2, 'unsupported Boolean expression')
+    values = [evaluate_expression(child, coordinates) for child in children]
+    return (all(values) if operator == 'and' else any(values) if operator == 'or'
+            else sum(values) == 1)
+
+
+def geometric_coordinates(fen, uci):
+    """Independent current-board geometry. No task outcome or candidate push."""
+    fields = fen.split()
+    _require(len(fields) == 6 and fields[1] == 'w', 'White board required')
+    _require(type(uci) is str and len(uci) == 4, 'KRK primitive action required')
+    board = {}
+    ranks = fields[0].split('/')
+    _require(len(ranks) == 8, 'FEN dimensions')
+    for row, rank in enumerate(ranks):
+        file = 0
+        for token in rank:
+            if token in '12345678':
+                file += int(token)
+            else:
+                _require(token in 'KRk' and file < 8, 'KRK material required')
+                board[file, 7-row] = token
+                file += 1
+        _require(file == 8, 'FEN rank width')
+    _require(sorted(board.values()) == ['K', 'R', 'k'], 'one of each KRK piece')
+    def square(name):
+        _require(len(name) == 2 and name[0] in 'abcdefgh' and name[1] in '12345678',
+                 'square syntax')
+        return ord(name[0])-97, int(name[1])-1
+    source, target = square(uci[:2]), square(uci[2:])
+    _require(board.get(source) in ('K', 'R'), 'White actuator origin')
+    squares = {piece: position for position, piece in board.items()}
+    wx, wy = squares['K']; bx, by = squares['k']; rx, ry = squares['R']
+    tx, ty = target
+    return (True, board[source] == 'R', abs(wx-bx), abs(wy-by), abs(rx-bx),
+            abs(ry-by), abs(tx-bx), abs(ty-by), abs(tx-wx), abs(ty-wy),
+            bx in (0, 7), by in (0, 7), tx == bx, ty == by, wx == bx, wy == by,
+            abs(tx-rx), abs(ty-ry), min(tx, 7-tx), min(ty, 7-ty))
+
+
+def independent_frame(actor, fen, action):
+    """Reconstruct active order and composite variability for this board.
+
+    Owner/path gating is applied independently rather than reading cached atomic
+    variability or saved masks. The complete native replay subsequently checks
+    these expressions against the actual graph's confirmations.
+    """
+    import chess
+    bindings = tuple(sorted(move.uci() for move in chess.Board(fen).legal_moves))
+    _require(bindings and action in bindings, 'recorded selected action is not legal')
+    _require(len(actor.schema) == 20, 'mask checker supports the declared 20 coordinates')
+    vectors = [geometric_coordinates(fen, binding) for binding in bindings]
+    for vector in vectors:
+        for spec, observed in zip(actor.schema, vector):
+            _require(type(observed) is type(spec.values[0]) and observed in spec.values,
+                     'coordinate domain/type differs')
+    owners = []
+    activation = {cid: [] for cid in actor.conditions}
+    member = {}
+    for owner, leaf in actor.leaves.items():
+        for cid in leaf.contributions:
+            _require(cid not in member and cid in actor.conditions,
+                     'duplicate or stale contributor ownership')
+            member[cid] = owner
+    _require(set(member) == set(actor.conditions), 'unowned scoring contributor')
+    for vector in vectors:
+        enabled = {owner: evaluate_expression(leaf.path, vector)
+                   for owner, leaf in actor.leaves.items()}
+        matches = [owner for owner, value in enabled.items() if value]
+        _require(len(matches) == 1, 'exactly one owner required per alternative')
+        owners.append(matches[0])
+        for cid in actor.conditions:
+            base = evaluate_expression(actor.base_expressions[cid], vector)
+            composite = base and enabled[member[cid]]
+            _require(composite == evaluate_expression(actor.expressions[cid], vector),
+                     'compiled expression disagrees with owner/path composition')
+            activation[cid].append(composite)
+    _require(len(set(owners)) == 1, 'state routing differs across legal alternatives')
+    slot = bindings.index(action)
+    active = tuple(cid for cid in actor.conditions if activation[cid][slot])
+    owner = owners[slot]
+    bias = actor.leaves[owner].bias_id
+    _require(bias in active, 'owned bias missing from selected activation')
+    mask = tuple(cid == bias or len(set(activation[cid])) > 1 for cid in active)
+    return dict(owner=owner, active=active, bias=bias, mask=mask,
+                bindings=bindings, activation=activation)
+
+
+def _frame_projection(encoded):
+    """Decode only the inert tuple/dict/float projection used by action frames."""
+    if encoded is None or type(encoded) in (bool, int, str):
+        return encoded
+    if type(encoded) is not dict:
+        raise ValueError('unsupported encoded frame')
+    if set(encoded) == {'tuple'}:
+        return tuple(_frame_projection(x) for x in encoded['tuple'])
+    if set(encoded) == {'float'}:
+        return float.fromhex(encoded['float'])
+    if set(encoded) == {'id', 'dict'}:
+        return {_frame_projection(k): _frame_projection(v) for k, v in encoded['dict']}
+    if set(encoded) == {'id', 'list'}:
+        return [_frame_projection(x) for x in encoded['list']]
+    raise ValueError('unsupported encoded frame field')
+
+
+def verify_episode_observations(actor, record):
+    """Check both frozen action masks BEFORE any native replay credit occurs."""
+    enabled = getattr(actor, 'action_invariant_credit', False)
+    _require(type(enabled) is bool, 'invalid actor filter flag')
+    _require(record['credit'].get('action_invariant_credit', False) is enabled,
+             'receipt filter mode differs from actor')
+    actions, frames = record['actions'], environmental_frames(record)
+    credit = record['credit']['frames']
+    _require(len(actions) == len(frames) == len(credit), 'observation frame census differs')
+    for action, environmental, saved in zip(actions, frames, credit):
+        frame = _frame_projection(action['frame'])
+        _require(frame['action'] == action['action'] == environmental['action'] == saved['action']
+                 and frame['event_id'] == action['event_id'] == environmental['event_id'] == saved['event_id'],
+                 'action frame binding differs')
+        actual = independent_frame(actor, environmental['fen'], saved['action'])
+        _require(tuple(saved['active']) == frame['active'] == actual['active']
+                 and saved['owner'] == frame['owner'] == actual['owner']
+                 and saved['bias'] == actual['bias'], 'independent active/owner frame differs')
+        mask = actual['mask'] if enabled else None
+        saved_mask = saved.get('weight_credit_mask')
+        _require((None if saved_mask is None else tuple(saved_mask)) == mask
+                 and frame.get('weight_credit_mask') == mask,
+                 'independent composite action-invariance mask differs')
+        if saved_mask is not None:
+            _require(all(type(flag) is bool for flag in saved_mask)
+                     and all(type(flag) is bool for flag in frame['weight_credit_mask']),
+                     'mask values must be Boolean')
+    return True
+
+
+def environmental_frames(record):
+    """Preserve each exercise's actual observation-time frame contract."""
+    outcome = record['outcome']
+    if record['kind'] == 'neutral':
+        return outcome['frames']
+    if record['kind'] == 'm1':
+        return [dict(event_id=outcome['event_id'], action=outcome['action'], fen=outcome['fen'])]
+    if record['kind'] == 'm2':
+        return [dict(event_id=row['event_id'], action=row['action'], fen=row['before_fen'])
+                for row in outcome['white_actions']]
+    raise ValueError('unsupported recorded exercise frame kind')
+
+
+def independent_margin_summary(scores, correct, selected, actual_success):
+    """Independent evaluator-only all-rival strict-preference arithmetic."""
+    _require(type(actual_success) is bool, 'actual success must be Boolean')
+    values = {}
+    for name, encoded in scores:
+        _require(type(name) is str and name not in values and type(encoded) is str,
+                 'invalid or duplicate score binding')
+        number = float.fromhex(encoded)
+        _require(math.isfinite(number) and number.hex() == encoded, 'noncanonical native score')
+        values[name] = number
+    _require(len(correct) == len(set(correct)) and set(correct) <= set(values),
+             'invalid correct-action membership')
+    wrong = [name for name in values if name not in correct]
+    gap = (max(values[name] for name in correct) - max(values[name] for name in wrong)
+           if correct and wrong else None)
+    strict = bool(correct) and (not wrong or gap > 1e-9)
+    return dict(correct_moves=correct, incorrect_moves=wrong,
+                best_correct_minus_best_incorrect_hex=None if gap is None else gap.hex(),
+                no_incorrect_alternative=bool(correct) and not wrong,
+                no_correct_alternative=not correct, strict_tolerance=1e-9,
+                strict_preference=strict, selected_correct=selected in correct,
+                strict_actual_success=strict and actual_success,
+                favorable_tie_success=actual_success and gap == 0.,
+                positive_but_not_strict_success=actual_success and gap is not None and 0. < gap <= 1e-9)
+
+
+def independent_correct_set(fen):
+    """Complete chess-rules labels for development evaluation only.
+
+    No producer outcome/mate helper is reused. The actor and credit checker never
+    receive this set. Black terminal draws are not counted as one-move successors.
+    """
+    import chess
+    board = chess.Board(fen)
+    correct = []
+    for move in sorted(board.legal_moves, key=lambda item: item.uci()):
+        after = board.copy(stack=True)
+        after.push(move)
+        if after.is_checkmate():
+            correct.append(move.uci())
+            continue
+        if after.is_game_over(claim_draw=True):
+            continue
+        replies = tuple(after.legal_moves)
+        all_replies = bool(replies)
+        for response in replies:
+            successor = after.copy(stack=True)
+            successor.push(response)
+            if successor.is_game_over(claim_draw=True):
+                all_replies = False
+                break
+            available = False
+            for finish in successor.legal_moves:
+                terminal = successor.copy(stack=True)
+                terminal.push(finish)
+                if terminal.is_checkmate():
+                    available = True
+                    break
+            if not available:
+                all_replies = False
+                break
+        if all_replies:
+            correct.append(move.uci())
+    return correct
+
+
+def verify_setup_evaluation(actor, evaluation):
+    """Reconstruct finite scoring and complete labels at a saved census.
+
+    No native action is run and no field from evaluation enters actor state.
+    This is additional to the independent native all-reply finishing replay.
+    """
+    checked = 0
+    for row in evaluation['m2']['rows']:
+        if 'setup_preferences' not in row:
+            raise ValueError('new comparison must record strict setup preferences')
+        scores = row['setup_native_scores']
+        _require(bool(scores), 'empty legal score census')
+        reconstructed = independent_frame(actor, row['fen'], scores[0][0])
+        expected_scores = []
+        for slot, binding in enumerate(reconstructed['bindings']):
+            value = math.fsum(actor.conditions[cid].weight.fast + actor.conditions[cid].weight.slow
+                             for cid in actor.conditions if reconstructed['activation'][cid][slot])
+            expected_scores.append([binding, value.hex()])
+        _require(expected_scores == scores, 'independent complete native score census differs')
+        correct = independent_correct_set(row['fen'])
+        expected = independent_margin_summary(scores, correct, row['first']['action'], row['all_reply_mate'])
+        _require(expected == row['setup_preferences'], 'independent strict-preference census differs')
+        checked += 1
+    return checked
+
+
+def verify_credit(receipt, reward):
+    before = receipt['completed_before']
+    frames = receipt['frames']
+    if (type(before) is not int or before < 0 or type(receipt['completed_after']) is not int
+            or not 1 <= len(frames) <= 2 or receipt['completed_after'] != before + len(frames)):
+        raise ValueError('invalid actual credit count')
+    if type(reward) not in (float, int) or not math.isfinite(reward) or reward not in (-1, 1):
+        raise ValueError('invalid selected reward')
+    def floating(value):
+        if type(value) is not str:
+            raise ValueError('exact hexadecimal float required')
+        number = float.fromhex(value)
+        if not math.isfinite(number) or number.hex() != value:
+            raise ValueError('nonfinite/noncanonical float')
+        return number
+    if any(type(row) is not list or len(row) != 3 or type(row[0]) is not int or row[0] < 0
+           for row in receipt['weights_before']):
+        raise ValueError('invalid contributor identities')
+    values = {cid: [floating(fast), floating(slow)]
+              for cid, fast, slow in receipt['weights_before']}
+    if len(values) != len(receipt['weights_before']):
+        raise ValueError('duplicate contribution')
+    alpha, decay = floating(receipt['learning_rate']), floating(receipt['decay'])
+    cadence, rate = receipt['consolidate_every'], floating(receipt['consolidation_rate'])
+    if not (0 < alpha <= 1 and 0 <= decay <= 1 and 0 <= rate <= 1 and type(cadence) is int and cadence > 0):
+        raise ValueError('invalid ordinary credit configuration')
+    enabled = receipt.get('action_invariant_credit', False)
+    if type(enabled) is not bool:
+        raise ValueError('filter mode must be Boolean')
+    prior_event = None
+    for index, frame in enumerate(frames):
+        active = frame['active']
+        if (type(frame['event_id']) is not int or frame['event_id'] < 0
+                or frame['event_id'] != before + index
+                or (prior_event is not None and frame['event_id'] != prior_event + 1)
+                or type(frame['action']) is not str or not frame['action']
+                or type(frame['owner']) is not int or frame['owner'] < 0
+                or type(frame['bias']) is not int):
+            raise ValueError('invalid action/owner/event identity')
+        prior_event = frame['event_id']
+        if (not active or any(type(cid) is not int or cid not in values for cid in active)
+                or len(set(active)) != len(active) or frame['bias'] not in active):
+            raise ValueError('invalid selected contributors')
+        mask = frame.get('weight_credit_mask')
+        if enabled:
+            if (type(mask) is not list or len(mask) != len(active)
+                    or any(type(flag) is not bool for flag in mask)
+                    or not mask[active.index(frame['bias'])]):
+                raise ValueError('invalid independent credit mask')
+        elif mask is not None:
+            raise ValueError('disabled filter must not supply a credit mask')
+        multiplier = decay ** (len(frames) - 1 - index)
+        residual = float(reward) - floating(frame['prediction'])
+        # Independently reproduce the explicit one-action compatibility branch.
+        increment = (alpha * residual / len(active) if multiplier == 1.0
+                     else alpha * multiplier * residual / len(active))
+        for offset, cid in enumerate(active):
+            if not enabled or mask[offset]:
+                values[cid][0] += increment
+        if (before + index + 1) % cadence == 0:
+            weight = values[frame['bias']]
+            transfer = rate * weight[0]
+            weight[0] -= transfer
+            weight[1] += transfer
+    expected = [[cid, fast.hex(), slow.hex()] for cid, (fast, slow) in values.items()]
+    if expected != receipt['weights_after_credit']:
+        raise ValueError('independent episodic arithmetic differs')
+    return True
