+def native_zero_weight_distribution(binding_count: int, epsilon: Fraction = Fraction(1, 4)):
+    """Exact initial native law, including the STRING option-id tie comparator."""
+    if type(binding_count) is not int or binding_count < 1 or not 0 <= epsilon <= 1:
+        raise ValueError("positive binding count and bounded epsilon required")
+    greedy = max(range(binding_count), key=lambda slot: f"option:{slot}")
+    probabilities = [epsilon / binding_count for _ in range(binding_count)]
+    probabilities[greedy] += 1 - epsilon
+    return greedy, tuple(probabilities)
+
+
+@dataclass(frozen=True)
+class ExposureBoard:
+    fen: str
+    orbit: str
+    legal_first_moves: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class ExposurePlan:
+    boards: tuple[ExposureBoard, ...]
+    train_pool_sha256: str
+    complete_legal_first_allowance: int
+    maximum_child_calls: int
+    maximum_seconds: int = 3600
+
+    @property
+    def sha256(self):
+        return canonical_digest(asdict(self))
+
+
+def prepare_exposure_plan(train_fens: Sequence[str], train_pool_sha256: str) -> ExposurePlan:
+    """Read-only selection, no child call and no strict-M2 recuration campaign."""
+    if len(train_fens) != 256 or len(set(train_fens)) != 256:
+        raise ValueError("complete unchanged 256-board strict-M2 TRAIN required")
+    groups: dict[str, list[str]] = {}
+    for fen in train_fens:
+        board = chess.Board(fen)
+        if (not board.is_valid() or board.turn != chess.WHITE or len(board.piece_map()) != 3
+                or len(board.pieces(chess.ROOK, chess.WHITE)) != 1
+                or board.is_game_over(claim_draw=True) or board.halfmove_clock != 0
+                or board.fullmove_number != 1 or board.castling_rights or board.ep_square is not None):
+            raise ValueError("train inventory outside qualified history-free KRK scope")
+        groups.setdefault(orbit_key(board), []).append(board.fen())
+    if len(groups) != 32:
+        raise ValueError("the unchanged TRAIN partition must contain exactly32 orbits")
+    boards = []
+    for orbit, fens in sorted(groups.items()):
+        orientations = sorted(set(fens))
+        if len(orientations) < 2:
+            raise ValueError("each train orbit must offer two distinct orientations")
+        for fen in orientations[:2]:
+            moves = tuple(sorted(move.uci() for move in chess.Board(fen).legal_moves))
+            boards.append(ExposureBoard(fen, orbit, moves))
+    allowance = sum(len(row.legal_first_moves) for row in boards)
+    return ExposurePlan(tuple(boards), train_pool_sha256, allowance, allowance)
+
