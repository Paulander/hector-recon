+def independent_panels(censuses):
+    """Independently reproduce the unchanged qualifying and control selectors."""
+    successful, rows = _verified_census_sets(censuses)
+    late = [{fen for fen in successful[episode] if _strict_factual_reuse(rows[episode][fen])}
+            for episode in (192, 256)]
+    candidates = sorted((late[0] & late[1]) - successful[0])
+    groups = {}
+    for fen in candidates:
+        orbit = rows[192][fen]['orbit']
+        require(type(orbit) is str and rows[256][fen]['orbit'] == orbit,
+                'late candidate orbit identity changed')
+        groups.setdefault(orbit, []).append(fen)
+    first_orbits = sorted(groups)[:2]
+    qualifying = [groups[orbit][0] for orbit in first_orbits]
+    for fen in candidates:
+        if len(qualifying) >= 8:
+            break
+        if fen not in qualifying:
+            qualifying.append(fen)
+    panel = [groups[orbit][0] for orbit in first_orbits]
+    for fen in sorted(fen for orbit in first_orbits for fen in groups[orbit]):
+        if len(panel) >= 8:
+            break
+        if fen not in panel:
+            panel.append(fen)
+    return tuple(sorted(qualifying)), tuple(sorted(panel))
