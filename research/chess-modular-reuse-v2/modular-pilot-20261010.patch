+def prospective_resource_table(measurements: Mapping[str, Sequence[float]], *,
+                               m2_finish_branch_bound: int,
+                               growth_coverage_complete: bool = False) -> dict:
+    """Complete component counts; missing changed-path coverage blocks admission.
+
+    Each component's measurements are non-overlapping incremental work. A full
+    actor total may be used only as max(total,decomposed sum), never added to it.
+    Historical rates/floors are analogues, not modular qualification.
+    """
+    if type(m2_finish_branch_bound) is not int or m2_finish_branch_bound <0:
+        raise ValueError("nonnegative authenticated complete-pool reply bound required")
+    units = {
+        "producer_action_and_two_module_credit_development":448,
+        "independent_replay_action_and_frame_reconstruction":448,
+        "standalone_m1_complete_copy_call":5*1512,
+        "whole_parent_m1_complete_copy_call":5*1512,
+        # Pending calls are not persistently cloned. Reserve one primary first
+        # request per board plus a repeated identical first request per reply.
+        "whole_parent_m2_first_complete_copy_call":5*(128+m2_finish_branch_bound),
+        "whole_parent_m2_finish_complete_copy_call":5*m2_finish_branch_bound,
+        "producer_completed_checkpoint_write":5,
+        "producer_authenticated_checkpoint_read":3,
+        "replay_authenticated_producer_checkpoint_read":8,
+        "cold_saved_episode_reconstruction":1,
+        "dependence_control_complete_all_reply_board":2*3*8,
+        "fixed_script_known_m1_control":2*8,
+        "output_record_and_hash_increment":448+896,
+        "full_census_display_and_exact_projection_output_readback":5,
+        "late_control_display_and_exact_projection_output_readback":2,
+        "independent_producer_episode_declaration_and_completion_readback":1}
+    producer_only = {"producer_action_and_two_module_credit_development",
+                     "producer_completed_checkpoint_write", "producer_authenticated_checkpoint_read"}
+    replay_only = {"independent_replay_action_and_frame_reconstruction",
+                   "replay_authenticated_producer_checkpoint_read",
+                   "independent_producer_episode_declaration_and_completion_readback"}
+    table = []
+    missing = []
+    raw_producer = Decimal(0)
+    raw_replay = Decimal(0)
+    for name, count in units.items():
+        producer_units =0 if name in replay_only else count
+        replay_units =0 if name in producer_only else count
+        samples = tuple(measurements.get(name, ()))
+        if (not samples or any(not math.isfinite(value) or value <0 for value in samples)):
+            missing.append(name)
+            maximum = None
+            raw = None
+        else:
+            maximum = max(Decimal(str(value)) for value in samples)
+            raw = maximum*count
+            raw_producer +=maximum*producer_units
+            raw_replay +=maximum*replay_units
+            if len(samples) <3:
+                missing.append(f"{name}:fewer_than_three_predeclared_repetitions")
+        table.append({"component": name, "units_per_actor":count,
+                      "producer_units_per_actor":producer_units,"replay_units_per_actor":replay_units,
+                      "retained_repetitions":len(samples),
+                      "complete_max_seconds":None if maximum is None else str(maximum),
+                      "raw_actor_seconds":None if raw is None else str(raw)})
+    combined =tuple(measurements.get("completed_checkpoint_write_readback",()))
+    if combined:
+        table.append({"component":"completed_checkpoint_write_readback",
+            "units_per_actor":0,"producer_units_per_actor":0,"replay_units_per_actor":0,
+            "retained_repetitions":len(combined),"complete_max_seconds":str(max(combined)),
+            "raw_actor_seconds":"0","diagnostic_analogue_only":True,
+            "excluded_from_reservation":"Combined basic write/readback timings do not establish role-specific five writes/three producer reads/eight replay reads."})
+    # Historical complete-actor analogues already include old census/checkpoint
+    # work: max rather than adding them avoids charging overhead twice.
+    historic_floor = {"producer":Decimal("6655.221271048125"),
+                      "replay":Decimal("6632.173523379315")}
+    producer_raw = max(raw_producer, historic_floor["producer"])
+    replay_raw = max(raw_replay, historic_floor["replay"])
+    rounding = Decimal(60)
+    cap = lambda raw: int((2*raw/rounding).to_integral_value(rounding=ROUND_CEILING)*rounding)
+    producer_cap, replay_cap = cap(producer_raw), cap(replay_raw)
+    reserves = {"changed_path_and_owned_launcher_qualification":180,
+                "six_wave_dispatch":360, "independent_metrics_ownership_resource_closure":3600,
+                "historical_integrity_and_archive_readback":900, "reporting_and_sealing":900}
