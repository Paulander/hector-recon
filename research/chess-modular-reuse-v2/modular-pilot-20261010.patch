+def _request_margin(trace):
+    selection = trace['selection']['parent']['action']
+    # Saved boosts are legitimate native selection inputs, but strict learned
+    # request preference is defined on complete unboosted scorer predictions.
+    scores = dict(trace['unboosted_scores']['parent'])
+    if selection not in scores or len(scores) !=2:
+        raise ValueError('complete two-connection native score record required')
+    return float(scores[selection])-max(float(value) for token,value in scores.items() if token !=selection)
+
