+def derive_history_metrics(censuses):
+    """Acquisition, gains, losses and recovery at the five measured checkpoints."""
+    successful, rows = _verified_census_sets(censuses)
+    episodes = (0, 64, 128, 192, 256)
+    histories = []
+    for fen in sorted(rows[0]):
