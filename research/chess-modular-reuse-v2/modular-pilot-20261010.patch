+def prelaunch_boundary(*, authorization: Mapping, independent_admission: Mapping,
+                       protocol_sha256: str, now_epoch: float) -> None:
+    """Executable refusal boundary. Packet A has no admissible launch record."""
+    if (authorization.get("packet") != "B"
+            or authorization.get("explicit_user_launch_authorized") is not True
+            or authorization.get("protocol_sha256") != protocol_sha256):
+        raise PermissionError("separate explicit Packet B launch authorization required")
+    if (independent_admission.get("status") != "PASS"
+            or independent_admission.get("admission_complete") is not True
+            or independent_admission.get("protocol_sha256") != protocol_sha256
+            or independent_admission.get("missing_complete_coverage") != []):
+        raise RuntimeError("complete independently measured Packet B admission required")
+    deadline = authorization.get("immutable_deadline_epoch")
+    reserve = independent_admission.get("complete_remaining_seconds")
+    if (type(deadline) not in (int,float) or type(reserve) not in (int,float)
+            or not math.isfinite(deadline) or not math.isfinite(reserve) or reserve <=0
+            or not math.isfinite(now_epoch) or deadline-now_epoch <reserve):
+        raise RuntimeError("entire remaining Packet B reservation does not fit new immutable clock")
+
+
+def assert_run_authorized(*, authorization: Mapping, independent_admission: Mapping,
+                          protocol_sha256: str, now_epoch: float) -> None:
+    """Public spelling for the executable, refusal-by-default launch boundary."""
+    return prelaunch_boundary(authorization=authorization,
+                              independent_admission=independent_admission,
+                              protocol_sha256=protocol_sha256,now_epoch=now_epoch)
