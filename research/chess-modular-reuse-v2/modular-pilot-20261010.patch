+class BatchedEvaluationWorkspace(EvaluationWorkspace):
+    """Separate trust interval; source and all learned dependencies stay frozen.
+
+    The owning guarded caller is the sole synchronous writer during the batch.
+    It must use a new batch for another checkpoint/control/definition state.
+    ``record_pending`` buffers JSON records, not policies or cached observations.
+    All results remain private UNACCEPTED until ``accept`` verifies the complete
+    closed batch.  An unexpected exception invalidates every pending handle.
+    """
+    def __init__(self, source, *, source_binding, binding_check, control=None):
+        self._trusted = False
+        self._batch_status = 'INITIALIZING'
+        self._generation = 0
+        self._pending = []
+        self._acceptance = None
+        self._rejection = None
+        self._finishing = False
+        self._trial_contract = None
+        self._owner = (os.getpid(), threading.get_ident())
+        super().__init__(source, source_binding=source_binding,
+                         binding_check=binding_check, control=control)
+        o = self.organism
+        self._cheap_registry = (id(o.modules), id(o.permissions), id(o.ledger),
+            id(o.ledger.permissions), id(o.ledger.modules), id(o.runtime), id(o.runtime.modules),
+            id(o.runtime.composer), id(o.runtime.composer.modules), id(o.runtime.graph))
+        self._cheap_scopes = {m: self._scope_identity(a) for m, a in o.modules.items()}
+        self._cheap_schemas = {m: typed_schema_signature(a.schema) for m, a in o.modules.items()}
+        self._cheap_configs = {m: (a.config, a.ownership_limits, a.development_config,
+            a.action_invariant_credit, a.reclosure_enabled) for m, a in o.modules.items()}
+        self._cheap_mounts = {m: self._mount_dimensions(a) for m, a in o.modules.items()}
+        self._dispatch = self._dispatch_identity()
+        self._gate_contract = self._gate_identity()
+        self._ledger_contract = (o.ledger.parent_id, dict(o.ledger.target_names))
+        self._parameter_owners = self._parameter_identity()
+        # Constructor/source authentication and this explicit entry use the
+        # complete unchanged strict checker, before the trusted interval opens.
+        super()._assert_integrity(check_source=True)
+        try:
+            self._entry_isolation = assert_no_source_alias(source, o, excluded=(self,))
+        except BaseException as error:
+            self._poison(error)
+            raise
+        self._batch_status = 'OPEN'
+        self._trusted = True
+        self._batch_metrics = {'entry_exact_checks': 1, 'acceptance_exact_checks': 0,
+                               'cheap_boundary_checks': 0, 'records_buffered': 0}
+
+    @staticmethod
+    def _scope_identity(actor):
+        return (id(actor), type(actor), id(actor.graph), id(actor.conditions),
+                id(actor.leaves), id(actor.base_expressions), id(actor.rng),
+                id(actor.exploration_rng))
+
+    @staticmethod
+    def _mount_dimensions(actor):
+        return (id(actor.graph), actor.slots, len(actor.graph.nodes), len(actor.graph.edges))
+
+    def _dispatch_identity(self):
+        o = self.organism
+        return (type(o), type(o.runtime), type(o.ledger), tuple(_method_identity(o, name) for name in (
+            'begin_episode', 'decide_and_commit', '_capture', '_commit', 'finish_episode')),
+            tuple(_method_identity(o.runtime, name) for name in (
+                'begin_decision', 'execute_phase', 'run', 'configure_call')),
+            tuple((m, tuple(_method_identity(a, name) for name in (
+                '_reset', '_ensure_slots', '_invocation_enter', '_invocation_bind',
+                '_invocation_capture', '_clear_live_pending')))
+                for m, a in o.modules.items()),
+            tuple(getattr(BoardAuthority, name) for name in ('register', 'commit', 'black_reply')),
+            tuple(_method_identity(o.ledger, name) for name in (
+                'begin_episode', 'capture', 'acknowledge_commit', 'close_episode',
+                'require_completed_barrier')))
+
+    def _gate_identity(self):
+        o = self.organism
+        nodes = o.runtime.composer.bridge_nodes
+        selected = nodes['bridge:selected']
+        return (tuple((key, id(node), node.ntype, node.predicate) for key, node in nodes.items()),
+            selected.meta['request_policy'], selected.meta['confirm_policy'],
+            selected.meta['selected_choice_source'],
+            tuple(selected.meta['selected_choice_connections'].items()),
+            nodes['bridge:decision'].meta['request_policy'],
+            nodes['bridge:decision'].meta['confirm_policy'],
+            nodes['bridge:decision'].meta['forward_choice_source'])
+
+    def _parameter_identity(self):
+        # Shared parameter objects must stay the same, even if a replacement
+        # has equal values. Native binding replicas may expand; learned owned
+        # condition/weight/statistics identities never change in this batch.
+        return tuple((m, id(actor.bias), tuple((cid, id(condition), id(condition.weight),
+            id(condition.stats)) for cid, condition in actor.conditions.items()))
+            for m, actor in self.organism.modules.items())
+
+    def _poison(self, error):
+        if self._batch_status != 'REJECTED':
+            self._generation += 1
+            self._batch_status = 'REJECTED'
+            self._acceptance = None
+            self._rejection = {'status': 'REJECTED', 'error': str(error),
+                'unaccepted_records': len(self._pending), 'cleanup_complete': False}
+            self._poisoned = True
+            self._trusted = False
+            try:
+                self._restore_private_barrier()
+                self._rejection['cleanup_complete'] = True
+            except BaseException as cleanup_error:
+                self._rejection['cleanup_error'] = str(cleanup_error)
+
+    def _require_open(self):
+        if self._batch_status != 'OPEN' or self._poisoned:
+            error = RejectedEvaluationBatch('batch is closed or rejected; create a new authenticated batch')
+            self._poison(error)
+            raise error
+
+    def _cheap_check(self):
+        self._require_open()
+        o = self.organism
+        registry = (id(o.modules), id(o.permissions), id(o.ledger), id(o.ledger.permissions), id(o.ledger.modules),
+            id(o.runtime), id(o.runtime.modules), id(o.runtime.composer),
+            id(o.runtime.composer.modules), id(o.runtime.graph))
+        if ((os.getpid(), threading.get_ident()) != self._owner
+                or registry != self._cheap_registry or tuple(o.modules) != MODULE_IDS
+                or tuple(o.ledger.modules) != MODULE_IDS
+                or tuple(o.runtime.modules) != MODULE_IDS
+                or tuple(o.runtime.composer.modules) != MODULE_IDS
+                or o.permissions != self._permissions or o.ledger.permissions != self._permissions
+                or o.connections != self._connections or o.evaluation_control != self.control
+                or o.runtime.composer.structure_versions != self._versions
+                or (o.ledger.parent_id, o.ledger.target_names) != self._ledger_contract
+                or type(o.runtime.engine) is not FormalReConEngine
+                or o.runtime.workspace is not self or self._dispatch_identity() != self._dispatch
+                or self._gate_identity() != self._gate_contract):
+            raise StaleEvaluationSnapshot('batch cheap registry/permission/control/dispatch/gate contract changed')
+        for module in MODULE_IDS:
+            actor = o.modules[module]
+            if (self._scope_identity(actor) != self._cheap_scopes[module]
+                    or o.runtime.modules[module] is not actor
+                    or o.runtime.composer.modules[module] is not actor
+                    or o.ledger.modules[module] is not actor
+                    or typed_schema_signature(actor.schema) != self._cheap_schemas[module]
+                    or (actor.config, actor.ownership_limits, actor.development_config,
+                        actor.action_invariant_credit, actor.reclosure_enabled)
+                    != self._cheap_configs[module]):
+                raise StaleEvaluationSnapshot('batch cheap typed module/configuration identity changed')
+        if o.event_base != self._base_counters[2]:
+            raise StaleEvaluationSnapshot('batch event namespace changed')
+        if o.ledger.development_queue:
+            raise StaleEvaluationSnapshot('evaluation cannot queue ordinary development')
+        if self._finishing and not o.ledger.pending_episode:
+            if (o.authority is not None
+                    or o.request_counter != self._base_counters[0] + len(o.ledger.last_commits)
+                    or o.episode_counter != self._base_counters[1] + 1
+                    or o.ledger.episodes_completed != self._base_ledger['episodes_completed'] + 1):
+                raise StaleEvaluationSnapshot('batch completed native finish contract changed')
+        elif self._active:
+            if (type(o.authority) is not BoardAuthority or o.authority.connections != self._connections
+                    or not o.ledger.pending_episode or type(o.authority.version) is not int
+                    or o.authority.version < 0
+                    or type(o.authority.board) is not chess.Board
+                    or self._trial_contract is None
+                    or (o.ledger.episode_id, o.ledger.max_white_actions) != self._trial_contract[:2]
+                    or o.authority.version != len(o.authority.board.move_stack) - self._trial_contract[2]
+                    or o.authority.pending is not None
+                    or len(o.authority.commit_history) != len(o.ledger.commits)
+                    or len(o.ledger.frames) != 2 * len(o.ledger.commits)
+                    or o.authority.committed != {row.request_id for row in o.ledger.commits}
+                    or o.request_counter != self._base_counters[0] + len(o.ledger.commits)
+                    or o.episode_counter != self._base_counters[1]):
+                raise StaleEvaluationSnapshot('batch authority/ledger/counter contract changed')
+        else:
+            if (o.request_counter != self._base_counters[0]
+                    or o.episode_counter != self._base_counters[1]
+                    or o.authority is not None or o.ledger.pending_episode):
+                raise StaleEvaluationSnapshot('batch completed baseline contract changed')
+        self._batch_metrics['cheap_boundary_checks'] += 1
+
+    def _assert_integrity(self, *, check_source=False):
+        if not self._trusted:
+            return super()._assert_integrity(check_source=check_source)
+        try:
+            self._cheap_check()
+        except BaseException as error:
+            self._poison(error)
+            raise
+
+    def _check_scope(self, scope):
+        if not self._trusted:
+            return super()._check_scope(scope)
+        actor = self.organism.modules[scope]
+        if (self._scope_identity(actor) != self._cheap_scopes[scope]
+                or typed_schema_signature(actor.schema) != self._cheap_schemas[scope]):
+            raise StaleEvaluationSnapshot('batch requested scope identity/schema changed')
+
+    def _refresh_scope(self, scope):
+        if not self._trusted:
+            return super()._refresh_scope(scope)
+        actor = self.organism.modules[scope]
+        now, old = self._mount_dimensions(actor), self._cheap_mounts[scope]
+        if now == old:
+            self._metrics['cache_hits'] += 1
+            return
+        if now[0] != old[0] or now[1] <= old[1]:
+            raise StaleEvaluationSnapshot('batch structure change is not native binding expansion')
+        # The unchanged strict path checks complete learned dependencies,
+        # semantic prefixes/weight identities, remounts and formally validates.
+        super()._refresh_scope(scope)
+        self._cheap_mounts[scope] = now
+
+    def record_pending(self, value):
+        self._require_open()
+        try:
+            self._cheap_check()
+            result = _json_copy(value)
+            index = len(self._pending)
+            self._pending.append(result)
+            self._batch_metrics['records_buffered'] += 1
+            return PendingEvaluationRecord(self, index, self._generation)
+        except BaseException as error:
+            self._poison(error)
+            raise
+
+    def _validate_release_index(self, index):
+        if type(index) is not int:
+            raise TypeError('accepted record index must be a typed integer, not Boolean or coercible value')
+        if index < 0 or index >= len(self._pending):
+            raise IndexError('accepted record index must be nonnegative and in range')
+
+    def begin_trial(self, *args, **kwargs):
+        self._require_open()
+        try:
+            board = super().begin_trial(*args, **kwargs)
+            ledger = self.organism.ledger
+            self._trial_contract = (ledger.episode_id, ledger.max_white_actions, len(board.move_stack))
+            self._cheap_check()
+            return board
+        except BaseException as error:
+            self._poison(error)
+            raise
+
+    begin_episode = begin_trial
+
+    def decide_and_commit(self, *, host_metadata=None):
+        self._require_open()
+        try:
+            commit = super().decide_and_commit(host_metadata=host_metadata)
+            return PendingEvaluationOperation(self, 'native_commit', commit, self._generation)
+        except BaseException as error:
+            self._poison(error)
+            raise
+
+    def black_reply(self, move):
+        self._require_open()
+        try:
+            return super().black_reply(move)
+        except BaseException as error:
+            self._poison(error)
+            raise
+
+    def finish_trial(self, *, eventual_mate, reason):
+        self._require_open()
+        try:
+            self._finishing = True
+            outcome = super().finish_trial(eventual_mate=eventual_mate, reason=reason)
+            self._finishing = False
+            return PendingEvaluationOperation(self, 'completed_evaluation_episode', outcome,
+                                               self._generation)
+        except BaseException as error:
+            self._finishing = False
+            self._poison(error)
+            raise
+
+    finish_episode = finish_trial
+
+    def discard_trial(self):
+        self._require_open()
+        try:
+            return super().discard_trial()
+        except BaseException as error:
+            self._poison(error)
+            raise
+
+    reset = discard_trial
+
+    def accept(self):
+        self._require_open()
+        try:
+            self._cheap_check()
+            if self._active:
+                raise RejectedEvaluationBatch('incomplete evaluation branch at batch acceptance')
+            self.organism.require_completed_barrier()
+            self._trusted = False
+            if self._parameter_identity() != self._parameter_owners:
+                raise StaleEvaluationSnapshot('batch owned parameter/condition aliases changed')
+            for actor in self.organism.modules.values():
+                actor.validate_ownership()
+            super()._assert_integrity(check_source=True)
+            if self._source.state_digest() != self.source_binding['snapshot_sha256']:
+                raise StaleEvaluationSnapshot('complete source snapshot changed at acceptance')
+            isolation = assert_no_source_alias(self._source, self.organism, excluded=(self,))
+            self._batch_metrics['acceptance_exact_checks'] += 1
+            self._acceptance = {'schema': 'native-evaluation-batch.v1', 'status': 'ACCEPTED',
+                'source_binding': dict(self.source_binding), 'records': len(self._pending),
+                'records_sha256': canonical_digest(self._pending), 'metrics': self.metrics,
+                'batch_metrics': dict(self._batch_metrics), 'learning_updates': 0,
+                'entry_isolation': self._entry_isolation, 'acceptance_isolation': isolation,
+                'development_updates': 0, 'scientific_initializations': 0,
+                'scientific_actions': 0, 'scientific_episodes': 0}
+            self._batch_status = 'ACCEPTED'
+            return AcceptedEvaluationBatch(self, self._generation)
+        except BaseException as error:
+            self._poison(error)
+            raise
+
+    finish_batch = accept
+
+    def rejection_record(self):
+        if self._batch_status != 'REJECTED':
+            raise ValueError('batch is not rejected')
+        return _json_copy(self._rejection)
+
+    def __getstate__(self):
+        error = RuntimeError('evaluation batch is ephemeral; serialize only its accepted inventory')
+        self._poison(error)
+        raise error
+
+
+__all__ = ['BatchedEvaluationWorkspace', 'PendingEvaluationRecord',
+           'PendingEvaluationOperation', 'AcceptedEvaluationBatch', 'RejectedEvaluationBatch']
diff --git a/src/recon_lite_chess/coach/modular_evaluation_child.py b/src/recon_lite_chess/coach/modular_evaluation_child.py
