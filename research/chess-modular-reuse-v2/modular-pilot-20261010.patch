+def run_actor(accepted_actor, *, identity: str, protocol_path: Path,
+              authorization: Mapping, independent_admission: Mapping,
+              m1_train: Sequence[str], m2_train: Sequence[str],
+              known_m1_fens: Sequence[str], development_fens: Sequence[str],
+              output: Path, interfaces: NativeCanaryInterfaces) -> dict:
+    """Once-only future producer. Never called or authorized by Packet A."""
+    stream,arm = _prelaunch(identity=identity,protocol_path=protocol_path,
+        authorization=authorization,independent_admission=independent_admission,interfaces=interfaces)
+    schedule = proposed_schedule(stream,m1_train,m2_train)
+    # Output initialization and organism construction occur ONLY after the gate;
+    # declaration of the complete schedule precedes scientific initialization.
+    output = Path(output)
+    output.mkdir(parents=True,exist_ok=False)
+    seeds = pair_seed_strings(stream)
+    write_json(output/'DECLARATION.json',{'identity':identity,'protocol_sha256':sha(protocol_path),
+        'seed_strings':seeds,'schedule_sha256':digest(schedule),
+        'schedule':[asdict(row) for row in schedule],'scientific_initialization':False})
+    organism = NativeModularOrganism(accepted_actor,m1_plastic=arm =='plastic',learning=True,
+                                    parent_seed=seeds['parent-birth'],setup_seed=seeds['setup-birth'])
+    for module in ('parent','setup'):
+        organism.modules[module].exploration_rng.seed(seeds[f'{module}-exploration'],version=2)
+    write_json(output/'INITIALIZED.json',{'identity':identity,'protocol_sha256':sha(protocol_path),
+        'state_sha256':organism.state_digest(),'seed_strings':seeds,
+        'schedule_sha256':digest(schedule),'scientific_initialization':True})
+    episodes = []
