+        'm2_board_histories': histories, 'm2_transitions': transitions,
+        'm2_coverage': {episode: len(successful[episode]) for episode in episodes},
+        'standalone_m1_coverage': {episode: censuses[episode]['standalone_m1_mates'] for episode in episodes},
+        'parent_m1_coverage': {episode: censuses[episode]['parent_m1_mates'] for episode in episodes}}
+    for role in ('standalone_m1', 'parent_m1'):
+        field = role + '_rows'
+        if not any(field in censuses[episode] for episode in episodes):
+            continue  # Numeric criterion fixtures may omit saved M1 records.
+        require(all(field in censuses[episode] for episode in episodes), 'incomplete M1 history rows')
+        by_episode, membership = {}, None
+        for episode in episodes:
+            values = censuses[episode][field]
+            mapping = {row['fen']: row['mate'] for row in values}
+            require(len(mapping) == len(values) == 1512 and all(type(v) is bool for v in mapping.values()),
+                    'complete1512 Boolean M1 history required')
+            if membership is None:
+                membership = set(mapping)
+            require(set(mapping) == membership and sum(mapping.values()) == censuses[episode][role + '_mates'],
+                    'M1 history population/count differs')
+            by_episode[episode] = {fen for fen, mate in mapping.items() if mate}
+        result[role + '_transitions'] = [{'from': old, 'to': new,
+            'gained_boards': sorted(by_episode[new] - by_episode[old]),
+            'lost_boards': sorted(by_episode[old] - by_episode[new])} for old, new in zip(episodes, episodes[1:])]
+    return result
