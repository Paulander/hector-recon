index 0000000..4b01a58
--- /dev/null
+++ b/src/recon_lite_chess/coach/modular_evaluation_child.py
@@ -0,0 +1,203 @@
+"""Isolated, child-only copies for standalone native M1 evaluation.
+
+This adapter consumes an already authenticated, completed native organism. It
+does not load a checkpoint, construct an organism, remap a graph, reconvert the
+child, or change a learning permission/law. The caller must use ``learn=False``
+on the returned private child. The full-parent evaluation path stays separate.
+
+Projection helpers are offline evidence tools. Their ordered, typed format
+preserves binary64 values and mutable alias relationships; they are not inputs
+to a learner or a source of action selection.
+"""
+from __future__ import annotations
+
+import copy
+from dataclasses import is_dataclass
+from enum import Enum
+import hashlib
+import random
+import types
+
+from recon_lite_hector.learning.selective_episode import EpisodicSelectiveDevelopment
+from recon_lite_hector.learning.terminal_development import typed_schema_signature
+from recon_lite_hector.learning.modular_graph import NativeInvocationGraph, MountedGraph
+from recon_lite_hector.learning.modular_credit import ModularCreditLedger
+
+from .m2_evidence import canonical, json_bytes
+from .native_modular import MODULE_IDS, NativeModularOrganism
+from .selective import STATE_COORDINATES
+from .terminal import SCHEMA
+
+
+# Execution replicas and record-time observations are checked separately from
+# learning state. Every unlisted field is retained, including effective weights,
+# evidence, learned definitions, owner histories, counters and every RNG stream.
+# ``last_episode_frames`` and ``episodes_completed`` are intentionally retained:
+# even a frozen modular ledger changes them when it closes an evaluation copy.
+EXECUTION_ONLY_FIELDS = frozenset({
+    'graph', 'slots', 'expression_ids', 'probe_nodes', 'birth_probe_nodes',
+    'action_probe_nodes', 'pending', 'context_pending', 'owner_pending',
+    'candidate_pending', 'action_bud_pending', 'birth_search_pending',
+    'deferred_development', '_action_invariant_credit_pending',
+    'last_route_observations',
+})
+
+
+def _require_actor(actor):
+    if type(actor) is not EpisodicSelectiveDevelopment:
+        raise TypeError('qualified exact episodic actor required')
+
+
+def child_semantic_projection(actor):
+    """Complete actor state, including graph replicas and transient execution."""
+    _require_actor(actor)
+    return canonical(actor)
+
+
+def child_learning_projection(actor):
+    """Generic parent/setup/M1 learning state, excluding only declared execution.
+
+    This projection alone does not prove isolation or complete state equality.
+    Use the semantic projection and ownership/reference checks for those claims.
+    """
+    _require_actor(actor)
+    return canonical({name: value for name, value in vars(actor).items()
+                      if name not in EXECUTION_ONLY_FIELDS})
+
+
+def projection_digest(projection):
+    """Hash an already canonical projection without projecting it a second time."""
+    return hashlib.sha256(json_bytes(projection)).hexdigest()
+
+
+def child_semantic_digest(actor):
+    return projection_digest(child_semantic_projection(actor))
+
+
+def child_learning_digest(actor):
+    return projection_digest(child_learning_projection(actor))
+
+
+def _reachable_objects(root):
+    """Inspect actual object references, without following function globals.
+
+    Immutable definitions may be shared. Their members are still traversed so
+    a mutable value hidden inside a frozen record cannot evade isolation checks.
+    Native persistent function predicates have no closures. A bound method is
+    traversed through its receiver; this detects an accidentally retained parent.
+    """
+    pending, seen = [root], set()
+    while pending:
+        item = pending.pop()
+        if item is None or type(item) in (bool, int, float, str, bytes) or isinstance(item, (Enum, type)):
+            continue
+        identity = id(item)
+        if identity in seen:
+            continue
+        seen.add(identity)
+        yield item
+        if isinstance(item, types.MethodType):
+            pending.append(item.__self__)
+        elif isinstance(item, (types.FunctionType, types.BuiltinFunctionType)):
+            if getattr(item, '__closure__', None):
+                raise ValueError('native evaluation child cannot retain a closure')
+        elif isinstance(item, dict):
+            for key, value in item.items():
+                pending.extend((key, value))
+        elif isinstance(item, (tuple, list, set, frozenset)):
+            pending.extend(item)
+        elif not isinstance(item, random.Random) and hasattr(item, '__dict__'):
+            pending.extend(vars(item).values())
+
+
+def _is_mutable(item):
+    frozen = is_dataclass(item) and item.__dataclass_params__.frozen
+    return (item is not None and type(item) not in (bool, int, float, str, bytes)
+        and not isinstance(item, (Enum, type, tuple, frozenset,
+            types.FunctionType, types.BuiltinFunctionType, types.MethodType))
+        and not frozen)
+
+
+def _mutable_ids(root):
+    return {id(item) for item in _reachable_objects(root) if _is_mutable(item)}
+
+
+def _foreign_ids(organism):
+    # Do not recursively traverse the organism/ledger/composer: those registries
+    # legitimately contain M1. Only their own identities are forbidden here.
+    result = {id(organism), id(organism.modules), id(organism.permissions),
+              id(organism.runtime), id(organism.runtime.composer),
+              id(organism.runtime.graph), id(organism.ledger)}
+    for owner in (organism, organism.runtime, organism.runtime.composer, organism.ledger):
+        # A copied child must not retain a dispatch environment, sibling registry
+        # or other mutable composed-runtime container even when it is empty.
+        result.update(id(value) for value in vars(owner).values() if _is_mutable(value))
+    for scope in ('parent', 'setup'):
+        # Immutable scalar/definition objects may legitimately be shared between
+        # resident modules. Only their mutable ownership boundary is disjoint.
+        result.update(_mutable_ids(organism.modules[scope]))
+    return result
+
+
+def _reject_composed_objects(child):
+    if any(isinstance(item, (NativeModularOrganism, NativeInvocationGraph,
+            MountedGraph, ModularCreditLedger)) for item in _reachable_objects(child)):
+        raise ValueError('M1 retained a parent, sibling or composed-runtime reference')
+
+
+def completed_m1_evaluation_copy(organism):
+    """Deep-copy only the completed M1 actor; never invoke composed restoration.
+
+    Authentication of checkpoint bytes, dependencies and native runtime precedes
+    this in-memory adapter and is the task guard's responsibility. The adapter
+    retains all source dictionaries/order, condition and edge aliases, schemas,
+    configuration, counters and RNGs exactly. It accepts a complete learning
+    organism, but supplies no feedback or learning call itself.
+    """
+    if type(organism) is not NativeModularOrganism:
+        raise TypeError('qualified exact native organism required')
+    organism.require_completed_barrier()
+    if tuple(organism.modules) != MODULE_IDS or tuple(organism.permissions) != MODULE_IDS:
+        raise ValueError('complete ordered module registry required')
+    if organism.evaluation_control is not None:
+        raise ValueError('standalone M1 cannot inherit a whole-parent laboratory control')
+    child = organism.modules['m1']
+    _require_actor(child)
+    EpisodicSelectiveDevelopment._require_completed_source(child)
+    if any(getattr(child, name, False) for name in (
+            '_episode_acting', '_episode_crediting', '_episode_multi_crediting')):
+        raise RuntimeError('completed child execution barrier required')
+    if (typed_schema_signature(child.schema) != typed_schema_signature(SCHEMA)
+            or tuple(child.state_coordinates) != tuple(STATE_COORDINATES)):
+        raise ValueError('accepted original16 M1 typed schema required')
+    if organism.permissions['m1'].explore:
+        raise ValueError('qualified M1 child must remain greedy')
+    config = child.config
+    if (config.learning_rate != .3 or config.exploration != .25
+            or config.eligibility_decay != .8 or config.prune_weight != .02
+            or config.consolidate_every != 32 or config.consolidation_rate != .1
+            or child.development_config.develop_every != 64
+            or child.development_config.min_support != 4
+            or child.action_invariant_credit or child.reclosure_enabled
+            or child.development_config.split_enabled):
+        raise ValueError('qualified ordinary M1 configuration required')
+    limits = child.ownership_limits
+    if (limits.max_leaves != 1 or limits.max_parameters != 96
+            or limits.max_definitions != 512 or limits.max_physical_nodes != 32768):
+        raise ValueError('qualified M1 ownership bounds required')
+    child.validate_ownership()
+    _reject_composed_objects(child)
+    if {id(item) for item in _reachable_objects(child)} & _foreign_ids(organism):
+        raise ValueError('M1 retained a parent, sibling or composed-runtime reference')
+
+    # EpisodicSelectiveDevelopment has completed-barrier __getstate__, but no
+    # composed __setstate__. Deepcopy therefore copies its existing dictionary
+    # and graph directly. No fresh constructor/from_actor/rebuild is involved.
+    result = copy.deepcopy(child)
+    if type(result) is not type(child):
+        raise TypeError('child-only copy changed the native actor class')
+    _reject_composed_objects(result)
+    result.validate_ownership()
+    if _mutable_ids(child) & _mutable_ids(result):
+        raise ValueError('child-only copy shared mutable learning or execution state')
+    return result
