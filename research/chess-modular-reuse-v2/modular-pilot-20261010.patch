+"""Isolated trajectory production and generative reconstruction for P/R.
+
+Normal censuses do not run here. R uses an independently initialized native
+organism, generates every action with its own RNG and compares complete physical
+states. Its pending evidence is ineligible for C until an external finalizer has
+bound successful, completed P and R guards. This engineering packet rejects all
+six scientific identities unless a separately supplied future launch gate passes.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict, is_dataclass
+import json
+from pathlib import Path
+
+from .canary_trajectory_verify import (
+    learning_evidence_episode, learning_evidence_start, snapshot, verify_episode,
+)
+from .m2_evidence import canonical, digest, json_bytes, sha, source_pins, write_json
+from .modular_canary import ARMS, NAMESPACE, STREAMS, pair_seed_strings
+from .native_modular import NativeModularOrganism, load_checkpoint, save_checkpoint
+
+
+DECLARATION_SCHEMA = 'amended-canary-trajectory-declaration.v1'
+ENGINEERING_NAMESPACE = 'm2-amended-engineering-20261007:'
+PILOT_NAMESPACE = 'm2-modular-learning-pilot-20261009-v1'
+PILOT_DECLARATION_SCHEMA = 'modular-learning-pilot-trajectory-declaration.v1'
+PILOT_FIXTURE_SCHEMA = 'modular-learning-pilot-engineering-fixture.v1'
+PILOT_FIXTURE_NAMESPACE = ENGINEERING_NAMESPACE + 'pilot-adapter20261010:'
+PILOT_COMPLETE_EPISODE_RAW_BYTE_ENVELOPE = 239361
+
+
+def pilot_seed_strings():
+    """Exact adopted paired namespaces; no arm name and no scientific RNG use."""
+    return {name: PILOT_NAMESPACE + ':001:' + name for name in (
+        'parent-birth', 'setup-birth', 'parent-exploration', 'setup-exploration',
+        'exercise-m1', 'exercise-m2')}
+
+
+def _runtime(runtime_identity):
+    return runtime_identity() if callable(runtime_identity) else dict(runtime_identity)
+
+
+def _schedule(declaration, future_launch_gate=None):
+    identity = declaration.get('identity', '')
+    pilot = identity.startswith(PILOT_NAMESPACE + ':')
+    fixture = identity.startswith(PILOT_FIXTURE_NAMESPACE)
+    wanted_schema = PILOT_DECLARATION_SCHEMA if pilot else PILOT_FIXTURE_SCHEMA if fixture else DECLARATION_SCHEMA
+    if declaration.get('schema') != wanted_schema:
+        raise ValueError('separately typed original/pilot/engineering trajectory declaration required')
+    scientific = identity.startswith(NAMESPACE + ':') or pilot
+    if scientific:
+        if not callable(future_launch_gate):
+            raise PermissionError('scientific canary initialization is unauthorized in this engineering packet')
+        future_launch_gate(declaration)
+        if declaration.get('scientific_initialization') is not True:
+            raise ValueError('future authorized scientific initialization must be declared explicitly')
+        pieces = identity.split(':')
+        streams = ('001',) if pilot else STREAMS
+        expected_seeds = (pilot_seed_strings() if pilot else pair_seed_strings(pieces[1])
+            if len(pieces) == 3 and pieces[1] in STREAMS else None)
+        if (len(pieces) != 3 or pieces[1] not in streams or pieces[2] not in ARMS
+                or pieces[2] != declaration.get('arm')
+                or declaration.get('seeds') != expected_seeds):
+            raise ValueError('fixed scientific identity/arm/paired seed mapping differs')
+    elif not identity.startswith(ENGINEERING_NAMESPACE) or declaration.get('scientific_initialization') is not False:
+        raise PermissionError('disposable engineering identity and non-scientific declaration required')
+    if declaration.get('arm') not in ('frozen', 'plastic'):
+        raise ValueError('declared frozen/plastic arm required')
+    seeds = declaration.get('seeds', {})
+    learning_seeds = {'parent-birth', 'setup-birth', 'parent-exploration', 'setup-exploration'}
+    exercise_seeds = {'exercise-m1', 'exercise-m2'}
+    if ((scientific and set(seeds) != learning_seeds | exercise_seeds)
+            or (not scientific and set(seeds) not in (learning_seeds, learning_seeds | exercise_seeds))):
+        raise ValueError('complete independent RNG namespace declaration required')
+    if not scientific and any(not str(value).startswith(ENGINEERING_NAMESPACE) for value in seeds.values()):
+        raise PermissionError('engineering seed namespaces must be separate from scientific streams')
+    rows = [asdict(row) if is_dataclass(row) else dict(row) for row in declaration['schedule']]
+    if not rows or len(rows) > 256 or [row['episode'] for row in rows] != list(range(1, len(rows) + 1)):
+        raise ValueError('finite ordered complete episode schedule required')
+    for row in rows:
+        if (type(row['episode']) is not int or type(row['white_action_budget']) is not int
+                or row['white_action_budget'] not in (1, 2) or type(row['fen']) is not str):
+            raise ValueError('bounded actual White-action schedule required')
+    checkpoints = tuple(declaration['checkpoint_episodes'])
+    if (tuple(sorted(set(checkpoints))) != checkpoints or 0 not in checkpoints
+            or len(rows) not in checkpoints or any(type(x) is not int or x < 0 or x > len(rows) for x in checkpoints)):
+        raise ValueError('complete checkpoint barrier map required')
+    cold = declaration.get('cold_mapping')
+    if cold is not None:
+        if (set(cold) != {'checkpoint', 'saved_episode'} or cold['checkpoint'] not in checkpoints
+                or cold['saved_episode'] != cold['checkpoint'] + 1
+                or cold['saved_episode'] > len(rows)):
+            raise ValueError('cold continuation must map completed checkpoint to its next saved episode')
+    if scientific:
+        if len(rows) != 256 or checkpoints != (0, 64, 128, 192, 256) or cold != {'checkpoint': 128, 'saved_episode': 129}:
+            raise ValueError('unchanged full scientific schedule/barriers/cold mapping required')
+        if any(row['white_action_budget'] != (1 if row['episode'] % 4 == 0 else 2) for row in rows):
+            raise ValueError('unchanged every-fourth rehearsal schedule required')
+        if any(row['environment_contract'] != ('m1' if row['episode'] % 4 == 0 else 'm2') for row in rows):
+            raise ValueError('unchanged every-fourth rehearsal environment contract required')
+    if declaration.get('schedule_sha256') != digest(rows):
+        raise ValueError('prospectively pinned schedule digest differs')
+    if declaration.get('source') != source_pins():
+        raise ValueError('final source was not prospectively pinned')
+    return rows, checkpoints, scientific
+
+
+def _new(accepted_actor, declaration):
+    if digest(accepted_actor) != declaration['foundation_state_sha256']:
+        raise ValueError('authenticated engineering/future foundation state differs')
+    seeds = declaration['seeds']
+    organism = NativeModularOrganism(accepted_actor,
+        m1_plastic=declaration['arm'] == 'plastic', learning=True,
+        parent_seed=seeds['parent-birth'], setup_seed=seeds['setup-birth'])
+    for module in ('parent', 'setup'):
+        organism.modules[module].exploration_rng.seed(seeds[f'{module}-exploration'], version=2)
+    return organism
+
+
+def _initial(accepted_actor, declaration, initial_factory, scientific):
+    if initial_factory is None:
+        return _new(accepted_actor, declaration)
+    if scientific:
+        raise PermissionError('scientific initial-state override is forbidden')
+    if declaration.get('schema') != PILOT_FIXTURE_SCHEMA or not callable(initial_factory):
+        raise PermissionError('initial override is limited to separately typed disposable pilot fixtures')
+    organism = initial_factory(declaration)
+    if type(organism) is not NativeModularOrganism:
+        raise TypeError('fixture initializer must return the exact native modular organism')
+    organism.validate(); organism.require_completed_barrier()
+    return organism
+
+
+def _record_extension(record, row, before, result, after, checked, callback):
+    if callback is None:
+        return
+    if not callable(callback):
+        raise TypeError('passive record extension must be callable')
+    extension = callback(row, before, result, after, checked)
+    if type(extension) is not dict or any(key in record for key in extension):
+        raise ValueError('passive extension must not replace trajectory/provenance fields')
+    # Verify JSON transport without changing any native observation or state.
+    json_bytes(extension)
+    if 'pilot_structural_deltas' in extension:
+        # Both P's complete episode and R's independently generated P-equivalent
+        # row use this same prospective envelope, including the file newline.
+        # Ordinary/legacy callbacks and the no-extension path are unchanged.
+        candidate = {**record, **extension}
+        if len(json_bytes(candidate)) + 1 > PILOT_COMPLETE_EPISODE_RAW_BYTE_ENVELOPE:
+            raise ValueError('complete pilot episode record exceeds retained raw-byte envelope')
+    record.update(extension)
+
+
+def _native_episode(organism, row, identity):
+    before = snapshot(organism)
+    before['episode_input'] = {'fen': row['fen'], 'white_action_budget': row['white_action_budget']}
+    result = organism.play_episode(row['fen'], max_white_actions=row['white_action_budget'],
+        episode_id=f"{identity}:episode:{row['episode']:03}")
+    after = snapshot(organism)
+    checked = verify_episode(before, result, after)
+    return result, before, after, checked
+
+
+def _cold(producer, checkpoint, row, declaration, expected_result, expected_state,
+          runtime_identity, deadline_check):
+    deadline_check()
+    path = producer / checkpoint['file']
+    organism = load_checkpoint(path, expected_sha256=checkpoint['sha256'],
+        expected_sidecar_sha256=checkpoint['sidecar_sha256'],
+        current_runtime_identity=_runtime(runtime_identity))
+    result, before, after, checked = _native_episode(organism, row, declaration['identity'])
+    if (json_bytes(canonical(result)) != json_bytes(canonical(expected_result))
+            or organism.state_digest() != expected_state):
+        raise ValueError('cold completed-checkpoint/next-saved-episode exact continuation differs')
+    del organism, result, before, after
+    return {'status': 'PASS', 'checkpoint': checkpoint['episode'], 'saved_episode': row['episode'],
+        'state_sha256': expected_state, 'independent_arithmetic': checked,
+        'additional_scientific_continuations': 0, 'physical_white_actions': checked['physical_white_actions']}
+
+
+def produce(accepted_actor, *, declaration, output, deadline_check, runtime_identity,
+            future_launch_gate=None, episode_record_extension=None, initial_factory=None,
+            record_observer=None):
+    """P: native learning + checkpoints + cold test, no normal census."""
+    rows, barriers, scientific = _schedule(declaration, future_launch_gate)
+    if scientific and initial_factory is not None:
+        raise PermissionError('scientific initial-state override is forbidden')
+    if scientific and record_observer is not None:
+        raise PermissionError('record timing observer is limited to engineering qualification')
+    deadline_check()
+    if declaration['runtime_identity'] != _runtime(runtime_identity):
+        raise ValueError('prospectively pinned native runtime differs')
+    output = Path(output); output.mkdir(parents=True, exist_ok=False)
+    write_json(output / 'DECLARATION.json', declaration)
+    organism = _initial(accepted_actor, declaration, initial_factory, scientific)
+    initial = organism.state_digest()
+    learning = learning_evidence_start(snapshot(organism))
+    episodes, checkpoints = [], []
+    physical = participation = 0; cold = None
+    for completed in range(len(rows) + 1):
+        deadline_check()
+        if completed in barriers:
+            path = output / f'checkpoint-{completed:03}.pkl.gz'
+            saved = save_checkpoint(path, organism, runtime_identity=_runtime(runtime_identity))
+            checkpoints.append({'episode': completed, 'file': path.name,
+                'sha256': saved['sha256'], 'sidecar_sha256': sha(path.with_suffix('.json')),
+                'producer_state_sha256': organism.state_digest(),
+                'contract_sha256': saved['contract_sha256']})
+        if completed == len(rows): break
+        row = rows[completed]
+        result, before, after, checked = _native_episode(organism, row, declaration['identity'])
+        if record_observer is not None: record_observer.begin(row)
+        learning_episode = learning_evidence_episode(learning, row, before, result, after, checked)
+        physical += len(result['commits']); participation += len(result['frames'])
+        record = {'episode': row['episode'], 'fen': row['fen'], 'white_action_budget': row['white_action_budget'],
+            'result_exact': canonical(result), 'pre_state_sha256': before['state_sha256'],
+            'post_state_sha256': after['state_sha256'], 'independent_arithmetic': checked,
+            'learning_evidence': learning_episode,
+            'physical_white_actions': len(result['commits']), 'participation_records': len(result['frames'])}
+        _record_extension(record, row, before, result, after, checked, episode_record_extension)
+        path = output / f"EPISODE-{row['episode']:03}.json"; write_json(path, record)
+        # Read every serialized record now, while only one episode is resident.
+        if json_bytes(json.loads(path.read_text())) != json_bytes(record):
+            raise ValueError('complete episode serialization/readback differs')
