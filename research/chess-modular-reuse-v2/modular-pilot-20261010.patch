+"""Incremental bytes exactly matching json_bytes(canonical(value)).
+
+There is one global mutable-alias ordinal map per root, not per row. The raw
+root and every encountered mutable object remain alive until encoding finishes.
+No complete canonical projection or complete JSON byte string is constructed.
+The original encoder is unchanged and used only by bounded qualification tests.
+"""
+from __future__ import annotations
+
+from dataclasses import is_dataclass
+from enum import Enum
+from functools import cmp_to_key
+import hashlib
+from itertools import chain, zip_longest
+import json
+import random
+import types
+
+from .m2_evidence import symbol
+
+
+def _quoted(value):
+    """ensure_ascii=True JSON string escaping, in bounded fragments."""
+    yield b'"'
+    buffer = bytearray()
+    escapes = {8: b'\\b', 9: b'\\t', 10: b'\\n', 12: b'\\f', 13: b'\\r',
+               34: b'\\"', 92: b'\\\\'}
+    for character in value:
+        ordinal = ord(character)
+        if ordinal in escapes:
+            buffer.extend(escapes[ordinal])
+        elif 32 <= ordinal <= 126:
+            buffer.append(ordinal)
+        elif ordinal <= 65535:
+            buffer.extend(('\\u%04x' % ordinal).encode('ascii'))
+        else:
+            ordinal -= 65536
+            buffer.extend(('\\u%04x\\u%04x' % (
+                55296 + (ordinal >> 10), 56320 + (ordinal & 1023))).encode('ascii'))
+        if len(buffer) >= 4096:
+            yield bytes(buffer)
+            buffer.clear()
+    if buffer:
+        yield bytes(buffer)
+    yield b'"'
+
+
+def _integer(value):
+    return str(value).encode('ascii')
+
+
+class _CanonicalStream:
+    def __init__(self, root):
+        self.root = root
+        self.seen = {}
+        self.keepalive = []
+
+    def sequence(self, values):
+        yield b'['
+        first = True
+        for value in values:
+            if not first:
+                yield b','
+            first = False
+            yield from self.visit(value)
+        yield b']'
+
+    def attributes(self, item):
+        yield b'['
+        first = True
+        # Attribute traversal order is exactly the old sorted-vars order. Only
+        # this one object's shallow attribute references are sorted, not output.
+        for name, value in sorted(vars(item).items()):
+            if not first:
+                yield b','
+            first = False
+            yield b'['
+            yield from _quoted(name)
+            yield b','
+            yield from self.visit(value)
+            yield b']'
+        yield b']'
+
+    def visit(self, item):
+        if item is None:
+            yield b'null'
+        elif type(item) is bool:
+            yield b'true' if item else b'false'
+        elif type(item) is int:
+            yield _integer(item)
+        elif type(item) is str:
+            yield from _quoted(item)
+        elif type(item) is float:
+            yield b'{"float":'
+            yield from _quoted(item.hex())
+            yield b'}'
+        elif type(item) is bytes:
+            yield b'{"bytes":"'
+            for offset in range(0, len(item), 2048):
+                yield item[offset:offset + 2048].hex().encode('ascii')
+            yield b'"}'
+        elif isinstance(item, Enum):
+            yield b'{"enum":'
+            yield from _quoted(symbol(type(item)))
+            yield b',"name":'
+            yield from _quoted(item.name)
+            yield b'}'
+        elif isinstance(item, type):
+            yield b'{"class":'
+            yield from _quoted(symbol(item))
+            yield b'}'
+        elif isinstance(item, (types.FunctionType, types.BuiltinFunctionType)):
+            if getattr(item, '__closure__', None):
+                raise TypeError('persistent closures unsupported')
+            yield b'{"callable":'
+            yield from _quoted(symbol(item))
+            yield b'}'
+        elif type(item) is tuple:
+            yield b'{"tuple":'
+            yield from self.sequence(item)
+            yield b'}'
+        elif type(item) is frozenset:
+            yield b'{"frozenset":'
+            yield from self.sequence(sorted(item, key=cmp_to_key(_canonical_compare)))
+            yield b'}'
+        elif is_dataclass(item) and item.__dataclass_params__.frozen:
+            # Frozen shells never enter seen. Final JSON keys sort attrs first;
+            # assigning member ordinals here is the same old visit order.
+            yield b'{"attrs":'
+            yield from self.attributes(item)
+            yield b',"frozen":'
+            yield from _quoted(symbol(type(item)))
+            yield b'}'
+        else:
+            identity = id(item)
+            if identity in self.seen:
+                yield b'{"ref":'
+                yield _integer(self.seen[identity])
+                yield b'}'
+                return
+            ordinal = len(self.seen)
+            self.seen[identity] = ordinal
+            self.keepalive.append(item)
+            # Assign the ordinal BEFORE children, even where sorted output
+            # puts those children before the parent's "id" key.
+            if type(item) is list:
+                yield b'{"id":'
+                yield _integer(ordinal)
+                yield b',"list":'
+                yield from self.sequence(item)
+                yield b'}'
+            elif type(item) is dict:
+                yield b'{"dict":['
+                first = True
+                for key, value in item.items():
+                    if not first:
+                        yield b','
+                    first = False
+                    yield b'['
+                    yield from self.visit(key)
+                    yield b','
+                    yield from self.visit(value)
+                    yield b']'
+                yield b'],"id":'
+                yield _integer(ordinal)
+                yield b'}'
+            elif type(item) is set:
+                yield b'{"id":'
+                yield _integer(ordinal)
+                yield b',"set":'
+                yield from self.sequence(sorted(item, key=cmp_to_key(_canonical_compare)))
+                yield b'}'
+            elif isinstance(item, random.Random):
+                yield b'{"id":'
+                yield _integer(ordinal)
+                yield b',"random":'
+                yield from self.visit(item.getstate())
+                yield b'}'
+            elif hasattr(item, '__dict__'):
+                yield b'{"attrs":'
+                yield from self.attributes(item)
+                yield b',"id":'
+                yield _integer(ordinal)
+                yield b',"type":'
+                yield from _quoted(symbol(type(item)))
+                yield b'}'
+            else:
+                raise TypeError('unsupported canonical type: ' + symbol(type(item)))
+
+
+def _canonical_compare(left, right):
+    """Same fresh-root canonical byte ordering as the old set sort_key.
+
+    Compare incremental bytes rather than retaining a full member-key blob.
+    Each comparator operand owns its own alias map, just like old sort_key.
+    """
+    left_stream, right_stream = _CanonicalStream(left), _CanonicalStream(right)
+    for a, b in zip_longest(chain.from_iterable(left_stream.visit(left)),
+                            chain.from_iterable(right_stream.visit(right)), fillvalue=None):
+        if a != b:
+            if a is None:
+                return -1
+            if b is None:
+                return 1
+            return -1 if a < b else 1
+    return 0
+
+
+def iter_canonical_json_bytes(value, *, chunk_size=65536):
+    """Yield exact legacy canonical JSON bytes in at-most-chunk_size blocks."""
+    if type(chunk_size) is not int or chunk_size < 1:
+        raise ValueError('positive typed chunk_size required')
+    encoder = _CanonicalStream(value)
+    buffer = bytearray()
+    for token in encoder.visit(value):
+        offset = 0
+        while offset < len(token):
+            take = min(chunk_size - len(buffer), len(token) - offset)
+            buffer.extend(token[offset:offset + take])
+            offset += take
+            if len(buffer) == chunk_size:
+                yield bytes(buffer)
+                buffer.clear()
+    if buffer:
+        yield bytes(buffer)
+
+
+def canonical_digest(value):
+    """SHA256 exactly matching existing m2_evidence.digest(value)."""
+    result = hashlib.sha256()
+    for block in iter_canonical_json_bytes(value):
+        result.update(block)
+    return result.hexdigest()
+
+
+streaming_digest = canonical_digest
+
+def iter_json_bytes(value, *, chunk_size=65536):
+    """Incremental plain JSON, exactly matching unchanged json_bytes(value).
+
+    JSONEncoder.iterencode owns validation/sorting/float conventions. No joined
+    root payload or root-sized encoded byte string is ever created here.
+    """
+    if type(chunk_size) is not int or chunk_size < 1:
+        raise ValueError('positive typed chunk_size required')
+    encoder = json.JSONEncoder(sort_keys=True, separators=(',', ':'),
+                               ensure_ascii=True, allow_nan=False)
+    buffer = bytearray()
+    for fragment in encoder.iterencode(value):
+        # ensure_ascii guarantees each character is one byte, including escaped
+        # Unicode/surrogates. Slice before encoding to avoid a large byte copy.
+        offset = 0
+        while offset < len(fragment):
+            take = min(chunk_size - len(buffer), len(fragment) - offset)
+            buffer.extend(fragment[offset:offset + take].encode('ascii'))
+            offset += take
+            if len(buffer) == chunk_size:
+                yield bytes(buffer)
+                buffer.clear()
+    if buffer:
+        yield bytes(buffer)
+
+
+def plain_json_digest(value):
+    """SHA256 exactly matching hashlib.sha256(json_bytes(value)).hexdigest()."""
+    result = hashlib.sha256()
+    for block in iter_json_bytes(value):
+        result.update(block)
+    return result.hexdigest()
+
+
+__all__ = ['iter_canonical_json_bytes', 'canonical_digest', 'streaming_digest',
+           'iter_json_bytes', 'plain_json_digest']
diff --git a/src/recon_lite_chess/coach/modular_evaluation_workspace.py b/src/recon_lite_chess/coach/modular_evaluation_workspace.py
