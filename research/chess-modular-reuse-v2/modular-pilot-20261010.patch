+def replay_actor(accepted_actor, *, producer: Path, identity: str, protocol_path: Path,
+                 authorization: Mapping, independent_admission: Mapping,
+                 m1_train: Sequence[str], m2_train: Sequence[str], known_m1_fens: Sequence[str],
+                 development_fens: Sequence[str], output: Path, interfaces: NativeCanaryInterfaces) -> dict:
+    """Once-only independent native reconstruction, not a new scientific actor.
+
+    A future qualified entry point must authenticate accepted transport before
+    passing it here. Every native action and full census is independently
+    executed and compared with the producer's saved records.
+    """
+    stream,arm =_prelaunch(identity=identity,protocol_path=protocol_path,authorization=authorization,
+        independent_admission=independent_admission,interfaces=interfaces)
+    producer =Path(producer)
+    declaration =json.loads((producer/'DECLARATION.json').read_text())
+    complete =json.loads((producer/'PRODUCER_COMPLETE.json').read_text())
+    schedule =proposed_schedule(stream,m1_train,m2_train)
+    seeds =pair_seed_strings(stream)
+    if declaration['identity'] !=identity or declaration['schedule_sha256'] !=digest(schedule):
+        raise ValueError('producer identity/schedule binding differs before replay initialization')
+    Path(output).mkdir(parents=True,exist_ok=False)
+    organism =NativeModularOrganism(accepted_actor,m1_plastic=arm =='plastic',learning=True,
+        parent_seed=seeds['parent-birth'],setup_seed=seeds['setup-birth'])
+    for module in ('parent','setup'):
+        organism.modules[module].exploration_rng.seed(seeds[f'{module}-exploration'],version=2)
+    physical =frames =0
+    censuses ={}
+    cold_replayed =False
+    for completed in range(257):
+        interfaces.deadline_check()
+        if completed in CENSUS_EPISODES:
+            actual =census(organism,known_m1_fens,development_fens,deadline_check=interfaces.deadline_check)
+            exact_path =producer/f'CENSUS-{completed:03}-EXACT.json'
+            if sha(exact_path) !=complete['census_exact_sha256'][str(completed)]:
+                raise ValueError('exact native census projection binding differs')
+            saved_exact =json.loads(exact_path.read_text())
+            if canonical(actual) !=saved_exact:
+                raise ValueError(f'independent full native census differs at {completed}')
+            censuses[completed] =actual
+            entry =next(row for row in complete['checkpoints'] if row['episode'] ==completed)
+            path =producer/entry['file']
+            checkpoint =load_checkpoint(path,expected_sha256=entry['sha256'],
+                expected_sidecar_sha256=entry['sidecar_sha256'],current_runtime_identity=interfaces.runtime_identity())
+            if checkpoint.state_digest() !=organism.state_digest():
+                raise ValueError('independent exact checkpoint state differs')
+        if completed ==256:
+            break
+        spec =schedule[completed]
+        actual =organism.play_episode(spec.fen,max_white_actions=spec.white_action_budget,
+            episode_id=f'{identity}:episode:{spec.episode:03}')
+        saved =json.loads((producer/f'EPISODE-{spec.episode:03}.json').read_text())
+        reconstructed =interfaces.independent_frame_reconstruction(actual)
+        if reconstructed.get('status') !='PASS' or canonical(actual) !=saved['result'] or organism.state_digest() !=saved['state_sha256']:
+            raise ValueError(f'independent native action/frame/state reconstruction differs at {spec.episode}')
+        physical +=len(actual['commits'])
+        frames +=len(actual['frames'])
+        if spec.episode ==129:
+            entry =next(row for row in complete['checkpoints'] if row['episode'] ==128)
+            path =producer/entry['file']
+            cold_actor =load_checkpoint(path,expected_sha256=entry['sha256'],
+                expected_sidecar_sha256=entry['sidecar_sha256'],current_runtime_identity=interfaces.runtime_identity())
+            cold_result =cold_actor.play_episode(spec.fen,max_white_actions=spec.white_action_budget,
+                episode_id=f'{identity}:episode:{spec.episode:03}')
+            if canonical(cold_result) !=canonical(actual) or cold_actor.state_digest() !=organism.state_digest():
+                raise ValueError('independent cold128/saved129 differs')
+            cold_replayed =True
+    for completed in (192,256):
+        entry =next(row for row in complete['checkpoints'] if row['episode'] ==completed)
+        path =producer/entry['file']
+        checkpoint =load_checkpoint(path,expected_sha256=entry['sha256'],
+            expected_sidecar_sha256=entry['sidecar_sha256'],current_runtime_identity=interfaces.runtime_identity())
+        actual_controls =interfaces.native_dependence_controls(checkpoint,censuses,known_m1_fens,completed,interfaces.deadline_check)
+        exact_path =producer/f'CONTROLS-{completed:03}-EXACT.json'
+        if sha(exact_path) !=complete['control_exact_sha256'][str(completed)]:
+            raise ValueError('exact native control projection binding differs')
+        saved_controls =json.loads(exact_path.read_text())
+        if canonical(actual_controls) !=saved_controls:
+            raise ValueError('independent native dependence controls differ')
+    if organism.state_digest() !=complete['final_state_sha256'] or physical !=complete['physical_white_actions'] or frames !=complete['participation_records']:
+        raise ValueError('independent native endpoint/counts differ')
+    result ={'status':'PASS','identity':identity,'replayed_scientific_episodes':256,
+        'physical_replayed_white_actions':physical,'replayed_participation_records':frames,
+        'full_censuses':5,'authenticated_checkpoint_censuses':5,'late_controls':2,
+        'cold_saved129':cold_replayed,'scientific_initializations':0,
+        'final_state_sha256':organism.state_digest(),'producer_complete_sha256':sha(producer/'PRODUCER_COMPLETE.json')}
+    write_json(Path(output)/'REPLAY_COMPLETE.json',result)
+    return result
