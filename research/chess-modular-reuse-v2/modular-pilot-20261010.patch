+        try:
+            return function(batch, *args, **kwargs)
+        except BaseException as error:
+            batch._poison(error)
+            raise
+    return recorded
+
+
+def _release_checked(owner, handle, section, count, release_section):
+    try:
+        return release_section(section, handle, count)
+    except BaseException as error:
+        if isinstance(owner, StandaloneM1Batch):
+            try:
+                owner.invalidate('accepted export/readback failed; results revoked')
+            except BaseException:
+                pass
+        else:
+            owner._poison(error)
+        raise
+
+
+def capture_decision(organism):
+    """Observe settled native graph state after commit, before frame closure."""
+    trace = copy.deepcopy(organism.traces[-1])
+    selected = trace['request']['selected_module']
+    if selected not in ('setup', 'm1'):
+        raise ValueError('native selected scope is not a registered skill')
+    if (trace['return']['selected_module'] != selected
+            or trace['commit']['module_id'] != selected):
+        raise ValueError('actual selected request/return/commit scope differs')
+    inputs = {}
+    for scope in ('parent', selected):
+        selection = trace['selection'][scope]
+        inputs[scope] = _score_inputs(organism.modules[scope], selection['bindings'])
+    return {'trace': trace, 'score_inputs': inputs}
+
+
+@_reject_record_failure
+def parent_m1_record(batch, fen, *, episode_id='census:parent-m1'):
+    board = batch.begin_trial(fen, max_white_actions=1, episode_id=episode_id)
+    batch.decide_and_commit()
+    decision = capture_decision(batch.organism)
+    selected = decision['trace']['request']['selected_module']
+    selection = decision['trace']['selection'][selected]
+    terminal = _terminal_or_rook(board)
+    reason, reward = terminal or ('exercise_timeout', -1.0)
+    record = {'fen': fen, 'action': selection['action'],
+        'prediction_hex': float(selection['prediction']).hex(),
+        'selected_scope': selected, 'decision': decision,
+        'after_fen': board.fen(), 'mate': reward > 0.0, 'reason': reason}
+    index = batch.record_pending(record).index
+    batch.finish_trial(eventual_mate=reward > 0.0, reason=reason)
+    return index
+
+
+@_reject_record_failure
+def parent_m2_record(batch, fen, *, deadline_check: Callable[[], None],
+                     episode_id='census:m2'):
+    """Keep each real branch's first state through its finishing request."""
+    board = batch.begin_trial(fen, max_white_actions=2, episode_id=episode_id)
+    batch.decide_and_commit()
+    first = capture_decision(batch.organism)
+    first_trace = first['trace']
+    first_terminal = _terminal_or_rook(board)
+    legal_replies = (() if first_terminal is not None else
+                     tuple(move.uci() for move in sorted(board.legal_moves,
+                                                       key=lambda move: move.uci())))
+    # The primary first invocation is separately counted; no saved action is
+    # used to execute a reply branch. Reset returns to the completed baseline.
+    batch.discard_trial()
+    replies = []
+    for reply in legal_replies:
+        deadline_check()
+        branch_board = batch.begin_trial(fen, max_white_actions=2,
+                                        episode_id=episode_id)
+        batch.decide_and_commit()
+        repeated = capture_decision(batch.organism)
+        if json_bytes(canonical(repeated)) != json_bytes(canonical(first)):
+            raise ValueError('independent reply branch repeated-first record differs')
+        batch.black_reply(chess.Move.from_uci(reply))
+        terminal = _terminal_or_rook(branch_board)
+        finish = None
+        if terminal is None:
+            batch.decide_and_commit()
+            finish = capture_decision(batch.organism)
+            terminal = _terminal_or_rook(branch_board)
+        reason, reward = terminal or ('exercise_timeout', -1.0)
+        replies.append({'black_action': reply, 'mate': reward > 0.0,
+            'reason': reason, 'repeated_first_record': repeated,
+            'finish_record': finish, 'after_fen': branch_board.fen()})
+        # Evaluation finish performs ordinary completion then restores private
+        # bookkeeping. It supplies no learner update under evaluation permissions.
+        batch.finish_trial(eventual_mate=reward > 0.0, reason=reason)
+    finish_traces = [None if row['finish_record'] is None else
+                     row['finish_record']['trace'] for row in replies]
+    all_reply = (first_terminal[1] > 0.0 if first_terminal is not None else
+                 bool(replies) and all(row['mate'] for row in replies))
+    row = {'fen': fen, 'orbit': orbit_key(chess.Board(fen)),
+        'all_reply_mate': all_reply, 'first_record': first,
+        'first_trace': first_trace,
+        'first_terminal': None if first_terminal is None else first_terminal[0],
+        'replies': replies,
+        'setup_first': first_trace['request']['selected_module'] == 'setup',
+        'm1_finish_every_reply': bool(finish_traces) and all(
+            trace is not None and trace['request']['selected_module'] == 'm1'
+            for trace in finish_traces),
+        'first_request_margin': _request_margin(first_trace),
+        'finish_request_margins': [_request_margin(trace) for trace in finish_traces
+                                   if trace is not None]}
+    return batch.record_pending(row).index
+
+
+def populations(known_m1_fens, development_fens, *, engineering_panel=False,
+                pilot_population_contract=None, pilot_contract_check=None):
+    if pilot_population_contract is not None:
+        if engineering_panel is not False or not callable(pilot_contract_check):
+            raise ValueError('pilot census requires separate authenticated contract, not engineering panel')
+        contract = pilot_population_contract
+        fields = {'schema', 'identity', 'logical_episode', 'physical_episode',
+            'm1_count', 'm2_count', 'm1_ordered_sha256', 'm2_ordered_sha256',
+            'panels_sha256', 'schedule_sha256', 'protocol_sha256',
+            'checkpoint_state_sha256', 'scientific_checkpoint'}
+        if type(contract) is not dict or set(contract) != fields:
+            raise ValueError('exact pilot population contract fields required')
+        if (contract['schema'] != 'modular-learning-pilot-census-populations.v1'
+                or contract['identity'] not in ('m2-modular-learning-pilot-20261009-v1:001:frozen',
+                                                'm2-modular-learning-pilot-20261009-v1:001:plastic')
+                or type(contract['logical_episode']) is not int
+                or contract['logical_episode'] not in (0, 128, 256)
+                or type(contract['physical_episode']) is not int
+                or contract['physical_episode'] != contract['logical_episode']
+                or contract['scientific_checkpoint'] is not True):
+            raise ValueError('true pilot identity and physical census barrier required')
+        required_m1 = 1512 if contract['logical_episode'] == 256 else 64
+        if (type(contract['m1_count']) is not int or contract['m1_count'] != required_m1
+                or type(contract['m2_count']) is not int or contract['m2_count'] != 32):
+            raise ValueError('exact pilot64/32 or endpoint1512/32 populations required')
+        for name in ('m1_ordered_sha256', 'm2_ordered_sha256', 'panels_sha256',
+                     'schedule_sha256', 'protocol_sha256', 'checkpoint_state_sha256'):
+            value = contract[name]
+            if (type(value) is not str or len(value) != 64
+                    or any(char not in '0123456789abcdef' for char in value)):
+                raise ValueError('pilot population authentication hash required: ' + name)
+        if pilot_contract_check(contract) is not True:
+            raise ValueError('external pilot population contract was not authenticated')
+        for rows, name, expected in ((known_m1_fens, 'm1', required_m1),
+                                     (development_fens, 'm2', 32)):
+            if (type(rows) not in (tuple, list) or len(rows) != expected
+                    or any(type(fen) is not str for fen in rows)
+                    or len(set(rows)) != len(rows)
+                    or hashlib.sha256(json_bytes(rows)).hexdigest() != contract[name + '_ordered_sha256']):
+                raise ValueError('pilot population membership/order binding differs: ' + name)
+        return
+    if pilot_contract_check is not None:
+        raise ValueError('pilot authenticator supplied without a pilot contract')
+    for name, rows, required in (('m1', known_m1_fens, 1512),
+                                 ('m2', development_fens, 128)):
+        if not isinstance(rows, (tuple, list)) or not rows or len(set(rows)) != len(rows):
+            raise ValueError('distinct ordered census population required: ' + name)
+        if any(type(fen) is not str for fen in rows):
+            raise TypeError('FEN strings required')
+        if not engineering_panel and len(rows) != required:
+            raise ValueError('complete fixed scientific census population required: ' + name)
+    if type(engineering_panel) is not bool:
+        raise TypeError('explicit engineering panel flag required')
+
+
+def execute_checkpoint_census(organism, known_m1_fens: Sequence[str],
+                              development_fens: Sequence[str], *, source_binding,
+                              binding_check, deadline_check,
+                              release_section: Callable, engineering_panel=False,
+                              phase_span=None, pilot_population_contract=None,
+                              pilot_contract_check=None):
+    """One native measurement per position/branch, with accepted streaming.
+
+    ``release_section(section, handle, count)`` must export and perform complete
+    raw and decoded readback through per-record access only. It returns factual
+    summaries/artifact bindings, not retained complete inventories. The completed
+    checkpoint remains resident, but every private workspace/handle is deleted
+    before the next section. This intentionally prices TWO parent entry/final
+    boundaries at each checkpoint rather than assuming a free mixed workspace.
+    """
+    populations(known_m1_fens, development_fens, engineering_panel=engineering_panel,
+                pilot_population_contract=pilot_population_contract,
+                pilot_contract_check=pilot_contract_check)
+    if not all(callable(value) for value in (binding_check, deadline_check, release_section)):
+        raise TypeError('authenticated boundary, guard and accepted transport required')
+    if phase_span is not None and not callable(phase_span):
+        raise TypeError('optional passive boundary observer must be callable')
+    span = phase_span or (lambda label: nullcontext())
+    organism.require_completed_barrier()
+    before = organism.state_digest()
+    if (pilot_population_contract is not None
+            and pilot_population_contract['checkpoint_state_sha256'] != before):
+        raise ValueError('pilot population contract checkpoint differs')
+    if source_binding['snapshot_sha256'] != before:
+        raise ValueError('completed checkpoint snapshot differs')
+    results = {}
+    with span('child_workspace_initialization'):
+        child = StandaloneM1Batch(organism, source_binding=source_binding,
+                                  binding_check=binding_check)
+    for fen in known_m1_fens:
+        deadline_check()
+        with span('child_m1_reset_execute_record'):
+            child.evaluate(fen, event_id=0)
+    with span('child_workspace_final_acceptance'):
+        handle = child.accept()
+    with span('child_m1_stream_export_readback'):
+        results['standalone_m1'] = _release_checked(child, handle, 'standalone_m1',
+                                                   len(known_m1_fens), release_section)
+    # The old public metadata-plus-inventory accessor copies every row. Check
+    # the qualified revocable handle, then copy metadata only; no inventory copy.
+    handle._check()
+    results['standalone_m1_acceptance'] = copy.deepcopy(child._acceptance)
+    del handle, child
+    gc.collect()
+
+    with span('parent_m1_workspace_initialization'):
+        parent = BatchedEvaluationWorkspace(organism, source_binding=source_binding,
+                                           binding_check=binding_check)
+    for fen in known_m1_fens:
+        deadline_check()
+        with span('parent_m1_reset_execute_finish_record'):
+            parent_m1_record(parent, fen)
+    with span('parent_m1_workspace_final_acceptance'):
+        handle = parent.accept()
+    with span('parent_m1_stream_export_readback'):
+        results['parent_m1'] = _release_checked(parent, handle, 'parent_m1',
+                                                len(known_m1_fens), release_section)
+    results['parent_m1_acceptance'] = handle.inventory()
+    del handle, parent
+    gc.collect()
+
+    with span('parent_m2_workspace_initialization'):
+        parent = BatchedEvaluationWorkspace(organism, source_binding=source_binding,
+                                           binding_check=binding_check)
+    for fen in development_fens:
+        deadline_check()
+        with span('parent_m2_complete_board_reset_branches_finish_record'):
+            parent_m2_record(parent, fen, deadline_check=deadline_check)
+    with span('parent_m2_workspace_final_acceptance'):
+        handle = parent.accept()
+    with span('parent_m2_stream_export_readback'):
+        results['parent_m2'] = _release_checked(parent, handle, 'parent_m2',
+                                                len(development_fens), release_section)
+    results['parent_m2_acceptance'] = handle.inventory()
+    del handle, parent
+    gc.collect()
+    deadline_check()
+    binding_check(source_binding)
+    if organism.state_digest() != before:
+        raise ValueError('census altered authenticated completed checkpoint')
+    return {'schema': 'amended-native-checkpoint-census.v1',
+        'status': 'PENDING_ENCLOSING_GUARD', 'source_binding': dict(source_binding),
+        'sections': results, 'native_census_executions': 1,
+        'fresh_standalone_m1': True, 'frozen_m1_reuse_registry': False,
+        'checkpoint_reads': 1, 'private_child_workspaces': 1,
+        'private_parent_workspaces': 2, 'engineering_panel': engineering_panel,
+        'normal_census_reexecuted_in_R_or_V': False,
+        'standalone_m1_native_calls': len(known_m1_fens),
+        'parent_m1_native_calls': len(known_m1_fens),
+        'scientific_initializations': 0, 'source_state_unchanged': True,
+        **({} if pilot_population_contract is None else {'pilot_population_contract_sha256':
+            hashlib.sha256(json_bytes(pilot_population_contract)).hexdigest()})}
