+    for module in participating:
+        f = models[module].f; f['last_episode_frames'] = tuple(frame.local for frame in frames if frame.module_id == module)
+        f['episodes_completed'] += 1; f['_episode_development_queue'] = []
+    development = copy.deepcopy(pre['ledger_development']); versions = dict(pre['versions'])
+    for record in queued:
+        module = record['module_id']; model = models[module]; model.develop(record['owner']); versions[module] += 1
+        development.append({**record, 'serviced_completed': model.f['completed'],
+                            'serviced_owner_visits': model.f['owner_visits'][record['owner']]})
+    for module, model in models.items():
+        _same(post['modules'][module]['fields'], model.f, module + ' complete mathematical state')
+        _same(post['modules'][module]['rng'], {key: value.getstate() for key, value in model.rng.items()}, module + ' all RNG transitions')
+        _same(post['modules'][module]['expression_ids'], model.ids, module + ' expression definition identities')
+        _same(post['modules'][module]['slots'], model.slots, module + ' binding replica count')
+        if set(post['modules'][module]['graph_nodes']) != model.nodes:
+            raise ValueError('independent physical node allocation mismatch: ' + module)
+    _same(post['versions'], versions, 'development remount versions')
+    _same(post['ledger_development'], development, 'ordered queued development servicing')
+    _same((post['request_counter'], post['episode_counter'], post['ledger_episodes']),
+          (pre['request_counter'] + len(commits), pre['episode_counter'] + 1, pre['ledger_episodes'] + 1),
+          'organism/ledger counters')
+    return {'status': 'PASS', 'schema': SCHEMA, 'ordered_frames': len(frames),
+        'physical_white_actions': len(commits), 'development_services': len(queued),
+        'pre_state_sha256': pre['state_sha256'], 'post_state_sha256': post['state_sha256'],
+        'mathematical_checks_sha256': digest((tuple(credits), development, versions)),
+        'native_execution_by_checker': 0, 'unsupported_semantics': []}
+
+
+def learning_evidence_start(initial):
+    """Small accumulator; detailed attribution stays in individual episode files."""
+    if initial['schema'] != SCHEMA:
+        raise ValueError('independently captured initial mathematical state required')
+    return {'schema': 'amended-canary-learning-evidence.v1',
+        'initial_state_sha256': initial['state_sha256'], 'completed_episodes': 0,
+        'initial_condition_ids': {module: list(initial['modules'][module]['fields']['conditions'])
+                                  for module in ('parent', 'setup')},
+        'structural_commits': {'parent': {}, 'setup': {}},
+        'positive_m2_receipts': 0, 'first_positive_m2_episode': None,
+        'parent_post_birth_nonzero_credit': 0, 'setup_post_birth_nonzero_credit': 0,
+        'parent_all_post_birth_nonzero_credit': 0, 'setup_all_post_birth_nonzero_credit': 0,
+        'credit_count_unit': 'active nonbias contributor in an actual ordered credit record',
+        'receipt_credit_order': 'terminal feedback receipt precedes the ordered credit of that episode',
+        'detailed_records': 'one bounded learning_evidence object in every EPISODE file',
+        'attribution_is_counterfactual': False}
+
+
+def learning_evidence_episode(summary, row, pre, result, post, checked):
+    """Aggregate verified experience and physically committed new structures.
+
+    A structure must already exist in the pre-episode registry to receive credit.
+    Thus a same-episode birth at the completed development barrier never counts.
+    The first actual positive M2 terminal receipt is registered before credit:
+    that receipt is causally upstream of all updates closing the same episode.
+    Cold reconstruction never calls this function and never adds new experience.
+    """
+    episode = row['episode']
+    if (summary['schema'] != 'amended-canary-learning-evidence.v1'
+            or type(episode) is not int or episode != summary['completed_episodes'] + 1
+            or checked.get('status') != 'PASS'
+            or checked['pre_state_sha256'] != pre['state_sha256']
+            or checked['post_state_sha256'] != post['state_sha256']):
+        raise ValueError('learning evidence requires complete ordered independent episode verification')
+    positive = row['environment_contract'] == 'm2' and result['eventual_mate'] is True
+    if positive:
+        summary['positive_m2_receipts'] += 1
+        if summary['first_positive_m2_episode'] is None:
+            summary['first_positive_m2_episode'] = episode
+    has_positive = summary['first_positive_m2_episode'] is not None
+    records = []
+    for frame, credit in zip(result['frames'], result['credit']):
+        module = frame.module_id
+        if module not in ('parent', 'setup') or not credit.updated or credit.increment == 0.0:
+            continue
+        fields = pre['modules'][module]['fields']
+        bias = fields['leaves'][frame.local.owner].bias_id
