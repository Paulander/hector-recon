+"""Independent mathematical checks of modular trajectory receipts.
+
+This laboratory adapter never calls a learner's observe, development, action or
+selection method. Native generative reconstruction is a separate P/R operation.
+The snapshot excludes physical execution replicas, which R compares in the full
+authenticated checkpoint state, but includes all persistent mathematical state.
+Unknown expression, ownership, learning or RNG semantics fail closed.
+"""
+from __future__ import annotations
+
+import copy
+from dataclasses import replace
+from itertools import product
+import hashlib
+import json
+import math
+import random
+
+import chess
+
+from recon_lite_hector.learning.context_compatibility import PreparedCheck, Verdict
+from recon_lite_hector.learning.recursive_context import Expression, SplitEvidence, TRUE
+from recon_lite_hector.learning.refining_route_action import ProspectiveRefinementNomination
+from recon_lite_hector.learning.route_action_bud import RouteActionEvidence
+from recon_lite_hector.learning.terminal_development import Condition, PlasticWeight
+from .m2_evidence import canonical, digest, json_bytes
+from .canary_census_semantics import measurements
+
+
+SCHEMA = 'independent-modular-trajectory-arithmetic.v1'
+EXECUTION_FIELDS = frozenset(('graph', 'slots', 'expression_ids', 'probe_nodes',
+    'birth_probe_nodes', 'action_probe_nodes', 'pending', 'context_pending',
+    'owner_pending', 'candidate_pending', 'action_bud_pending',
+    'birth_search_pending', 'deferred_development', '_action_invariant_credit_pending'))
+MODULES = ('parent', 'setup', 'm1')
