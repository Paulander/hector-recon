+"""Prepare authenticated mathematical census inputs from completed native state.
+
+This adapter performs no policy invocation, actuation, learning or checkpoint
+deserialization.  The caller has already authenticated/loaded a checkpoint and
+independently reconstructed its complete state.  Before exporting expressions,
+it checks the actual native graph compiler blueprint, rather than trusting the
+actor's expression dictionary as a description of a possibly altered graph.
+"""
+from __future__ import annotations
+
+from .canary_census_semantics import (CAPSULE_SCHEMA, CONNECTIONS, evaluate_expression,
+                                    json_digest, require, validate_capsule)
+
+_TRANSIENT_META = frozenset(('choice_selected', 'choice_selected_child',
+    'emitted_actuator_identity', 'reading', 'emitted'))
+
+
+def _typed_equal(left, right):
+    """Metadata equality must not identify a Boolean with an integer/float."""
+    if type(left) is not type(right):
+        return False
+    if type(left) is dict:
+        return (list(left) == list(right) and all(type(k) is str for k in left)
+                and all(_typed_equal(left[k], right[k]) for k in left))
+    if type(left) in (tuple, list):
+        return len(left) == len(right) and all(_typed_equal(a, b) for a, b in zip(left, right))
+    if type(left) is float:
+        return left.hex() == right.hex()
+    return left == right
+
+
+def expression_data(expression):
+    operator = expression.operator
+    if operator == 'true':
+        require(not expression.children and expression.atom is None, 'malformed native TRUE expression')
+        return {'operator': 'true'}
+    if operator == 'read':
+        require(not expression.children and type(expression.atom) is tuple and len(expression.atom) == 2,
+                'malformed native reader expression')
+        index, value = expression.atom
+        require(type(index) is int and type(value) in (bool, int), 'unsupported native typed atom')
+        return {'operator': 'read', 'coordinate': index, 'type': type(value).__name__, 'value': value}
+    require(operator in ('and', 'or', 'xor') and expression.atom is None,
+            'unsupported native expression semantics')
+    return {'operator': operator, 'children': [expression_data(child) for child in expression.children]}
+
+
+def _schema(actor):
+    rows = []
+    for coordinate in actor.schema:
+        values = list(coordinate.values)
+        require(values and type(values[0]) in (bool, int) and all(type(v) is type(values[0]) for v in values),
+                'unsupported mixed native coordinate domain')
+        rows.append({'name': coordinate.name, 'type': type(values[0]).__name__, 'values': values})
+    return rows
+
+
+def _blueprint(actor):
+    from recon_lite.graph import Edge, Graph, LinkType, Node, NodeType
+    from recon_lite_hector.learning.terminal_development import _catalog, _reader, _constant, _exploration, _actuator
+
+    graph = actor.graph
+    require(type(graph) is Graph and type(graph.nodes) is dict and type(graph.edges) is list
+            and all(type(item) is Node and type(item.meta) is dict for item in graph.nodes.values())
+            and all(type(edge) is Edge and type(edge.meta) is dict for edge in graph.edges),
+            'unsupported native graph/node/edge/container type')
+    actor.validate_ownership()
+    require(type(actor.expression_ids) is dict and all(type(value) is int and value >= 0
+        for value in actor.expression_ids.values()) and len(set(actor.expression_ids.values())) == len(actor.expression_ids),
+        'typed unique native definition indices required')
+    # A checkpoint can precede its first binding-slot allocation.  Check its
+    # latent definitions now as well as existing compiled nodes; otherwise an
+    # unsupported definition could hide until the first native expansion.
+    schema = _schema(actor)
+    declared = [*actor.expression_ids, *actor.base_expressions.values(),
+                *actor.owner_candidates, *actor.birth_expressions, *actor.action_readers]
+    for definition in declared:
+        evaluate_expression(expression_data(definition), schema)
+    require(type(actor.slots) is int and actor.slots >= 0, 'invalid native replica count')
+    conditions = tuple(actor.conditions)
+    require(len(actor.leaves) == 1, 'unsupported native owner partition')
+    owner = next(iter(actor.leaves.values()))
+    require(owner.path.operator == 'true' and not owner.path.children and owner.path.atom is None,
+            'unsupported native owner route')
+    visited_nodes, expected_pairs = set(), {}
+
+    def clean_meta(node):
+        return {k: v for k, v in node.meta.items() if k not in _TRANSIENT_META
+                and not (k == 'actuator_identity' and node.nid.startswith('option:'))}
+
+    def node(nid, kind, predicate, meta):
+        require(nid in graph.nodes, 'compiled node missing: ' + nid)
+        item = graph.nodes[nid]
+        require(item.nid == nid and item.ntype == kind and item.predicate is predicate
+                and _typed_equal(clean_meta(item), meta), 'unsupported/corrupt compiled node semantics: ' + nid)
+        visited_nodes.add(nid)
+        return item
+
+    def pair(parent, child, weight=1.0, identity=None):
+        key = parent, child
+        previous = expected_pairs.get(key)
+        require(previous is None or previous == (weight, identity), 'inconsistent compiled hierarchy pair')
+        expected_pairs[key] = weight, identity
+        down = graph.edge_by_key.get((parent, child, LinkType.SUB))
+        up = graph.edge_by_key.get((child, parent, LinkType.SUR))
+        require(down is not None and up is not None and type(down.w) is float and float(down.w) == 1.0 and not down.meta
+                and float(up.w).hex() == float(weight).hex() and not up.meta,
+                'compiled hierarchy pair/weight differs')
+        if identity is not None:
+            require(up.w is identity, 'compiled owned score parameter alias differs')
+        else:
+            require(type(up.w) is float, 'typed fixed hierarchy weight differs')
+
+    def expr(expression, slot, owning):
+        require(expression in actor.expression_ids, 'native expression definition id missing')
+        definition = actor.expression_ids[expression]
+        require(type(definition) is int and definition >= 0, 'invalid native expression definition id')
+        nid = f'expr:{slot}:{definition}'
+        if expression.children:
+            nid += ':in:' + owning
+        if expression.operator == 'read':
+            node(nid, NodeType.TERMINAL, _reader, {'slot': slot, 'atom': expression.atom})
+            require(not graph.children(nid), 'native reader has children')
+        elif expression.operator == 'true':
+            node(nid, NodeType.TERMINAL, _constant, {})
+            require(not graph.children(nid), 'native TRUE terminal has children')
+        else:
+            require(expression.operator in ('and', 'or', 'xor'), 'unsupported compiled Boolean operator')
+            item = node(nid, NodeType.SCRIPT, None, {'confirm_policy': expression.operator,
+                'recursive_expression': True, 'definition_id': definition})
+            require(float(item.activation.value).hex() == 1.0.hex(), 'Boolean SCRIPT activation changed')
+            children = [expr(child, slot, nid) for child in expression.children]
+            require(graph.children(nid) == children, 'compiled Boolean child order differs')
+            for child in children:
+                pair(nid, child)
+        return nid
+
+    node('action_choice', NodeType.SCRIPT, None, {'confirm_policy': 'choice'})
+    node('catalog_root', NodeType.SCRIPT, None, {'confirm_policy': 'and'})
+    node('catalog', NodeType.TERMINAL, _catalog, {})
+    node('execute', NodeType.SCRIPT, None, {'confirm_policy': 'and'})
+    node('actuator', NodeType.TERMINAL, _actuator, {})
+    require(graph.children('catalog_root') == ['catalog'] and graph.children('execute') == ['actuator'],
+            'native catalog/actuator hierarchy differs')
+    pair('catalog_root', 'catalog'); pair('execute', 'actuator')
+    require(graph.children('action_choice') == [f'option:{slot}' for slot in range(actor.slots)],
+            'native option order differs')
+    for slot in range(actor.slots):
+        option = f'option:{slot}'
+        node(option, NodeType.SCRIPT, None, {'confirm_policy': 'weighted_evidence'})
+        pair('action_choice', option)
+        node(f'bias:{slot}', NodeType.TERMINAL, _constant, {'slot': slot})
+        node(f'explore:{slot}', NodeType.TERMINAL, _exploration, {'slot': slot})
+        pair(option, f'bias:{slot}', float(actor.bias), actor.bias)
+        pair(option, f'explore:{slot}', 1.)
+        expected = [f'bias:{slot}', f'explore:{slot}']
+        for cid, condition in actor.conditions.items():
+            require(cid in actor.expressions and cid in actor.base_expressions, 'native condition definition missing')
+            require(actor.expressions[cid] == actor.base_expressions[cid], 'nonconstant owner gate is unsupported')
+            gate = f'gate:{slot}:{cid}'
+            item = node(gate, NodeType.SCRIPT, None, {'confirm_policy': 'and', 'condition_id': cid})
+            require(float(item.activation.value).hex() == 1.0.hex(), 'native score gate activation changed')
+            pair(option, gate, float(condition.weight), condition.weight)
+            child = expr(actor.expressions[cid], slot, gate)
+            require(graph.children(gate) == [child], 'native contributor gate has additional dependencies')
+            pair(gate, child)
+            expected.append(gate)
+        require(graph.children(option) == expected, 'native ordered score contributor inventory differs')
+        for root_prefix, definitions, indices in (
+            ('owner-probe', actor.owner_candidates, actor.probe_nodes),
+            ('birth-probe', actor.birth_expressions, actor.birth_probe_nodes),
+            ('action-probe', actor.action_readers, actor.action_probe_nodes)):
+            root = f'{root_prefix}:{slot}'
+            node(root, NodeType.SCRIPT, None, {'confirm_policy': 'weighted_evidence'})
+            children = [expr(definition, slot, root) for definition in definitions]
+            require(graph.children(root) == children and tuple(children) == indices[slot],
+                    'native observation probe mapping differs')
+            for child in children:
+                pair(root, child)
+    # Retirement may leave shared leaf definitions without a live parent.
+    # Such leaves cannot score, but their typed source definition is still checked.
+    reverse = {value: expression for expression, value in actor.expression_ids.items()}
+    require(len(reverse) == len(actor.expression_ids), 'duplicate native definition indices')
+    for nid in graph.nodes:
+        if nid in visited_nodes:
+            continue
+        parts = nid.split(':')
+        require(len(parts) == 3 and parts[0] == 'expr' and parts[1].isdigit() and parts[2].isdigit(),
+                'unsupported extra native graph node: ' + nid)
+        slot, definition = int(parts[1]), int(parts[2])
+        expression = reverse.get(definition)
+        require(0 <= slot < actor.slots and expression is not None and not expression.children,
+                'unsupported orphan native definition')
+        require(not graph.all_parents(nid), 'unaccounted live native expression dependency')
+        expr(expression, slot, '')
+    require(set(graph.nodes) == visited_nodes, 'incomplete native graph blueprint coverage')
+    edge_keys = set()
+    for edge in graph.edges:
+        require(edge.ltype in (LinkType.SUB, LinkType.SUR), 'unsupported sequence dependency in census graph')
+        key = edge.src, edge.dst, edge.ltype
+        require(key not in edge_keys and graph.edge_by_key.get(key) is edge, 'duplicate/stale native edge index')
+        edge_keys.add(key)
+        parent, child = (edge.src, edge.dst) if edge.ltype is LinkType.SUB else (edge.dst, edge.src)
+        require((parent, child) in expected_pairs, 'unaccounted native graph edge')
+    require(len(edge_keys) == 2 * len(expected_pairs) and set(graph.edge_by_key) == edge_keys,
+            'compiled hierarchy inventory/index differs')
+    for mapping_name, ltype in (('out', None), ('inc', None)):
+        mapping = getattr(graph, mapping_name)
+        derived = {}
+        for edge in graph.edges:
+            key = (edge.src if mapping_name == 'out' else edge.dst, edge.ltype)
+            value = edge.dst if mapping_name == 'out' else edge.src
+            derived.setdefault(key, []).append(value)
+        require(mapping == derived, 'compiled ordered graph index differs: ' + mapping_name)
+    parents = dict.fromkeys(graph.nodes)
+    fanin = {nid: [] for nid, item in graph.nodes.items() if item.ntype is NodeType.TERMINAL}
+    for edge in graph.edges:
+        if edge.ltype is not LinkType.SUB:
+            continue
+        if edge.dst in fanin:
+            fanin[edge.dst].append(edge.src)
+            if parents[edge.dst] is None:
+                parents[edge.dst] = edge.src
+        else:
+            require(parents[edge.dst] is None, 'native SCRIPT has multiple owners')
+            parents[edge.dst] = edge.src
+    require(graph.parent == parents and graph.parents_fanin == fanin,
+            'compiled ownership/fan-in graph indices differ')
+    proof = {'nodes': [[nid, graph.nodes[nid].ntype.name,
+        None if graph.nodes[nid].predicate is None else graph.nodes[nid].predicate.__module__ + '.' + graph.nodes[nid].predicate.__qualname__,
+        clean_meta(graph.nodes[nid])] for nid in graph.nodes],
+        'edges': [[edge.src, edge.dst, edge.ltype.name, float(edge.w).hex()] for edge in graph.edges],
+        'slots': actor.slots}
+    return json_digest(proof)
+
+
+def _composed_blueprint(organism):
+    """Authenticate the real fixed bridge and every composed live source view."""
+    from recon_lite.formal_engine import FormalReConEngine
+    from recon_lite.graph import Edge, Graph, LinkType, Node, NodeType
+    from recon_lite_hector.learning.modular_graph import (
+        MountedGraph, NativeInvocationGraph, _MappedNode, _MappedEdge, _MappedMetadata, _call_phase)
+    from .native_modular import _real_commit
+
+    runtime, modules = organism.runtime, organism.modules
+    composer = runtime.composer
+    require(type(runtime) is NativeInvocationGraph and type(composer) is MountedGraph
+            and runtime.organism is organism and type(runtime.graph) is Graph
+            and runtime.graph is composer.graph and type(runtime.engine) is FormalReConEngine
+            and runtime.engine.g is composer.graph, 'native composed runtime/engine binding differs')
+    for registry in (runtime.modules, composer.modules, organism.ledger.modules):
+        require(tuple(registry) == tuple(modules) and all(registry[scope] is actor for scope, actor in modules.items()),
+                'native composed scope registry/identity differs')
+    require(composer.max_scope_nodes == 32768 and composer.max_bridge_nodes == 64
+            and composer.max_composite_nodes == 98368, 'native composed resource bounds differ')
+    signatures = {scope: tuple((coordinate.name, tuple((type(value).__name__, value) for value in coordinate.values))
+                              for coordinate in actor.schema) for scope, actor in modules.items()}
+    require(_typed_equal(composer.schema_signatures, signatures), 'native composed typed schema registry differs')
+    require(not runtime.configurations and not runtime.environments and not runtime.selections,
+            'completed checkpoint retained configured calls/selection frames')
+    require(set(runtime.environment) == {'native_runtime', 'scope_environments', 'raise_terminal_errors'}
+            and runtime.environment['native_runtime'] is runtime
+            and runtime.environment['scope_environments'] is runtime.environments
+            and runtime.environment['raise_terminal_errors'] is True,
+            'native runtime environment authority binding differs')
+    definitions, pairs = {}, []
+
+    def bridge(nid, ntype, predicate, meta):
+        definitions[nid] = ntype, predicate, meta
+
+    def pair(parent, child):
+        pairs.extend(((parent, child, LinkType.SUB), (child, parent, LinkType.SUR)))
+
+    for scope in modules:
+        root = '__call__:' + scope
+        bridge(root, NodeType.SCRIPT, None, {'request_policy': 'ordered_sub', 'confirm_policy': 'forward_choice',
+            'module_scope': scope, 'forward_choice_source': scope + '::action_choice'})
+        stages = []
+        for phase in ('entry', 'bind', 'capture'):
+            stage, terminal = root + ':' + phase, root + ':' + phase + ':terminal'
+            bridge(stage, NodeType.SCRIPT, None, {'confirm_policy': 'and'})
+            bridge(terminal, NodeType.TERMINAL, _call_phase, {'module_scope': scope, 'call_phase': phase})
+            pair(stage, terminal); stages.append(stage)
+        for child in (stages[0], scope + '::catalog_root', stages[1], scope + '::action_choice', stages[2]):
+            pair(root, child)
+    bridge('bridge:selected', NodeType.SCRIPT, None, {'request_policy': 'selected_choice',
+        'confirm_policy': 'selected_choice', 'selected_choice_source': '__call__:parent',
+        'selected_choice_connections': {'connection:0': '__call__:setup', 'connection:1': '__call__:m1'}})
+    pair('bridge:selected', '__call__:setup'); pair('bridge:selected', '__call__:m1')
+    bridge('bridge:decision', NodeType.SCRIPT, None, {'request_policy': 'ordered_sub',
+        'confirm_policy': 'forward_choice', 'forward_choice_source': 'bridge:selected'})
+    bridge('bridge:commit', NodeType.SCRIPT, None, {'confirm_policy': 'and'})
+    bridge('bridge:actuator', NodeType.TERMINAL, _real_commit, {})
+    pair('bridge:commit', 'bridge:actuator')
+    for child in ('__call__:parent', 'bridge:selected', 'bridge:commit'):
+        pair('bridge:decision', child)
+    require(tuple(composer.bridge_nodes) == tuple(definitions), 'fixed native bridge node inventory/order differs')
+    dynamic = _TRANSIENT_META | {'selected_request_child', 'selected_connection', 'selected_child', 'target_scope', 'return_source'}
+    for nid, (kind, predicate, metadata) in definitions.items():
+        item = composer.bridge_nodes[nid]
+        clean = {key: value for key, value in item.meta.items() if key not in dynamic}
+        require(type(item) is Node and item.nid == nid and item.ntype is kind and item.predicate is predicate
+                and _typed_equal(clean, metadata) and runtime.graph.nodes.get(nid) is item,
+                'fixed native bridge predicate/metadata/live-node differs: ' + nid)
+    require(len(composer.bridge_edges) == len(pairs), 'fixed native bridge edge inventory differs')
+    for edge, expected in zip(composer.bridge_edges, pairs):
+        require(type(edge) is Edge and (edge.src, edge.dst, edge.ltype) == expected
+                and type(edge.w) is float and edge.w.hex() == 1.0.hex() and not edge.meta,
+                'fixed native bridge edge/weight/order differs')
+    expected_nodes, expected_edges = [], []
+    for scope, actor in modules.items():
+        for local_id, local in actor.graph.nodes.items():
+            global_id = scope + '::' + local_id; mapped = runtime.graph.nodes.get(global_id)
+            require(type(mapped) is _MappedNode and mapped.scope == scope and mapped.local is local
+                    and type(mapped.meta) is _MappedMetadata and mapped.meta.node is local and mapped.meta.scope == scope,
+                    'composed graph contains a stale/foreign source node view')
+            expected_nodes.append(global_id)
+        for local in actor.graph.edges:
+            key = scope + '::' + local.src, scope + '::' + local.dst, local.ltype
+            mapped = runtime.graph.edge_by_key.get(key)
+            require(type(mapped) is _MappedEdge and mapped.scope == scope and mapped.local is local
+                    and type(mapped.meta) is _MappedMetadata and mapped.meta.node is local and mapped.meta.scope == scope,
+                    'composed graph contains a stale/foreign source edge view')
+            expected_edges.append(mapped)
+    expected_nodes.extend(definitions)
+    expected_edges.extend(composer.bridge_edges)
+    graph = runtime.graph
+    require(list(graph.nodes) == expected_nodes and len(graph.edges) == len(expected_edges)
+            and all(actual is expected for actual, expected in zip(graph.edges, expected_edges)),
+            'composed graph node/edge order or binding differs')
+    require(len(graph.edge_by_key) == len(expected_edges)
+            and all(graph.edge_by_key.get((edge.src, edge.dst, edge.ltype)) is edge for edge in expected_edges),
+            'composed graph edge index differs')
+    out, inc = {}, {}
+    parents = dict.fromkeys(graph.nodes)
+    fanin = {nid: [] for nid, item in graph.nodes.items() if item.ntype is NodeType.TERMINAL}
+    for edge in expected_edges:
+        out.setdefault((edge.src, edge.ltype), []).append(edge.dst)
+        inc.setdefault((edge.dst, edge.ltype), []).append(edge.src)
+        if edge.ltype is LinkType.SUB:
+            if edge.dst in fanin:
+                fanin[edge.dst].append(edge.src)
+                if parents[edge.dst] is None:
+                    parents[edge.dst] = edge.src
+            else:
+                require(parents[edge.dst] is None, 'composed SCRIPT has a foreign second owner')
+                parents[edge.dst] = edge.src
+    require(graph.out == out and graph.inc == inc and graph.parent == parents and graph.parents_fanin == fanin,
+            'composed graph dependency/ownership indices differ')
+    proof = {'bridge_nodes': [[nid, kind.name, None if predicate is None else predicate.__module__ + '.' + predicate.__qualname__,
+        meta] for nid, (kind, predicate, meta) in definitions.items()],
+        'bridge_edges': [[src, dst, kind.name] for src, dst, kind in pairs],
+        'composed_node_ids': expected_nodes, 'local_node_views_and_edge_aliases_verified': True}
+    return json_digest(proof)
+
+
+def export_capsule(organism, bindings):
+    """Bind verified native state to data-only mathematical evaluation inputs."""
+    from .native_modular import MODULE_IDS, NativeModularOrganism
+    require(type(organism) is NativeModularOrganism, 'exact native organism required for capsule')
+    organism.require_completed_barrier()
+    organism.validate()
+    require(type(bindings) is dict and bindings.get('snapshot_sha256') == organism.state_digest(),
+            'capsule export snapshot is not authenticated')
+    require(tuple(organism.modules) == MODULE_IDS and organism.connections == CONNECTIONS
+            and organism.evaluation_control is None, 'unmodified completed native scope mapping required')
+    bridge_proof = _composed_blueprint(organism)
+    scopes = {}
+    for scope, actor in organism.modules.items():
+        proof = _blueprint(actor)
+        owner = next(iter(actor.leaves.values()))
+        rows = []
+        for cid, condition in actor.conditions.items():
+            rows.append({'identity': cid, 'owner': owner.identity,
+                'fast': float(condition.weight.fast).hex(), 'slow': float(condition.weight.slow).hex(),
+                'effective': float(condition.weight).hex(), 'expression': expression_data(actor.expressions[cid]),
+                'owned_bias': cid == owner.bias_id})
+        scopes[scope] = {'schema': _schema(actor), 'legacy_bias': float(actor.bias).hex(), 'conditions': rows,
+            'owner': {'identity': owner.identity, 'contributions': list(owner.contributions),
+                      'bias_id': owner.bias_id, 'path': expression_data(owner.path)},
+            'state_coordinates': list(actor.state_coordinates),
+            'score_term_order': ['bias', 'explore'] + list(actor.conditions),
+            'graph_blueprint_sha256': proof}
+    result = {'schema': CAPSULE_SCHEMA, 'bindings': dict(bindings),
+        'request_counter': organism.request_counter, 'episode_counter': organism.episode_counter,
+        'event_base': dict(organism.event_base), 'versions': dict(organism.runtime.composer.structure_versions),
+        'connections': dict(organism.connections), 'scopes': scopes, 'score_blueprint_verified': True,
+        'bridge_blueprint_sha256': bridge_proof}
+    result['payload_sha256'] = json_digest(result)
+    validate_capsule(result)
+    return result
