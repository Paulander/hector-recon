+def verify_episode(pre, result, post):
+    """Check all supported credit/evidence/development/RNG semantics exactly."""
+    if pre['schema'] != SCHEMA or post['schema'] != SCHEMA:
+        raise ValueError('unsupported trajectory snapshot schema')
+    if tuple(pre['modules']) != MODULES or tuple(post['modules']) != MODULES:
+        raise ValueError('missing or reordered modular scope')
+    _same(post['permissions'], pre['permissions'], 'permissions')
+    _same(post['event_base'], pre['event_base'], 'event namespaces')
+    frames, commits, credits, traces = (tuple(result[k]) for k in ('frames', 'commits', 'credit', 'traces'))
+    if not commits or len(frames) != 2 * len(commits) or len(credits) != len(frames) or len(traces) != len(commits):
+        raise ValueError('incomplete ordered actual participation')
+    if result['eventual_mate'] != commits[-1].immediate_mate:
+        raise ValueError('eventual outcome does not bind final physical commit')
+    _actual_history(pre, result, commits, traces, frames)
+    models = {m: _Model(pre['modules'][m]) for m in MODULES}
+    for ordinal, (commit, trace) in enumerate(zip(commits, traces), 1):
+        request = f"request:{pre['request_counter'] + ordinal}"
+        pair = frames[2 * (ordinal - 1):2 * ordinal]
+        if (commit.request_id != request or commit.white_ordinal != ordinal
+                or tuple(frame.module_id for frame in pair) != ('parent', commit.selected_module)
+                or trace['request']['selected_module'] != commit.selected_module
+                or trace['commit']['primitive'] != commit.primitive):
+            raise ValueError('ordered commit/selected-module provenance differs')
+        board = chess.Board(trace['commit']['before_fen']); move = chess.Move.from_uci(commit.primitive)
+        if board.turn != chess.WHITE or move not in board.legal_moves:
+            raise ValueError('recorded commit is not a legal actual White transition')
+        board.push(move)
+        _same((board.fen(), board.is_checkmate() and board.turn == chess.BLACK),
+              (trace['commit']['after_fen'], commit.immediate_mate), 'actual commit outcome')
+        for frame in pair:
+            module = frame.module_id
+            if (frame.request_id != request or frame.white_ordinal != ordinal
+                    or frame.permissions != pre['permissions'][module]
+                    or frame.structure_version != pre['versions'][module]
+                    or frame.local.event_id != pre['event_base'][module] + pre['request_counter'] + ordinal - 1):
+                raise ValueError('frame identity/version/permission differs')
+            _derive_invocation(models[module], module, trace, frame, frame.permissions)
+    queued = []; participating = tuple(dict.fromkeys(frame.module_id for frame in frames if frame.permissions.update))
+    for frame, credit in zip(frames, credits):
+        module = frame.module_id; model = models[module]; f = model.f; local = frame.local; owner = local.owner
+        expected_target = 'own_immediate_mate.v1' if module == 'm1' else 'remaining_episode_mate.v1'
+        if frame.target_name != expected_target: raise ValueError('module feedback target differs')
+        immediate = module == 'm1'
+        reward = 1.0 if (commits[frame.white_ordinal - 1].immediate_mate if immediate else result['eventual_mate']) else -1.0
+        multiplier = 1.0 if immediate else f['config'].eligibility_decay ** (commits[-1].white_ordinal - frame.white_ordinal)
+        n = len(local.active)
+        if not n or f['leaves'][owner].bias_id not in local.active: raise ValueError('active bias/denominator missing')
+        delta = (f['config'].learning_rate * (reward - local.prediction) / n if multiplier == 1.0
+                 else f['config'].learning_rate * multiplier * (reward - local.prediction) / n)
+        expected = (module, frame.request_id, frame.white_ordinal, (module, owner),
+                    tuple((module, cid) for cid in local.active), local.prediction, reward, multiplier,
+                    n, delta, delta if frame.permissions.update else 0.0, frame.permissions.update)
+        actual = tuple(getattr(credit, key) for key in ('module_id', 'request_id', 'white_ordinal',
+            'owner_key', 'contributor_keys', 'prediction', 'reward', 'multiplier', 'denominator',
+            'ordinary_increment', 'increment', 'updated'))
+        _same(actual, expected, 'ordered credit arithmetic/provenance')
+        if not frame.permissions.update: continue
+        if local.event_id <= f['last_event']: raise ValueError('stale credit event')
+        for cid in local.active:
+            f['conditions'][cid].weight.fast += delta
+            _stats(f['conditions'][cid].stats, active=True, cycle=f['completed'], reward=reward)
+        for cid in f['leaves'][owner].contributions:
+            _stats(f['conditions'][cid].stats, active=False, cycle=f['completed'], reward=reward)
+        f['completed'] += 1
+        if f['completed'] % f['config'].consolidate_every == 0:
+            weight = f['conditions'][f['leaves'][owner].bias_id].weight
+            transfer = f['config'].consolidation_rate * weight.fast
+            weight.fast -= transfer; weight.slow += transfer
+        residual = reward - local.prediction
+        for index, enabled in enumerate(local.candidate_observations):
+            _split_add(f['owner_evidence'][owner].setdefault(index, SplitEvidence()), enabled, residual)
+        for ri, side in enumerate(local.candidate_observations):
+            for ai, enabled in enumerate(local.action_reader_observations):
+                evidence = f['action_bud_evidence'][owner].setdefault((ri, ai), RouteActionEvidence())
+                key = bool(side), bool(enabled); evidence.counts[key] = evidence.counts.get(key, 0) + 1
+                evidence.sums[key] = evidence.sums.get(key, 0.0) + residual
+                evidence.variable += bool(local.action_reader_variable[ai])
+        for cid in local.refinement_active:
+            for index, side in enumerate(local.candidate_observations):
+                _split_add(f['refinement_evidence'][cid].setdefault(index, SplitEvidence()), side, residual)
+            nomination = f['prospective_nominations'].get(cid)
+            if nomination is not None:
+                _split_add(nomination.validation, local.candidate_observations[nomination.index], residual)
+            else:
+                f['prospective_started'].setdefault(cid, f['owner_visits'][owner])
+                evidence = f['prospective_discovery'].setdefault(cid, {})
