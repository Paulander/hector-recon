+"""Complete-feedback episodic adapter for the selective refinement learner.
+
+The owner/refinement stack was intentionally written around one actual action
+per feedback receipt.  M2 exercises submit more than one White action before
+the environment can report a terminal result.  This adapter carries the
+existing action-time bookkeeping across that interval and reuses the existing
+selected-action credit law once the final scalar feedback arrives.
+
+There is no opponent state, pseudo-reward, alternative-action label, or second
+graph.  Each frame stores the formal observations produced while its own
+action was selected.  At receipt time those frozen frames are replayed oldest
+first through the inherited observer; only the weight delta receives the
+eligibility multiplier.  Development is queued while the frames are being
+credited and serviced after the complete episode.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import copy
+import math
+from typing import Any
+
+from recon_lite.graph import NodeState
+
+from .recursive_context import RecursiveDevelopment
+from .refining_route_action import ProspectiveRefiningRouteActionDevelopment
+from .terminal_development import TerminalDevelopment
+
+
+@dataclass(frozen=True)
+class EpisodicActionFrame:
+    """Immutable action-time receipt data for one actual selected action.
+
+    The fields are intentionally generic: ``action`` is an opaque actuator
+    binding, observations are formal terminal confirmations, and ``active``
+    contains the owned condition identities that participated in the score.
+    No board or task-specific object is retained here.
+
+    ``weight_credit_mask`` is absent for ordinary credit. In the opt-in mode
+    it is aligned with ``active``: bias and action-varying contributors are
+    True, action-invariant nonbias contributors False. The complete active
+    tuple still defines prediction, credit normalization and participation.
+    """
+
+    event_id: Any
+    action: Any
+    prediction: float
+    active: tuple[int, ...]
+    refinement_active: tuple[int, ...]
+    owner: int
+    candidate_observations: tuple[bool, ...]
+    action_reader_observations: tuple[bool, ...]
+    action_reader_variable: tuple[bool, ...]
+    birth_observations: tuple[bool, ...]
+    weight_credit_mask: tuple[bool, ...] | None = None
+
+
+@dataclass(frozen=True)
+class _FrameFeedback:
+    """Small generic feedback value used while replaying saved frames."""
+
+    event_id: Any
+    action: Any
+    reward: float
+
+
+class EpisodicSelectiveDevelopment(ProspectiveRefiningRouteActionDevelopment):
+    """Existing prospective learner with complete-episode selected-action credit.
+
+    ``from_actor`` accepts an initialized prospective actor and copies its
+    graph, trainable weights, histories and RNG streams without rebuilding the
+    graph.  It also accepts the empty ``RecursiveDevelopment`` source used by
+    the inherited ``create`` convenience constructor.  In the latter case
+    normal fresh construction is delegated to the existing conversion stack.
+    An episode is bounded to ``max_episode_actions`` actual actions (two by
+    default, matching the M2 exercise). ``action_invariant_credit`` defaults
+    off; enabling it filters only nonbias fast increments using each frozen
+    frame's native composite activations across that frame's legal options.
+    """
+
+    @classmethod
+    def from_actor(cls, source, *, max_episode_actions=2,
+                   action_invariant_credit=False, **kwargs):
+        if type(max_episode_actions) is not int or max_episode_actions < 1:
+            raise ValueError("max_episode_actions must be a positive integer")
+        if type(action_invariant_credit) is not bool:
+            raise ValueError("action_invariant_credit must be a Boolean")
+        # FreshOwnerDevelopment.create creates this exact empty recursive source
+        # before calling the classmethod.  Let the established conversion path
+        # initialize owner/birth/prospective state for a new actor.
+        if type(source) is RecursiveDevelopment:
+            actor = super().from_actor(source, **kwargs)
+            if actor.development_config.split_enabled:
+                raise ValueError(
+                    "episodic conversion requires split_enabled=False")
+            cls._initialize_episode_state(actor, episode_count=0,
+                                          max_episode_actions=max_episode_actions,
+                                          action_invariant_credit=action_invariant_credit)
+            return actor
+
+        if not isinstance(source, ProspectiveRefiningRouteActionDevelopment):
+            raise ValueError(
+                "episodic conversion requires an initialized prospective actor")
+        if kwargs:
+            raise TypeError(
+                "initialized episodic conversion does not accept construction options")
+        development_config = getattr(source, "development_config", None)
+        if (development_config is not None
+                and development_config.split_enabled):
+            raise ValueError(
+                "episodic conversion requires split_enabled=False")
+        source_embodiment = getattr(source, "embodiment", None)
+        cls._require_completed_source(source)
+        actor = cls.__new__(cls)
+        # A deepcopy preserves edge-to-weight identity within the copied graph,
+        # while keeping the source graph and all source RNG streams untouched.
+        actor.__dict__ = copy.deepcopy(source.__dict__)
+        if source_embodiment is not None:
+            actor.embodiment = source_embodiment
+        cls._initialize_episode_state(
+            actor,
+            episode_count=getattr(source, "episodes_completed", 0),
+            max_episode_actions=max_episode_actions,
+            action_invariant_credit=action_invariant_credit,
+            preserve_history=True,
+        )
+        return actor
+
+    @staticmethod
+    def _require_completed_source(source):
+        transient = (
+            "pending", "context_pending", "owner_pending", "candidate_pending",
+            "action_bud_pending", "birth_search_pending",
+            "deferred_development", "_episodic_frames",
+            "_episode_development_queue", "_episode_started",
+        )
+        for name in transient:
+            value = getattr(source, name, None)
+            if name in ("pending", "_episode_started"):
+                active = bool(value)
+            else:
+                active = value is not None and value != []
+            if active:
+                raise RuntimeError("conversion requires completed episode feedback")
+
+    @staticmethod
+    def _initialize_episode_state(actor, *, episode_count=0,
+                                  max_episode_actions=2,
+                                  action_invariant_credit=False,
+                                  preserve_history=False):
+        if not preserve_history or not hasattr(actor, "last_episode_frames"):
+            actor.last_episode_frames = ()
+        if not preserve_history or not hasattr(actor, "episodes_completed"):
+            actor.episodes_completed = int(episode_count)
+        actor._episodic_frames = []
+        actor._episode_started = False
+        actor._episode_acting = False
+        actor._episode_crediting = False
+        actor._episode_multi_crediting = False
+        actor._episode_development_queue = []
+        actor._episodic_credit_multiplier = 1.0
+        actor.action_invariant_credit = action_invariant_credit
+        actor._action_invariant_credit_pending = None
+        actor.max_episode_actions = max_episode_actions
+        if not preserve_history or not hasattr(actor, "episode_development_history"):
+            actor.episode_development_history = []
+
+    @property
+    def episode_count(self):
+        """Number of complete environment episodes (distinct from ``completed``)."""
+        return self.episodes_completed
+
+    @property
+    def pending_episode(self):
+        return self._episode_started
+
+    @property
+    def episode_frames(self):
+        """Frozen frames for the currently pending episode, oldest first.
+
+        The final live frame is read from the inherited pending fields, so this
+        property is useful immediately after every ``act`` call.  It becomes
+        empty after a valid final receipt; ``last_episode_frames`` retains the
+        just-completed trace for a runner that records it after ``observe``.
+        """
+        frames = list(self._episodic_frames)
+        if self.pending:
+            frames.append(self._current_frame())
+        return tuple(frames)
+
+    @property
+    def development_queue(self):
+        return tuple(dict(record) for record in self._episode_development_queue)
+
+    def __getstate__(self):
+        if ((self._episode_started or self._episodic_frames or self.pending)
+                and not self._episode_crediting):
+            raise RuntimeError("checkpoint requires completed episode feedback")
+        return super().__getstate__()
+
+    def _weight_credit_multiplier(self):
+        # ContextDecisionDevelopment applies this only to the SUR weight delta.
+        # A default of one preserves exact predecessor single-action arithmetic.
+        return self._episodic_credit_multiplier
+
+    def _before_execute(self, engine, env, *, event_id, slot, prediction, learn):
+        super()._before_execute(engine, env, event_id=event_id, slot=slot,
+                                prediction=prediction, learn=learn)
+        if not learn or not getattr(self, "action_invariant_credit", False):
+            return
+        # These are the ACTUAL compiled scorer gates, including complete
+        # composite predicates and owner/context gating. Atomic-reader
+        # variability, expression metadata, and later boards are not substitutes.
+        # Choice has already settled all current legal options; no new reader
+        # request, environment query, RNG draw or formal execution is needed.
+        owner = self.owner_pending[2]
+        leaf = self.leaves[owner]
+        active = tuple(cid for cid in self.conditions
+                       if self.graph.nodes[f"gate:{slot}:{cid}"].state
+                       == NodeState.CONFIRMED)
+        if leaf.bias_id not in active or not set(active) <= set(leaf.contributions):
+            raise RuntimeError("action-time mask crossed decision ownership")
+        mask = []
+        for cid in active:
+            states = tuple(self.graph.nodes[f"gate:{binding_slot}:{cid}"].state
+                           for binding_slot in range(len(env["bindings"])))
+            if any(state not in (NodeState.CONFIRMED, NodeState.FAILED)
+                   for state in states):
+                raise RuntimeError("action-time composite gates did not settle")
+            mask.append(cid == leaf.bias_id or len(set(states)) > 1)
+        self._action_invariant_credit_pending = (
+            event_id, env["bindings"][slot], owner, active, tuple(mask))
+
+    def _weight_credit_mask(self, owner, active):
+        if not getattr(self, "action_invariant_credit", False):
+            return None
+        snapshot = getattr(self, "_action_invariant_credit_pending", None)
+        if (snapshot is None or not self.pending
+                or snapshot[:2] != self.pending[-1][:2]
+                or snapshot[2] != owner or snapshot[3] != tuple(active)):
+            raise RuntimeError("missing or stale action-time weight credit mask")
+        return snapshot[4]
+
+    def _assert_episode_mutation_allowed(self):
+        if (getattr(self, "_episode_started", False)
+                or getattr(self, "_episodic_frames", [])
+                or getattr(self, "pending", [])) and not (
+                getattr(self, "_episode_acting", False)
+                or getattr(self, "_episode_crediting", False)):
+            raise RuntimeError("mutation requires completed episode feedback")
+
+    def _ensure_slots(self, count):
+        self._assert_episode_mutation_allowed()
+        return super()._ensure_slots(count)
+
+    def _rebuild(self, slots):
+        self._assert_episode_mutation_allowed()
+        return super()._rebuild(slots)
+
+    def split_decision(self, owner, route):
+        self._assert_episode_mutation_allowed()
+        return super().split_decision(owner, route)
+
+    def _refine_local(self, owner, cid, predicate, *, evidence_score=None):
+        self._assert_episode_mutation_allowed()
+        return super()._refine_local(owner, cid, predicate,
+                                      evidence_score=evidence_score)
+
+    def _reclose_local(self, owner, split):
+        self._assert_episode_mutation_allowed()
+        return super()._reclose_local(owner, split)
+
+    def _run_development(self, owner):
+        self._assert_episode_mutation_allowed()
+        return super()._run_development(owner)
+
+    def _develop_owner(self, owner):
+        self._assert_episode_mutation_allowed()
+        if self._episode_multi_crediting:
+            self._episode_development_queue.append({
+                "owner": owner,
+                "scheduled_completed": self.completed,
+                "scheduled_owner_visits": self.owner_visits[owner],
+            })
+            return None
+        # This is the inherited BirthSearchOwnerDevelopment deferral path. It
+        # remains active for a one-action episode, preserving M1 exactly.
+        return super()._develop_owner(owner)
+
+    def _retire_local(self, owner):
+        self._assert_episode_mutation_allowed()
+        return super()._retire_local(owner)
+
+    def _birth_local(self, owner):
+        self._assert_episode_mutation_allowed()
+        return super()._birth_local(owner)
+
+    def _birth(self):
+        self._assert_episode_mutation_allowed()
+        return super()._birth()
+
+    def _prune(self):
+        self._assert_episode_mutation_allowed()
+        return super()._prune()
+
+    def _remove_contributions(self, identities, reason):
+        self._assert_episode_mutation_allowed()
+        return super()._remove_contributions(identities, reason)
+
+    def act(self, port, *, event_id, learn):
+        if self._episode_started and not learn:
+            raise RuntimeError("cannot evaluate during an unfinished episode")
+        if learn:
+            try:
+                stale = event_id <= self.last_event
+            except Exception as error:
+                raise ValueError("action event must increase; cannot duplicate credit") from error
+            if stale:
+                raise ValueError("action event must increase; cannot duplicate credit")
+            if (self._episode_started
+                    and len(self._episodic_frames) + bool(self.pending)
+                    >= self.max_episode_actions):
+                raise RuntimeError("episode action limit reached; submit final feedback")
+
+        old_frame = None
+        if learn and self.pending:
+            old_frame = self._current_frame()
+            self._episodic_frames.append(old_frame)
+            self._clear_live_pending()
+
+        self._episode_acting = True
+        try:
+            # This is FreshOwnerDevelopment.act with only its immediate-feedback
+            # guard removed.  Calling TerminalDevelopment directly avoids the
+            # RecursiveDevelopment prefix switch and keeps the existing matched
+            # exploration RNG stream unchanged.
+            birth_rng = self.rng
+            self.rng = self.exploration_rng
+            try:
+                action = TerminalDevelopment.act(self, port, event_id=event_id,
+                                                  learn=learn)
+            finally:
+                self.rng = birth_rng
+        except Exception:
+            # A failed later action must not discard the already submitted
+            # frames; restore the previous live frame so its final receipt can
+            # still be submitted or diagnosed by the caller.
+            if old_frame is not None:
+                if self._episodic_frames and self._episodic_frames[-1] == old_frame:
+                    self._episodic_frames.pop()
+                self._install_frame(old_frame)
+            raise
+        finally:
+            self._episode_acting = False
+
+        if learn:
+            self._episode_started = True
+        return action
+
+    def observe(self, feedback):
+        if not self._episode_started or not self.pending:
+            raise ValueError("outcome must bind to a pending episode")
+
+        frames = tuple(self._episodic_frames) + (self._current_frame(),)
+        reward = self._validate_complete_feedback(feedback, frames)
+        # Validate single-action receipts too: inherited evidence observers
+        # clear pending fields before weight credit, so a stale frame must be
+        # rejected before entering any of them. Valid M1 arithmetic and order
+        # are still exactly the predecessor's observer path below.
+        self._validate_frames(frames)
+
+        # With one live frame, use the predecessor observer byte-for-byte in
+        # its action/evidence/counter/growth order.  This is the M1 equivalence
+        # path; no episodic queue is introduced for a one-action episode.
+        if not self._episodic_frames:
+            frame = frames[0]
+            self._episode_crediting = True
+            try:
+                result = super().observe(feedback)
+            except Exception:
+                raise
+            else:
+                self.last_episode_frames = (frame,)
+                self._action_invariant_credit_pending = None
+                self._episode_started = False
+                self.episodes_completed += 1
+                return result
+            finally:
+                self._episode_crediting = False
+                self._episodic_credit_multiplier = 1.0
+
+        # All validation occurs before installing/replaying any frame.  Invalid,
+        # stale and nonfinite receipts therefore cannot partially credit a trace.
+        decay = self.config.eligibility_decay
+        start_completed = self.completed
+        self._episode_crediting = True
+        self._episode_multi_crediting = True
+        self._episode_development_queue = []
+        try:
+            for index, frame in enumerate(frames):
+                self._install_frame(frame)
+                self._episodic_credit_multiplier = decay ** (len(frames) - 1 - index)
+                super().observe(_FrameFeedback(frame.event_id, frame.action, reward))
+        finally:
+            self._episodic_credit_multiplier = 1.0
+            self._episode_multi_crediting = False
+            self._episode_crediting = False
+
+        # Every frame is now credited.  Close the episode before servicing any
+        # queued lifecycle opportunity, so no external mutation/checkpoint can
+        # observe a half-credited trace and no newly born proposal can use an
+        # earlier receipt from this same episode as validation.
+        queued = tuple(self._episode_development_queue)
+        self.last_episode_frames = frames
+        self._clear_live_pending()
+        self._episodic_frames.clear()
+        self._episode_started = False
+        self.episodes_completed += 1
+        self._episode_development_queue = []
+        self.episode_development_history.append({
+            "start_completed": start_completed,
+            "end_completed": self.completed,
+            "opportunities": [],
+        })
+        for record in queued:
+            owner = record["owner"]
+            self._run_development(owner)
+            self.episode_development_history[-1]["opportunities"].append({
+                **record,
+                "serviced_completed": self.completed,
+                "serviced_owner_visits": self.owner_visits[owner],
+            })
+        return None
+
+    def _current_frame(self):
+        if not self.pending:
+            raise RuntimeError("no live action frame")
+        if len(self.pending) != 1:
+            raise RuntimeError("an episode requires exactly one live action frame")
+        event_id, action, prediction, active = self.pending[-1]
+        owner_pending = self.owner_pending
+        candidate = self.candidate_pending
+        action_bud = self.action_bud_pending
+        birth = self.birth_search_pending
+        if (owner_pending is None or candidate is None or action_bud is None
+                or birth is None or len(action_bud) != 7):
+            raise RuntimeError("incomplete formal action frame")
+        if (owner_pending[:2] != (event_id, action)
+                or candidate[:3] != (event_id, action, owner_pending[2])
+                or birth[:3] != (event_id, action, owner_pending[2])
+                or action_bud[:3] != (event_id, action, owner_pending[2])):
+            raise RuntimeError("formal action frame binding mismatch")
+        if candidate[3] != prediction or birth[3] != prediction:
+            raise RuntimeError("formal action frame prediction mismatch")
+        if action_bud[3] != candidate[4]:
+            raise RuntimeError("formal action frame observations mismatch")
+        credit_mask = self._weight_credit_mask(owner_pending[2], active)
+        return EpisodicActionFrame(
+            event_id, action, float(prediction), tuple(active),
+            tuple(action_bud[6]), owner_pending[2],
+            tuple(candidate[4]), tuple(action_bud[4]), tuple(action_bud[5]),
+            tuple(birth[4]),
+            credit_mask,
+        )
+
+    def _clear_live_pending(self):
+        self.pending.clear()
+        self.owner_pending = None
+        self.candidate_pending = None
+        self.action_bud_pending = None
+        self.birth_search_pending = None
+        self.deferred_development = None
+        self._action_invariant_credit_pending = None
+
+    def _install_frame(self, frame):
+        self.pending = [(frame.event_id, frame.action, frame.prediction, frame.active)]
+        self.owner_pending = (frame.event_id, frame.action, frame.owner)
+        self.candidate_pending = (
+            frame.event_id, frame.action, frame.owner, frame.prediction,
+            frame.candidate_observations,
+        )
+        self.action_bud_pending = (
+            frame.event_id, frame.action, frame.owner,
+            frame.candidate_observations, frame.action_reader_observations,
+            frame.action_reader_variable, frame.refinement_active,
+        )
+        self.birth_search_pending = (
+            frame.event_id, frame.action, frame.owner, frame.prediction,
+            frame.birth_observations,
+        )
+        self.deferred_development = None
+        mask = getattr(frame, "weight_credit_mask", None)
+        self._action_invariant_credit_pending = (
+            frame.event_id, frame.action, frame.owner, tuple(frame.active), mask
+        ) if mask is not None else None
+
+    def _validate_complete_feedback(self, feedback, frames):
+        try:
+            event_id = feedback.event_id
+            action = feedback.action
+            reward = float(feedback.reward)
+        except (AttributeError, TypeError, ValueError, OverflowError) as error:
+            raise ValueError("complete feedback must contain a finite scalar reward") from error
+        if not math.isfinite(reward):
+            raise ValueError("reward must be finite")
+        if (event_id, action) != (frames[-1].event_id, frames[-1].action):
+            raise ValueError("outcome must bind to the final actual action")
+        return reward
+
+    def _validate_frames(self, frames):
+        if not frames:
+            raise ValueError("an episode requires at least one actual action")
+        for previous, current in zip(frames, frames[1:]):
+            try:
+                ordered = current.event_id > previous.event_id
+            except Exception as error:
+                raise ValueError("episode action events must be strictly increasing") from error
+            if not ordered:
+                raise ValueError("episode action events must be strictly increasing")
+        for frame in frames:
+            if not math.isfinite(frame.prediction):
+                raise ValueError("action prediction must be finite")
+            if not isinstance(frame.owner, int) or frame.owner not in self.leaves:
+                raise ValueError("action frame owner is stale")
+            leaf = self.leaves[frame.owner]
+            if (not frame.active or len(set(frame.active)) != len(frame.active)
+                    or leaf.bias_id not in frame.active
