+def neutral(inputs, seed, output):
+    """The fixed declared64episode nonstudy fixture; never task feedback."""
+    output = Path(output)
+    output.mkdir(parents=True, exist_ok=False)
+    identity = f'm2-readiness-nonstudy-neutral-v1:{seed}'
+    started, cpu = time.perf_counter(), time.process_time()
+    state = initialize(inputs, seed, identity)
+    preparation = time.perf_counter() - started
+    boards = _training_boards(inputs)[:16]
+    checkpoints, timings = [], []
+    def checkpoint():
+        path = output / f'checkpoint-{state.episodes:04d}.pkl.gz'
+        start = time.perf_counter()
+        record = save(path, state, metadata={'mode': 'neutral', 'identity': identity})
+        timings.append({'phase': 'checkpoint', 'seconds': time.perf_counter() - start})
+        checkpoints.append(record)
+        return path, record
+    checkpoint()
+    with gzip.open(output / 'episodes.jsonl.gz', 'wt') as stream:
+        for index in range(64):
+            fens = [boards[(2 * index + offset) % len(boards)] for offset in (0, 1)]
+            row, seconds = perform(state, kind='neutral', fens=fens, reward=(1., -1., -1., 1.)[index % 4])
+            stream.write(json_bytes(row).decode() + '\n')
+            stream.flush()
+            timings.append({'phase': 'episode', 'episode': index + 1, 'seconds': seconds,
+                            'boundary': bool(state.actor.episode_development_history and
+                                state.actor.episode_development_history[-1]['opportunities'])})
+            if state.episodes in (32, 64):
+                path, record = checkpoint()
+                if state.episodes == 32:
+                    state = load(path, expected_sha256=record['sha256'])
+    verify_source(state.source)
+    result = dict(status='PASS', mode='neutral', identity=identity, lineage=state.lineage,
+        source=state.source, runtime=runtime(), episodes=64, selected_actions=128,
+        scientific_m2_actions=0, task_outcome_queries=0, cold_at_episode=32,
+        neutral_boards=list(boards), neutral_reward_cycle=[1., -1., -1., 1.],
+        checkpoints=checkpoints, receipt_sha256=sha(output / 'episodes.jsonl.gz'),
+        preparation_seconds=preparation, wall_seconds=time.perf_counter() - started,
+        cpu_seconds=time.process_time() - cpu, timings=timings,
+        final_state_sha256=digest(state), topology={'nodes': len(state.actor.graph.nodes),
+        'edges': len(state.actor.graph.edges), 'contributors': len(state.actor.conditions),
+        'definitions': len(state.actor.expression_ids)})
+    write_json(output / 'RESULT.json', result)
+    return result
