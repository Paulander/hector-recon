index 0000000..1791d55
--- /dev/null
+++ b/src/recon_lite_chess/coach/mate_two.py
@@ -0,0 +1,214 @@
+"""Two White actions, one actor, and only the actually played terminal reward.
+
+The opponent sees the committed board only. Its private exact defence search is
+not a feature or a White move label. The default chooses the first UCI-sorted
+reply preventing immediate mate, or the first reply if every reply permits mate.
+This deterministic exposure rule does not establish all-reply competence.
+
+Action scores are predictions trained toward the terminal return of the current
+exercise. At the first action the remaining budget is two White actions; at the
+finish it is one. No horizon coordinate is supplied, so a score is neither an
+automatic one-move competence probability nor a learned child-availability claim.
+"""
+
+from dataclasses import asdict, dataclass
+import pickle
+
+import chess
+
+from recon_lite_chess.autogrowth.mate_horizon_opponent import choose_mate_horizon_reply
+from .exercise import Attempt
+from .interface import Feedback
+from .m2_schema import chess_feature_port
+
+
+@dataclass(frozen=True)
+class WhiteAction:
+    event_id: int
+    before_fen: str
+    action: str | None
+    after_fen: str
+
+
+@dataclass(frozen=True)
+class MateTwoAttempt:
+    fen: str
+    white_actions: tuple[WhiteAction, ...]
+    black_actions: tuple[str, ...]
+    after_fen: str
+    reward: float
+    reason: str
+
+
+def _start(fen, *, claim_draw=True):
+    board = chess.Board(fen)
+    material = sorted((p.piece_type, p.color) for p in board.piece_map().values())
+    expected = sorted(((chess.KING, True), (chess.ROOK, True), (chess.KING, False)))
+    if (material != expected or not board.is_valid() or board.turn != chess.WHITE
+            or board.is_game_over(claim_draw=claim_draw)):
+        raise ValueError("a live legal White-to-move KRK exercise is required")
+    return board
+
+
+class _FirstScorePort:
+    """Evaluation-only passive score tap at the actual actuator boundary."""
+    def __init__(self, port, actor, output):
+        self.port, self.actor, self.output = port, actor, output
+        self.schema = port.schema
+
+    def __getattr__(self, name):
+        return getattr(self.port, name)
+
+    def execute(self, binding):
+        self.output['native_scores'] = [
+            [name, self.actor.graph.nodes[f'option:{i}'].activation.value.hex()]
+            for i, name in enumerate(self.port.bindings())]
+        return self.port.execute(binding)
+
+
+def _white_action(actor, board, event_id, learn, score_record=None):
+    before = board.fen()
+    port = chess_feature_port(actor, board)
+    if score_record is not None:
+        if learn:
+            raise ValueError('evaluation score tap cannot be used for training')
+        port = _FirstScorePort(port, actor, score_record)
+    action = actor.act(port, event_id=event_id, learn=learn)
+    if action != port.executed:
+        raise RuntimeError("White action must be executed through its actuator terminal")
+    return WhiteAction(event_id, before, action, board.fen())
+
+
+def _terminal(board):
+    if board.is_checkmate():
+        return ("checkmate", 1.0) if board.turn == chess.BLACK else ("lost", -1.0)
+    if board.is_game_over(claim_draw=True):
+        return "draw", -1.0
+    return None
+
+
+def play_mate_one_rehearsal(actor, fen, *, event_id, learn):
+    """The ordinary M1 one-action contract under the actor's explicit schema.
+
+    This keeps the existing M1 timeout/stalemate distinction and automatic-draw
+    start check. It permits M1 rehearsal by a migrated actor without changing
+    the legacy exercise's default sixteen-coordinate embodiment.
+    """
+    board = _start(fen, claim_draw=False)
+    action = _white_action(actor, board, event_id, learn)
+    moved = int(action.action is not None)
+    reason = ("no_action" if not moved else "checkmate" if board.is_checkmate()
+              else "stalemate" if board.is_stalemate() else "exercise_timeout")
+    reward = 1.0 if reason == "checkmate" else -1.0
+    if learn:
+        actor.observe(Feedback(event_id, action.action, reward))
+    return Attempt(event_id, fen, action.action, board.fen(), reward, reason, moved)
+
+
+def play_mate_two(actor, fen, *, start_event, learn,
+                  opponent=choose_mate_horizon_reply):
+    """Execute one real episode; credit both saved White frames at its end.
+
+    An ordinary first move has no immediate reward. Black's reply adds no learner
+    action/event. Exactly one final receipt, owned by the last actual White
+    action, lets the episodic adapter credit the saved frames oldest first.
+    Invalid opponent/actuator failures leave pending frames uncredited for review.
+    FEN supplies clocks but no preceding repetition history; claims available on
+    the supplied board or on its actual continuation terminate this exercise.
+    """
+    if type(start_event) is not int or start_event < 0:
+        raise ValueError("nonnegative action event required")
+    board = _start(fen)
+    white, black = [], []
+    outcome = None
+    for index in range(2):
+        step = _white_action(actor, board, start_event + index, learn)
+        white.append(step)
+        if step.action is None:
+            outcome = "no_action", -1.0
+            break
+        outcome = _terminal(board)
+        if outcome is not None or index == 1:
+            break
+        # Only the committed board reaches the opponent, never actor internals.
+        reply = opponent(board.copy(stack=True))
+        if not isinstance(reply, chess.Move) or reply not in board.legal_moves:
+            raise ValueError("opponent must return a legal Black move")
+        board.push(reply)
+        black.append(reply.uci())
+        outcome = _terminal(board)
+        if outcome is not None:
+            break
+    reason, reward = outcome or ("exercise_timeout", -1.0)
+    if learn:
+        actor.observe(Feedback(white[-1].event_id, white[-1].action, reward))
+    return MateTwoAttempt(fen, tuple(white), tuple(black), board.fen(), reward, reason)
+
+
+def evaluate_all_replies(actor, fens, *, previous=None, reply_order="uci",
+                         record_first_scores=False):
+    """Read-only exhaustive evaluation of the actor's actual finishing choices.
+
+    Each position starts from the identical input actor state. Its first action
+    is chosen once; every reply starts from an identical serialization taken
+    AFTER that choice. This preserves any action-local state, RNG progression or
+    dynamic binding slots while preventing one branch from influencing another.
+    Evaluation clones receive ``learn=False`` and never receive ``observe``.
+    No clone or feedback object escapes; all results are laboratory records.
+
+    ``reverse_uci`` changes execution order for an isolation audit; returned
+    reply records remain canonically sorted. Events 0/1 are local diagnostic
+    identities, independent of position order, and are not training receipts.
+    Completed-episode serialization is required, so evaluation cannot borrow an
+    outstanding training action's receipt ownership.
+    """
+    if reply_order not in ("uci", "reverse_uci"):
+        raise ValueError("reply_order must be uci or reverse_uci")
+    if getattr(actor, "pending_episode", False) or getattr(actor, "pending", None):
+        raise RuntimeError("evaluation requires completed episode feedback")
+    baseline = pickle.dumps(actor, protocol=pickle.HIGHEST_PROTOCOL)
+    rows = []
+    for fen in fens:
+        learner = pickle.loads(baseline)
+        board = _start(fen)
+        score_record = {} if record_first_scores else None
+        first = _white_action(learner, board, 0, False, score_record)
+        terminal = _terminal(board) if first.action is not None else ("no_action", -1.0)
+        replies = []
+        if terminal is None:
+            after_first = pickle.dumps(learner, protocol=pickle.HIGHEST_PROTOCOL)
+            ordered = sorted(board.legal_moves, key=lambda move: move.uci(),
+                             reverse=reply_order == "reverse_uci")
+            for reply in ordered:
+                branch_actor = pickle.loads(after_first)
+                successor = board.copy(stack=True)
+                successor.push(reply)
+                end = _terminal(successor)
+                finish = None
+                if end is None:
+                    finish = _white_action(branch_actor, successor, 1, False)
+                    end = (_terminal(successor) if finish.action is not None
+                           else ("no_action", -1.0))
+                reason, reward = end or ("exercise_timeout", -1.0)
+                replies.append({"black_action": reply.uci(),
+                                "finish": asdict(finish) if finish else None,
+                                "after_fen": successor.fen(), "reason": reason,
+                                "mate": reward > 0})
+            replies.sort(key=lambda row: row["black_action"])
+        success = (terminal[1] > 0 if terminal else
+                   bool(replies) and all(row["mate"] for row in replies))
+        rows.append({"fen": fen, "first": asdict(first), "replies": replies,
+                     "all_reply_mate": success,
+                     "first_terminal": terminal[0] if terminal else None})
+        if record_first_scores:
+            rows[-1]['setup_native_scores'] = score_record['native_scores']
+    successes = {row["fen"] for row in rows if row["all_reply_mate"]}
+    old = ({row["fen"] for row in previous["rows"] if row["all_reply_mate"]}
+           if previous is not None else None)
+    return {"positions": len(rows),
+            "all_reply_mates": sum(row["all_reply_mate"] for row in rows),
+            "black_replies": sum(len(row["replies"]) for row in rows),
+            "mating_finishes": sum(reply["mate"] for row in rows for reply in row["replies"]),
+            "gains": None if old is None else len(successes - old),
+            "losses": None if old is None else len(old - successes),
+            "learning": False, "training_receipts": 0, "rows": rows}
