+@dataclass
+class EpisodeState:
+    actor: EpisodicSelectiveDevelopment
+    identity: str
+    lineage: dict
+    source: dict
+    next_event: int = 3072
+    episodes: int = 0
+    credited_white_actions: int = 0
+    schedule_rng: random.Random = field(default_factory=random.Random)
+    orders: dict = field(default_factory=dict)
+    cursors: dict = field(default_factory=dict)
+    exercise_identity: str | None = None
+    credit_arm: str | None = None
+
+    def position(self, label, fens):
+        if self.cursors.get(label, 0) >= len(self.orders.get(label, ())):
+            self.orders[label] = list(range(len(fens)))
+            self.schedule_rng.shuffle(self.orders[label])
+            self.cursors[label] = 0
+        index = self.orders[label][self.cursors[label]]
+        self.cursors[label] += 1
+        return fens[index]
+
+
+def initialize(inputs, seed, identity, *, exercise_identity=None,
+               action_invariant_credit=False, credit_arm=None):
+    inputs = Path(inputs)
+    manifest = json.loads((inputs / 'INPUTS.json').read_text())
+    lineage = next(x for x in manifest['lineages'] if x['seed'] == seed)
+    original = load_m1(inputs / lineage['file'], expected_sha256=lineage['sha256'],
+                       expected_state_sha256=lineage['state_sha256'], seed=seed)
+    actor = migrate_m1_schema(original.organism, source_checkpoint_sha256=lineage['sha256'],
+                              source_identity=f'accepted-native-m1:{seed}:3072')
+    actor = EpisodicSelectiveDevelopment.from_actor(
+        actor, action_invariant_credit=action_invariant_credit)
+    return EpisodeState(actor, identity, lineage, source_pins(), next_event=original.next_event,
+                        schedule_rng=random.Random('m2-position-order:' + (exercise_identity or identity)),
+                        exercise_identity=exercise_identity, credit_arm=credit_arm)
+
+
+def weights(actor):
+    return [[cid, c.weight.fast.hex(), c.weight.slow.hex()] for cid, c in actor.conditions.items()]
+
+
+def rngs(actor):
+    return {k: digest(v) for k, v in vars(actor).items() if isinstance(v, random.Random)}
+
+
+class TappedPort:
+    """Passively hashes ordered actual terminal accesses; returns them unchanged."""
+    def __init__(self, port, actor):
+        self.port, self.actor = port, actor
+        self.schema = port.schema
+        self.access = hashlib.sha256()
+        self.reads = 0
+        self.scores = None
+
+    @property
+    def executed(self):
+        return self.port.executed
+
+    def bindings(self):
+        result = self.port.bindings()
+        self.access.update(json_bytes(['bindings', result]))
+        return result
+
+    def measure(self, coordinate, binding):
+        result = self.port.measure(coordinate, binding)
+        self.access.update(json_bytes(['read', coordinate, binding, type(result).__name__, result]))
+        self.reads += 1
+        return result
+
+    def execute(self, binding):
+        bindings = self.port.bindings()
+        self.scores = [[name, self.actor.graph.nodes[f'option:{i}'].activation.value.hex()]
+                       for i, name in enumerate(bindings)]
+        self.access.update(json_bytes(['execute', binding]))
+        return self.port.execute(binding)
+
+
+class Recorder:
+    """Outside the actor. Records selected frames, never supplies an answer."""
+    def __init__(self, actor, expected=None):
+        self.actor, self.expected = actor, expected
+        self.actions = []
+        self.credit = None
+
+    def __getattr__(self, name):
+        return getattr(self.actor, name)
+
+    def act(self, port, *, event_id, learn):
+        tapped = TappedPort(port, self.actor)
+        action = self.actor.act(tapped, event_id=event_id, learn=learn)
+        frame = asdict(self.actor.episode_frames[-1]) if learn else None
+        record = {'event_id': event_id, 'action': action, 'frame': canonical(frame),
+                  'native_scores': tapped.scores, 'access_sha256': tapped.access.hexdigest(),
+                  'terminal_reads': tapped.reads}
+        if self.expected is not None:
+            index = len(self.actions)
+            if index >= len(self.expected['actions']) or record != self.expected['actions'][index]:
+                raise ValueError(f'generated native action/frame mismatch at event{event_id}')
+        self.actions.append(record)
+        return action
+
+    def observe(self, feedback):
+        if self.expected is not None and (feedback.reward != self.expected['reward']
+                or len(self.actions) != len(self.expected['actions'])):
+            raise ValueError('selected-outcome/episode binding mismatch before credit')
+        actor = self.actor
+        references = [(cid, c.weight) for cid, c in actor.conditions.items()]
+        frames = actor.episode_frames
+        compact_frames = [dict(event_id=f.event_id, action=f.action, owner=f.owner,
+            prediction=f.prediction.hex(), active=list(f.active),
+            bias=actor.leaves[f.owner].bias_id,
+            weight_credit_mask=(list(f.weight_credit_mask)
+                if getattr(f, 'weight_credit_mask', None) is not None else None)) for f in frames]
+        before = weights(actor)
+        old_counts = {key: len(getattr(actor, key)) for key in HISTORIES}
+        completed = actor.completed
+        actor.observe(feedback)
+        self.credit = dict(completed_before=completed, completed_after=actor.completed,
+            action_invariant_credit=getattr(actor, 'action_invariant_credit', False),
+            frames=compact_frames, weights_before=before,
+            weights_after_credit=[[cid, w.fast.hex(), w.slow.hex()] for cid, w in references],
+            weights_after_growth=weights(actor),
+            history_delta=canonical({key: getattr(actor, key)[old_counts[key]:] for key in HISTORIES}),
+            learning_rate=actor.config.learning_rate.hex(), decay=actor.config.eligibility_decay.hex(),
+            consolidate_every=actor.config.consolidate_every,
+            consolidation_rate=actor.config.consolidation_rate.hex())
+        if self.expected is not None and self.credit != self.expected['credit']:
+            raise ValueError('native credit/development receipt mismatch')
+
+
+def neutral_episode(recorder, fens, event, reward):
+    """Two independent terminal frames, not simulated M2 gameplay or outcomes."""
+    actions = []
+    for offset, fen in enumerate(fens):
+        board = chess.Board(fen)
+        port = chess_feature_port(recorder, board)
+        action = recorder.act(port, event_id=event + offset, learn=True)
+        if action != port.executed:
+            raise RuntimeError('native actuator mismatch')
+        actions.append({'event_id': event + offset, 'fen': fen, 'action': action, 'after_fen': board.fen()})
+    recorder.observe(Feedback(event + len(actions) - 1, actions[-1]['action'], reward))
+    return {'reason': 'neutral_scripted', 'reward': reward, 'frames': actions}
+
+
+def perform(state, *, kind, fens, reward=None, expected=None):
+    observer = Recorder(state.actor, expected)
+    before_rng = rngs(state.actor)
+    start = time.perf_counter()
+    if kind == 'neutral':
+        outcome = neutral_episode(observer, fens, state.next_event, reward)
+    elif kind == 'm1':
+        outcome = asdict(play_mate_one_rehearsal(observer, fens[0], event_id=state.next_event, learn=True))
+    elif kind == 'm2':
+        outcome = asdict(play_mate_two(observer, fens[0], start_event=state.next_event, learn=True))
+    else:
+        raise ValueError('unsupported exercise')
+    elapsed = time.perf_counter() - start
+    count = len(observer.actions)
+    state.next_event += count
+    state.credited_white_actions += count
+    state.episodes += 1
+    if state.actor.completed != state.next_event or state.actor.pending_episode:
+        raise ValueError('episode did not close in actual-action units')
+    record = dict(episode=state.episodes, kind=kind, fens=list(fens), reward=outcome['reward'],
+                  outcome=outcome, actions=observer.actions, credit=observer.credit,
+                  rng_before=before_rng, rng_after=rngs(state.actor))
+    if expected is not None and json_bytes(record) != json_bytes(expected):
+        raise ValueError('replayed episode/environment differs')
+    return record, elapsed
+
+
+def _training_boards(inputs):
+    path = Path(inputs) / 'M1_TRAIN.txt'
+    manifest = json.loads((Path(inputs) / 'INPUTS.json').read_text())
+    if sha(path) != manifest['training_sha256']:
+        raise ValueError('rehearsal input changed')
+    return tuple(path.read_text().splitlines())
+
