+class RejectedEvaluationBatch(RuntimeError):
+    pass
+
+
+def _json_copy(value):
+    # JSON is evidence output only.  Binary64 shortest-roundtrip encoding
+    # preserves float values; callers can supply canonical exact projections.
+    return json.loads(json.dumps(value, allow_nan=False, separators=(',', ':')))
+
+
+def _method_identity(value, name):
+    method = getattr(value, name)
+    return getattr(method, '__func__', method)
+
+
+class PendingEvaluationRecord:
+    """Revocable private-to-batch preview, never accepted evidence."""
+    def __init__(self, batch, index, generation):
+        self._batch, self.index, self._generation = batch, index, generation
+
+    @property
+    def status(self):
+        if (self._batch._generation != self._generation
+                or self._batch._batch_status == 'REJECTED'):
+            return 'REJECTED'
+        return 'UNACCEPTED'
+
+    def preview(self):
+        try:
+            if self.status != 'UNACCEPTED' or self._batch._batch_status != 'OPEN':
+                raise RejectedEvaluationBatch('pending record cannot be released as accepted evidence')
+            self._batch._validate_release_index(self.index)
+            return {'status': 'UNACCEPTED', 'private_to_batch': True, 'index': self.index,
+                    'value': _json_copy(self._batch._pending[self.index])}
+        except BaseException as error:
+            self._batch._poison(error)
+            raise
+
+    def __getstate__(self):
+        error = RuntimeError('pending evaluation handles are not serializable evidence')
+        self._batch._poison(error)
+        raise error
+
+
+class PendingEvaluationOperation:
+    """Lightweight operational token, not part of the evidence inventory.
+
+    No trace/outcome copy is added to the batch.  A preview is explicitly
+    private and UNACCEPTED; the guarded caller records its designated complete
+    evidence separately with record_pending.  Failed batches revoke this token.
+    """
+    def __init__(self, batch, operation, value, generation):
+        self._batch, self.operation, self._value = batch, operation, value
+        self._generation = generation
+
+    @property
+    def status(self):
+        if (self._batch._generation != self._generation
+                or self._batch._batch_status == 'REJECTED'):
+            return 'REJECTED'
+        return 'UNACCEPTED'
+
+    def preview(self):
+        try:
+            if self.status != 'UNACCEPTED' or self._batch._batch_status != 'OPEN':
+                raise RejectedEvaluationBatch('operational token is not accepted evidence')
+            if self.operation == 'native_commit':
+                value = {'kind': self.operation, 'commit': asdict(self._value)}
+            else:
+                value = {'kind': self.operation, 'outcome': canonical(self._value)}
+            return {'status': 'UNACCEPTED', 'private_to_batch': True,
+                    'operation': self.operation, 'value': _json_copy(value)}
+        except BaseException as error:
+            self._batch._poison(error)
+            raise
+
+    def __getstate__(self):
+        error = RuntimeError('operational tokens are not serializable evidence')
+        self._batch._poison(error)
+        raise error
+
+
+class AcceptedEvaluationBatch:
+    """Only this revocable handle releases the entire verified inventory."""
+    def __init__(self, batch, generation):
+        self._batch, self._generation = batch, generation
+
+    def _check(self):
+        if (self._batch._batch_status != 'ACCEPTED'
+                or self._batch._generation != self._generation
+                or self._batch._poisoned):
+            raise RejectedEvaluationBatch('accepted handle was invalidated')
+
+    def results(self):
+        return self._release(lambda: self._batch._pending)
+
+    def record(self, index):
+        def selected():
+            self._batch._validate_release_index(index)
+            return self._batch._pending[index]
+        return self._release(selected)
+
+    def inventory(self):
+        return self._release(lambda: self._batch._acceptance)
+
+    def _release(self, selected):
+        try:
+            self._check()
+            return _json_copy(selected())
+        except BaseException as error:
+            self._batch._poison(error)
+            raise
+
+    def __getstate__(self):
+        error = RuntimeError('serialize the verified inventory, not a live acceptance handle')
+        self._batch._poison(error)
+        raise error
+
