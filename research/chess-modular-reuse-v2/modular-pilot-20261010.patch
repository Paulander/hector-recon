+                if repeated.primitive !=first.primitive or canonical(branch.traces[-1]) !=canonical(first_trace):
+                    raise ValueError('repeated native first choice/trace differs across reply branches')
+                branch.authority.black_reply(reply)
+                terminal = _terminal_or_rook(branch_board)
+                finish_trace = None
+                if terminal is None:
+                    branch.decide_and_commit()
+                    finish_calls +=1
+                    finish_trace = copy.deepcopy(branch.traces[-1])
+                    terminal = _terminal_or_rook(branch_board)
+                reason,reward = terminal or ('exercise_timeout',-1.0)
+                replies.append({'black_action':reply.uci(),'mate':reward >0,
+                                'reason':reason,'finish_trace':finish_trace,
+                                'after_fen':branch_board.fen()})
+        all_reply = first_terminal[1] >0 if first_terminal else bool(replies) and all(row['mate'] for row in replies)
+        finish_traces = [row['finish_trace'] for row in replies]
+        m2_rows.append({'fen':fen,'orbit':orbit_key(chess.Board(fen)),
+            'all_reply_mate':all_reply,'first_trace':first_trace,
+            'first_terminal':None if first_terminal is None else first_terminal[0],
+            'replies':replies,'setup_first':_selected_module(first_trace) =='setup',
+            'm1_finish_every_reply':bool(finish_traces) and all(
+                trace is not None and _selected_module(trace) =='m1' for trace in finish_traces),
+            'first_request_margin':_request_margin(first_trace),
+            'finish_request_margins':[_request_margin(trace) for trace in finish_traces if trace is not None]})
+    if organism.state_digest() !=before:
+        raise ValueError('full census changed the scientific actor')
+    return {'standalone_m1_mates':sum(row['mate'] for row in standalone),
+            'parent_m1_mates':sum(row['mate'] for row in parent_one),
+            'standalone_m1_rows':standalone,'parent_m1_rows':parent_one,'m2_rows':m2_rows,
+            'standalone_m1_calls':1512,'parent_one_move_m1_calls':1512,
+            'm2_primary_and_repeated_first_calls':first_calls,'m2_finishing_calls':finish_calls,
+            'pending_persistence_used':False,'learning':False,'scientific_receipts':0}
