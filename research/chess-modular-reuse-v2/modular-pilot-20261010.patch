--- /dev/null
+++ b/src/recon_lite_chess/coach/modular_evaluation_isolation.py
@@ -0,0 +1,134 @@
+"""Offline persistent ownership proof across complete native object graphs.
+
+Cycles and immutable definition sharing are allowed. Nested mutable state is
+not. This is a supported-state reachability proof, not hostile-Python security;
+functions/classes/module globals are deliberately outside native ownership.
+"""
+from __future__ import annotations
+
+import array
+from dataclasses import fields, is_dataclass
+from enum import Enum
+import random
+import types
+import weakref
+
+
+class UnsupportedEvaluationOwnership(TypeError):
+    pass
+
+
+def mutable_reachable_ids(root, *, excluded=()):
+    """Cycle-safe mutable IDs, including attrs/slots and frozen-record fields.
+
+    ``excluded`` cuts only explicitly justified object references. The parent
+    evaluator passes its workspace itself to cut runtime.workspace's deliberate
+    back-reference; neither the entire source nor a source module is excluded.
+    """
+    blocked = {id(item) for item in excluded}
+    pending, seen, mutable = [root], set(), set()
+    while pending:
+        item = pending.pop()
+        if item is None or type(item) in (bool, int, float, complex, str, bytes):
+            continue
+        identity = id(item)
+        if identity in blocked or identity in seen:
+            continue
+        seen.add(identity)
+        if isinstance(item, (type, types.ModuleType,
+                             types.FunctionType, types.BuiltinFunctionType)):
+            # Never follow executable globals/closures into unrelated owners.
+            continue
+        if isinstance(item, types.MethodType):
+            pending.append(item.__self__)
+            continue
+        if isinstance(item, weakref.ReferenceType):
+            pending.append(item())
+            continue
+        if isinstance(item, Enum):
+            pending.append(item.value)
+            continue
+        if isinstance(item, random.Random):
+            if type(item) is not random.Random:
+                raise UnsupportedEvaluationOwnership('unsupported opaque Random subclass ownership')
+            mutable.add(identity)
+            pending.append(vars(item))
+            # The native RNG's internal state has scalar/tuple values, no
+            # separately aliased mutable ownership. The RNG itself is owned.
+            continue
+        if isinstance(item, (bytearray, array.array)):
+            mutable.add(identity)
+            attributes = getattr(item, '__dict__', None)
+            if attributes is not None:
+                pending.append(attributes)
+            continue
+        if isinstance(item, memoryview):
+            mutable.add(identity)
+            pending.append(item.obj)
+            continue
+        if any(cls.__module__ == 'numpy' and cls.__name__ == 'ndarray'
+               for cls in type(item).__mro__):
+            if not (type(item).__module__ == 'numpy' and type(item).__name__ == 'ndarray'):
+                raise UnsupportedEvaluationOwnership('unsupported opaque ndarray subclass ownership')
+            mutable.add(identity)
+            pending.append(item.base)
+            if item.dtype.hasobject:
+                pending.extend(item.flat)
+            continue
+        if isinstance(item, dict):
+            mutable.add(identity)
+            for key, value in item.items():
+                pending.extend((key, value))
+        elif isinstance(item, (list, set)):
+            mutable.add(identity)
+            pending.extend(item)
+        elif isinstance(item, (tuple, frozenset)):
+            pending.extend(item)
+        elif is_dataclass(item):
+            if not item.__dataclass_params__.frozen:
+                mutable.add(identity)
+            pending.extend(getattr(item, field.name) for field in fields(item))
+        else:
+            attributes = getattr(item, '__dict__', None)
+            slots = []
+            for cls in type(item).__mro__:
+                declared = cls.__dict__.get('__slots__', ())
+                if isinstance(declared, str):
+                    declared = (declared,)
+                for name in declared:
+                    if name in ('__dict__', '__weakref__'):
+                        continue
+                    if name.startswith('__') and not name.endswith('__'):
+                        name = '_' + cls.__name__.lstrip('_') + name
+                    slots.append(name)
+            if attributes is None and not slots:
+                raise UnsupportedEvaluationOwnership(
+                    'unsupported opaque ownership object: ' + type(item).__module__ + '.' + type(item).__qualname__)
+            mutable.add(identity)
+            if attributes is not None:
+                pending.append(attributes)
+            for name in slots:
+                if hasattr(item, name):
+                    pending.append(getattr(item, name))
+            continue
+        # Container/dataclass subclasses may have additional mutable attrs;
+        # frozen records are immutable shells, not a license to omit their data.
+        attributes = getattr(item, '__dict__', None)
+        if attributes is not None and not (is_dataclass(item) and item.__dataclass_params__.frozen):
+            pending.append(attributes)
+    return mutable
+
+
+def assert_no_source_alias(source, private, *, excluded=()):
+    """Reject any supported persistent source/private mutable intersection."""
+    source_ids = mutable_reachable_ids(source)
+    private_ids = mutable_reachable_ids(private, excluded=excluded)
+    shared = source_ids & private_ids
+    if shared:
+        raise ValueError('persistent source/private mutable alias detected (' + str(len(shared)) + ' objects)')
+    return {'source_mutable_objects': len(source_ids),
+            'private_mutable_objects': len(private_ids), 'shared_mutable_objects': 0,
+            'excluded_private_references': len({id(item) for item in excluded})}
+
+
+__all__ = ['assert_no_source_alias', 'mutable_reachable_ids', 'UnsupportedEvaluationOwnership']
diff --git a/src/recon_lite_chess/coach/modular_evaluation_m1_batch.py b/src/recon_lite_chess/coach/modular_evaluation_m1_batch.py
