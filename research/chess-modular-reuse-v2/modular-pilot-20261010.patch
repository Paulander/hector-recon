+def _derive_invocation(model, module, trace, frame, permission):
+    """Derive sensors, Boolean confirmations, scores, choice and exploration RNG."""
+    f = model.f; board = chess.Board(trace['commit']['before_fen'])
+    bindings = ('connection:0', 'connection:1') if module == 'parent' else tuple(sorted(move.uci() for move in board.legal_moves))
+    selected = trace['selection'][module]
+    _same(tuple(selected['bindings']), bindings, module + ' complete legal binding order')
+    model.physical(max(model.slots, len(bindings)))
+    readings = [dict(enumerate(measurements(board, binding, module))) for binding in bindings]
+    owners = []
+    active_rows = []
+    for row in readings:
+        matches = [owner for owner, leaf in f['leaves'].items() if _expression(leaf.path, row, f['schema'])]
+        if len(matches) != 1: raise ValueError('independent owner must be unique')
+        owners.append(matches[0]); active_rows.append(tuple(cid for cid in f['conditions'] if _expression(f['expressions'][cid], row, f['schema'])))
+    if len(set(owners)) != 1: raise ValueError('owner varies over action menu')
