+"""Opt-in native request calls on one composed formal graph.
+
+Local learner graphs remain views of their original nodes and weights. Global
+nodes proxy those exact mutable objects, namespacing IDs and declared metadata
+references without rebuilding the accepted scorer. Only a native selected SUB
+gate chooses which module's entry/catalog/scorer/probes execute. The bridge
+returns an opaque primitive; it never pushes a domain actuator.
+"""
+from __future__ import annotations
+
+from collections.abc import MutableMapping
+from dataclasses import dataclass
+import random
+
+from recon_lite.formal_engine import FormalReConEngine
+from recon_lite.graph import Edge, Graph, LinkType, Node, NodeState, NodeType
+
+from .terminal_development import ACTION_CHOICE, typed_schema_signature
+
+
+# Only declared node-reference fields are renamed. An opaque action spelling,
+# reading, owner ID, expression/condition ID or sensor value is never renamed.
+NODE_REFERENCE_FIELDS = frozenset({
+    "choice_strength_node_ids", "choice_tie_strength_node_ids",
+    "choice_selected_child", "selected_choice_source",
+    "selected_choice_connections", "selected_request_child", "selected_child",
+    "forward_choice_source", "return_source",
+})
+
+
+class _MappedMetadata(MutableMapping):
+    def __init__(self, node, scope):
+        self.node, self.scope = node, scope
+
+    def _map(self, value, *, reverse=False):
+        prefix = self.scope + "::"
+        if isinstance(value, str):
+            return value[len(prefix):] if reverse and value.startswith(prefix) else (
+                value if reverse else prefix + value)
+        if isinstance(value, tuple):
+            return tuple(self._map(item, reverse=reverse) for item in value)
+        if isinstance(value, list):
+            return [self._map(item, reverse=reverse) for item in value]
+        if isinstance(value, dict):
+            # Connection keys are opaque identities; only their node targets map.
+            return {key: self._map(item, reverse=reverse) for key, item in value.items()}
+        return value
+
+    def __getitem__(self, key):
+        if key == "execution_scope":
+            return self.scope
+        value = self.node.meta[key]
+        return self._map(value) if key in NODE_REFERENCE_FIELDS else value
+
+    def __setitem__(self, key, value):
+        if key == "execution_scope":
+            if value != self.scope:
+                raise ValueError("execution scope is immutable")
+            return
+        self.node.meta[key] = self._map(value, reverse=True) if key in NODE_REFERENCE_FIELDS else value
+
+    def __delitem__(self, key):
+        if key == "execution_scope":
+            raise ValueError("execution scope is immutable")
+        del self.node.meta[key]
+
+    def __iter__(self):
+        yield from self.node.meta
+        if "execution_scope" not in self.node.meta:
+            yield "execution_scope"
+
+    def __len__(self):
+        return len(self.node.meta) + ("execution_scope" not in self.node.meta)
+
+    def copy(self):
+        return dict(self)
+
+
+class _MappedNode:
+    """Global ID with exactly the local mutable execution/activation objects."""
+
+    def __init__(self, scope, node):
+        self.scope, self.local = scope, node
+        self.meta = _MappedMetadata(node, scope)
+
+    @property
+    def nid(self):
+        return self.scope + "::" + self.local.nid
+
+    @property
+    def ntype(self):
+        return self.local.ntype
+
+    @property
+    def state(self):
+        return self.local.state
+
+    @state.setter
+    def state(self, value):
+        self.local.state = value
+
+    @property
+    def activation(self):
+        return self.local.activation
+
+    @property
+    def predicate(self):
+        return self.local.predicate
+
+    @property
+    def tick_entered(self):
+        return self.local.tick_entered
+
+    @tick_entered.setter
+    def tick_entered(self, value):
+        self.local.tick_entered = value
+
+
+class _MappedEdge:
+    """Persistent local-edge view, including declared metadata references."""
+
+    def __init__(self, scope, edge):
+        self.scope, self.local = scope, edge
+        self.meta = _MappedMetadata(edge, scope)
+
+    @property
+    def src(self):
+        return self.scope + "::" + self.local.src
+
+    @property
+    def dst(self):
+        return self.scope + "::" + self.local.dst
+
+    @property
+    def ltype(self):
+        return self.local.ltype
+
+    @property
+    def w(self):
+        return self.local.w
+
+    @w.setter
+    def w(self, value):
+        self.local.w = value
+
+
+class MountedGraph:
+    """Atomically remount namespaced scopes without copying their weights.
+
+    Each module's child/edge order and relative ID order remain unchanged. The
+    fixed bridge is separately inventoried and survives local development.
+    """
+
+    def __init__(self, modules, *, max_scope_nodes=32768, max_bridge_nodes=64):
+        if not modules or any(not isinstance(scope, str) or not scope or "::" in scope
+                              for scope in modules):
+            raise ValueError("module scopes must be distinct nonempty namespace components")
+        if len({id(actor) for actor in modules.values()}) != len(modules):
+            raise ValueError("logical modules may not share an actor")
+        self.modules = dict(modules)
+        self.schema_signatures = {scope: typed_schema_signature(actor.schema)
+                                  for scope, actor in modules.items()}
+        self.max_scope_nodes = max_scope_nodes
+        self.max_bridge_nodes = max_bridge_nodes
+        self.max_composite_nodes = len(modules) * max_scope_nodes + max_bridge_nodes
+        self.bridge_nodes = {}
+        self.bridge_edges = []
+        self.graph = Graph()
+        self.structure_versions = {scope: 0 for scope in modules}
+        self.remount()
+
+    def global_id(self, scope, local_id):
+        if scope not in self.modules:
+            raise KeyError("unregistered module")
+        return scope + "::" + local_id
+
+    def local_id(self, scope, global_id):
+        prefix = scope + "::"
+        if not global_id.startswith(prefix):
+            raise ValueError("foreign module node identity")
+        return global_id[len(prefix):]
+
+    def node_ids(self, scope):
+        return tuple(self.global_id(scope, nid) for nid in self.modules[scope].graph.nodes)
+
+    def add_bridge_node(self, node):
+        if node.nid in self.graph.nodes or node.nid in self.bridge_nodes:
+            raise ValueError("duplicate composed node")
+        if len(self.bridge_nodes) >= self.max_bridge_nodes:
+            raise RuntimeError("fixed bridge node cap exceeded")
+        self.bridge_nodes[node.nid] = node
+        self.remount(validate=False)
+
+    def add_edge(self, src, dst, ltype, *, weight=1.0, meta=None):
+        if (src, dst, ltype) in self.graph.edge_by_key:
+            raise ValueError("duplicate composed edge")
+        self.bridge_edges.append(Edge(src, dst, ltype, weight, {} if meta is None else dict(meta)))
+        try:
+            self.remount(validate=False)
+        except Exception:
+            self.bridge_edges.pop()
+            raise
+
+    def add_hierarchy_pair(self, parent, child):
+        count = len(self.bridge_edges)
+        try:
+            self.add_edge(parent, child, LinkType.SUB)
+            self.add_edge(child, parent, LinkType.SUR)
+        except Exception:
+            del self.bridge_edges[count:]
+            self.remount(validate=False)
+            raise
+
+    def remount(self, scope=None, *, validate=True, structure_changed=False, candidate_actor=None):
+        if scope is not None and scope not in self.modules:
+            raise KeyError("unregistered module")
+        if (structure_changed or candidate_actor is not None) and scope is None:
+            raise ValueError("a structural version change requires one scope")
+        actors = dict(self.modules)
+        if candidate_actor is not None:
+            actors[scope] = candidate_actor
+        staged = Graph()
+        mutable_owners = {}
+        for name, actor in actors.items():
+            if typed_schema_signature(actor.schema) != self.schema_signatures[name]:
+                raise ValueError("module typed schema meaning changed")
+            if len(actor.graph.nodes) > self.max_scope_nodes:
+                raise RuntimeError("logical scope physical-node cap exceeded")
+            objects = [actor.graph, actor.bias]
+            objects.extend(value for value in vars(actor).values()
+                           if isinstance(value, (dict, list, set, random.Random)))
+            for condition in actor.conditions.values():
+                objects.extend((condition, condition.weight, condition.stats))
+            for node in actor.graph.nodes.values():
+                objects.extend((node, node.activation, node.meta))
+            for edge in actor.graph.edges:
+                objects.append(edge.meta)
+            for obj in objects:
+                old = mutable_owners.setdefault(id(obj), name)
+                if old != name:
+                    raise ValueError("mutable parameters or RNG cross module ownership")
+            for node in actor.graph.nodes.values():
+                mapped_id = self.global_id(name, node.nid)
+                previous = self.graph.nodes.get(mapped_id)
+                # Reindexing the composite does not recompile or remount an
+                # unchanged scope: its exact mapped nodes survive by identity.
+                mapped = previous if isinstance(previous, _MappedNode) and previous.local is node else _MappedNode(name, node)
+                staged.add_node(mapped)
+        for node in self.bridge_nodes.values():
+            staged.add_node(node)
+        if len(staged.nodes) > self.max_composite_nodes:
+            raise RuntimeError("composite resident-node cap exceeded")
+        for name, actor in actors.items():
+            for edge in actor.graph.edges:
+                src, dst = self.global_id(name, edge.src), self.global_id(name, edge.dst)
+                staged.add_edge(src, dst, edge.ltype)
+                key = src, dst, edge.ltype
+                previous = self.graph.edge_by_key.get(key)
+                mapped = previous if isinstance(previous, _MappedEdge) and previous.local is edge else _MappedEdge(name, edge)
+                staged.edges[-1] = mapped
+                staged.edge_by_key[key] = mapped
+        for edge in self.bridge_edges:
+            staged.add_edge(edge.src, edge.dst, edge.ltype)
+            replacement = staged.edge_by_key[(edge.src, edge.dst, edge.ltype)]
+            previous = self.graph.edge_by_key.get((edge.src, edge.dst, edge.ltype))
+            if previous is edge:
+                replacement = previous
+            else:
+                replacement = edge
+            staged.edges[-1] = replacement
+            staged.edge_by_key[(edge.src, edge.dst, edge.ltype)] = replacement
+        if validate:
+            staged.validate_formal_pairs()
+        # Existing engine references this Graph object. Commit only after all
+        # IDs, parents, edge restrictions, ownership and caps have been checked.
+        self.graph.__dict__ = staged.__dict__
+        if structure_changed:
+            self.structure_versions[scope] += 1
+
+    def remount_candidate(self, scope, candidate_actor):
+        """Stage development before its original actor commits the candidate.
+
+        The ownership ledger reconnects surviving weights before this call,
+        then immediately commits ``original.__dict__ = candidate.__dict__``.
+        Registry objects and sibling scopes never change. A rejected mount
+        leaves the global graph and structure version untouched.
+        """
+        self.remount(scope, candidate_actor=candidate_actor, structure_changed=True)
+
+
+class ScopedEngine:
+    """Local-ID execution view of the same global formal engine."""
+
+    def __init__(self, runtime, scope):
+        self.runtime, self.scope = runtime, scope
+
+    @property
+    def g(self):
+        return self.runtime.modules[self.scope].graph
+
+    @property
+    def tick(self):
+        return self.runtime.engine.tick
+
+    def request(self, local_id):
+        self.runtime.engine.request(self.runtime.composer.global_id(self.scope, local_id))
+
+    def clear_request(self, local_id):
+        self.runtime.engine.clear_request(self.runtime.composer.global_id(self.scope, local_id))
+
+    def run(self, *, max_ticks=32, env=None, until=None, active_nodes=None):
+        # Probe ticks touch local actor nodes only, never bridge/caller/sibling
+        # states. Boundary SUB/SUR links are serviced by outer full-graph ticks.
+        ids = (self.runtime.composer.node_ids(self.scope) if active_nodes is None
+               else tuple(self.runtime.composer.global_id(self.scope, nid) for nid in active_nodes))
+        if env is not None:
+            self.runtime.environments[self.scope] = env
+        self.runtime.engine.run(max_ticks=max_ticks, env=self.runtime.environment,
+                                active_nodes=ids,
+                                until=None if until is None else lambda _engine: until(self))
+        return self.runtime.engine.trace
+
+    def emit_exactly_one_actuator(self, local_id):
+        return self.runtime.engine.emit_exactly_one_actuator(
+            self.runtime.composer.global_id(self.scope, local_id))
+
+    def refresh(self):
+        self.runtime.composer.remount(self.scope)
+
+
+@dataclass
+class _CallConfiguration:
+    port_factory: object
+    event_id: object
+    explore: bool
+    record: bool
+    on_capture: object = None
+
+
+def _call_phase(node, env):
+    runtime = env["native_runtime"]
+    scope, phase = node.meta["module_scope"], node.meta["call_phase"]
+    runtime.execute_phase(scope, phase)
+    return True, True
+
+
+class NativeInvocationGraph:
+    """Native ordered module calls and selection-derived child requests.
+
+    Configure inputs before a decision, without measuring dormant modules. The
+    entry terminal creates the selected module's real port; catalog, binding,
+    choice and capture follow through real SUB/SUR links in this one graph.
+    A caller may attach one final real commit terminal to the fixed bridge.
+    """
+
+    def __init__(self, modules, *, max_scope_nodes=32768, max_bridge_nodes=64):
+        self.modules = dict(modules)
+        self.composer = MountedGraph(modules, max_scope_nodes=max_scope_nodes,
+                                     max_bridge_nodes=max_bridge_nodes)
+        self.configurations, self.environments, self.selections = {}, {}, {}
+        self.environment = {"native_runtime": self, "scope_environments": self.environments,
+                            "raise_terminal_errors": True}
+        for scope in modules:
+            self._install_call(scope)
+        self.composer.remount()
+        self.engine = FormalReConEngine(self.graph, record_trace=False)
+
+    @property
+    def graph(self):
+        return self.composer.graph
+
+    @staticmethod
+    def call_id(scope):
+        return "__call__:" + scope
+
+    def _install_call(self, scope):
+        root = self.call_id(scope)
+        self.composer.add_bridge_node(Node(root, NodeType.SCRIPT, meta={
+            "request_policy": "ordered_sub", "confirm_policy": "forward_choice",
+            "module_scope": scope,
+            "forward_choice_source": self.composer.global_id(scope, ACTION_CHOICE)}))
+        stages = []
+        for phase in ("entry", "bind", "capture"):
+            stage, terminal = root + ":" + phase, root + ":" + phase + ":terminal"
+            self.composer.add_bridge_node(Node(stage, NodeType.SCRIPT, meta={"confirm_policy": "and"}))
+            self.composer.add_bridge_node(Node(terminal, NodeType.TERMINAL, predicate=_call_phase,
+                meta={"module_scope": scope, "call_phase": phase}))
+            self.composer.add_hierarchy_pair(stage, terminal)
+            stages.append(stage)
+        children = (stages[0], self.composer.global_id(scope, "catalog_root"), stages[1],
+                    self.composer.global_id(scope, ACTION_CHOICE), stages[2])
+        for child in children:
+            self.composer.add_hierarchy_pair(root, child)
+
+    def install_selected_gate(self, gate_id, *, source_scope, connections):
+        if (source_scope not in self.modules or not connections
+                or any(not isinstance(identity, str) or not identity for identity in connections)
+                or any(scope not in self.modules for scope in connections.values())):
+            raise ValueError("selected requests require registered module connections")
+        if len(set(connections.values())) != len(connections):
+            raise ValueError("one generic call site per registered module is required")
+        targets = {identity: self.call_id(scope) for identity, scope in connections.items()}
+        self.composer.add_bridge_node(Node(gate_id, NodeType.SCRIPT, meta={
+            "request_policy": "selected_choice", "confirm_policy": "selected_choice",
+            "selected_choice_source": self.call_id(source_scope),
+            "selected_choice_connections": targets}))
+        for child in targets.values():
+            self.composer.add_hierarchy_pair(gate_id, child)
+        self.composer.remount()
+        return gate_id
+
+    def configure_call(self, scope, port_factory, *, event_id, explore=False,
+                       record=False, on_capture=None):
+        if scope not in self.modules or not callable(port_factory):
+            raise ValueError("registered module and lazy real-port factory required")
+        if type(explore) is not bool or type(record) is not bool:
+            raise TypeError("separate exploration/record permissions must be Boolean")
+        self.configurations[scope] = _CallConfiguration(port_factory, event_id, explore, record, on_capture)
+
+    def begin_decision(self):
+        self.environments.clear()
+        self.selections.clear()
+        for actor in self.modules.values():
+            actor._reset()
+        for node in self.composer.bridge_nodes.values():
+            node.state, node.activation.value = NodeState.INACTIVE, 0.0
+            for key in ("selected_request_child", "selected_connection", "selected_child", "target_scope",
+                        "emitted_actuator_identity", "return_source", "emitted"):
+                node.meta.pop(key, None)
+        self.engine = FormalReConEngine(self.graph, record_trace=False)
+
+    def execute_phase(self, scope, phase):
+        actor, config = self.modules[scope], self.configurations[scope]
+        engine = ScopedEngine(self, scope)
+        if phase == "entry":
+            port = config.port_factory()
+            self.environments[scope] = actor._invocation_enter(port, event_id=config.event_id,
+                explore=config.explore, record=config.record)
+        elif phase == "bind":
+            actor._invocation_bind(engine, self.environments[scope])
+        elif phase == "capture":
+            selection = actor._invocation_capture(engine, self.environments[scope])
+            self.selections[scope] = selection
+            if config.on_capture is not None:
+                config.on_capture(scope, selection)
+        else:
+            raise ValueError("unregistered invocation phase")
+
+    def run(self, root_id, *, max_ticks=256):
+        self.engine.request(root_id)
+        self.engine.run(max_ticks=max_ticks, env=self.environment,
+            until=lambda engine: engine.g.nodes[root_id].state in (NodeState.CONFIRMED, NodeState.FAILED))
+        if self.graph.nodes[root_id].state != NodeState.CONFIRMED:
+            raise RuntimeError("native request did not complete")
+        return self.engine.emit_exactly_one_actuator(root_id)
+
+    def selection(self, scope):
+        return self.selections[scope]
+
+    def selected_target(self, gate_id):
+        gate = self.graph.nodes[gate_id]
+        if gate.state not in (NodeState.TRUE, NodeState.CONFIRMED):
+            raise RuntimeError("selected request has not returned")
+        identity = gate.meta["selected_connection"]
+        child = gate.meta["selected_child"]
+        if gate.meta["selected_choice_connections"].get(identity) != child:
+            raise RuntimeError("unregistered return provenance")
+        scope = gate.meta["target_scope"]
+        if self.call_id(scope) != child:
+            raise RuntimeError("foreign module return provenance")
+        return identity, scope, child
