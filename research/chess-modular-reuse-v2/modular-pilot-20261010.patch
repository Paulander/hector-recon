+    if permission.explore:
+        rng = model.rng['exploration_rng']
+        if rng.random() < f['config'].exploration:
+            bound = 1.0 + 2.0 * (abs(_effective(f['bias'])) + sum(abs(_effective(c.weight)) for c in f['conditions'].values()))
+            boosts[rng.randrange(len(bindings))] = bound
+    _same(tuple(selected['exploration']), tuple(boosts.items()), module + ' exploration allocation')
+    scores = tuple((binding, math.fsum((_effective(f['bias']), boosts.get(i, 0.0),
+        *(_effective(f['conditions'][cid].weight) for cid in active_rows[i])))) for i, binding in enumerate(bindings))
+    _same(tuple(trace['scores'][module]), scores, module + ' ordered binary64 scores')
+    # Native choice tie is STRING option ID, not actuator spelling or numeric slot.
+    i = max(range(len(bindings)), key=lambda slot: (scores[slot][1], f'option:{slot}'))
+    q = scores[i][1] - boosts.get(i, 0.0)
+    _same((selected['action'], selected['slot'], selected['prediction'], tuple(selected['active'])),
+          (bindings[i], i, q, active_rows[i]), module + ' actual selected action')
+    _same(tuple(trace['unboosted_scores'][module]), tuple((b, value - boosts.get(slot, 0.0)) for slot, (b, value) in enumerate(scores)), module + ' unboosted scores')
