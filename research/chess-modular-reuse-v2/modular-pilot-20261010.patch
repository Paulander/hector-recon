@@ -0,0 +1,225 @@
+"""Offline strict-M2 curation. Only boards and orbit identities are exported.
+
+Scope: standard chess, exactly White king/rook and Black king, White to move,
+valid live placements, zero halfmove clock, fullmove one, no prior history,
+castling rights or en-passant square. All distinct raw placements are eligible;
+there is no edge restriction, solution-count cap, sensor or learner filter.
+Strict M2 means no immediate mate, and some first move after which EVERY legal
+Black reply permits an actual mating White finish. Exact search is curation
+only; no action labels or solver values reach the learner.
+"""
+
+import hashlib
+import json
+from pathlib import Path
+import random
+
+import chess
+
+from .pools import orbit_key
+
+
+SPLITS = ("train", "development", "final")
+SCHEMA = "strict_mate_two_orbit_pool.v1"
+SCOPE = {
+    "material": "white king, white rook, black king; White to move",
+    "legality": "python-chess valid live standard-chess placement",
+    "history": "halfmove=0; fullmove=1; empty history; no castling or en passant",
+    "geometry": "all distinct placements; no edge or solution-count restriction",
+    "membership": "no immediate mate; exists first action permitting mate after every reply",
+    "selection": "no learner, sensor, score or outcome-based difficulty exclusion",
+}
+
+
+def _placement(wk, wr, bk):
+    board = chess.Board(None)
+    for square, kind, color in ((wk, chess.KING, True), (wr, chess.ROOK, True),
+                                (bk, chess.KING, False)):
+        board.set_piece_at(square, chess.Piece(kind, color))
+    board.turn = chess.WHITE
+    return board
+
+
+def _valid_scope(board):
+    material = sorted((p.piece_type, p.color) for p in board.piece_map().values())
+    return (material == sorted(((chess.KING, True), (chess.ROOK, True),
+                                (chess.KING, False)))
+            and not board.chess960 and board.turn == chess.WHITE
+            and board.halfmove_clock == 0 and board.fullmove_number == 1
+            and not board.castling_rights and board.ep_square is None
+            and not board.move_stack and board.is_valid()
+            and not board.is_game_over(claim_draw=True))
+
+
+def _mate_available(board):
+    for move in list(board.legal_moves):
+        leaf = board.copy(stack=False)
+        leaf.push(move)
+        if leaf.is_checkmate():
+            return True
+    return False
+
+
+def is_strict_mate_two(board):
+    """Offline Boolean membership only; does not expose winning moves."""
+    if not _valid_scope(board) or _mate_available(board):
+        return False
+    for first in list(board.legal_moves):
+        after = board.copy(stack=False)
+        after.push(first)
+        if after.is_game_over(claim_draw=True):
+            continue
+        replies = list(after.legal_moves)
+        if not replies:
+            continue
+        for reply in replies:
+            successor = after.copy(stack=False)
+            successor.push(reply)
+            if successor.is_game_over(claim_draw=True) or not _mate_available(successor):
+                break
+        else:
+            return True
+    return False
+
+
+def orbit_split(canonical, *, seed):
+    """Stable 80/10/10 D4-orbit assignment, before orientation expansion."""
+    bucket = int(hashlib.sha256(f"{seed}:{canonical}".encode()).hexdigest()[:8], 16) % 10
+    return "train" if bucket < 8 else "development" if bucket == 8 else "final"
+
+
+def d4_fens(board):
+    """Return every distinct orientation of a declared history-free placement."""
+    if not _valid_scope(board):
+        raise ValueError("D4 expansion requires a live legal history-free KRK placement")
+    squares = (board.king(chess.WHITE), next(iter(board.pieces(chess.ROOK, chess.WHITE))),
+               board.king(chess.BLACK))
+    images = set()
+    for reflection in (False, True):
+        for rotations in range(4):
+            row = []
+            for square in squares:
+                x, y = chess.square_file(square), chess.square_rank(square)
+                if reflection:
+                    x = 7 - x
+                for _ in range(rotations):
+                    x, y = 7 - y, x
+                row.append(chess.square(x, y))
+            images.add(_placement(*row).fen())
+    return tuple(sorted(images))
+
+
+def curate_orbits(fens, *, seed):
+    """Validate supplied strict-M2 candidates and expand each orbit once.
+
+    This finite-input entry point permits small mechanical fixtures without
+    sampling a scientific cohort. The output contains FENs only, grouped by the
+    prospective orbit split. Invalid or non-strict candidates raise an error.
+    """
+    boards = {}
+    for fen in fens:
+        board = chess.Board(fen)
+        if not is_strict_mate_two(board):
+            raise ValueError("candidate is not a declared strict-M2 placement")
+        boards.setdefault(orbit_key(board), board)
+    rows = {split: [] for split in SPLITS}
+    for canonical, board in sorted(boards.items()):
+        # The whole orbit is assigned before any orientation enters a split.
+        split = orbit_split(canonical, seed=seed)
+        rows[split].extend(d4_fens(board))
+    return {split: tuple(fens) for split, fens in rows.items()}
+
+
+def prepare(directory: Path, *, seed: int | str, train_orbits: int,
+            development_orbits: int, final_orbits: int,
+            max_attempts: int = 1_000_000):
+    """Sample raw placements without replacement at the admitted orbit level.
+
+    Requested sizes count canonical orbits, not orientations. Seed and quotas
+    must be declared before running; do not reroll after observing performance.
+    This prepares inventories only and never runs an actor on any split.
+    """
+    directory = Path(directory)
+    counts = dict(zip(SPLITS, (train_orbits, development_orbits, final_orbits)))
+    if (any(type(n) is not int or n < 0 for n in counts.values())
+            or sum(counts.values()) == 0):
+        raise ValueError("orbit sizes must be nonnegative integers with a positive total")
+    if (type(seed) not in (int, str) or (isinstance(seed, str) and not seed)
+            or type(max_attempts) is not int or max_attempts < 1):
+        raise ValueError("integer or nonempty string seed and positive attempt budget required")
+    if directory.exists():
+        raise FileExistsError("pool directory exists; reuse it or choose a new directory")
+    rng = random.Random(seed)
+    accepted = {split: {} for split in SPLITS}
+    examined = set()
+    attempts = 0
+    while any(len(accepted[k]) < counts[k] for k in SPLITS) and attempts < max_attempts:
+        attempts += 1
+        board = _placement(*rng.sample(range(64), 3))
+        if not _valid_scope(board):
+            continue
+        canonical = orbit_key(board)
+        if canonical in examined:
+            continue
+        examined.add(canonical)
+        split = orbit_split(canonical, seed=seed)
+        if len(accepted[split]) >= counts[split] or not is_strict_mate_two(board):
+            continue
+        accepted[split][canonical] = board
+    if any(len(accepted[k]) != counts[k] for k in SPLITS):
+        raise RuntimeError(f"pool budget exhausted: { {k: len(v) for k, v in accepted.items()} }")
+    manifest = {"schema": SCHEMA, "seed": seed, "scope": SCOPE,
+                "sampling": "uniform distinct raw squares; first qualifying unique orbits per split",
+                "partition": "SHA256(seed:canonical D4 orbit), first 8 hex digits modulo 10; 80/10/10",
+                "attempts": attempts, "max_attempts": max_attempts,
+                "actor_evaluations": 0, "final_outcomes_opened": False, "splits": {}}
+    # Solve/allocate fully before publishing files; a sampling failure creates none.
+    directory.mkdir(parents=True)
+    for split in SPLITS:
+        keys = sorted(accepted[split])
+        fens = [fen for key in keys for fen in d4_fens(accepted[split][key])]
+        data = ("\n".join(fens) + ("\n" if fens else "")).encode()
+        (directory / f"{split}.txt").write_bytes(data)
+        manifest["splits"][split] = {
+            "count": len(fens), "orbits": keys,
+            "distinct_orbits": len(keys), "sha256": hashlib.sha256(data).hexdigest(),
+        }
+    (directory / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    return manifest
+
+
+def load_split(directory: Path, split: str, *, allow_final: bool = False):
+    """Verify one board-only split without opening another split's boards.
+
+    Final evaluation requires a deliberate opt-in after the protocol is frozen.
+    That opt-in does not itself grant permission to execute scientific training.
+    """
+    if split not in SPLITS:
+        raise ValueError("unsupported strict-M2 split")
+    if split == "final" and not allow_final:
+        raise ValueError("final split is sealed until an explicitly frozen evaluation")
+    directory = Path(directory)
+    manifest = json.loads((directory / "manifest.json").read_text())
+    if manifest["schema"] != SCHEMA:
+        raise ValueError("unsupported strict-M2 pool schema")
+    data = (directory / f"{split}.txt").read_bytes()
+    digest = hashlib.sha256(data).hexdigest()
+    rows = tuple(data.decode().splitlines())
+    entry = manifest["splits"][split]
+    if digest != entry["sha256"] or len(rows) != entry["count"] or len(set(rows)) != len(rows):
+        raise ValueError("pool content differs from its frozen manifest")
+    grouped = {}
+    for fen in rows:
+        board = chess.Board(fen)
+        if not _valid_scope(board):
+            raise ValueError("pool board violates declared placement scope")
+        key = orbit_key(board)
+        if orbit_split(key, seed=manifest["seed"]) != split:
+            raise ValueError("pool contains an orbit from another split")
+        grouped.setdefault(key, set()).add(fen)
+    if sorted(grouped) != entry["orbits"] or len(grouped) != entry["distinct_orbits"]:
+        raise ValueError("pool orbit inventory differs from its manifest")
+    for fens in grouped.values():
+        if fens != set(d4_fens(chess.Board(next(iter(fens))))):
+            raise ValueError("pool must contain every D4 orientation of an admitted orbit")
+    return rows, digest
