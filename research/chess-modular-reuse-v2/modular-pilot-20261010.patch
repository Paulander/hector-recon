+"""Opt-in trusted synchronous evaluation batches; strict reference unchanged.
+
+Expensive exact source/learning/RNG/graph checks surround one exclusive batch.
+Native execution and cheap authority/permission/dispatch checks remain at each
+request.  Interim copied-board records are UNACCEPTED until exact final checks.
+This is a laboratory trust contract, not protection against hostile Python,
+concurrent mutation, or change-and-restore attacks.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict
+import json
+import os
+import threading
+
+import chess
+
+from recon_lite.formal_engine import FormalReConEngine
+from recon_lite_hector.learning.terminal_development import typed_schema_signature
+
+from .m2_evidence import canonical, digest
+from .modular_evaluation_workspace import EvaluationWorkspace, StaleEvaluationSnapshot
+from .modular_evaluation_isolation import assert_no_source_alias
+from .modular_evaluation_streaming_digest import canonical_digest
+from .native_modular import MODULE_IDS
+from .modular_ports import BoardAuthority
