+@dataclass(frozen=True)
+class ChildObservation:
+    action: str | None
+    unboosted_q: float | None
+    operational_confirmation: bool
+
+
+def _terminal_reason(board):
+    if board.is_checkmate():
+        return "white_mate" if board.turn == chess.BLACK else "white_lost"
+    if len(board.pieces(chess.ROOK, chess.WHITE)) != 1:
+        return "captured_rook"
+    if board.is_game_over(claim_draw=True):
+        return "draw_or_terminal"
+    return None
+
+
+def _some_immediate_mate(board):
+    for move in board.legal_moves:
+        leaf = board.copy(stack=True)
+        leaf.push(move)
+        if leaf.is_checkmate() and leaf.turn == chess.BLACK:
+            return True
+    return False
+
+
+def run_exposure_assay(plan: ExposurePlan,
+                       pristine_child: Callable[[chess.Board], ChildObservation], *,
+                       engineering_gates_pass: bool, pinned_plan_sha256: str,
+                       deadline_check: Callable[[], None] | None = None) -> dict:
+    """Offline laboratory sweep; caller authenticates/copies native child each call.
+
+    The callback receives an authoritative committed successor COPY and must use
+    a pristine greedy M1 copy without observe/development. Every complete sweep
+    row is retained. The caller's owned-process guard remains authoritative.
+    """
+    if engineering_gates_pass is not True:
+        raise RuntimeError("unresolved engineering gates block exposure")
+    if plan.sha256 != pinned_plan_sha256 or plan.maximum_seconds > 3600:
+        raise ValueError("exposure plan changed or exceeds authorized60minute cap")
+    if len(plan.boards) != 64 or plan.maximum_child_calls != plan.complete_legal_first_allowance:
+        raise ValueError("complete64-board selection/call allowance required")
+    started = time.monotonic()
+    rows = []
+    child_calls = 0
+    for item in plan.boards:
+        board = chess.Board(item.fen)
+        actual_moves = tuple(sorted(move.uci() for move in board.legal_moves))
+        if actual_moves != item.legal_first_moves:
+            raise ValueError("pinned legal-first inventory changed")
+        for slot, first in enumerate(item.legal_first_moves):
+            if time.monotonic() - started >= plan.maximum_seconds:
+                raise TimeoutError("complete exposure assay exceeded pinned cap; no retry")
+            if deadline_check is not None:
+                deadline_check()
+            successor = board.copy(stack=True)
+            successor.push_uci(first)
+            reason = _terminal_reason(successor)
+            legal_reply_count = successor.legal_moves.count() if reason is None else 0
+            reply = None
+            if reason is None:
+                reply_move = choose_mate_horizon_reply(successor.copy(stack=True))
+                reply = reply_move.uci()
+                successor.push(reply_move)
+                reason = _terminal_reason(successor)
+            some_mate = _some_immediate_mate(successor) if reason is None else False
+            observation = ChildObservation(None, None, False)
+            child_mate = False
+            child_seconds = 0.0
+            if reason is None:
+                child_calls += 1
+                if child_calls > plan.maximum_child_calls:
+                    raise RuntimeError("pinned child-call allowance exceeded")
+                child_started = time.monotonic()
+                observation = pristine_child(successor.copy(stack=True))
+                child_seconds = time.monotonic() - child_started
+                if not isinstance(observation, ChildObservation):
+                    raise TypeError("explicit action/q/operational ChildObservation required")
+                if type(observation.operational_confirmation) is not bool:
+                    raise ValueError("operational confirmation must be a Boolean")
+                if observation.unboosted_q is not None and not math.isfinite(observation.unboosted_q):
+                    raise ValueError("nonfinite child prediction")
+                if observation.action is not None:
+                    move = chess.Move.from_uci(observation.action)
+                    if move not in successor.legal_moves:
+                        raise ValueError("native child returned an illegal primitive")
+                    leaf = successor.copy(stack=True)
+                    leaf.push(move)
+                    child_mate = leaf.is_checkmate() and leaf.turn == chess.BLACK
+                reason = "child_mate" if child_mate else "child_did_not_mate"
+            rows.append({"fen": item.fen, "orbit": item.orbit, "first_slot": slot,
+                         "first": first, "legal_first_count": len(item.legal_first_moves),
+                         "legal_reply_count": legal_reply_count, "black_reply": reply,
+                         "successor_fen": successor.fen(), "some_immediate_mate": some_mate,
+                         "child_action": observation.action,
+                         "child_unboosted_q": observation.unboosted_q,
+                         "operational_confirmation": observation.operational_confirmation,
+                         "child_mate": child_mate, "reason": reason,
+                         "child_call_seconds": child_seconds})
+    if len(rows) != plan.complete_legal_first_allowance:
+        raise RuntimeError("incomplete first-move sweep")
+    return {"schema": "native-modular-offline-exposure.v1", "plan_sha256": plan.sha256,
+            "boards": 64, "train_orbits": 32, "legal_first_moves": len(rows),
+            "child_calls": child_calls, "child_calls_allowance": plan.maximum_child_calls,
+            "seconds": time.monotonic() - started, "learning": False,
+            "scientific_initializations": 0, "labels_reach_learner": False,
+            "rows": rows, "estimates": estimate_exposure(rows)}
+
+
+def _probability_record(probability: Fraction, *, episodes=M2_EPISODES):
+    p = float(probability)
+    return {"per_m2_episode_exact": f"{probability.numerator}/{probability.denominator}",
+            "per_m2_episode": p, "expected_per_actor": episodes * p,
+            "zero_positive_per_actor_iid_approximation": (1.0 - p) ** episodes,
+            "expected_six_actor_total": 6 * episodes * p,
+            "six_actor_zero_iid_approximation": (1.0 - p) ** (6 * episodes)}
+
+
+def estimate_exposure(rows: Sequence[Mapping]) -> dict:
+    """Recorded attribution of fixed-policy opportunity, not a learning forecast."""
+    groups: dict[str, list[Mapping]] = {}
+    for row in rows:
+        groups.setdefault(row["fen"], []).append(row)
+    if len(groups) != 64:
+        raise ValueError("complete64-board assay required")
+    board_estimates = []
+    for fen, first_rows in sorted(groups.items()):
+        ordered = sorted(first_rows, key=lambda row: row["first_slot"])
+        n = len(ordered)
+        if [row["first_slot"] for row in ordered] != list(range(n)):
+            raise ValueError("missing or duplicate legal-first observations")
+        if any(row["legal_first_count"] != n or type(row["child_mate"]) is not bool
+               for row in ordered):
+            raise ValueError("complete actual legal-first counts/Boolean outcomes required")
+        greedy_slot, probabilities = native_zero_weight_distribution(n)
+        setup_success = sum((weight for row, weight in zip(ordered, probabilities)
+                             if row["child_mate"]), Fraction(0))
+        uniform_success = Fraction(sum(row["child_mate"] for row in ordered), n)
+        board_estimates.append({"fen": fen, "greedy_setup_slot": greedy_slot,
+                                "actual_setup_distribution_success": setup_success,
+                                "uniform_setup_success": uniform_success})
+    mean_setup = sum((row["actual_setup_distribution_success"] for row in board_estimates),
+                     Fraction(0)) / len(board_estimates)
+    mean_uniform = sum((row["uniform_setup_success"] for row in board_estimates),
+                       Fraction(0)) / len(board_estimates)
+    _, parent_distribution = native_zero_weight_distribution(2)
+    timing = parent_distribution[0] * parent_distribution[1]
+    return {
+        "initial_parent_setup_probability": str(parent_distribution[0]),
+        "initial_parent_m1_probability": str(parent_distribution[1]),
+        "setup_first_and_m1_second_probability": str(timing),
+        "native_tie_rule": "descending STRING option node ids; not numeric last slot",
+        "actual_initial_parent_and_setup": _probability_record(timing * mean_setup),
+        "uniform_legal_setup_same_actual_parent_timing": _probability_record(timing * mean_uniform),
+        "ideal_request_timing_same_actual_setup_distribution_and_existing_child": _probability_record(mean_setup),
+        "ideal_request_timing_uniform_setup_labelled_extra_comparison": _probability_record(mean_uniform),
+        "some_mate_exists_count": sum(row["some_immediate_mate"] for row in rows),
+        "actual_child_mate_count": sum(row["child_mate"] for row in rows),
+        "operational_confirmation_count": sum(row["operational_confirmation"] for row in rows),
+        "assumptions": ["Pristine initial parent/setup remain zero-weight with ordinary epsilon=.25; M1 stays pristine greedy.",
+                        "64 deterministic orientations are treated as representative of the256 TRAIN boards with uniform board weighting.",
+                        "Expected counts use192 strict-M2 episodes per actor; zero-event probabilities additionally approximate independent identically distributed episodes.",
+                        "Actual shuffled-without-replacement exercises and paired lineage dependence mean the iid zero/cohort values are approximations, not statistical reliability claims.",
+                        "No claim predicts changing policies, supplies good setup moves, or proves impossibility; some-mate labels are not child's competence."]}
+
+
+def _successes(rows):
+    return {row["fen"] for row in rows if row["all_reply_mate"] is True}
+
+
+def _strict_reuse(row):
+    margins = row.get("finish_request_margins", ())
+    return (row.get("setup_first") is True and row.get("m1_finish_every_reply") is True
+            and bool(margins) and math.isfinite(row.get("first_request_margin", math.nan))
+            and row["first_request_margin"] > STRICT_MARGIN
+            and all(math.isfinite(value) and value > STRICT_MARGIN for value in margins))
+
+
+def qualifying_set(censuses: Mapping[int, Mapping]) -> tuple[str, ...]:
+    """Select up to eight deterministically; require two orbits before filling."""
+    baseline = _successes(censuses[0]["m2_rows"])
+    late = [{row["fen"]: row for row in censuses[episode]["m2_rows"]
+             if row["all_reply_mate"] is True and _strict_reuse(row)} for episode in (192, 256)]
+    candidates = sorted(set(late[0]).intersection(late[1]) - baseline)
+    if not candidates:
+        return ()
+    by_orbit: dict[str, list[str]] = {}
+    for fen in candidates:
+        orbit = late[0][fen]["orbit"]
+        if late[1][fen]["orbit"] != orbit:
+            raise ValueError("changed orbit identity across censuses")
+        by_orbit.setdefault(orbit, []).append(fen)
+    chosen = [by_orbit[orbit][0] for orbit in sorted(by_orbit)[:2]]
+    for fen in candidates:
+        if len(chosen) >= 8:
+            break
+        if fen not in chosen:
+            chosen.append(fen)
+    return tuple(sorted(chosen))
+
+
+def dependence_panel(censuses: Mapping[int, Mapping]) -> tuple[str, ...]:
+    """At most eight lexical persistent-new strict reused successes, at most2orbits."""
+    baseline = _successes(censuses[0]["m2_rows"])
+    late = [{row["fen"]: row for row in censuses[episode]["m2_rows"]
+             if row["all_reply_mate"] is True and _strict_reuse(row)} for episode in (192, 256)]
+    candidates = sorted(set(late[0]).intersection(late[1]) - baseline)
+    groups: dict[str, list[str]] = {}
+    for fen in candidates:
+        groups.setdefault(late[0][fen]["orbit"], []).append(fen)
+    selected_orbits = sorted(groups)[:2]
+    chosen = [groups[orbit][0] for orbit in selected_orbits]
+    for fen in sorted(fen for orbit in selected_orbits for fen in groups[orbit]):
+        if len(chosen) == 8:
+            break
+        if fen not in chosen:
+            chosen.append(fen)
+    return tuple(sorted(chosen))
+
+
+def adjudicate_actor(censuses: Mapping[int, Mapping], *, learning_evidence: Mapping,
+                     controls: Mapping, mechanical_pass: bool,
+                     native_replay_pass: bool, ownership_pass: bool) -> dict:
+    if set(censuses) != set(CENSUS_EPISODES):
+        raise ValueError("all five fixed censuses required; no favorable subsets")
+    for census in censuses.values():
+        rows = census["m2_rows"]
+        if len(rows) !=128 or len({row["fen"] for row in rows}) !=128:
+            raise ValueError("complete distinct128-board M2 census required")
+        if any(type(row["all_reply_mate"]) is not bool for row in rows):
+            raise ValueError("actual all-reply Boolean outcomes required")
+    baseline = _successes(censuses[0]["m2_rows"])
+    late_successes = {episode: _successes(censuses[episode]["m2_rows"])
+                      for episode in (192, 256)}
+    persistent_new = set.intersection(*(rows-baseline for rows in late_successes.values()))
+    late_rows = {row["fen"]: row for row in censuses[192]["m2_rows"]}
+    orbits = {late_rows[fen]["orbit"] for fen in persistent_new}
+    qualifying = qualifying_set(censuses)
+    qualifying_orbits = {late_rows[fen]["orbit"] for fen in qualifying}
+    panel = dependence_panel(censuses)
+    control_modes = ("disconnect_m1_no_fallback", "replace_m1_with_setup", "fixed_setup_then_m1_lab_only")
+    control_complete = bool(panel)
+    disconnect_dependence = bool(panel)
+    for episode in (192, 256):
+        for mode in control_modes:
+            measured = controls.get(episode, {}).get(mode, {})
+            if set(measured) != set(panel):
+                control_complete = False
+            if mode == "disconnect_m1_no_fallback":
+                if any(measured.get(fen) is not False for fen in panel):
+                    disconnect_dependence = False
+        if len(controls.get(episode, {}).get("script_known_m1", {})) != 8:
+            control_complete = False
+    gates = {
+        "all_census_standalone_and_parent_m1": all(
+            row["standalone_m1_mates"] ==1512 and row["parent_m1_mates"] ==1512
+            for row in censuses.values()),
+        "persistent_new_m2_eight_two_orbits": len(persistent_new) >=8 and len(orbits) >=2,
+        "late_m2_net_eight": all(len(rows) >=len(baseline)+8 for rows in late_successes.values()),
+        "qualified_native_reuse_eight_two_orbits": len(qualifying) ==8 and len(qualifying_orbits) >=2,
+        "real_positive_m2_receipt": learning_evidence.get("positive_m2_receipts", 0) >0,
+        "subsequent_nonzero_born_or_refined_parent_credit": learning_evidence.get("parent_post_birth_nonzero_credit", 0) >0,
+        "subsequent_nonzero_born_or_refined_setup_credit": learning_evidence.get("setup_post_birth_nonzero_credit", 0) >0,
+        "complete_dependence_controls": control_complete,
+        "disconnect_eliminates_panel_completion": disconnect_dependence,
+        "mechanical_pass": mechanical_pass is True,
+        "native_replay_pass": native_replay_pass is True,
+        "ownership_pass": ownership_pass is True}
+    return {"joint_canary_pass": all(gates.values()), "gates": gates,
+            "baseline_m2": len(baseline), "late_m2": {ep: len(rows) for ep, rows in late_successes.items()},
+            "persistent_new_m2": len(persistent_new), "persistent_new_orbits": len(orbits),
+            "qualifying_set": list(qualifying), "dependence_panel": list(panel),
+            "replacement_or_script_equality": "reported separately; neither forces failure nor proves superiority",
+            "persistence": "late192/256 samples only; not continuous retention"}
+
