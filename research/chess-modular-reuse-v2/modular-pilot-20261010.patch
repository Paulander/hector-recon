+"""Opt-in single-graph request organism; no scientific launcher or new law.
+
+The host supplies only the actual board and an episode termination budget.
+Registered native SUB connections choose the child. Neither host task metadata
+nor child scores participate in parent choice. A single output terminal commits.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict
+import copy
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import pickle
+
+import chess
+
+from recon_lite.graph import Node, NodeType
+from recon_lite_hector.learning.context_decision import OwnershipLimits
+from recon_lite_hector.learning.modular_credit import ModularCreditLedger, ModulePermissions
+from recon_lite_hector.learning.modular_graph import NativeInvocationGraph
+from recon_lite_hector.learning.owner_birth_search import BirthSearchConfig
+from recon_lite_hector.learning.owner_development import OwnerDevelopmentConfig
+from recon_lite_hector.learning.selective_episode import EpisodicSelectiveDevelopment
+from recon_lite_hector.learning.terminal_development import DevelopmentConfig, typed_schema_signature
+from recon_lite_chess.autogrowth.mate_horizon_opponent import choose_mate_horizon_reply
+from .m2_evidence import digest, sha, source_pins, verify_source, write_json
+from .m2_schema import M2_SCHEMA
+from .mate_two import _start, _terminal
+from .modular_ports import (PARENT_SCHEMA, PARENT_STATE_COORDINATES, CONNECTIONS,
+    RequestFeaturePort, DeferredM1Port, DeferredSetupPort, ModuleRequest, ModuleReturn,
+    BoardAuthority)
+from .selective import STATE_COORDINATES
+from .terminal import SCHEMA
+
+MODULE_IDS = ('parent', 'setup', 'm1')
+DEFINITION_VERSION = 'native_modular_request.v1'
+TARGET_VERSION = 'parent-setup-eventual_m1-immediate.v1'
+PERMISSION_VERSION = 'independent-explore-record-update-develop.v1'
+
+
+def fresh(schema, states, seed):
+    return EpisodicSelectiveDevelopment.create(schema=schema, state_coordinates=states,
+        seed=seed, config=DevelopmentConfig(),
+        limits=OwnershipLimits(max_leaves=1, max_parameters=96, max_definitions=512,
+                               max_physical_nodes=32768),
+        search=BirthSearchConfig(mode='residual', candidates=64),
+        development=OwnerDevelopmentConfig(split_enabled=False, candidates=42,
+                                           develop_every=64, min_support=4),
+        reclosure_enabled=False, prospective_resource_cost=.25)
+
+
+def _real_commit(node, env):
+    env['native_runtime'].organism._commit()
+    return True, True
+
+
+class NativeModularOrganism:
+    """Three resident owned modules, native selected call, complete credit ledger."""
+
+    def __init__(self, accepted_actor, *, m1_plastic=False, learning=False,
+                 parent_seed='packet-a:parent', setup_seed='packet-a:setup'):
+        if type(m1_plastic) is not bool or type(learning) is not bool:
+            raise TypeError('explicit Boolean arm/execution permissions required')
+        if typed_schema_signature(accepted_actor.schema) != typed_schema_signature(SCHEMA):
+            raise ValueError('accepted original16-coordinate child required')
+        self.modules = {
+            'parent': fresh(PARENT_SCHEMA, PARENT_STATE_COORDINATES, parent_seed),
+            'setup': fresh(M2_SCHEMA, STATE_COORDINATES, setup_seed),
+            'm1': EpisodicSelectiveDevelopment.from_actor(accepted_actor,
+                max_episode_actions=2, action_invariant_credit=False)}
+        self.permissions = {
+            'parent': ModulePermissions(learning, True, learning, learning),
+            'setup': ModulePermissions(learning, True, learning, learning),
+            'm1': ModulePermissions(False, True, learning and m1_plastic, learning and m1_plastic)}
+        self.request_counter = 0
+        self.event_base = {m: max(-1, int(getattr(a, 'last_event', -1))) + 1
+                           for m, a in self.modules.items()}
+        self.episode_counter = 0
+        self.connections = dict(CONNECTIONS)
+        self.evaluation_control = None
+        self._build_runtime()
+        self.validate()
+
+    def _build_runtime(self, versions=None, ledger_state=None):
+        self.runtime = NativeInvocationGraph(self.modules)
+        self.runtime.organism = self
+        self.runtime.install_selected_gate('bridge:selected', source_scope='parent', connections=CONNECTIONS)
+        c = self.runtime.composer
+        c.add_bridge_node(Node('bridge:decision', NodeType.SCRIPT, meta={
+            'request_policy': 'ordered_sub', 'confirm_policy': 'forward_choice',
+            'forward_choice_source': 'bridge:selected'}))
+        c.add_bridge_node(Node('bridge:commit', NodeType.SCRIPT, meta={'confirm_policy': 'and'}))
+        c.add_bridge_node(Node('bridge:actuator', NodeType.TERMINAL, predicate=_real_commit))
+        c.add_hierarchy_pair('bridge:commit', 'bridge:actuator')
+        for child in (self.runtime.call_id('parent'), 'bridge:selected', 'bridge:commit'):
+            c.add_hierarchy_pair('bridge:decision', child)
+        c.remount()
+        if versions is not None:
+            if set(versions) != set(MODULE_IDS) or any(type(v) is not int or v < 0 for v in versions.values()):
+                raise ValueError('invalid saved structure versions')
+            c.structure_versions = dict(versions)
+        self.ledger = ModularCreditLedger(self.modules, permissions=self.permissions,
+            structure_version=self._version, remount=self._remount)
+        if ledger_state:
+            self.ledger.last_frames = ledger_state['last_frames']
+            self.ledger.last_commits = ledger_state['last_commits']
+            self.ledger.last_credit = ledger_state['last_credit']
+            self.ledger.development_history = ledger_state['development_history']
+            self.ledger.episodes_completed = ledger_state['episodes_completed']
+        self.authority = None
+        self.request = self.returned = None
+        self.ports = {}
+        self.traces = []
+        self.last_episode = None if ledger_state is None else ledger_state['last_episode']
+
+    def _version(self, module):
+        return self.runtime.composer.structure_versions[module]
+
+    def _remount(self, module, candidate):
+        self.runtime.composer.remount_candidate(module, candidate)
+
+    def validate(self):
+        if tuple(self.modules) != MODULE_IDS or tuple(self.permissions) != MODULE_IDS:
+            raise ValueError('missing/duplicate/reordered module registry')
+        for module, schema in (('parent', PARENT_SCHEMA), ('setup', M2_SCHEMA), ('m1', SCHEMA)):
+            actor = self.modules[module]
+            if typed_schema_signature(actor.schema) != typed_schema_signature(schema):
+                raise ValueError('typed schema mapping differs')
+            actor.validate_ownership()
+            expected_states = PARENT_STATE_COORDINATES if module=='parent' else STATE_COORDINATES
+            if tuple(actor.state_coordinates)!=tuple(expected_states):
+                raise ValueError('module state-reader coordinate meaning differs')
+            config = actor.config
+            if (config.learning_rate !=.3 or config.exploration !=.25 or config.eligibility_decay !=.8
+                    or config.prune_weight !=.02 or config.consolidate_every !=32
+                    or config.consolidation_rate !=.1 or actor.development_config.develop_every !=64
+                    or actor.development_config.min_support !=4):
+                raise ValueError('qualified ordinary credit/development configuration differs')
+            if actor.action_invariant_credit or actor.reclosure_enabled or actor.development_config.split_enabled:
+                raise ValueError('undeclared learning mechanism')
+            if (actor.ownership_limits.max_leaves !=1 or actor.ownership_limits.max_parameters !=96 or actor.ownership_limits.max_definitions !=512
+                    or actor.ownership_limits.max_physical_nodes !=32768):
+                raise ValueError('qualified per-scope limits differ')
+        if self.permissions['m1'].explore:
+            raise ValueError('child choice must be greedy in both arms')
+        self.ledger.validate_module_isolation()
+        self.runtime.graph.validate_formal_pairs()
+
+    def _make_port(self, module):
+        factory = {'parent': RequestFeaturePort, 'setup': DeferredSetupPort, 'm1': DeferredM1Port}[module]
+        port = factory(self.authority.board)
+        self.ports[module] = port
+        return port
+
+    def _capture(self, module, selection):
+        ordinal = len(self.ledger.commits) + 1
+        if module == 'parent':
+            connection = selection.action
+            selected = self.connections[connection]  # registry lookup, not child policy dispatch
+            self.request = ModuleRequest(self.current_request, 'parent', selected, connection,
+                self.authority.token, selected, self._version(selected), 'native', 'bridge:commit')
+            self.authority.register(self.request)
+            self.ports[module].execute(connection)
+        elif self.request is None or module != self.request.selected_module:
+            raise ValueError('unselected skill attempted a return')
+        self.ledger.capture(module, request_id=self.current_request, white_ordinal=ordinal,
+                            board_version=self.authority.version)
+        if module != 'parent':
+            self.ports[module].execute(selection.action)  # deferred, no board push
+            self.returned = ModuleReturn(self.current_request, module, module, self._version(module),
+                self.authority.token, selection.action, 'selected', 'native_choice.v1')
+
+    def _commit(self):
+        connection, scope, _ = self.runtime.selected_target('bridge:selected')
+        if self.evaluation_control =='disconnect_m1_no_fallback' and scope=='m1':
+            raise RuntimeError('EVALUATION_DISCONNECTED_RETURN: no real primitive or reward')
+        primitive = self.runtime.engine.emit_exactly_one_actuator('bridge:selected')
+        if (self.request != self.authority.pending or self.request.execution_mode !='native'
+                or self.request.structure_version !=self._version(scope)
+                or self.returned.primitive !=primitive
+                or self.runtime.selection(scope).action !=primitive):
+            raise ValueError('returned primitive/configuration differs from actual settled graph selection')
+        version = self.authority.version
+        commit = self.authority.commit(self.returned, graph_gate_confirmed=True,
+                                      selected_connection=connection, selected_scope=scope)
+        self.ledger.acknowledge_commit(request_id=commit.request_id,
+            white_ordinal=len(self.ledger.commits)+1, selected_module=scope, primitive=commit.primitive,
+            board_version=version, immediate_mate=commit.immediate_mate)
+        self.traces.append({'request': asdict(self.request), 'return': asdict(self.returned),
+            'commit': asdict(commit), 'selection': {m: asdict(v) for m,v in self.runtime.selections.items()},
+            'scores': {m: tuple((binding, self.modules[m].graph.nodes[f'option:{i}'].activation.value)
+                          for i,binding in enumerate(s.bindings)) for m,s in self.runtime.selections.items()},
+            'unboosted_scores': {m: tuple((binding,
+                self.modules[m].graph.nodes[f'option:{i}'].activation.value-dict(s.exploration).get(i,0.0))
+                for i,binding in enumerate(s.bindings)) for m,s in self.runtime.selections.items()},
+            'instantiated_ports': tuple(self.ports), 'native_gate':
+                dict(self.runtime.graph.nodes['bridge:selected'].meta)})
+
+    def begin_episode(self, board, *, max_white_actions, episode_id):
+        self.require_completed_barrier()
+        self.authority = BoardAuthority(board, connections=self.connections)
+        self.ledger.begin_episode(episode_id, max_white_actions=max_white_actions)
+        self.traces = []
+
+    def decide_and_commit(self, *, host_metadata=None):
+        """Metadata is accepted only for a boundary fixture; never read by graph."""
+        if not self.ledger.pending_episode or self.authority.pending is not None:
+            raise RuntimeError('new native decision requires a live episode with no pending request')
+        self.request_counter += 1
+        self.current_request = f'request:{self.request_counter}'
+        self.request = self.returned = None
+        self.ports = {}
+        self.runtime.begin_decision()
+        for module in MODULE_IDS:
+            permission = self.permissions[module]
+            self.runtime.configure_call(module, lambda module=module: self._make_port(module),
+                event_id=self.event_base[module]+self.request_counter-1,
+                explore=permission.explore, record=permission.record, on_capture=self._capture)
+        # ONLY formal selected_choice SUB requests the skill call site.
+        primitive = self.runtime.run('bridge:decision')
+        if self.authority.commit_history[-1].primitive != primitive:
+            raise RuntimeError('forwarded primitive differs from committed graph return')
+        return self.authority.commit_history[-1]
+
+    def finish_episode(self, *, eventual_mate, reason):
+        if self.authority.pending is not None:
+            raise RuntimeError('precommit technical failure cannot receive invented reward')
+        self.ledger.close_episode(eventual_mate=eventual_mate)
+        self.episode_counter += 1
+        self.last_episode = {'episode_id': self.episode_counter, 'reason': reason,
+            'eventual_mate': eventual_mate, 'traces': copy.deepcopy(self.traces),
+            'frames': self.ledger.last_frames, 'credit': self.ledger.last_credit,
+            'commits': self.ledger.last_commits, 'final_fen': self.authority.board.fen()}
+        self.authority = None
+        self.request = self.returned = None
+        self.ports = {}
+        self.runtime.configurations.clear()
+        self.runtime.environments.clear()
+        self.runtime.selections.clear()
+        self.require_completed_barrier()
+        return self.last_episode
+
+    def play_episode(self, fen, *, max_white_actions=2, episode_id=None, host_metadata=None):
+        board = _start(fen)
+        self.begin_episode(board, max_white_actions=max_white_actions,
+                           episode_id=episode_id or f'engineering:{self.episode_counter+1}')
+        reason = 'exercise_timeout'
+        for ordinal in range(1,max_white_actions+1):
+            self.decide_and_commit(host_metadata=host_metadata)
+            terminal = _terminal(board)
+            if terminal:
+                reason = terminal[0]
+                break
+            if ordinal == max_white_actions:
+                break
+            if not board.pieces(chess.ROOK, chess.WHITE):
+                reason = 'rook_captured'; break
+            self.authority.black_reply(choose_mate_horizon_reply(board))
+            terminal = _terminal(board)
+            if terminal:
+                reason = terminal[0]; break
+            if not board.pieces(chess.ROOK, chess.WHITE):
+                reason = 'rook_captured'; break
+        return self.finish_episode(eventual_mate=reason=='checkmate', reason=reason)
+
+    def require_completed_barrier(self):
+        self.ledger.require_completed_barrier()
+        if self.authority is not None and (self.authority.pending is not None or self.ledger.pending_episode):
+            raise RuntimeError('persistent checkpoints reject suspended calls/episodes')
+
+    def contract(self):
+        self.require_completed_barrier()
+        return {'definition': DEFINITION_VERSION, 'targets': TARGET_VERSION, 'permissions': PERMISSION_VERSION,
+            'module_ids': MODULE_IDS, 'connections': dict(CONNECTIONS),
+            'schemas': {m: typed_schema_signature(a.schema) for m,a in self.modules.items()},
+            'permission_values': self.permissions, 'versions': dict(self.runtime.composer.structure_versions),
+            'request_counter': self.request_counter, 'event_base':dict(self.event_base),
+            'episode_counter':self.episode_counter,
+            'caps': {'parameters':288,'definitions':1536,'module_nodes':98304,'bridge_nodes':64},
+            'ledger': self.ledger.checkpoint_contract()}
+
+    def __getstate__(self):
+        self.require_completed_barrier()
+        if self.evaluation_control is not None:
+            raise RuntimeError('laboratory interventions are evaluation-only, not persistent policies')
+        return {'contract':self.contract(), 'modules':self.modules, 'permissions':self.permissions,
+            'request_counter':self.request_counter, 'event_base':self.event_base,
+            'episode_counter':self.episode_counter, 'ledger_state':{
+                'last_frames':self.ledger.last_frames,'last_commits':self.ledger.last_commits,
+                'last_credit':self.ledger.last_credit,'development_history':self.ledger.development_history,
+                'episodes_completed':self.ledger.episodes_completed,'last_episode':self.last_episode}}
+
+    def __setstate__(self, state):
+        contract = state['contract']
+        if (contract['definition']!=DEFINITION_VERSION or contract['targets']!=TARGET_VERSION
+                or contract['permissions']!=PERMISSION_VERSION or contract['module_ids']!=MODULE_IDS
+                or contract['connections']!=CONNECTIONS or state['permissions']!=contract['permission_values']):
+            raise ValueError('corrupt mapping, target, permission or module checkpoint contract')
+        self.modules, self.permissions = state['modules'], state['permissions']
+        self.request_counter, self.event_base = state['request_counter'], state['event_base']
+        self.episode_counter = state['episode_counter']
+        if (any(type(v) is not int or v<0 for v in (self.request_counter,self.episode_counter))
+                or set(self.event_base)!=set(MODULE_IDS)
+                or any(type(v) is not int or v<0 for v in self.event_base.values())
+                or self.request_counter!=contract['request_counter']
+                or self.episode_counter!=contract['episode_counter'] or self.event_base!=contract['event_base']
+                or state['ledger_state']['episodes_completed']!=self.episode_counter):
+            raise ValueError('corrupt checkpoint counters or event identity registry')
+        self.connections = dict(CONNECTIONS)
+        self.evaluation_control = None
+        self._build_runtime(contract['versions'],state['ledger_state'])
+        self.validate()
+        if self.contract()!=contract:
+            raise ValueError('checkpoint complete definition/ledger binding differs')
+
+    def state_digest(self):
+        return digest(self.__getstate__())
+
+    def evaluation_copy(self):
+        """Isolated completed-barrier copy, greedy audit-only in all modules."""
+        self.require_completed_barrier()
+        result = copy.deepcopy(self)
+        result.permissions = {m: ModulePermissions(False, True, False, False) for m in MODULE_IDS}
+        result.ledger.permissions = dict(result.permissions)
+        result.validate()
+        return result
+
+    def apply_evaluation_control(self, mode):
+        """Output/connection interventions on an isolated greedy audit copy only."""
+        self.require_completed_barrier()
+        if mode not in ('disconnect_m1_no_fallback','replace_m1_with_setup'):
+            raise ValueError('undeclared laboratory control')
+        if any(p.explore or p.update or p.develop for p in self.permissions.values()):
+            raise ValueError('control cannot enter learning or exploratory execution')
+        self.evaluation_control = mode
+        if mode=='replace_m1_with_setup':
+            self.connections['connection:1']='setup'
+            gate = self.runtime.graph.nodes['bridge:selected']
+            gate.meta['selected_choice_connections']['connection:1']=self.runtime.call_id('setup')
+        self.runtime.graph.validate_formal_pairs()
+        return self
+
+
+def save_checkpoint(path, organism, *, runtime_identity):
+    organism.validate()
+    organism.require_completed_barrier()
+    path = Path(path)
+    body = pickle.dumps(organism,protocol=5)
+    with path.open('xb') as stream:
+        with gzip.GzipFile(filename='',fileobj=stream,mode='wb',mtime=0,compresslevel=1) as out:
+            out.write(body)
+    record = {'sha256':sha(path),'state_sha256':organism.state_digest(),
+              'contract_sha256':digest(organism.contract()),'source':source_pins(),
+              'runtime_identity':runtime_identity}
+    write_json(path.with_suffix('.json'),record)
+    return record
+
+
+def load_checkpoint(path, *, expected_sha256, expected_sidecar_sha256, current_runtime_identity):
+    """All transport/source/runtime authentication occurs BEFORE pickle load."""
+    path = Path(path)
+    if sha(path)!=expected_sha256 or sha(path.with_suffix('.json'))!=expected_sidecar_sha256:
+        raise ValueError('checkpoint transport/sidecar authentication failed')
+    record = json.loads(path.with_suffix('.json').read_text())
+    if record['sha256']!=expected_sha256 or record['runtime_identity']!=current_runtime_identity:
+        raise ValueError('native checkpoint/runtime binding differs before deserialization')
+    verify_source(record['source'])
+    with gzip.open(path,'rb') as stream:
+        actor = pickle.load(stream)
+    if (type(actor) is not NativeModularOrganism or actor.state_digest()!=record['state_sha256']
+            or digest(actor.contract())!=record['contract_sha256']):
+        raise ValueError('checkpoint native state/contract authentication failed')
+    actor.validate()
+    actor.require_completed_barrier()
+    return actor
