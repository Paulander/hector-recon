+def _same(actual, expected, label):
+    if json_bytes(canonical(actual)) != json_bytes(canonical(expected)):
+        raise ValueError('independent trajectory mismatch: ' + label)
+
+
+def snapshot(organism):
+    """Capture data, never a graph deepcopy or a mutable reference to its owner."""
+    organism.require_completed_barrier()
+    organism.validate()
+    modules = {}
+    for name, actor in organism.modules.items():
+        fields = {key: value for key, value in vars(actor).items()
+                  if key not in EXECUTION_FIELDS and not isinstance(value, random.Random)}
+        modules[name] = {
+            'fields': copy.deepcopy(fields), 'slots': actor.slots,
+            'expression_ids': dict(actor.expression_ids),
+            'graph_nodes': tuple(actor.graph.nodes),
+            'rng': {key: value.getstate() for key, value in vars(actor).items()
+                    if isinstance(value, random.Random)},
+            'class': type(actor).__module__ + '.' + type(actor).__qualname__,
+        }
+    return {'schema': SCHEMA, 'modules': modules,
+        'permissions': dict(organism.permissions),
+        'versions': dict(organism.runtime.composer.structure_versions),
+        'event_base': dict(organism.event_base),
+        'request_counter': organism.request_counter,
+        'episode_counter': organism.episode_counter,
+        'ledger_episodes': organism.ledger.episodes_completed,
+        'ledger_development': copy.deepcopy(organism.ledger.development_history),
+        'state_sha256': organism.state_digest()}
+
+
+def _expression(expression, readings, schema=None):
+    if type(expression) is not Expression:
+        raise ValueError('unsupported expression definition type')
+    op = expression.operator
+    if op == 'true':
+        if expression.children or expression.atom is not None:
+            raise ValueError('corrupt constant definition')
+        return True
+    if op == 'read':
+        if expression.children or type(expression.atom) is not tuple or len(expression.atom) != 2:
+            raise ValueError('corrupt reader definition')
+        i, wanted = expression.atom
+        if type(i) is not int or i not in readings or type(wanted) not in (bool, int):
+            raise ValueError('unsupported expression coordinate/atom')
+        if schema is not None and (not 0 <= i < len(schema) or not any(
+                type(value) is type(wanted) and value == wanted for value in schema[i].values)):
+            raise ValueError('unsupported expression typed domain')
+        value = readings[i]
+        if type(value) is not type(wanted):
+            raise ValueError('unsupported typed expression reading')
+        return value == wanted
+    if expression.atom is not None or type(expression.children) is not tuple or len(expression.children) < 2:
+        raise ValueError('corrupt composite definition')
+    children = tuple(_expression(child, readings, schema) for child in expression.children)
+    if op == 'and':
+        return all(children)
+    if op == 'or':
+        return any(children)
+    if op == 'xor':
+        return sum(children) == 1
+    raise ValueError('unsupported expression semantics: ' + str(op))
+
+
+def _compose(op, children):
+    children = tuple(children)
+    if op == 'xor' and len(set(children)) != len(children):
+        raise ValueError('duplicate exactly-one child')
+    ordered = tuple(sorted(set(children), key=repr))
+    if not ordered or op not in ('and', 'or', 'xor'):
+        raise ValueError('unsupported expression composition')
+    return ordered[0] if len(ordered) == 1 else Expression(op, ordered)
+
+
+def _negate(expression):
+    return _compose('xor', (TRUE, expression))
+
+
+def _split_add(evidence, enabled, residual):
+    if enabled:
+        evidence.n1 += 1
+        evidence.sum1 += residual
+    else:
+        evidence.n0 += 1
+        evidence.sum0 += residual
+
+
+def _split_score(evidence, minimum):
+    if min(evidence.n0, evidence.n1) < minimum:
+        return None
+    difference = evidence.sum1 / evidence.n1 - evidence.sum0 / evidence.n0
+    return evidence.n0 * evidence.n1 / (evidence.n0 + evidence.n1) * difference ** 2
+
+
+def _route_score(evidence, minimum):
+    keys = ((False, False), (False, True), (True, False), (True, True))
+    if evidence.variable < minimum or min(evidence.counts.get(k, 0) for k in keys) < minimum:
+        return None
+    means = {k: evidence.sums[k] / evidence.counts[k] for k in keys}
+    contrast = ((means[True, True] - means[True, False])
+                - (means[False, True] - means[False, False]))
+    return contrast * contrast / sum(1 / evidence.counts[k] for k in keys)
+
+
+def _gain(nomination, minimum):
+    val, first = nomination.validation, nomination.discovery
+    if min(val.n0, val.n1) < minimum:
+        return None
+    pooled = (first.sum0 + first.sum1) / (first.n0 + first.n1)
+    means = (first.sum0 / first.n0, first.sum1 / first.n1)
+    return sum(2 * (mean - pooled) * total - count * (mean * mean - pooled * pooled)
+               for mean, count, total in zip(means, (val.n0, val.n1), (val.sum0, val.sum1)))
+
+
+def _effective(weight):
+    """Independent binary64 sum; do not delegate to the native weight method."""
+    if type(weight.fast) is not float or type(weight.slow) is not float:
+        raise ValueError('unsupported weight scalar type')
+    value = weight.fast + weight.slow
+    if not math.isfinite(value):
+        raise ValueError('nonfinite effective weight')
+    return value
+
+
+def _stats(stats, *, active, cycle, reward):
+    # Preserve the predecessor's individual recomputation boundaries and order.
+    r, c, s = stats.relevance_stats, stats.credit_stats, stats.survival_stats
+    def recompute():
+        precision = 0.0 if r.activation_count == 0 else r.confirm_count / r.activation_count
+        coverage = 0.0 if r.request_exposures == 0 else r.activation_count / r.request_exposures
+        relevance = 0.0
+        relevance += .35 * precision
+        relevance += .25 * min(1.0, coverage)
+        relevance += .20 * min(1.0, r.parent_locality)
+        relevance += .20 * min(1.0, r.sibling_contrast)
+        if c.positive_intervention + c.negative_intervention + c.neutral_intervention > 0:
+            relevance += .25
+        s.maturity = min(1.0, relevance)
+        pressure = 0.0
+        if c.negative_intervention > c.positive_intervention:
+            pressure += .35
+        if r.request_exposures >= 3 and r.activation_count == 0:
+            pressure += .25
+        s.prune_pressure = min(1.0, pressure)
+        relevant = r.request_exposures > 0 and r.activation_count > 0 and (
+            r.confirm_count > 0 or r.parent_locality > 0.0 or r.sibling_contrast > 0.0)
+        if relevant and c.negative_intervention > 0 and c.positive_intervention == 0:
+            s.quarantine_reason = 'local_suppressor_candidate'
+    if active:
+        r.activation_count += 1
+        s.parent_locality = 'action_choice'; r.parent_locality = 1.0
+        recompute()
+        r.confirm_count += 1; s.last_confirm_cycle = int(cycle)
+        s.parent_locality = 'action_choice'; r.parent_locality = 1.0
+        recompute()
+        key = ('positive' if reward > 0 else 'negative' if reward < 0 else 'neutral') + '_correlation'
+        setattr(c, key, getattr(c, key) + 1)
+        recompute()
+    else:
+        r.request_exposures += 1
+        s.parent_locality = 'action_choice'; r.parent_locality = 1.0
+        recompute()
+
+
+class _Model:
+    """Data-only shadow of one scope; no learner method is attached."""
+    def __init__(self, entry):
+        self.f = copy.deepcopy(entry['fields'])
+        self.ids = dict(entry['expression_ids'])
+        self.slots = entry['slots']
+        self.nodes = set(entry['graph_nodes'])
+        self.rng = {}
+        for key, state in entry['rng'].items():
+            value = random.Random(); value.setstate(state); self.rng[key] = value
+        if entry['class'] != 'recon_lite_hector.learning.selective_episode.EpisodicSelectiveDevelopment':
+            raise ValueError('unsupported trajectory actor class')
+        if (self.f['action_invariant_credit'] or self.f['reclosure_enabled']
+                or self.f['development_config'].split_enabled or len(self.f['leaves']) != 1):
+            raise ValueError('unsupported trajectory learning/ownership semantics')
+
+    def physical(self, count, *, rebuild=False):
+        """Independent expression-ID/node allocation, without allocating a Graph."""
+        f = self.f; limits = f['ownership_limits']
+        if len(f['conditions']) > limits.max_parameters:
+            raise ValueError('ownership parameter/leaf budget exhausted')
+        if rebuild:
+            self.nodes = {'action_choice', 'catalog_root', 'catalog', 'execute', 'actuator'}
+            start = 0
+        else:
+            start = self.slots
+        def expr(expression, slot, owner):
+            if expression not in self.ids:
+                if len(self.ids) >= limits.max_definitions:
+                    raise ValueError('ownership definition budget exhausted')
+                self.ids[expression] = len(self.ids)
+            if len(self.nodes) >= limits.max_physical_nodes:
+                raise ValueError('ownership physical node budget exhausted')
+            nid = f'expr:{slot}:{self.ids[expression]}'
+            if expression.children:
+                nid += ':in:' + owner
+            if nid in self.nodes:
+                return
+            self.nodes.add(nid)
+            for child in expression.children:
+                expr(child, slot, nid)
+        for leaf in f['leaves'].values():
+            for cid in leaf.contributions:
+                base = f['base_expressions'][cid]
+                value = base if leaf.path == TRUE else _compose('and', (base, leaf.path))
+                if value.depth > limits.max_depth:
+                    raise ValueError('ownership expression depth budget exhausted')
+                f['expressions'][cid] = value
+        for slot in range(start, count):
+            self.nodes.update((f'option:{slot}', f'bias:{slot}', f'explore:{slot}'))
+            for cid in f['conditions']:
+                root = f'gate:{slot}:{cid}'; self.nodes.add(root)
+                expr(f['expressions'][cid], slot, root)
+        # The inherited compiler adds all owner, then birth, then action probes.
+        for prefix, expressions in (('owner', f['owner_candidates']),
+                                    ('birth', f['birth_expressions']),
+                                    ('action', f['action_readers'])):
+            for slot in range(count):
+                root = f'{prefix}-probe:{slot}'
+                if root in self.nodes:
+                    continue
+                self.nodes.add(root)
+                for expression in expressions:
+                    expr(expression, slot, root)
+        if len(self.nodes) > limits.max_physical_nodes:
+            raise ValueError('ownership physical node budget exhausted')
+        self.slots = max(self.slots, count)
+        if rebuild:
+            f['recursive_config'] = replace(f['recursive_config'],
+                max_definitions=limits.max_definitions,
+                max_physical_nodes=limits.max_physical_nodes)
+
+    def compatibility(self, owner, expression):
+        """Independent bounded categorical proof, including cache/order semantics."""
+        f = self.f; cfg = f['compatibility_config']
+        if not cfg.enabled:
+            return Verdict('disabled')
+        instructions, roots, domains = [], [], {}
+        visited = 0
+        for root in (f['leaves'][owner].path, expression):
+            stack, results = [(root, False)], []
+            while stack:
+                value, expanded = stack.pop()
+                if not expanded:
+                    visited += 1
+                    if visited > cfg.max_nodes or len(value.children) > cfg.max_nodes:
+                        return Verdict('unknown', reason='expression budget')
+                    if value.operator in ('read', 'true'):
+                        if value.operator == 'read':
+                            i, wanted = value.atom
+                            if i >= len(f['schema']):
+                                return Verdict('unknown', reason='undeclared reader')
+                            coordinate = f['schema'][i]
+                            if len(coordinate.values) > cfg.max_assignments:
+                                return Verdict('unknown', reason='domain budget')
+                            if not any(type(x) is type(wanted) and x == wanted for x in coordinate.values):
+                                return Verdict('unknown', reason='reader type/domain mismatch')
+                            domains[i] = (i, coordinate.name, type(wanted).__name__, coordinate.values)
+                            instruction = ('read', i, type(wanted).__name__, wanted)
+                        else:
+                            instruction = ('true',)
+                        instructions.append(instruction); results.append(len(instructions) - 1)
