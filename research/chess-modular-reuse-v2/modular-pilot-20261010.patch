+        losses = [episodes[i] for i in range(1, len(episodes)) if statuses[i-1] and not statuses[i]]
+        recoveries = [episodes[i] for i in range(1, len(episodes))
+            if statuses[i] and not statuses[i-1] and any(lost < episodes[i] for lost in losses)]
