@@ -0,0 +1,697 @@
+"""Offline semantic checking of one recorded native census.
+
+This module has no native organism, graph engine, checkpoint deserializer or
+learning imports.  It calculates declared terminal measurements and Boolean
+score dependencies from an externally authenticated data capsule.  A verified
+saved decision is not a second native execution.  The caller authenticates the
+checkpoint, reconstruction certificate, completed guards and transport before
+accepting the facts returned here.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+
+import chess
+
+CAPSULE_SCHEMA = 'modular-canary-evaluation-capsule.v1'
+CONNECTIONS = {'connection:0': 'setup', 'connection:1': 'm1'}
+SCOPES = ('parent', 'setup', 'm1')
+STATE_COORDINATES = (0, 2, 3, 4, 5, 10, 11, 14, 15)
+M1_NAMES = ('white_to_move', 'actuator_moves_rook', 'kings_file_distance',
+    'kings_rank_distance', 'rook_black_king_file_distance',
+    'rook_black_king_rank_distance', 'target_black_king_file_distance',
+    'target_black_king_rank_distance', 'target_white_king_file_distance',
+    'target_white_king_rank_distance', 'black_king_on_edge_file',
+    'black_king_on_edge_rank', 'target_aligned_black_king_file',
+    'target_aligned_black_king_rank', 'kings_aligned_file', 'kings_aligned_rank')
+M2_NAMES = M1_NAMES + ('target_current_rook_file_distance',
+    'target_current_rook_rank_distance', 'target_nearest_file_edge_distance',
+    'target_nearest_rank_edge_distance')
+BOOL_INDICES = frozenset((0, 1, 10, 11, 12, 13, 14, 15))
+
+
+class SemanticCensusError(ValueError):
+    """Malformed, false or unsupported evidence; no result may be accepted."""
+
+
+def require(value, message):
+    if not value:
+        raise SemanticCensusError(message)
+
+
+def json_digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'),
+        ensure_ascii=True, allow_nan=False).encode()).hexdigest()
+
+
+def _hex(value, label):
+    require(type(value) is str, label + ' must be an explicit binary64 hex string')
+    try:
+        number = float.fromhex(value)
+    except (TypeError, ValueError, OverflowError) as error:
+        raise SemanticCensusError(label + ' is not binary64') from error
+    require(math.isfinite(number) and number.hex() == value,
+            label + ' is nonfinite or not canonical binary64')
+    return number
+
+
+def _float_hex(value, label):
+    require(type(value) is float, label + ' must preserve a recorded binary64 float')
+    number = float(value)
+    require(math.isfinite(number), label + ' is not finite')
+    return number.hex()
+
+
+def _expected_schema(scope):
+    names = (tuple(M1_NAMES[index] for index in STATE_COORDINATES) +
+             ('outgoing_connection',)) if scope == 'parent' else (
+             M1_NAMES if scope == 'm1' else M2_NAMES)
+    rows = []
+    for index, name in enumerate(names):
+        original = STATE_COORDINATES[index] if scope == 'parent' and index < 9 else index
+        boolean = original in BOOL_INDICES and not (scope == 'parent' and index == 9)
+        values = [False, True] if boolean else ([0, 1] if scope == 'parent' and index == 9 else
+            list(range(4 if index in (18, 19) else 8)))
+        rows.append({'name': name, 'type': 'bool' if boolean else 'int', 'values': values})
+    return rows
+
+
+def _expression(expression, schema, values=None, depth=0):
+    require(type(expression) is dict and depth <= 4, 'unsupported expression shape/depth')
+    op = expression.get('operator')
+    if op == 'true':
+        require(set(expression) == {'operator'}, 'TRUE expression has undeclared fields')
+        return True
+    if op == 'read':
+        require(set(expression) == {'operator', 'coordinate', 'type', 'value'},
+                'reader expression has undeclared/missing fields')
+        index, expected = expression['coordinate'], expression['value']
+        require(type(index) is int and 0 <= index < len(schema), 'reader coordinate outside schema')
+        coordinate = schema[index]
+        require(expression['type'] == coordinate['type'] == type(expected).__name__
+                and any(type(v) is type(expected) and v == expected for v in coordinate['values']),
+                'reader typed atom differs from declared coordinate')
+        return True if values is None else type(values[index]) is type(expected) and values[index] == expected
+    require(op in ('and', 'or', 'xor') and set(expression) == {'operator', 'children'},
+            'unsupported Boolean semantics')
+    children = expression['children']
+    require(type(children) is list and len(children) >= 2, 'Boolean composition needs distinct children')
+    keys = [json_digest(child) for child in children]
+    require(len(keys) == len(set(keys)), 'duplicate Boolean child definitions')
+    truth = [_expression(child, schema, values, depth + 1) for child in children]
+    if values is None:
+        return True
+    return all(truth) if op == 'and' else any(truth) if op == 'or' else sum(truth) == 1
+
+
+def validate_capsule(capsule):
+    """Validate the portable language; external authentication remains required."""
+    require(type(capsule) is dict and set(capsule) == {'schema', 'bindings', 'request_counter',
+        'episode_counter', 'event_base', 'versions', 'connections', 'scopes',
+        'score_blueprint_verified', 'bridge_blueprint_sha256', 'payload_sha256'}, 'capsule fields differ')
+    require(capsule['schema'] == CAPSULE_SCHEMA and capsule['score_blueprint_verified'] is True,
+            'unsupported or unvalidated scoring capsule')
+    body = {key: value for key, value in capsule.items() if key != 'payload_sha256'}
+    require(json_digest(body) == capsule['payload_sha256'], 'capsule payload binding differs')
+    require(type(capsule['bridge_blueprint_sha256']) is str and len(capsule['bridge_blueprint_sha256']) == 64
+            and all(c in '0123456789abcdef' for c in capsule['bridge_blueprint_sha256']),
+            'composed/bridge blueprint is unbound')
+    bindings = capsule['bindings']
+    require(type(bindings) is dict, 'capsule binding is not a dictionary')
+    for name in ('snapshot_sha256', 'source_pin_sha256', 'runtime_identity_sha256'):
+        value = bindings.get(name)
+        require(type(value) is str and len(value) == 64 and all(c in '0123456789abcdef' for c in value),
+                'missing authenticated capsule binding: ' + name)
+    require(type(capsule['connections']) is dict and capsule['connections'] == CONNECTIONS
+            and type(capsule['scopes']) is dict and set(capsule['scopes']) == set(SCOPES),
+            'capsule scope/connection registry differs')
+    for name in ('request_counter', 'episode_counter'):
+        require(type(capsule[name]) is int and capsule[name] >= 0, 'invalid capsule counter')
+    for name in ('event_base', 'versions'):
+        require(type(capsule[name]) is dict and set(capsule[name]) == set(SCOPES)
+                and all(type(v) is int and v >= 0 for v in capsule[name].values()),
+                'invalid capsule version/event mapping')
+    for scope, actor in capsule['scopes'].items():
+        require(type(actor) is dict and set(actor) == {'schema', 'legacy_bias', 'conditions',
+            'owner', 'state_coordinates', 'score_term_order', 'graph_blueprint_sha256'},
+                'scope capsule fields differ')
+        expected = _expected_schema(scope)
+        require(actor['schema'] == expected and all(
+            type(a['values'][i]) is type(b['values'][i]) for a, b in zip(actor['schema'], expected)
+            for i in range(len(b['values']))), 'scope typed measurement schema differs')
+        require(_hex(actor['legacy_bias'], 'legacy bias') == 0., 'owned scorer legacy bias is not zero')
+        conditions = actor['conditions']
+        require(type(conditions) is list and 1 <= len(conditions) <= 96,
+                'unsupported owned contributor count')
+        ids = []
+        for row in conditions:
+            require(type(row) is dict and set(row) == {'identity', 'owner', 'fast', 'slow', 'effective',
+                'expression', 'owned_bias'}, 'condition capsule fields differ')
+            require(type(row['identity']) is int and row['identity'] >= 0 and type(row['owner']) is int,
+                    'condition identity must be module scoped integer')
+            ids.append(row['identity'])
+            fast, slow = _hex(row['fast'], 'fast weight'), _hex(row['slow'], 'slow weight')
+            effective = _hex(row['effective'], 'effective weight')
+            require(math.isfinite(fast + slow), 'effective weight overflows binary64')
+            require((fast + slow).hex() == row['effective'], 'effective fast/slow arithmetic differs')
+            _expression(row['expression'], actor['schema'])
+            require(type(row['owned_bias']) is bool, 'typed owned bias flag required')
+        owner = actor['owner']
+        require(type(owner) is dict and set(owner) == {'identity', 'contributions', 'bias_id', 'path'}
+                and type(owner['identity']) is int and owner['identity'] >= 0
+                and type(owner['bias_id']) is int and owner['bias_id'] >= 0,
+                'unsupported decision owner')
+        require(len(ids) == len(set(ids)) and type(owner['contributions']) is list
+                and all(type(cid) is int for cid in owner['contributions'])
+                and len(owner['contributions']) == len(set(owner['contributions']))
+                and set(owner['contributions']) == set(ids)
+                and all(c['owner'] == owner['identity'] for c in conditions), 'contributor ownership/order differs')
+        require(owner['path'] == {'operator': 'true'}, 'unsupported nonconstant owner routing')
+        biases = [c for c in conditions if c['owned_bias']]
+        require(len(biases) == 1 and biases[0]['identity'] == owner['bias_id']
+                and biases[0]['expression'] == {'operator': 'true'}, 'owned TRUE bias is missing')
+        require(type(actor['state_coordinates']) is list and all(type(i) is int for i in actor['state_coordinates'])
+                and actor['state_coordinates'] == list(range(9) if scope == 'parent' else STATE_COORDINATES),
+                'state coordinate mapping differs')
+        require(type(actor['score_term_order']) is list and len(actor['score_term_order']) == len(ids) + 2
+                and actor['score_term_order'][:2] == ['bias', 'explore']
+                and all(type(i) is int for i in actor['score_term_order'][2:])
+                and actor['score_term_order'] == ['bias', 'explore'] + ids,
+                'compiled scoring term order differs')
+        require(type(actor['graph_blueprint_sha256']) is str and len(actor['graph_blueprint_sha256']) == 64
+                and all(c in '0123456789abcdef' for c in actor['graph_blueprint_sha256']),
+                'scoring graph blueprint is unbound')
+    return capsule
+
+
+def measurements(board, binding, scope):
+    """Independent implementation of the pinned 9+argument /16/20 sensors."""
+    wk, bk = board.king(chess.WHITE), board.king(chess.BLACK)
+    rooks = tuple(board.pieces(chess.ROOK, chess.WHITE))
+    require(wk is not None and bk is not None and len(rooks) == 1, 'declared KRK observation required')
+    wr = rooks[0]
+    wx, wy = chess.square_file(wk), chess.square_rank(wk)
+    bx, by = chess.square_file(bk), chess.square_rank(bk)
+    rx, ry = chess.square_file(wr), chess.square_rank(wr)
+    if scope == 'parent':
+        require(binding in CONNECTIONS, 'unregistered request binding')
+        return (board.turn == chess.WHITE, abs(wx-bx), abs(wy-by), abs(rx-bx), abs(ry-by),
+            bx in (0, 7), by in (0, 7), wx == bx, wy == by, int(binding == 'connection:1'))
+    require(scope in ('setup', 'm1'), 'unsupported skill measurement scope')
+    try:
+        move = chess.Move.from_uci(binding)
+    except (TypeError, ValueError) as error:
+        raise SemanticCensusError('invalid observed primitive') from error
+    require(move in board.legal_moves, 'observed primitive is not legal in actual frame')
+    tx, ty = chess.square_file(move.to_square), chess.square_rank(move.to_square)
+    values = (board.turn == chess.WHITE, board.piece_type_at(move.from_square) == chess.ROOK,
+        abs(wx-bx), abs(wy-by), abs(rx-bx), abs(ry-by), abs(tx-bx), abs(ty-by),
+        abs(tx-wx), abs(ty-wy), bx in (0, 7), by in (0, 7), tx == bx, ty == by,
+        wx == bx, wy == by)
+    return values if scope == 'm1' else values + (
+        abs(tx-rx), abs(ty-ry), min(tx, 7-tx), min(ty, 7-ty))
+
+
+def expected_score_inputs(capsule, scope, board):
+    """Calculate all legal options without native selection or action execution."""
+    actor = capsule['scopes'][scope]
+    bindings = tuple(CONNECTIONS) if scope == 'parent' else tuple(sorted(m.uci() for m in board.legal_moves))
+    require(board.turn == chess.WHITE and bindings, 'a live White choice menu is required')
+    rows, actives = [], []
+    for slot, binding in enumerate(bindings):
+        values = measurements(board, binding, scope)
+        terms = [(f'bias:{slot}', 'CONFIRMED', 1.0.hex(), actor['legacy_bias']),
+                 (f'explore:{slot}', 'CONFIRMED', 0.0.hex(), 1.0.hex())]
+        active, products = [], [float.fromhex(actor['legacy_bias']), 0.]
+        for condition in actor['conditions']:
+            enabled = _expression(condition['expression'], actor['schema'], values)
+            terms.append((f"gate:{slot}:{condition['identity']}",
+                'CONFIRMED' if enabled else 'FAILED', 1.0.hex(), condition['effective']))
+            if enabled:
+                active.append(condition['identity'])
+                products.append(float.fromhex(condition['effective']) * 1.0)
+        q = math.fsum(products)
+        rows.append((binding, q.hex(), tuple(terms)))
+        actives.append(tuple(active))
+    winner = max(range(len(rows)), key=lambda i: (float.fromhex(rows[i][1]), f'option:{i}'))
+    return tuple(rows), winner, tuple(actives)
+
+
+def _check_score_rows(expected, actual):
+    require(type(actual) in (tuple, list) and len(actual) == len(expected), 'complete legal score menu differs')
+    for wanted, row in zip(expected, actual):
+        require(type(row) in (tuple, list) and len(row) == 3 and row[0] == wanted[0]
+                and row[1] == wanted[1], 'independent legal binding/score differs')
+        terms = row[2]
+        require(type(terms) in (tuple, list) and len(terms) == len(wanted[2]),
+                'omitted/extra scoring contributor')
+        for want, term in zip(wanted[2], terms):
+            require(type(term) in (tuple, list) and tuple(term) == want,
+                    'independent activation/state/weight/term order differs')
+
+
+def board_token(board, version):
+    require(type(version) is int and version >= 0, 'invalid authority version')
+    body = (version, board.fen(), tuple(move.uci() for move in board.move_stack))
+    return hashlib.sha256(json.dumps(body, separators=(',', ':')).encode()).hexdigest()
+
+
+def _require_krk(board, *, live=True, claim_draw=True):
+    require(type(board) is chess.Board and board.is_valid() and board.turn == chess.WHITE,
+            'valid White-to-move board required')
+    material = sorted((piece.piece_type, piece.color) for piece in board.piece_map().values())
+    require(material == sorted(((chess.KING, True), (chess.ROOK, True), (chess.KING, False))),
+            'exact declared three-piece KRK material required')
+    if live:
+        require(not board.is_game_over(claim_draw=claim_draw), 'live declared KRK frame required')
+
+
+def _terminal(board):
+    if board.is_checkmate():
+        return ('checkmate', True) if board.turn == chess.BLACK else ('lost', False)
+    if board.is_game_over(claim_draw=True):
+        return 'draw', False
+    if not board.pieces(chess.ROOK, chess.WHITE):
+        return 'rook_captured', False
+    return None
+
+
+def _orbit(board):
+    squares = (board.king(chess.WHITE), next(iter(board.pieces(chess.ROOK, chess.WHITE))), board.king(chess.BLACK))
+    images = []
+    for reflect in (False, True):
+        for rotations in range(4):
+            image = []
+            for square in squares:
+                x, y = chess.square_file(square), chess.square_rank(square)
+                if reflect:
+                    x = 7-x
+                for _ in range(rotations):
+                    x, y = 7-y, x
+                image.append(chess.square(x, y))
+            images.append(tuple(image))
+    return ','.join(str(v) for v in min(images))
+
+
+def verify_standalone_m1(capsule, record, *, validated=False):
+    if not validated:
+        validate_capsule(capsule)
+    require(type(record) is dict and set(record) == {'fen', 'action', 'prediction_hex', 'bindings',
+        'score_inputs', 'after_fen', 'mate'}, 'unsupported standalone M1 evidence schema/fields')
+    board = chess.Board(record['fen'])
+    _require_krk(board, claim_draw=False)
+    rows, winner, _ = expected_score_inputs(capsule, 'm1', board)
+    _check_score_rows(rows, record['score_inputs'])
+    bindings = tuple(row[0] for row in rows)
+    require(type(record['bindings']) in (tuple, list) and all(type(value) is str for value in record['bindings'])
+            and tuple(record['bindings']) == bindings and record['action'] == bindings[winner]
+            and record['prediction_hex'] == rows[winner][1], 'standalone greedy STRING-ID choice differs')
+    board.push_uci(bindings[winner])
+    mate = board.turn == chess.BLACK and board.is_checkmate()
+    require(record['after_fen'] == board.fen() and type(record['mate']) is bool and record['mate'] == mate,
+            'standalone saved transition/outcome differs')
+    return {'fen': record['fen'], 'action': bindings[winner], 'mate': mate,
+            'after_fen': board.fen(), 'legal_options': len(rows),
+            'ordered_terms': sum(len(row[2]) for row in rows), 'native_executions': 0}
+
+
+def verify_decision(capsule, record, board, version, ordinal=1, *,
+                    expected_request_counter=None, validated=False):
+    """Verify one committed request and return its independently advanced board."""
+    if not validated:
+        validate_capsule(capsule)
+    _require_krk(board)
+    require(type(record) is dict and set(record) == {'trace', 'score_inputs'},
+            'native decision evidence fields differ')
