@@ -0,0 +1,116 @@
+"""Explicit append-only migration of a completed selective M1 actor.
+
+The caller verifies the original checkpoint bytes against its accepted lineage
+manifest before deserializing. This function records that supplied identity and
+returns a private copy; it neither opens nor overwrites checkpoint files. Added
+readers enter the existing generic action-reader proposal/evidence mechanism.
+No contributor, weight, solution branch or historical observation is created.
+"""
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+import re
+
+from recon_lite_hector.learning.recursive_context import Expression
+from recon_lite_hector.learning.refining_route_action import (
+    ProspectiveRefiningRouteActionDevelopment,
+)
+
+from .m2_schema import (
+    M1_SCHEMA_VERSION, M2_SCHEMA, M2_SCHEMA_VERSION, schema_manifest, schema_version,
+)
+from .selective import STATE_COORDINATES
+from .terminal import SCHEMA
+
+
+@dataclass(frozen=True)
+class SensorSchemaMigration:
+    version: str
+    source_schema: str
+    destination_schema: str
+    source_schema_sha256: str
+    destination_schema_sha256: str
+    source_checkpoint_sha256: str
+    source_identity: str
+    source_actor_type: str
+    source_completed: int
+    source_last_event: int
+    preserved_coordinates: int
+    appended_coordinates: tuple[str, ...]
+    appended_action_readers: int
+
+
+def _action_readers(schema, state_coordinates):
+    # Same exhaustive equality grammar and ordering as RouteActionBudDevelopment.
+    return tuple(Expression("read", atom=(index, value))
+                 for index, coordinate in enumerate(schema)
+                 if index not in state_coordinates for value in coordinate.values)
+
+
+def migrate_m1_schema(source, *, source_checkpoint_sha256: str, source_identity: str):
+    """Return a completed actor with an explicit, provenance-bound v2 schema.
+
+    Old reader indices and all action-bound evidence keep their identities. New
+    equality readers are appended with no evidence or scoring edge. The ordinary
+    birth candidate pool is retained verbatim; the existing route/action budding
+    law can discover the appended dimensions from future actual observations.
+    RNGs are copied without draws. Resource limits remain those of the source.
+    This promises initial equivalence, not future trajectory equivalence.
+    """
+    if not isinstance(source, ProspectiveRefiningRouteActionDevelopment):
+        raise TypeError("migration requires a selective prospective actor")
+    if schema_version(source.schema) != M1_SCHEMA_VERSION:
+        raise ValueError("migration requires the exact legacy sixteen-coordinate schema")
+    if getattr(source, "sensor_schema_version", M1_SCHEMA_VERSION) != M1_SCHEMA_VERSION:
+        raise ValueError("source schema version disagrees with its typed coordinates")
+    if getattr(source, "sensor_schema_migration", None) is not None:
+        raise ValueError("source already has sensor migration provenance")
+    if (not isinstance(source_checkpoint_sha256, str)
+            or re.fullmatch(r"[0-9a-f]{64}", source_checkpoint_sha256) is None):
+        raise ValueError("source checkpoint requires a lowercase SHA-256 identity")
+    if not isinstance(source_identity, str) or not source_identity.strip():
+        raise ValueError("source requires its accepted lineage identity")
+    if source.state_coordinates != frozenset(STATE_COORDINATES):
+        raise ValueError("migration requires unchanged declared state coordinates")
+    expected = _action_readers(SCHEMA, source.state_coordinates)
+    if source.action_readers != expected:
+        raise ValueError("source action-reader grammar/order differs from the legacy schema")
+
+    # Invoke the complete inherited checkpoint contract before copying. The
+    # episodic extension (when present) also rejects pending saved frames here.
+    source.__getstate__()
+    source.validate_ownership()
+    actor = copy.deepcopy(source)
+    actor.schema = M2_SCHEMA
+    actor.action_readers = _action_readers(M2_SCHEMA, actor.state_coordinates)
+    appended = actor.action_readers[len(expected):]
+    for slot in range(actor.slots):
+        root = f"action-probe:{slot}"
+        if (root not in actor.graph.nodes
+                or len(actor.action_probe_nodes.get(slot, ())) != len(expected)):
+            raise ValueError("source action-reader execution instances are incomplete")
+        nodes = list(actor.action_probe_nodes[slot])
+        for expression in appended:
+            node = actor._expression_node(expression, slot, root)
+            actor.graph.add_hierarchy_pair(root, node)
+            nodes.append(node)
+        actor.action_probe_nodes[slot] = tuple(nodes)
+    actor.validate_ownership()
+    actor.sensor_schema_version = M2_SCHEMA_VERSION
+    actor.sensor_schema_migration = SensorSchemaMigration(
+        version="selective_m1_sensor_migration.v1",
+        source_schema=M1_SCHEMA_VERSION,
+        destination_schema=M2_SCHEMA_VERSION,
+        source_schema_sha256=schema_manifest(M1_SCHEMA_VERSION)["sha256"],
+        destination_schema_sha256=schema_manifest(M2_SCHEMA_VERSION)["sha256"],
+        source_checkpoint_sha256=source_checkpoint_sha256,
+        source_identity=source_identity,
+        source_actor_type=f"{type(source).__module__}.{type(source).__qualname__}",
+        source_completed=source.completed,
+        source_last_event=source.last_event,
+        preserved_coordinates=len(SCHEMA),
+        appended_coordinates=tuple(coordinate.name for coordinate in M2_SCHEMA[len(SCHEMA):]),
+        appended_action_readers=len(appended),
+    )
+    return actor
