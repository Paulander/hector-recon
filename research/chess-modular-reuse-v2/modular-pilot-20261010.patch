+            'first_successful_census': next((episode for episode, value in zip(episodes, statuses) if value), None),
+            'loss_censuses': losses, 'recovery_censuses': recoveries})
+    transitions = []
+    for old, new in zip(episodes, episodes[1:]):
+        gained, lost = successful[new] - successful[old], successful[old] - successful[new]
+        transitions.append({'from': old, 'to': new, 'gained_boards': sorted(gained), 'lost_boards': sorted(lost),
+            'gained_orbits': sorted({rows[new][fen]['orbit'] for fen in gained}),
