+            and census['parent_m1_mates'] == 1512 for census in censuses.values()),
+        'persistent_new_m2_eight_two_orbits': len(persistent) >= 8 and len(orbits) >= 2,
+        'late_m2_net_eight': all(len(successes[episode]) >= len(baseline) + 8 for episode in (192, 256)),
+        'qualified_native_reuse_eight_two_orbits': len(qualifying) == 8 and len(qualifying_orbits) >= 2,
+        'real_positive_m2_receipt': learning_evidence.get('positive_m2_receipts', 0) > 0,
+        'subsequent_nonzero_born_or_refined_parent_credit': learning_evidence.get('parent_post_birth_nonzero_credit', 0) > 0,
+        'subsequent_nonzero_born_or_refined_setup_credit': learning_evidence.get('setup_post_birth_nonzero_credit', 0) > 0,
+        'complete_dependence_controls': complete,
