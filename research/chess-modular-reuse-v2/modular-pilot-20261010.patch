index 0000000..913a69f
--- /dev/null
+++ b/src/recon_lite_chess/coach/modular_evaluation_m1_batch.py
@@ -0,0 +1,382 @@
+"""Opt-in resident standalone M1 evaluation with deferred batch acceptance.
+
+One completed authenticated source supplies one private child. Every board is
+submitted to its unchanged native ``act(..., learn=False)`` and terminal. No
+choice, score, outcome or terminal reading is reused to select an action.
+
+The pinned laboratory trust interval excludes concurrent/source/private writers
+and dispatch monkeypatches. Expensive exact checks run at entry and acceptance,
+not before every position. Persistent unexpected mutation or an exception poisons
+the whole batch and revokes its acceptance handles. This is not adversarial
+Python isolation or protection against change-and-restore attacks.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import math
+from types import MappingProxyType
+
+import chess
+
+from recon_lite.formal_engine import FormalReConEngine
+from recon_lite.graph import Graph, LinkType, Node, NodeState
+from recon_lite_hector.learning.selective_episode import EpisodicSelectiveDevelopment
+from recon_lite_hector.learning.terminal_development import TerminalDevelopment, typed_schema_signature
+
+from .m2_evidence import canonical, digest, json_bytes
+from .modular_evaluation_child import (
+    completed_m1_evaluation_copy, child_learning_digest, _reject_composed_objects,
+)
+from .modular_evaluation_isolation import assert_no_source_alias
+from .modular_evaluation_workspace import _graph_stamp
+from .modular_evaluation_streaming_digest import plain_json_digest
+from .native_modular import MODULE_IDS, NativeModularOrganism
+from .terminal import ChessFeaturePort, SCHEMA
+
+
+class M1BatchInvalidated(ValueError):
+    """No buffered result from this failed laboratory batch is accepted."""
+
+
+_REPLICA_MAPS = ('expression_ids', 'probe_nodes', 'birth_probe_nodes', 'action_probe_nodes')
+_METHODS = ('act', '_reset', '_ensure_slots', '_before_execute')
+
+
+def _dispatch_signature():
+    # Function/descriptor identities, not only their qualified-name strings.
+    classes = (*EpisodicSelectiveDevelopment.__mro__[:-1], FormalReConEngine,
+               Graph, ChessFeaturePort, NativeModularOrganism)
+    return tuple((cls, tuple((name, id(value)) for name, value in vars(cls).items()
+        if callable(value) or isinstance(value, (classmethod, staticmethod, property))))
+        for cls in classes)
+
+
+def _complete_graph_stamp(actor):
+    """Retain the old strict stamp and add ordered node/container type checks."""
+    graph = actor.graph
+    if type(graph) is not Graph or type(graph.nodes) is not dict or type(graph.edges) is not list:
+        raise M1BatchInvalidated('native graph/container class changed')
+    if any(type(key) is not str or type(node) is not Node or key != node.nid
+           or type(node.meta) is not dict for key, node in graph.nodes.items()):
+        raise M1BatchInvalidated('native ordered node identity or metadata type changed')
+    return (_graph_stamp(actor), id(graph.nodes), id(graph.edges),
+            tuple((key, id(node)) for key, node in graph.nodes.items()),
+            tuple((node.nid, canonical(node.activation.value))
+                  for node in graph.nodes.values() if 'condition_id' in node.meta))
+
+
+def _replica_signature(actor):
+    result = []
+    for name in _REPLICA_MAPS:
+        mapping = getattr(actor, name)
+        if type(mapping) is not dict:
+            raise M1BatchInvalidated('native replica map must remain ordered dict: ' + name)
+        if name == 'expression_ids':
+            if any(type(value) is not int or value < 0 for value in mapping.values()):
+                raise M1BatchInvalidated('typed expression definition index changed')
+        elif any(type(key) is not int or not 0 <= key < actor.slots
+                or type(value) is not tuple or any(type(nid) is not str
+                    or nid not in actor.graph.nodes for nid in value)
+                for key, value in mapping.items()):
+            raise M1BatchInvalidated('typed native probe index changed: ' + name)
+        result.append((name, tuple((canonical(key), canonical(value)) for key, value in mapping.items())))
+    return tuple(result)
+
+
+def _score_inputs(actor, bindings):
+    """Passive exact recording after selection; never supplies scores to choice."""
+    rows = []
+    for slot, binding in enumerate(bindings):
+        option = f'option:{slot}'
+        inputs, numerical = [], []
+        for nid in actor.graph.children(option):
+            node = actor.graph.nodes[nid]
+            weight = float(actor.graph.edge_by_key[(nid, option, LinkType.SUR)].w)
+            activation = float(node.activation.value)
+            inputs.append((nid, node.state.name, activation.hex(), weight.hex()))
+            if node.state == NodeState.CONFIRMED:
+                numerical.append(weight * activation)
+        actual = float(actor.graph.nodes[option].activation.value)
+        if math.fsum(numerical).hex() != actual.hex():
+            raise M1BatchInvalidated('passive ordered binary64 score arithmetic differs')
+        rows.append((binding, actual.hex(), tuple(inputs)))
+    return tuple(rows)
+
+
+class AcceptedM1Batch:
+    """Revocable release handle: a failed/reused batch cannot release old results."""
+    def __init__(self, owner, generation):
+        self._owner, self._generation = owner, generation
+
+    def _check(self):
+        if self._owner._state != 'ACCEPTED' or self._generation != self._owner._generation:
+            raise M1BatchInvalidated('stale or invalidated standalone M1 acceptance handle')
+
+    def results(self):
+        return self._release(lambda: tuple(copy.deepcopy(self._owner._results)))
+
+    def _release(self, make_copy):
+        # Output copying/serialization is part of the acceptance contract, not
+        # native execution. Any unexpected release exception revokes all handles.
+        try:
+            self._check()
+            result = make_copy()
+            json_bytes(result)
+            return result
+        except BaseException as error:
+            if self._owner._state == 'INVALIDATED':
+                raise
+            self._owner._poison('accepted standalone M1 result release failed', cause=error)
+
+    def record(self, index=None):
+        def release():
+            if index is not None:
+                if type(index) is not int or not 0 <= index < len(self._owner._results):
+                    self._owner._poison('invalid accepted result index')
+                return copy.deepcopy(self._owner._results[index])
+            return {**copy.deepcopy(self._owner._acceptance),
+                    'results': tuple(copy.deepcopy(self._owner._results))}
+        return self._release(release)
+
+
+class StandaloneM1Batch:
+    """One resident no-learning child; outputs remain unaccepted until closure.
+
+    ``binding_check`` performs actual source/runtime authentication at entry and
+    before acceptance. It is mandatory; three hash strings are not authentication.
+    Access to ``child`` exists for offline qualification only. The trusted batch
+    owner must not mutate it or the source between those boundaries.
+    """
+    def __init__(self, source, *, source_binding, binding_check):
+        if type(source) is not NativeModularOrganism or not callable(binding_check):
+            raise TypeError('authenticated exact completed native source and binding check required')
+        required = {'snapshot_sha256', 'source_pin_sha256', 'runtime_identity_sha256'}
+        if (set(source_binding) != required or any(type(value) is not str or len(value) != 64
+                or any(char not in '0123456789abcdef' for char in value)
+                for value in source_binding.values())):
+            raise ValueError('three explicit SHA256 snapshot/source/runtime bindings required')
+        source.require_completed_barrier()
+        source.validate()
+        if source.state_digest() != source_binding['snapshot_sha256']:
+            raise M1BatchInvalidated('source snapshot binding differs before batch copy')
+        self._binding = MappingProxyType(dict(source_binding))
+        self._binding_check = binding_check
+        binding_check(self._binding)
+        self._source = source
+        self._source_digest = source.state_digest()
+        self._source_contract = digest(source.contract())
+        self._source_graphs = {scope: _complete_graph_stamp(actor)
+                               for scope, actor in source.modules.items()}
+        self._source_actor_ids = tuple(id(actor) for actor in source.modules.values())
+        self._source_permissions = dict(source.permissions)
+        self._child = completed_m1_evaluation_copy(source)
+        self._learning = child_learning_digest(self._child)
+        self._graph = _complete_graph_stamp(self._child)
+        self._replicas = _replica_signature(self._child)
+        self._observations = canonical(self._child.last_route_observations)
+        self._dispatch = _dispatch_signature()
+        self._methods = {name: getattr(self._child, name).__func__ for name in _METHODS}
+        self._terminal_act = TerminalDevelopment.act
+        self._config_ids = tuple(id(getattr(self._child, name)) for name in
+                                 ('config', 'ownership_limits', 'development_config'))
+        self._counters = tuple(getattr(self._child, name) for name in
+                               ('completed', 'last_event', 'episodes_completed'))
+        self._state, self._generation = 'OPEN', 0
+        self._results = []
+        self._acceptance = None
+        self._metrics = {'complete_child_copies': 1, 'evaluations': 0,
+            'native_calls_started': 0, 'native_white_commits': 0, 'ordinary_resets': 0,
+            'binding_expansion_checks': 0, 'entry_integrity_checks': 1,
+            'acceptance_integrity_checks': 0, 'failed_batches': 0,
+            'action_score_outcome_cache_hits': 0}
+        self._cheap_boundary()
+        self._full_integrity()
+
+    @property
+    def child(self):
+        return self._child
+
+    @property
+    def source_binding(self):
+        return self._binding
+
+    @property
+    def metrics(self):
+        return dict(self._metrics)
+
+    @property
+    def status(self):
+        return self._state
+
+    def __getstate__(self):
+        raise RuntimeError('resident evaluation batch is ephemeral, never a native checkpoint')
+
+    def _poison(self, message, *, cause=None):
+        if self._state != 'INVALIDATED':
+            self._metrics['failed_batches'] += 1
+        self._state = 'INVALIDATED'
+        self._generation += 1
+        self._results.clear()
+        self._acceptance = None
+        error = M1BatchInvalidated(message)
+        if cause is not None:
+            raise error from cause
+        raise error
+
+    def invalidate(self, message='explicit standalone M1 batch rejection'):
+        self._poison(message)
+
+    def _cheap_boundary(self):
+        if self._state == 'INVALIDATED':
+            raise M1BatchInvalidated('standalone M1 batch was invalidated')
+        child, source = self._child, self._source
+        if (type(child) is not EpisodicSelectiveDevelopment or type(child.graph) is not Graph
+                or id(child.graph) != self._graph[0].identities[0]
+                or type(child.slots) is not int or child.slots != self._graph[0].slots
+                or tuple(source.modules) != MODULE_IDS or tuple(source.permissions) != MODULE_IDS
+                or tuple(id(actor) for actor in source.modules.values()) != self._source_actor_ids
+                or source.permissions != self._source_permissions
+                or source.evaluation_control is not None or source.authority is not None
+                or source.request is not None or source.returned is not None):
+            self._poison('typed child/source identity, completed mapping or permissions changed')
+        if (typed_schema_signature(child.schema) != typed_schema_signature(SCHEMA)
+                or tuple(id(getattr(child, name)) for name in
+                    ('config', 'ownership_limits', 'development_config')) != self._config_ids
+                or child.action_invariant_credit or child.reclosure_enabled
+                or child.development_config.split_enabled
+                or tuple(getattr(child, name) for name in
+                    ('completed', 'last_event', 'episodes_completed')) != self._counters
+                or TerminalDevelopment.act is not self._terminal_act
+                or any(getattr(getattr(child, name), '__func__', None) is not function
+                       for name, function in self._methods.items())):
+            self._poison('typed schema, native no-learning law/method or counter contract changed')
+        source.require_completed_barrier()
+        EpisodicSelectiveDevelopment._require_completed_source(child)
+        if any(getattr(child, name, False) for name in
+               ('_episode_acting', '_episode_crediting', '_episode_multi_crediting')):
+            self._poison('resident child has unfinished execution or credit')
+
+    def _full_integrity(self):
+        self._cheap_boundary()
+        self._binding_check(self._binding)
+        self._source.validate()
+        if (self._source.state_digest() != self._source_digest
+                or digest(self._source.contract()) != self._source_contract
+                or any(_complete_graph_stamp(self._source.modules[scope]) != stamp
+                       for scope, stamp in self._source_graphs.items())):
+            self._poison('authenticated source learning/RNG/graph/contract changed')
+        self._child.validate_ownership()
+        if (child_learning_digest(self._child) != self._learning
+                or _complete_graph_stamp(self._child) != self._graph
+                or _replica_signature(self._child) != self._replicas
+                or canonical(self._child.last_route_observations) != self._observations
+                or _dispatch_signature() != self._dispatch):
+            self._poison('resident child graph, learning/RNG, replicas or dispatch changed')
+        _reject_composed_objects(self._child)
+        # The whole source includes runtime/composer/bridge/ledger state, not
+        # only M1 or immediate owner containers. Equal-valued nested metadata
+        # aliases must fail even when canonical values and graph stamps match.
+        assert_no_source_alias(self._source, self._child)
+
+    def _accept_expansion(self, old_slots):
+        actor = self._child
+        if actor.slots == old_slots:
+            return
+        old = self._graph[0]
+        now = _complete_graph_stamp(actor)
+        replicas = _replica_signature(actor)
+        if (actor.slots <= old_slots or now[0].nodes[:len(old.nodes)] != old.nodes
+                or now[0].edges[:len(old.edges)] != old.edges
+                or now[4][:len(self._graph[4])] != self._graph[4]
+                or child_learning_digest(actor) != self._learning
+                or any(current_name != previous_name
+                    or current_rows[:len(previous_rows)] != previous_rows
+                    for (current_name, current_rows), (previous_name, previous_rows)
+                    in zip(replicas, self._replicas))):
+            self._poison('binding expansion changed prior learned/native dependencies')
+        # Native act already used the unchanged _ensure_slots and formal pair
+        # validation before choice. No additional scorer or remount is supplied.
+        actor.validate_ownership()
+        self._graph, self._replicas = now, replicas
+        self._metrics['binding_expansion_checks'] += 1
+
+    def evaluate(self, fen, *, event_id=0):
+        """Run one new board; return an UNACCEPTED receipt index, never its result."""
+        if self._state != 'OPEN':
+            self._poison('evaluation attempted outside an open standalone M1 batch')
+        port = None
+        try:
+            self._cheap_boundary()
+            if type(fen) is not str or type(event_id) is not int:
+                self._poison('typed FEN and integer evaluation event identity required')
+            board = chess.Board(fen)
+            if not board.is_valid() or board.turn != chess.WHITE or board.is_game_over():
+                self._poison('standalone M1 requires a valid nonterminal White-to-move board')
+            port = ChessFeaturePort(board)
+            bindings = tuple(port.bindings())
+            if not bindings or any(type(value) is not str for value in bindings):
+                self._poison('complete typed legal actuator menu required')
+            old_slots = self._child.slots
+            self._metrics['native_calls_started'] += 1
+            action = self._child.act(port, event_id=event_id, learn=False)
+            if port.executed is not None:
+                self._metrics['native_white_commits'] += 1
+            if (type(action) is not str or action != port.executed or action not in bindings
+                    or len(board.move_stack) != 1 or board.move_stack[0].uci() != action
+                    or tuple(self._child.graph.nodes['catalog'].meta['reading']) != bindings):
+                self._poison('native M1 terminal action/one-commit/binding contract differs')
+            values = _score_inputs(self._child, bindings)
+            record = {'fen': fen, 'action': action, 'prediction_hex': values[bindings.index(action)][1],
+                'bindings': bindings, 'score_inputs': values, 'after_fen': board.fen(),
+                'mate': board.is_checkmate() and board.turn == chess.BLACK}
+            EpisodicSelectiveDevelopment._require_completed_source(self._child)
+            self._child._reset()
+            self._metrics['ordinary_resets'] += 1
+            self._accept_expansion(old_slots)
+            self._cheap_boundary()
+            index = len(self._results)
+            self._results.append(record)
+            self._metrics['evaluations'] += 1
+            return {'status': 'UNACCEPTED', 'index': index, 'acceptance_required': True}
+        except BaseException as error:
+            if port is not None and port.executed is not None and self._metrics['native_calls_started'] > self._metrics['native_white_commits']:
+                self._metrics['native_white_commits'] += 1
+            if self._state == 'INVALIDATED':
+                raise
+            self._poison('unexpected standalone M1 evaluation exception; entire batch rejected', cause=error)
+
+    def assert_integrity(self):
+        """Mandatory full acceptance-boundary check; does not release results."""
+        try:
+            self._full_integrity()
+        except BaseException as error:
+            if self._state == 'INVALIDATED':
+                raise
+            self._poison('standalone M1 batch integrity failed', cause=error)
+        return {'status': self._state, 'source_binding': dict(self._binding),
+                'buffered_results': len(self._results), 'accepted': self._state == 'ACCEPTED'}
+
+    def accept(self):
+        """Perform full final checks before issuing a revocable release handle."""
+        try:
+            self.assert_integrity()
+            self._metrics['acceptance_integrity_checks'] += 1
+            acceptance = {'schema': 'resident-standalone-m1-accepted-batch.v1',
+                'status': 'ACCEPTED', 'source_binding': dict(self._binding),
+                'result_count': len(self._results),
+                'results_sha256': plain_json_digest(self._results),
+                'source_state_before_and_after': self._source_digest,
+                'resident_learning_before_and_after': self._learning,
+                'metrics': self.metrics, 'native_learning_updates': 0,
+                'scientific_initializations': 0, 'entry_and_final_integrity_pass': True,
+                'trust_boundary': 'exclusive synchronous laboratory; persistent mutation detection at acceptance; no arbitrary concurrent or change-and-restore guarantee'}
+            self._acceptance = acceptance
+            self._state = 'ACCEPTED'
+            return AcceptedM1Batch(self, self._generation)
+        except BaseException as error:
+            if self._state == 'INVALIDATED':
+                raise
+            self._poison('standalone M1 acceptance failed; entire batch rejected', cause=error)
+
+    finish_batch = accept
