+def _prelaunch(*, identity, protocol_path, authorization, independent_admission,
+               interfaces: NativeCanaryInterfaces):
+    protocol_sha = sha(protocol_path)
+    assert_run_authorized(authorization=authorization,independent_admission=independent_admission,
+                          protocol_sha256=protocol_sha,now_epoch=time.time())
+    pieces = identity.split(':')
+    if len(pieces) !=3 or pieces[0] !=NAMESPACE or pieces[1] not in STREAMS or pieces[2] not in ARMS:
+        raise ValueError('one of six predeclared identities required; no substitute seeds')
+    if not isinstance(interfaces,NativeCanaryInterfaces) or any(not callable(value) for value in vars(interfaces).values()):
+        raise RuntimeError('all qualified native census/control/reconstruction/guard interfaces required before initialization')
+    interfaces.deadline_check()
+    return pieces[1],pieces[2]
