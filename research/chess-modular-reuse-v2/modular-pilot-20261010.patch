+"""Prospective modular canary and offline exposure bookkeeping.
+
+Nothing in this module constructs a scientific actor, reads a pickle, fits a
+policy, or supplies feedback. Packet A may prepare schedules and laboratory
+records. Execution of Packet B requires a new explicit authorization and fully
+measured admission; declarations and proposed seeds are not initialization.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+from decimal import Decimal, ROUND_CEILING
+from fractions import Fraction
+import hashlib
+import json
+import math
+import random
+import time
+from typing import Callable, Iterable, Mapping, Sequence
+
+import chess
+
+from recon_lite_chess.autogrowth.mate_horizon_opponent import choose_mate_horizon_reply
+from .pools import orbit_key
+
+
+NAMESPACE = "m2-native-modular-canary-20261005-v1"
+STREAMS = ("001", "002", "003")
+ARMS = ("frozen", "plastic")
+CENSUS_EPISODES = (0, 64, 128, 192, 256)
+KNOWN_M1_POSITIONS = 1512
+M1_TRAIN_POSITIONS = 1080
+M2_TRAIN_POSITIONS = 256
+M2_DEVELOPMENT_POSITIONS = 128
+EPISODES = 256
+M1_REHEARSALS = 64
+M2_EPISODES = 192
+PHYSICAL_ACTION_CAP = 448
+PARTICIPATION_CAP = 896
+COHORT_PHYSICAL_ACTION_CAP = 2688
+COHORT_PARTICIPATION_CAP = 5376
+STRICT_MARGIN = 0.0
+SCHEMA_VERSION = "native-modular-canary.v1"
+TARGET_VERSION = "parent-setup-eventual_m1-immediate.v1"
+PERMISSION_VERSION = "independent-explore-record-update-develop.v1"
+
+
+def canonical_digest(value: object) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"),
+                                     allow_nan=False).encode()).hexdigest()
+
+
+def proposed_identities() -> tuple[str, ...]:
+    return tuple(f"{NAMESPACE}:{stream}:{arm}" for stream in STREAMS for arm in ARMS)
+
+
+def assert_unused_identities(initialized_or_receipted: Iterable[str]) -> None:
+    """Caller inventories actual initialization/receipts; a declaration is not use."""
+    collision = sorted(set(proposed_identities()).intersection(initialized_or_receipted))
+    if collision:
+        raise ValueError(f"proposed scientific identities already used: {collision}")
+
+
+def pair_seed_strings(stream: str) -> dict[str, str]:
+    if stream not in STREAMS:
+        raise ValueError("unknown predeclared stream; no substitute streams")
+    prefix = f"{NAMESPACE}:{stream}"
+    return {key: f"{prefix}:{key}" for key in
+            ("parent-birth", "parent-exploration", "setup-birth", "setup-exploration",
+             "exercise-m1", "exercise-m2")}
+
+
+@dataclass(frozen=True)
+class EpisodeSpec:
+    episode: int
+    environment_contract: str
+    white_action_budget: int
+    fen: str
+    pool_index: int
+    shuffle_cycle: int
+
+
+def _shuffled_cursor(rows: Sequence[str], seed_string: str):
+    # Version-2 Python string seeding and native shuffle consumption are pinned.
+    rng = random.Random()
+    rng.seed(seed_string, version=2)
+    cycle = 0
+    while True:
+        indices = list(range(len(rows)))
+        rng.shuffle(indices)
+        for index in indices:
+            yield rows[index], index, cycle
+        cycle += 1
+
+
+def proposed_schedule(stream: str, m1_train: Sequence[str],
+                      m2_train: Sequence[str]) -> tuple[EpisodeSpec, ...]:
+    if len(m1_train) != M1_TRAIN_POSITIONS or len(m2_train) != M2_TRAIN_POSITIONS:
+        raise ValueError("unchanged complete 1080/256 training pools required")
+    if len(set(m1_train)) != len(m1_train) or len(set(m2_train)) != len(m2_train):
+        raise ValueError("duplicate pool identities")
+    seeds = pair_seed_strings(stream)
+    cursors = {"m1": _shuffled_cursor(tuple(m1_train), seeds["exercise-m1"]),
+               "m2": _shuffled_cursor(tuple(m2_train), seeds["exercise-m2"])}
+    result = []
+    for episode in range(1, EPISODES + 1):
+        kind = "m1" if episode % 4 == 0 else "m2"
+        fen, index, cycle = next(cursors[kind])
+        result.append(EpisodeSpec(episode, kind, 1 if kind == "m1" else 2,
+                                  fen, index, cycle))
+    return tuple(result)
+
+
+def prospective_protocol(*, input_hashes: Mapping[str, str],
+                         unused_inventory_sha256: str) -> dict:
+    return {
+        "schema": SCHEMA_VERSION, "status": "PROPOSED_NOT_INITIALIZED_NOT_AUTHORIZED",
+        "scientific_actors_initialized": 0, "scientific_time_window": None,
+        "requires_new_explicit_launch_authorization": True,
+        "requires_complete_measured_independent_admission": True,
+        "namespace": NAMESPACE, "streams": list(STREAMS), "arms": list(ARMS),
+        "identities": list(proposed_identities()),
+        "identity_inventory_sha256": unused_inventory_sha256,
+        "input_hashes": dict(sorted(input_hashes.items())),
+        "initial_foundation": {
+            "lineage": "202609250801", "completed_action": 3072,
+            "checkpoint_sha256": "535aacae805569168752774efddde387b85522eb641552ac9153c233c81bcdd0",
+            "accepted_state_digest": "8be2bba1bc13b49e0f65a1c9a18d2040867d4fef4ef56409d63db8d9df09e2a8",
+            "accepted_m1_rng_retained": True, "independent_lineages": 1},
+        "seed_strings": {stream: pair_seed_strings(stream) for stream in STREAMS},
+        "seed_convention": "Python Random.seed(string, version=2); no arm name in seeds",
+        "schedule": {"episodes": EPISODES, "every_fourth": "one-White-action M1",
+                     "m1_rehearsal": M1_REHEARSALS, "m2": M2_EPISODES,
+                     "m1_train": M1_TRAIN_POSITIONS, "m2_train": M2_TRAIN_POSITIONS,
+                     "cursor": "independent matched shuffled-without-replacement per pool",
+                     "all_start_at_parent": True, "task_label_is_graph_input": False},
+        "permissions": {
+            "parent": {"exploration": 0.25, "record": True, "update": True, "develop": True},
+            "setup": {"exploration": 0.25, "record": True, "update": True, "develop": True},
+            "m1_frozen": {"exploration": 0.0, "record": True, "update": False, "develop": False},
+            "m1_plastic": {"exploration": 0.0, "record": True, "update": True, "develop": True}},
+        "target_version": TARGET_VERSION, "permission_version": PERMISSION_VERSION,
+        "acquisition_deadline": 192, "fixed_endpoint": 256,
+        "checkpoint_and_census": list(CENSUS_EPISODES),
+        "cold_replay": {"checkpoint": 128, "saved_episode": 129,
+                        "additional_scientific_continuation": False},
+        "censuses": {"standalone_m1": KNOWN_M1_POSITIONS,
+                     "whole_parent_one_move_m1": KNOWN_M1_POSITIONS,
+                     "whole_parent_all_reply_m2": M2_DEVELOPMENT_POSITIONS,
+                     "separate_measurements": True},
+        "actor_requirements": {
+            "m1": "1512/1512 standalone AND whole-parent at every census",
+            "m2": "at least eight baseline-new successes persistent at192/256 over at least two D4 orbits; net>=baseline+8 both",
+            "reuse": "setup-first and M1-finish on every reply; strict unboosted parent request preference at both late censuses",
+            "learning": "actual positive M2 receipt; subsequent nonzero credit to genuinely born/refined parent AND setup structure",
+            "verification": "mechanical/native replay/ownership PASS and finisher disconnect eliminates selected completion with no fallback"},
+        "selection_rule": "qualifying_set and dependence_panel functions in pinned coach/modular_canary.py",
+        "controls": {"late_censuses": [192, 256], "panel_max": 8, "panel_orbits_max": 2,
+                     "modes": ["disconnect_m1_no_fallback", "replace_m1_with_setup", "fixed_setup_then_m1_lab_only"],
+                     "prospective_known_m1_script_boards": 8,
+                     "equal_replacement_or_script_is_automatic_failure": False},
+        "caps": {"physical_white_actions_per_actor": PHYSICAL_ACTION_CAP,
+                 "participation_records_per_actor": PARTICIPATION_CAP,
+                 "cohort_physical_white_actions": COHORT_PHYSICAL_ACTION_CAP,
+                 "cohort_participation_records": COHORT_PARTICIPATION_CAP},
+        "execution_order": [{"stream": stream, "phase": phase, "arms": list(ARMS)}
+                            for stream in STREAMS for phase in ("producers", "native_replays")],
+        "workers_max": 2, "numerical_threads_each": 1,
+        "sampled_rss_bytes_each": 2 * 1024**3,
+        "final_test_open": False, "default_adoption": False,
+        "interpretation": "three streams of one accepted M1 lineage; bounded reuse/integration mechanism canary, not an M2 milestone or population-reliability test",
+        "persistence_interpretation": "two late censuses, not continuous competence; retain all intervening played failures"}
+
+
+def prospective_m1_script_panel(known_m1_fens: Sequence[str]) -> tuple[str, ...]:
+    if len(known_m1_fens) !=1512 or len(set(known_m1_fens)) !=1512:
+        raise ValueError("complete distinct1512 known-M1 inventory required")
+    return tuple(sorted(known_m1_fens)[:8])
+
+
+def complete_development_reply_bound(development_fens: Sequence[str]) -> dict:
+    """Offline geometry-only branch bound over every possible legal first move.
+
+    This enumerates chess-rule transitions to count Black bindings, not child
+    choices or outcomes. It does not use a prospective actor or final-test rows.
+    """
+    if len(development_fens) !=128 or len(set(development_fens)) !=128:
+        raise ValueError("complete distinct128-board development inventory required")
+    rows = []
+    for fen in sorted(development_fens):
+        board = chess.Board(fen)
+        if not board.is_valid() or board.turn !=chess.WHITE:
+            raise ValueError("legal White-to-move development board required")
+        branch_counts = []
+        for first in sorted(board.legal_moves, key=lambda move:move.uci()):
+            after = board.copy(stack=True)
+            after.push(first)
+            count = 0 if _terminal_reason(after) is not None else after.legal_moves.count()
+            branch_counts.append({"first":first.uci(),"legal_black_replies":count})
+        rows.append({"fen":fen,"all_legal_first_count":len(branch_counts),
+                     "maximum_black_replies":max((row["legal_black_replies"] for row in branch_counts),default=0),
+                     "branches":branch_counts})
