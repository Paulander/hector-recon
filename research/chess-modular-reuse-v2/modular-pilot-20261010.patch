+    first_terminal = _terminal(primary)
+    require(record['first_terminal'] == (None if first_terminal is None else first_terminal[0]),
+            'M2 first terminal classification differs')
+    legal_replies = [] if first_terminal else sorted(move.uci() for move in primary.legal_moves)
+    replies = record['replies']
+    require(type(replies) in (tuple, list) and [r['black_action'] for r in replies] == legal_replies,
+            'missing/extra/reordered all-reply branches')
+    verified, first_calls, finish_calls = [], 1, 0
+    for row in replies:
+        require(type(row) is dict and set(row) == {'black_action', 'mate', 'reason',
+            'repeated_first_record', 'finish_record', 'after_fen'}, 'unsupported complete M2 branch schema/fields')
+        branch, repeat = verify_decision(capsule, row['repeated_first_record'], start, 0, validated=True)
+        require(row['repeated_first_record'] == record['first_record'] and repeat == first,
+                'repeated native first record differs across reply branches')
+        first_calls += 1
+        branch.push_uci(row['black_action'])
+        end = _terminal(branch)
+        finish = None
+        if end is None:
+            require(row['finish_record'] is not None, 'unfinished required M2 branch')
+            branch, finish = verify_decision(capsule, row['finish_record'], branch, 2, 2, validated=True)
+            finish_calls += 1
+            end = _terminal(branch)
+        else:
+            require(row['finish_record'] is None, 'terminal branch invents a finishing request')
+        reason, mate = end or ('exercise_timeout', False)
+        require(row['after_fen'] == branch.fen() and row['reason'] == reason
+                and type(row['mate']) is bool and row['mate'] == mate, 'M2 saved branch outcome differs')
+        verified.append({'black_action': row['black_action'], 'mate': mate, 'reason': reason,
+            'finish_scope': None if finish is None else finish['selected_module'],
+            'finish_request_margin': None if finish is None else finish['request_margin']})
+    success = first_terminal[1] if first_terminal else bool(verified) and all(r['mate'] for r in verified)
+    finishing = bool(verified) and all(r['finish_scope'] == 'm1' for r in verified)
+    margins = [r['finish_request_margin'] for r in verified if r['finish_request_margin'] is not None]
+    facts = {'fen': record['fen'], 'orbit': _orbit(start), 'all_reply_mate': success,
+        'setup_first': first['selected_module'] == 'setup', 'm1_finish_every_reply': finishing,
+        'first_request_margin': first['request_margin'], 'finish_request_margins': margins,
+        'm2_primary_and_repeated_first_calls': first_calls, 'm2_finishing_calls': finish_calls,
+        'black_replies': len(verified), 'native_executions': 0}
+    for key in ('orbit', 'all_reply_mate', 'setup_first', 'm1_finish_every_reply'):
+        require(record[key] == facts[key] and (type(record[key]) is bool if key != 'orbit' else type(record[key]) is str),
+                'derived M2 metric differs: ' + key)
+    require(_float_hex(record['first_request_margin'], 'first margin') == float(facts['first_request_margin']).hex()
+            and len(record['finish_request_margins']) == len(margins)
+            and all(_float_hex(a, 'finish margin') == float(b).hex() for a, b in zip(record['finish_request_margins'], margins)),
+            'M2 strict request margin arithmetic differs')
+    return facts
