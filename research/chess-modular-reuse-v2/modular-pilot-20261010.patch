index 0000000..377a588
--- /dev/null
+++ b/src/recon_lite_chess/coach/modular_evaluation_workspace.py
@@ -0,0 +1,418 @@
+"""Snapshot-bound, opt-in laboratory workspace; no learner/runtime changes.
+
+The original complete ``evaluation_copy`` remains the reference.  This adapter
+makes one such private copy, retains its native graph, and restores completed
+baseline bookkeeping between independent evaluation trials.  It never caches a
+choice, score, terminal observation, reward, or partially executed branch.
+"""
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+from types import MappingProxyType
+
+import chess
+
+from recon_lite.graph import Edge, LinkType, NodeState
+from recon_lite_hector.learning.modular_graph import NativeInvocationGraph, ScopedEngine
+
+from .m2_evidence import canonical, digest
+from .mate_two import _start, _terminal
+from .modular_evaluation_child import child_learning_projection, projection_digest
+from .native_modular import MODULE_IDS, NativeModularOrganism
+
+
+class StaleEvaluationSnapshot(ValueError):
+    """An invalidated workspace is permanently unusable, not silently repaired."""
+
+
+# These are the existing formal engine's per-invocation outputs, never inputs
+# defining a learned expression or its insertion/child order.
+_EXECUTION_META = frozenset({
+    'choice_selected', 'choice_selected_child', 'emitted_actuator_identity',
+    'reading', 'emitted', 'selected_request_child', 'selected_connection',
+    'selected_child', 'target_scope', 'return_source',
+})
+
+
+def _node_definition(node):
+    meta = {key: value for key, value in node.meta.items()
+            if key not in _EXECUTION_META
+            and not (key == 'actuator_identity' and node.nid.startswith('option:'))}
+    return (node.nid, node.ntype, node.predicate, canonical(meta),
+            # Ordinary condition gates carry constant activation.  Their
+            # value is not cleared by _reset(), so protect it explicitly.
+            node.activation.value if 'condition_id' in node.meta else None)
+
+
+@dataclass(frozen=True)
+class _GraphStamp:
+    nodes: tuple
+    edges: tuple
+    indices: tuple
+    identities: tuple
+    slots: int
+
+
+def _index_signature(graph):
+    """Exact typed, ordered indices without projecting every Edge twice.
+
+    Node/edge fields, predicates, weight identities/values and edge metadata
+    remain separately protected in _graph_stamp.  Indices contain only typed
+    immutable keys, ordered child strings, and object identities.  Container
+    identities retain list/dict alias detection without recursively revisiting
+    the same Edge/PlasticWeight objects through edge_by_key.
+    """
+    result = []
+    for name in ('out', 'inc', 'parents_fanin'):
+        mapping = getattr(graph, name)
+        if type(mapping) is not dict:
+            raise ValueError('graph index must be a native ordered dict: ' + name)
+        rows = []
+        for key, children in mapping.items():
+            valid_key = (type(key) is str if name == 'parents_fanin' else
+                type(key) is tuple and len(key) == 2 and type(key[0]) is str
+                and type(key[1]) is LinkType)
+            if (not valid_key or type(children) is not list
+                    or any(type(child) is not str for child in children)):
+                raise ValueError('graph child index has invalid typed key/list: ' + name)
+            rows.append((key, id(children), tuple(children)))
+        result.append((name, id(mapping), tuple(rows)))
+    mapping = graph.parent
+    if (type(mapping) is not dict or any(type(key) is not str
+            or (value is not None and type(value) is not str)
+            for key, value in mapping.items())):
+        raise ValueError('graph parent index has invalid typed key/value')
+    result.append(('parent', id(mapping), tuple(mapping.items())))
+    mapping = graph.edge_by_key
+    if type(mapping) is not dict:
+        raise ValueError('graph edge_by_key must be a native ordered dict')
+    rows = []
+    for key, edge in mapping.items():
+        if (type(key) is not tuple or len(key) != 3
+                or type(key[0]) is not str or type(key[1]) is not str
+                or type(key[2]) is not LinkType or type(edge) is not Edge):
+            raise ValueError('graph edge_by_key index has invalid typed key/edge')
+        rows.append((key, id(edge)))
+    result.append(('edge_by_key', id(mapping), tuple(rows)))
+    return tuple(result)
+
+
+def _graph_stamp(actor):
+    graph = actor.graph
+    return _GraphStamp(
+        tuple(_node_definition(node) for node in graph.nodes.values()),
+        tuple((edge.src, edge.dst, edge.ltype, id(edge.w),
+               canonical(edge.w), canonical(edge.meta)) for edge in graph.edges),
+        _index_signature(graph),
+        (id(graph), tuple(id(node) for node in graph.nodes.values()),
+         tuple(id(edge) for edge in graph.edges)), actor.slots)
+
+
+def _learning_digest(actor):
+    return projection_digest(child_learning_projection(actor))
+
+
+class _EvaluationScopedEngine(ScopedEngine):
+    def refresh(self):
+        self.runtime.workspace._refresh_scope(self.scope)
+
+
+class _EvaluationInvocationGraph(NativeInvocationGraph):
+    """Private adapter: only the refresh strategy differs from native phases."""
+
+    def execute_phase(self, scope, phase):
+        if phase != 'bind':
+            return super().execute_phase(scope, phase)
+        actor = self.modules[scope]
+        self.workspace._check_scope(scope)
+        engine = _EvaluationScopedEngine(self, scope)
+        # All catalog, binding order, probes, denominator, math.fsum, native
+        # choice, local validation and capture are the existing implementation.
+        actor._invocation_bind(engine, self.environments[scope])
+
+
+class EvaluationWorkspace:
+    """One authenticated completed snapshot, one resident evaluation graph.
+
+    ``binding_check`` is mandatory: the owning guarded packet authenticates the
+    supplied source/runtime hashes before entry.  It is called again at every
+    independent trial, not substituted by treating hash strings as proof.
+    This class neither loads checkpoints nor admits a scientific actor.
+
+    Access to ``organism`` is for readback and existing census helpers.  Mutating
+    its protected state invalidates this workspace.  Use the methods below for
+    trial execution, never direct native calls on that object.
+    """
+
+    def __init__(self, source, *, source_binding, binding_check, control=None):
+        if type(source) is not NativeModularOrganism:
+            raise TypeError('exact native modular completed snapshot required')
+        if not callable(binding_check):
+            raise ValueError('authenticated source/runtime binding check required')
+        required = {'snapshot_sha256', 'source_pin_sha256', 'runtime_identity_sha256'}
+        if (set(source_binding) != required or any(
+                type(value) is not str or len(value) != 64
+                or any(c not in '0123456789abcdef' for c in value)
+                for value in source_binding.values())):
+            raise ValueError('three explicit SHA256 snapshot/source/runtime bindings required')
+        source.require_completed_barrier()
+        source.validate()
+        if source_binding['snapshot_sha256'] != source.state_digest():
+            raise StaleEvaluationSnapshot('snapshot binding differs before private copy')
+        self._binding = MappingProxyType(dict(source_binding))
+        self._binding_check = binding_check
+        self._binding_check(self._binding)
+        self._source = source
+        self._source_learning = {m: _learning_digest(a) for m, a in source.modules.items()}
+        self._source_graphs = {m: _graph_stamp(a) for m, a in source.modules.items()}
+        self._source_contract = digest(source.contract())
+        self._organism = source.evaluation_copy()
+        if control is not None:
+            self._organism.apply_evaluation_control(control)
+        self.control = control
+        self._organism.runtime.__class__ = _EvaluationInvocationGraph
+        self._organism.runtime.workspace = self
+        self._learning = {m: _learning_digest(a) for m, a in self._organism.modules.items()}
+        self._mounts = {m: _graph_stamp(a) for m, a in self._organism.modules.items()}
+        self._permissions = dict(self._organism.permissions)
+        self._connections = dict(self._organism.connections)
+        self._versions = dict(self._organism.runtime.composer.structure_versions)
+        self._bridge = tuple(_node_definition(n) for n in
+                             self._organism.runtime.composer.bridge_nodes.values())
+        self._base_counters = (self._organism.request_counter,
+                               self._organism.episode_counter,
+                               dict(self._organism.event_base))
+        ledger = self._organism.ledger
+        self._base_ledger = {key: copy.deepcopy(getattr(ledger, key)) for key in (
+            'last_frames', 'last_commits', 'last_credit', 'development_history',
+            'episodes_completed')}
+        self._base_last_episode = copy.deepcopy(self._organism.last_episode)
+        self._poisoned = False
+        self._active = False
+        self._metrics = {'complete_copies': 1, 'trials': 0, 'native_decisions': 0,
+                         'cache_hits': 0, 'binding_expansion_remounts': 0,
+                         'failed_trials': 0, 'discarded_trials': 0}
+        self._assert_integrity(check_source=True)
+
+    @property
+    def organism(self):
+        return self._organism
+
+    @property
+    def source_binding(self):
+        return self._binding
+
+    @property
+    def metrics(self):
+        return dict(self._metrics)
+
+    @property
+    def active(self):
+        return self._active
+
+    def __getstate__(self):
+        raise RuntimeError('evaluation workspace is ephemeral and never checkpointed')
+
+    def _stale(self, message):
+        self._poisoned = True
+        raise StaleEvaluationSnapshot(message)
+
+    def _check_scope(self, scope):
+        actor = self._organism.modules[scope]
+        if _learning_digest(actor) != self._learning[scope]:
+            self._stale('evaluation learner/RNG/definition state changed: ' + scope)
+        try:
+            stamp = _graph_stamp(actor)
+        except (TypeError, ValueError) as error:
+            self._stale('evaluation graph index has invalid native types: ' + scope)
+        if stamp != self._mounts[scope]:
+            self._stale('evaluation graph changed outside native binding expansion: ' + scope)
+
+    def _assert_integrity(self, *, check_source=False):
+        if self._poisoned:
+            raise StaleEvaluationSnapshot('evaluation workspace was invalidated')
+        o = self._organism
+        if (tuple(o.modules) != MODULE_IDS or o.permissions != self._permissions
+                or o.ledger.permissions != self._permissions
+                or o.connections != self._connections or o.evaluation_control != self.control
+                or o.runtime.composer.structure_versions != self._versions
+                or tuple(_node_definition(n) for n in o.runtime.composer.bridge_nodes.values())
+                != self._bridge):
+            self._stale('evaluation permissions/mapping/structure/control changed')
+        for scope in MODULE_IDS:
+            self._check_scope(scope)
+        if check_source:
+            try:
+                self._binding_check(self._binding)
+                self._source.require_completed_barrier()
+                if digest(self._source.contract()) != self._source_contract:
+                    self._stale('source completed contract/counters changed')
+                for scope in MODULE_IDS:
+                    if (_learning_digest(self._source.modules[scope]) != self._source_learning[scope]
+                            or _graph_stamp(self._source.modules[scope]) != self._source_graphs[scope]):
+                        self._stale('source learning/schema/graph snapshot changed')
+            except StaleEvaluationSnapshot:
+                raise
+            except Exception as error:
+                self._poisoned = True
+                raise StaleEvaluationSnapshot('source/runtime authentication failed') from error
+
+    def assert_integrity(self):
+        """Readback at packet/checkpoint/census boundaries; no native execution."""
+        self._assert_integrity(check_source=True)
+        return {'source_binding': dict(self._binding), 'metrics': self.metrics,
+                'learning_unchanged': True, 'scientific_initializations': 0}
+
+    def _refresh_scope(self, scope):
+        actor = self._organism.modules[scope]
+        now, old = _graph_stamp(actor), self._mounts[scope]
+        if now == old:
+            self._metrics['cache_hits'] += 1
+            return
+        # The only permitted structural change is the original _ensure_slots
+        # called inside the native bind phase.  It can clone old node objects,
+        # but must preserve their exact semantic prefix and weight identities.
+        if (now.slots <= old.slots or now.nodes[:len(old.nodes)] != old.nodes
+                or now.edges[:len(old.edges)] != old.edges
+                or _learning_digest(actor) != self._learning[scope]):
+            self._stale('native binding expansion changed learned dependencies')
+        self._organism.runtime.composer.remount(scope)
+        actor.graph.validate_formal_pairs()
+        self._mounts[scope] = now
+        self._metrics['binding_expansion_remounts'] += 1
+
+    def _restore_private_barrier(self):
+        o = self._organism
+        # Only this workspace's disposable observation/eligibility containers
+        # are discarded.  No reward, observe, development, load, or remount.
+        for actor in o.modules.values():
+            actor._clear_live_pending()
+            actor._reset()
+        ledger = o.ledger
+        ledger.episode_id = None
+        ledger.max_white_actions = 0
+        ledger._frames.clear()
+        ledger._commits.clear()
+        ledger._development_queue.clear()
+        for key, value in self._base_ledger.items():
+            setattr(ledger, key, value)
+        o.request_counter, o.episode_counter, event_base = self._base_counters
+        o.event_base = dict(event_base)
+        o.last_episode = self._base_last_episode
+        o.authority = o.request = o.returned = None
+        o.ports = {}
+        o.traces = []
+        o.runtime.configurations.clear()
+        o.runtime.environments.clear()
+        o.runtime.selections.clear()
+        for node in o.runtime.composer.bridge_nodes.values():
+            node.state, node.activation.value = NodeState.INACTIVE, 0.0
+            for key in _EXECUTION_META:
+                node.meta.pop(key, None)
+        self._active = False
+        o.require_completed_barrier()
+
+    def discard_trial(self):
+        """Discard a private incomplete laboratory branch, never invent reward."""
+        self._assert_integrity()
+        if self._active:
+            self._metrics['discarded_trials'] += 1
+        self._restore_private_barrier()
+        self._assert_integrity()
+
+    reset = discard_trial
+
+    def begin_trial(self, board, *, max_white_actions, episode_id='evaluation:workspace',
+                    source_binding=None):
+        if self._active:
+            raise RuntimeError('finish or explicitly discard the current private evaluation trial')
+        if source_binding is not None and dict(source_binding) != dict(self._binding):
+            self._stale('caller supplied another snapshot/source/runtime binding')
+        self._assert_integrity(check_source=True)
+        self._restore_private_barrier()
+        try:
+            board = _start(board) if type(board) is str else board.copy(stack=True)
+            self._organism.begin_episode(board, max_white_actions=max_white_actions,
+                                         episode_id=episode_id)
+        except Exception:
+            self._metrics['failed_trials'] += 1
+            self._restore_private_barrier()
+            raise
+        self._active = True
+        self._metrics['trials'] += 1
+        return self._organism.authority.board
+
+    begin_episode = begin_trial
+
+    def decide_and_commit(self, *, host_metadata=None):
+        if not self._active:
+            raise RuntimeError('private evaluation trial must begin first')
+        self._assert_integrity()
+        try:
+            result = self._organism.decide_and_commit(host_metadata=host_metadata)
+            self._metrics['native_decisions'] += 1
+            self._assert_integrity()
+            return result
+        except Exception:
+            self._metrics['failed_trials'] += 1
+            if not self._poisoned:
+                self._restore_private_barrier()
+            raise
+
+    def black_reply(self, move):
+        if not self._active:
+            raise RuntimeError('private evaluation trial must begin first')
+        self._assert_integrity()
+        try:
+            self._organism.authority.black_reply(move)
+        except Exception:
+            self._metrics['failed_trials'] += 1
+            self._restore_private_barrier()
+            raise
+
+    def finish_trial(self, *, eventual_mate, reason):
+        if not self._active:
+            raise RuntimeError('private evaluation trial must begin first')
+        self._assert_integrity()
+        try:
+            result = self._organism.finish_episode(eventual_mate=eventual_mate, reason=reason)
+            self._assert_integrity()
+            self._restore_private_barrier()
+            return result
+        except Exception:
+            self._metrics['failed_trials'] += 1
+            if not self._poisoned:
+                self._restore_private_barrier()
+            raise
+
+    finish_episode = finish_trial
+
+    def play_episode(self, fen, *, max_white_actions=2, episode_id=None, host_metadata=None):
+        board = self.begin_trial(fen, max_white_actions=max_white_actions,
+                                 episode_id=episode_id or 'evaluation:workspace')
+        reason = 'exercise_timeout'
+        for ordinal in range(1, max_white_actions + 1):
+            self.decide_and_commit(host_metadata=host_metadata)
+            terminal = _terminal(board)
+            if terminal:
+                reason = terminal[0]
+                break
+            if ordinal == max_white_actions:
+                break
+            if not board.pieces(chess.ROOK, chess.WHITE):
+                reason = 'rook_captured'
+                break
+            from recon_lite_chess.autogrowth.mate_horizon_opponent import choose_mate_horizon_reply
+            self.black_reply(choose_mate_horizon_reply(board))
+            terminal = _terminal(board)
+            if terminal:
+                reason = terminal[0]
+                break
+            if not board.pieces(chess.ROOK, chess.WHITE):
+                reason = 'rook_captured'
+                break
+        return self.finish_trial(eventual_mate=reason == 'checkmate', reason=reason)
+
+
+__all__ = ['EvaluationWorkspace', 'StaleEvaluationSnapshot']
diff --git a/src/recon_lite_chess/coach/modular_ports.py b/src/recon_lite_chess/coach/modular_ports.py
new file mode 100644
index 0000000..dc553ec
--- /dev/null
+++ b/src/recon_lite_chess/coach/modular_ports.py
@@ -0,0 +1,205 @@
+"""Actual-board terminals for native modular requests and deferred primitives.
+
+Request observations are nine existing board-only coordinates, in their original
+order, plus a registered connection argument. No child catalog or score is read
+to obtain them. Move ports retain the qualified16/20-coordinate embodiment but
+return a selected primitive instead of pushing it. The authority's one real
+commit is an output-terminal operation, never a second policy choice.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import json
+from typing import Any
+
+import chess
+
+from recon_lite_hector.learning.terminal_development import Coordinate
+from .m2_schema import M2ChessFeaturePort
+from .selective import STATE_COORDINATES
+from .terminal import ChessFeaturePort, SCHEMA
+
+PARENT_SCHEMA_VERSION = 'chess_board9_connection.v1'
+PARENT_SCHEMA = tuple(SCHEMA[i] for i in STATE_COORDINATES) + (
+    Coordinate('outgoing_connection', (0, 1)),)
+PARENT_STATE_COORDINATES = tuple(range(len(STATE_COORDINATES)))
+CONNECTIONS = {'connection:0': 'setup', 'connection:1': 'm1'}
+
+
+def board_token(board: chess.Board, version: int) -> str:
+    body = (version, board.fen(), tuple(move.uci() for move in board.move_stack))
+    return hashlib.sha256(json.dumps(body, separators=(',', ':')).encode()).hexdigest()
+
+
+def _state_measurements(board: chess.Board):
+    wk, bk = board.king(chess.WHITE), board.king(chess.BLACK)
+    rooks = tuple(board.pieces(chess.ROOK, chess.WHITE))
+    if wk is None or bk is None or len(rooks) != 1:
+        raise ValueError('request port requires the actual declared KRK board')
+    wr = rooks[0]
+    wx, wy = chess.square_file(wk), chess.square_rank(wk)
+    bx, by = chess.square_file(bk), chess.square_rank(bk)
+    rx, ry = chess.square_file(wr), chess.square_rank(wr)
+    return (board.turn == chess.WHITE, abs(wx-bx), abs(wy-by), abs(rx-bx),
+            abs(ry-by), bx in (0, 7), by in (0, 7), wx == bx, wy == by)
+
+
+class RequestFeaturePort:
+    schema = PARENT_SCHEMA
+    sensor_schema_version = PARENT_SCHEMA_VERSION
+
+    def __init__(self, board: chess.Board, *, catalog=('connection:0', 'connection:1')):
+        if (tuple(sorted(catalog)) != tuple(sorted(CONNECTIONS))
+                or len(set(catalog)) != len(catalog)):
+            raise ValueError('exact registered connection catalog required')
+        self._board, self._catalog = board, tuple(catalog)
+        self._fingerprint = board_token(board, 0)
+        self.executed = None
+        self.measurements = []
+
+    def bindings(self):
+        return self._catalog
+
+    def measure(self, coordinate: int, binding: str):
+        if binding not in CONNECTIONS or type(coordinate) is not int or not 0 <= coordinate < 10:
+            raise ValueError('unknown request argument or coordinate')
+        if self.executed is not None or board_token(self._board, 0) != self._fingerprint:
+            raise RuntimeError('stale request observation frame')
+        value = (_state_measurements(self._board)[coordinate] if coordinate < 9
+                 else int(binding == 'connection:1'))
+        value = self.schema[coordinate].validate(value)
+        self.measurements.append((coordinate, binding, value))
+        return value
+
+    def execute(self, binding):
+        if binding not in self._catalog or self.executed is not None:
+            raise ValueError('unregistered or duplicate request return')
+        if board_token(self._board, 0) != self._fingerprint:
+            raise ValueError('stale request observation frame at return')
+        # Operational selection only, not applicability or real actuation.
+        self.executed = binding
+
+
+class _DeferredMove:
+    """Selection-return output, preserving ordinary measurements and bindings."""
+
+    def __init__(self, board: chess.Board):
+        super().__init__(board)
+        self._fingerprint = board_token(board, 0)
+
+    def execute(self, binding):
+        if self.executed is not None or binding not in self._moves:
+            raise ValueError('duplicate or unknown deferred primitive')
+        if board_token(self._board, 0) != self._fingerprint or self._moves[binding] not in self._board.legal_moves:
+            raise ValueError('stale deferred primitive')
+        self.executed = binding
+
+
+class DeferredM1Port(_DeferredMove, ChessFeaturePort):
+    pass
+
+
+class DeferredSetupPort(_DeferredMove, M2ChessFeaturePort):
+    pass
+
+
+@dataclass(frozen=True)
+class ModuleRequest:
+    request_id: str
+    caller_module: str
+    selected_module: str
+    connection_id: str
+    board_authority: str
+    scope: str
+    structure_version: int
+    execution_mode: str
+    return_continuation: str
+
+
+@dataclass(frozen=True)
+class ModuleReturn:
+    request_id: str
+    selected_module: str
+    scope: str
+    structure_version: int
+    board_authority: str
+    primitive: str
+    operational_status: str
+    provenance: str
+
+
+@dataclass(frozen=True)
+class PrimitiveCommit:
+    request_id: str
+    module_id: str
+    primitive: str
+    before_fen: str
+    after_fen: str
+    authority_before: str
+    authority_after: str
+    immediate_mate: bool
+
+
+class BoardAuthority:
+    """One current board; only registered graph returns can commit a primitive."""
+
+    def __init__(self, board: chess.Board, *, connections=None):
+        self.board = board
+        self.connections = dict(CONNECTIONS if connections is None else connections)
+        if (set(self.connections) !=set(CONNECTIONS)
+                or any(scope not in ('setup','m1') for scope in self.connections.values())):
+            raise ValueError('invalid registered board-authority connections')
+        self.version = 0
+        self.pending: ModuleRequest | None = None
+        self.committed: set[str] = set()
+        self.commit_history: list[PrimitiveCommit] = []
+
+    @property
+    def token(self):
+        return board_token(self.board, self.version)
+
+    def register(self, request: ModuleRequest):
+        if self.pending is not None or request.request_id in self.committed:
+            raise ValueError('pending or duplicate authority request')
+        if (request.caller_module != 'parent' or request.selected_module not in ('setup', 'm1')
+                or self.connections.get(request.connection_id) != request.selected_module
+                or request.scope != request.selected_module or request.board_authority != self.token
+                or request.return_continuation != 'bridge:commit'):
+            raise ValueError('unregistered module/connection/authority request')
+        self.pending = request
+
+    def commit(self, returned: ModuleReturn, *, graph_gate_confirmed: bool,
+               selected_connection: str, selected_scope: str) -> PrimitiveCommit:
+        request = self.pending
+        if (request is None or not graph_gate_confirmed or returned.request_id in self.committed
+                or selected_connection != request.connection_id or selected_scope != request.selected_module
+                or returned.request_id != request.request_id or returned.selected_module != request.selected_module
+                or returned.scope != request.scope or returned.structure_version != request.structure_version
+                or returned.board_authority != request.board_authority or self.token != request.board_authority
+                or returned.operational_status != 'selected' or returned.provenance != 'native_choice.v1'):
+            raise ValueError('stale, duplicate, unregistered or foreign graph return')
+        if self.board.turn != chess.WHITE:
+            raise ValueError('primitive commit requires the actual White authority')
+        try:
+            move = chess.Move.from_uci(returned.primitive)
+        except (ValueError, TypeError) as error:
+            raise ValueError('invalid primitive identity') from error
+        if move not in self.board.legal_moves:
+            raise ValueError('returned primitive is not a current legal binding')
+        before, token = self.board.fen(), self.token
+        self.board.push(move)
+        self.version += 1
+        result = PrimitiveCommit(request.request_id, request.selected_module, returned.primitive,
+            before, self.board.fen(), token, self.token,
+            self.board.turn == chess.BLACK and self.board.is_checkmate())
+        self.committed.add(request.request_id)
+        self.pending = None
+        self.commit_history.append(result)
+        return result
+
+    def black_reply(self, move: chess.Move):
+        if self.pending is not None or self.board.turn != chess.BLACK or move not in self.board.legal_moves:
+            raise ValueError('Black reply requires the actual committed board')
+        self.board.push(move)
+        self.version += 1
