+            commit = summary['structural_commits'][module].get(str(cid))
+            if cid == bias or cid in summary['initial_condition_ids'][module] or commit is None:
+                continue
+            condition = fields['conditions'].get(cid)
+            if (condition is None or condition.born != commit['born_completed']
+                    or commit['episode'] >= episode):
+                raise ValueError('credited contributor does not bind a prior physical structural commit')
+            summary[module + '_all_post_birth_nonzero_credit'] += 1
+            if has_positive:
+                summary[module + '_post_birth_nonzero_credit'] += 1
+            records.append({'module': module, 'condition': cid, 'episode': episode,
+                'request_id': frame.request_id, 'white_ordinal': frame.white_ordinal,
+                'environment_contract': row['environment_contract'], 'kind': commit['kind'],
+                'structural_commit_episode': commit['episode'],
+                'structural_commit_sha256': commit['sha256'], 'born_completed': condition.born,
+                'prediction_hex': credit.prediction.hex(), 'reward_hex': credit.reward.hex(),
+                'multiplier_hex': credit.multiplier.hex(), 'denominator': credit.denominator,
+                'increment_hex': credit.increment.hex(), 'ordinary_increment_hex': credit.ordinary_increment.hex(),
+                'has_upstream_positive_m2_receipt': has_positive,
+                'first_positive_m2_episode': summary['first_positive_m2_episode']})
+    newly_committed = []
+    for module in ('parent', 'setup'):
+        before = pre['modules'][module]['fields']; after = post['modules'][module]['fields']
+        history = after['development_history']
+        if len(history) < len(before['development_history']):
+            raise ValueError('development history shortened while aggregating evidence')
+        for event in history[len(before['development_history']):]:
+            refinement = event.get('refinement')
+            if refinement is not None:
+                condition_ids = tuple(refinement['children']); kind = 'refined'
+                parent = refinement['parent']
+                if (type(parent) is not int or parent not in before['conditions']
+                        or parent == before['leaves'][refinement['owner']].bias_id
+                        or parent in after['conditions'] or len(condition_ids) != 2
+                        or len(set(condition_ids)) != 2
+                        or any(_effective(after['conditions'][cid].weight) != refinement['inherited_weight']
+                               for cid in condition_ids)):
+                    raise ValueError('refinement evidence does not bind a removed nonbias parent and inherited children')
+                commit_hash = digest(refinement)
+            elif event.get('birth') is not None:
+                condition_ids = (event['birth'],); kind = 'bud' if event.get('bud') is not None else 'born'
+                commit_hash = digest(event)
+            else:
+                continue
+            for cid in condition_ids:
+                condition = after['conditions'].get(cid)
+                if (type(cid) is not int or condition is None or cid in before['conditions']
+                        or cid in summary['initial_condition_ids'][module]
+                        or str(cid) in summary['structural_commits'][module]
+                        or condition.born != event['episode']):
+                    raise ValueError('structural history is not a genuine committed new contributor')
+                record = {'module': module, 'condition': cid, 'episode': episode,
+                    'kind': kind, 'sha256': commit_hash, 'born_completed': condition.born}
+                summary['structural_commits'][module][str(cid)] = record
+                newly_committed.append(record)
+    summary['completed_episodes'] = episode
+    return {'schema': 'amended-canary-episode-learning-evidence.v1', 'episode': episode,
+        'positive_m2_receipt': positive, 'positive_m2_terminal_reward_hex': '0x1.0000000000000p+0' if positive else None,
+        'post_birth_nonzero_credit': records, 'structural_commits': newly_committed,
+        'actual_learning_episode_added': 1, 'native_execution_by_aggregator': 0,
+        'pre_state_sha256': pre['state_sha256'], 'post_state_sha256': post['state_sha256']}
