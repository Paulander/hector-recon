+    Every branch clones a completed baseline and repeats the first graph choice
+    exactly; its trace must match the primary first trace. No pending episode is
+    pickled/deepcopied. This costs additional first calls, budgeted separately.
+    """
+    if len(known_m1_fens) !=1512 or len(set(known_m1_fens)) !=1512:
+        raise ValueError('complete1512 known-M1 census required')
+    if len(development_fens) !=128 or len(set(development_fens)) !=128:
+        raise ValueError('complete128 M2 development census required')
+    before = organism.state_digest()
+    standalone = []
+    parent_one = []
+    for fen in known_m1_fens:
+        deadline_check()
+        # A pristine evaluation organism supplies a standalone skill view; this
+        # is distinct from selecting it through the learned parent.
+        child = organism.evaluation_copy().modules['m1']
+        board = chess.Board(fen)
+        port = ChessFeaturePort(board)
+        action = child.act(port,event_id=0,learn=False)
+        if action !=port.executed:
+            raise RuntimeError('standalone M1 did not commit through its terminal')
+        standalone.append({'fen':fen,'action':action,'mate':board.is_checkmate(),
+                           'after_fen':board.fen()})
+        deadline_check()
+        parent = organism.evaluation_copy()
+        outcome = parent.play_episode(fen,max_white_actions=1,episode_id='census:parent-m1')
+        parent_one.append({'fen':fen,'mate':outcome['eventual_mate'],
+                           'reason':outcome['reason'],'traces':outcome['traces']})
+    m2_rows = []
+    first_calls = 0
+    finish_calls = 0
+    for fen in development_fens:
+        deadline_check()
+        primary = organism.evaluation_copy()
+        board = _start(fen)
+        primary.begin_episode(board,max_white_actions=2,episode_id='census:m2')
+        first = primary.decide_and_commit()
+        first_calls +=1
+        first_trace = copy.deepcopy(primary.traces[-1])
+        first_terminal = _terminal_or_rook(board)
+        replies = []
+        if first_terminal is None:
+            for reply in sorted(board.legal_moves,key=lambda move:move.uci()):
