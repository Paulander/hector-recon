+def _actual_history(pre, result, commits, traces, frames):
+    """Offline legal-transition, authority and actual terminal regrading.
+
+    The observed Black move is recovered uniquely from the saved consecutive
+    boards, without querying outcomes of alternative White actions. Native R
+    separately generates its opponent actions from the pinned opponent policy.
+    """
+    initial = pre.get('episode_input', {}).get('fen', traces[0]['commit']['before_fen'])
+    board = chess.Board(initial); version = 0
+    budget = pre.get('episode_input', {}).get('white_action_budget')
+    if budget is not None and (len(commits) > budget or budget not in (1, 2)):
+        raise ValueError('actual trajectory exceeds declared physical-action budget')
+    def token():
+        body = (version, board.fen(), tuple(move.uci() for move in board.move_stack))
+        return hashlib.sha256(json.dumps(body, separators=(',', ':')).encode()).hexdigest()
+    def terminal():
+        if board.is_checkmate():
+            return 'checkmate' if board.turn == chess.BLACK else 'lost'
+        if board.is_game_over(claim_draw=True):
+            return 'draw'
+        return None
+    def observed_black(after_fen):
+        if board.turn != chess.BLACK or terminal() is not None:
+            raise ValueError('recorded Black reply follows a terminal or wrong-turn board')
+        matches = []
+        for move in board.legal_moves:
+            successor = board.copy(stack=True); successor.push(move)
+            if successor.fen() == after_fen: matches.append(move)
+        if len(matches) != 1:
+            raise ValueError('saved Black transition is missing, ambiguous or illegal')
+        board.push(matches[0])
+    for index, (commit, trace) in enumerate(zip(commits, traces)):
+        request, returned, actual = (trace[key] for key in ('request', 'return', 'commit'))
+        pair = frames[2 * index:2 * index + 2]
+        request_id = f"request:{pre['request_counter'] + index + 1}"
+        selected = commit.selected_module; connection = trace['selection']['parent']['action']
+        expected_scope = {'connection:0': 'setup', 'connection:1': 'm1'}.get(connection)
+        if expected_scope != selected:
+            raise ValueError('selected parent connection and physical skill differ')
+        authority = token()
+        _same((request['request_id'], request['caller_module'], request['selected_module'],
+               request['connection_id'], request['board_authority'], request['scope'],
+               request['structure_version'], request['execution_mode'], request['return_continuation']),
+              (request_id, 'parent', selected, connection, authority, selected,
+               pre['versions'][selected], 'native', 'bridge:commit'), 'native request authority')
+        _same((returned['request_id'], returned['selected_module'], returned['scope'],
+               returned['structure_version'], returned['board_authority'], returned['primitive'],
+               returned['operational_status'], returned['provenance']),
+              (request_id, selected, selected, pre['versions'][selected], authority, commit.primitive,
+               'selected', 'native_choice.v1'), 'selected skill return authority')
+        _same((actual['request_id'], actual['module_id'], actual['primitive'], actual['before_fen'],
+               actual['authority_before']), (request_id, selected, commit.primitive, board.fen(), authority),
+              'physical commit provenance/history')
+        if commit.board_version != version or any(frame.board_version != version for frame in pair):
+            raise ValueError('participation board version differs from actual history')
+        if tuple(trace['selection']) != ('parent', selected) or tuple(trace['instantiated_ports']) != ('parent', selected):
+            raise ValueError('unrequested module invocation or missing selected call')
+        move = chess.Move.from_uci(commit.primitive)
+        if board.turn != chess.WHITE or move not in board.legal_moves:
+            raise ValueError('actual White primitive is illegal')
+        board.push(move); version += 1
+        _same((actual['after_fen'], actual['authority_after'], actual['immediate_mate']),
+              (board.fen(), token(), board.is_checkmate() and board.turn == chess.BLACK),
+              'physical commit return/outcome')
+        if index + 1 < len(commits):
+            if terminal() is not None or not board.pieces(chess.ROOK, chess.WHITE):
+                raise ValueError('extra White invocation follows a terminal board')
+            observed_black(traces[index + 1]['commit']['before_fen']); version += 1
+            if terminal() is not None or not board.pieces(chess.ROOK, chess.WHITE):
+                raise ValueError('extra White invocation follows terminal Black reply')
+        elif result['final_fen'] != board.fen():
+            if budget is not None and len(commits) >= budget:
+                raise ValueError('Black reply after completed White-action budget')
+            observed_black(result['final_fen']); version += 1
+    _same(result['final_fen'], board.fen(), 'actual final board')
+    reason = terminal()
+    if reason is None:
+        reason = 'rook_captured' if not board.pieces(chess.ROOK, chess.WHITE) else 'exercise_timeout'
+    _same((result['reason'], result['eventual_mate']), (reason, reason == 'checkmate'),
+          'independent actual terminal reason and reward')
+
